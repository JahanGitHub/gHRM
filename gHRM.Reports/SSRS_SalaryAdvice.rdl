                        <ColSpan>2</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell />
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox182">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=SUM(
    IIf(System.String.IsNullOrEmpty(Fields!Arrear.Value), 0, Fields!Arrear.Value)
     + IIf(System.String.IsNullOrEmpty(Fields!TemporaryFieldAllowance.Value), 0, Fields!TemporaryFieldAllowance.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!ArrearBonus.Value), 0, Fields!ArrearBonus.Value)
	    + IIf(System.String.IsNullOrEmpty(Fields!SalaryRefund.Value), 0, Fields!SalaryRefund.Value)

    + IIf(System.String.IsNullOrEmpty(Fields!BasicSalary.Value), 0, Fields!BasicSalary.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!Conveyance.Value), 0, Fields!Conveyance.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!HouseRent.Value), 0, Fields!HouseRent.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!InChargeAllowance.Value), 0, Fields!InChargeAllowance.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!Medical.Value), 0, Fields!Medical.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!PFOfficeContribution.Value), 0, Fields!PFOfficeContribution.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!SpecialAllowance.Value), 0, Fields!SpecialAllowance.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!ArrearCPFOfficeContribution.Value), 0, Fields!ArrearCPFOfficeContribution.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!LFA.Value), 0, Fields!LFA.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!Overtime.Value), 0, Fields!Overtime.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!MobileDeduction2.Value), 0, Fields!MobileDeduction2.Value)
    + IIf(System.String.IsNullOrEmpty(Fields!TA_DA_Allowance.Value), 0, Fields!TA_DA_Allowance.Value)
	 

    - IIf(System.String.IsNullOrEmpty(Fields!ITDeduction.Value), 0, Fields!ITDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!IncomeTaxDeduction.Value), 0, Fields!IncomeTaxDeduction.Value)
	 - IIf(System.String.IsNullOrEmpty(Fields!LWP.Value), 0, Fields!LWP.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!MobileDeduction.Value), 0, Fields!MobileDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!PFEmployeeDeduction.Value), 0, Fields!PFEmployeeDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!PFOfficeDeduction.Value), 0, Fields!PFOfficeDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!PFLoanDeduction.Value), 0, Fields!PFLoanDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!RoomRentDeduction.Value), 0, Fields!RoomRentDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!StampDeduction.Value), 0, Fields!StampDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!ArrearCPFEmpDeduction.Value), 0, Fields!ArrearCPFEmpDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!Vehicle_Use.Value), 0, Fields!Vehicle_Use.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!Salary_Deposit.Value), 0, Fields!Salary_Deposit.Value)   - IIf(System.String.IsNullOrEmpty(Fields!OtherDeduction.Value), 0, Fields!OtherDeduction.Value)
    - IIf(System.String.IsNullOrEmpty(Fields!ArrearCPFOfficeDeduction.Value), 0, Fields!ArrearCPFOfficeDeduction.Value)
)</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0.00;(#,0.00)</Format>
                                  </Style>
                                </TextRun>
