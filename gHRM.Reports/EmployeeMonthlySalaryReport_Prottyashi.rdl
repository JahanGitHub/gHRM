                    <TablixCell>
                      <CellContents>
                        <Textbox Name="deduction_others">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!deduction_others.Value</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>0;(0)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>deduction_others</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>1pt</PaddingLeft>
                            <PaddingRight>1pt</PaddingRight>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox40">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(string.IsNullOrEmpty(Fields!ITDeduction.Value), 0, Fields!ITDeduction.Value)  + IIf(string.IsNullOrEmpty(Fields!laptoploan.Value), 0, Fields!laptoploan.Value)  + IIf(string.IsNullOrEmpty(Fields!houseloan.Value), 0, Fields!houseloan.Value)  + IIf(string.IsNullOrEmpty(Fields!motorloan.Value), 0, Fields!motorloan.Value)

                                   
                                    + IIf(string.IsNullOrEmpty(Fields!MobileDeduction.Value), 0, Fields!MobileDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!PFEmployeeDeduction.Value), 0, Fields!PFEmployeeDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!PFOfficeDeduction.Value), 0, Fields!PFOfficeDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!PFLoanDeduction.Value), 0, Fields!PFLoanDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!RoomRentDeduction.Value), 0, Fields!RoomRentDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!StampDeduction.Value), 0, Fields!StampDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!ArrearCPFEmpDeduction.Value), 0, Fields!ArrearCPFEmpDeduction.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!ArrearCPFOfficeDeduction.Value), 0, Fields!ArrearCPFOfficeDeduction.Value)
									 + IIf(string.IsNullOrEmpty(Fields!Vehicle_Use.Value), 0, Fields!Vehicle_Use.Value)
									  + IIf(string.IsNullOrEmpty(Fields!Salary_Deposit.Value), 0, Fields!Salary_Deposit.Value)

									 + IIf(string.IsNullOrEmpty(Fields!Welfarefund.Value), 0, Fields!Welfarefund.Value)
									  + IIf(string.IsNullOrEmpty(Fields!VercHealthWelfareFund.Value), 0, Fields!VercHealthWelfareFund.Value)

										  + IIf(string.IsNullOrEmpty(Fields!cosavings.Value), 0, Fields!cosavings.Value)


										    + IIf(string.IsNullOrEmpty(Fields!cogenloan.Value), 0, Fields!cogenloan.Value)


											  + IIf(string.IsNullOrEmpty(Fields!cosploan.Value), 0, Fields!cosploan.Value)


									+ IIf(string.IsNullOrEmpty(Fields!advance.Value), 0, Fields!advance.Value)
									
									+ IIf(string.IsNullOrEmpty(Fields!absentsalarydeduction.Value), 0, Fields!absentsalarydeduction.Value)


												  + IIf(string.IsNullOrEmpty(Fields!pension.Value), 0, Fields!pension.Value)

												    + IIf(string.IsNullOrEmpty(Fields!deduction_others.Value), 0, Fields!deduction_others.Value)</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>#,0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox40</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>Solid</Style>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>1pt</PaddingLeft>
                            <PaddingRight>1pt</PaddingRight>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox43">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=                         
                                     IIf(string.IsNullOrEmpty(Fields!BasicSalary.Value), 0, Fields!BasicSalary.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!Conveyance.Value), 0, Fields!Conveyance.Value)

									 + IIf(string.IsNullOrEmpty(Fields!hardship.Value), 0, Fields!hardship.Value)

                                    + IIf(string.IsNullOrEmpty(Fields!HouseRent.Value), 0, Fields!HouseRent.Value)
                                   
                                    + IIf(string.IsNullOrEmpty(Fields!Medical.Value), 0, Fields!Medical.Value)
                                   
 + IIf(string.IsNullOrEmpty(Fields!DearneasAllowance.Value), 0, Fields!DearneasAllowance.Value)
                    
					 + IIf(string.IsNullOrEmpty(Fields!PFEmployeeDeduction.Value), 0, Fields!PFEmployeeDeduction.Value)

					  + IIf(string.IsNullOrEmpty(Fields!consolidate.Value), 0, Fields!consolidate.Value)
                          + IIf(string.IsNullOrEmpty(Fields!MobileDeduction2.Value), 0, Fields!MobileDeduction2.Value)         
                                  
                           + IIf(string.IsNullOrEmpty(Fields!FieldAllowance.Value), 0, Fields!FieldAllowance.Value)            
                                    - IIf(string.IsNullOrEmpty(Fields!MobileDeduction.Value), 0, Fields!Entertainment.Value)
                                  
                     
           

								   - IIf(string.IsNullOrEmpty(Fields!houseloan.Value), 0, Fields!houseloan.Value)

								    - IIf(string.IsNullOrEmpty(Fields!motorloan.Value), 0, Fields!motorloan.Value)


 - IIf(string.IsNullOrEmpty(Fields!laptoploan.Value), 0, Fields!laptoploan.Value)
									  - IIf(string.IsNullOrEmpty(Fields!Welfarefund.Value), 0, Fields!Welfarefund.Value)

									   - IIf(string.IsNullOrEmpty(Fields!VercHealthWelfareFund.Value), 0, Fields!VercHealthWelfareFund.Value)


									     - IIf(string.IsNullOrEmpty(Fields!PFEmployeeDeduction.Value), 0, Fields!PFEmployeeDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!PFOfficeDeduction.Value), 0, Fields!PFOfficeDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!PFLoanDeduction.Value), 0, Fields!PFLoanDeduction.Value)

									    - IIf(string.IsNullOrEmpty(Fields!cosavings.Value), 0, Fields!cosavings.Value)


										 - IIf(string.IsNullOrEmpty(Fields!cogenloan.Value), 0, Fields!cogenloan.Value)


										  - IIf(string.IsNullOrEmpty(Fields!cosploan.Value), 0, Fields!cosploan.Value)


										 


										    - IIf(string.IsNullOrEmpty(Fields!pension.Value), 0, Fields!pension.Value)


	    - IIf(string.IsNullOrEmpty(Fields!advance.Value), 0, Fields!advance.Value)


			    - IIf(string.IsNullOrEmpty(Fields!absentsalarydeduction.Value), 0, Fields!absentsalarydeduction.Value)

											 - IIf(string.IsNullOrEmpty(Fields!deduction_others.Value), 0, Fields!deduction_others.Value)</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <Format>#,0</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
