                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Sum(IIf(System.String.IsNullOrEmpty(Fields!Arrear.Value), 0, Fields!Arrear.Value) + IIf(System.String.IsNullOrEmpty(Fields!ArrearBonus.Value), 0, Fields!ArrearBonus.Value) + IIf(System.String.IsNullOrEmpty(Fields!BasicSalary.Value), 0, Fields!BasicSalary.Value) + IIf(System.String.IsNullOrEmpty(Fields!Conveyance.Value), 0, Fields!Conveyance.Value) + IIf(System.String.IsNullOrEmpty(Fields!HouseRent.Value), 0, Fields!HouseRent.Value) + IIf(System.String.IsNullOrEmpty(Fields!InChargeAllowance.Value), 0, Fields!InChargeAllowance.Value) + IIf(System.String.IsNullOrEmpty(Fields!Medical.Value), 0, Fields!Medical.Value) + IIf(System.String.IsNullOrEmpty(Fields!PFOfficeContribution.Value), 0, Fields!PFOfficeContribution.Value) + IIf(System.String.IsNullOrEmpty(Fields!SpecialAllowance.Value), 0, Fields!SpecialAllowance.Value) + IIf(System.String.IsNullOrEmpty(Fields!ArrearCPFOfficeContribution.Value), 0, Fields!ArrearCPFOfficeContribution.Value))</Value>
                                  <Style>
                                    <FontFamily>Arial Narrow</FontFamily>
                                    <FontSize>7pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>#,0;(#,0)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
