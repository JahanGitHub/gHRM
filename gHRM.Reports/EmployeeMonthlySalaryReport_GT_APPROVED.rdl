                                <TextRun>
                                  <Value>
                                    =IIf(string.IsNullOrEmpty(Fields!Arrear.Value), 0, Fields!Arrear.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!ArrearBonus.Value), 0, Fields!ArrearBonus.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!BasicSalary.Value), 0, Fields!BasicSalary.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!Conveyance.Value), 0, Fields!Conveyance.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!HouseRent.Value), 0, Fields!HouseRent.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!InChargeAllowance.Value), 0, Fields!InChargeAllowance.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!Medical.Value), 0, Fields!Medical.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!PFOfficeContribution.Value), 0, Fields!PFOfficeContribution.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!SpecialAllowance.Value), 0, Fields!SpecialAllowance.Value)
                                    + IIf(string.IsNullOrEmpty(Fields!ArrearCPFOfficeContribution.Value), 0, Fields!ArrearCPFOfficeContribution.Value)

                                    - IIf(string.IsNullOrEmpty(Fields!ITDeduction.Value), 0, Fields!ITDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!IncomeTaxDeduction.Value), 0, Fields!IncomeTaxDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!MobileDeduction.Value), 0, Fields!MobileDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!PFEmployeeDeduction.Value), 0, Fields!PFEmployeeDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!PFOfficeDeduction.Value), 0, Fields!PFOfficeDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!PFLoanDeduction.Value), 0, Fields!PFLoanDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!RoomRentDeduction.Value), 0, Fields!RoomRentDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!StampDeduction.Value), 0, Fields!StampDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!ArrearCPFEmpDeduction.Value), 0, Fields!ArrearCPFEmpDeduction.Value)
                                    - IIf(string.IsNullOrEmpty(Fields!ArrearCPFOfficeDeduction.Value), 0, Fields!ArrearCPFOfficeDeduction.Value)
                                  </Value>
