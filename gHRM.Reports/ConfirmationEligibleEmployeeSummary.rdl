  <Code>Public Function ConvertToBangla(Text as String)
    Return Text.Replace("0", "০").Replace("1", "১").Replace("2", "২").Replace("3", "৩").Replace("4", "৪").Replace("5", "৫").Replace("6", "৬").Replace("7", "৭").Replace("8", "৮").Replace("9", "৯").Replace("Jan", "জানুয়ারি").Replace("Feb", "ফেব্রুয়ারী").Replace("Mar", "মার্চ").Replace("Apr", "এপ্রিল").Replace("May", "মে").Replace("Jun", "জুন").Replace("Jul", "জুলাই").Replace("Aug", "আগষ্ট").Replace("Sep", "সেপ্টেম্বর").Replace("Oct", "অক্টোবর").Replace("Nov", "নভেম্বর").Replace("Dec", "ডিসেম্বর")
End Function
