              <Textbox Name="Textbox20">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="১। কর্মসূচির কাজে আপনাকে ৬ মাস শিক্ষানবিশ হিসেবে থাকতে হবে। শিক্ষানবিশকালীন আপনার মাসিক বেতন সর্বসাকুল্যে টাকা    "+First(CStr(Fields!GrossSalary.Value), "PersonalInfo") + "/= (" + First(CStr(Fields!GrossSalaryInWord.Value)) + " Taka Only) নির্ধারণ করা হলো। সন্তোষজনক শিক্ষানবিশকাল শেষে আপনার চাকরী নিয়মিতকরণসহ কর্মসূচির নির্ধারিত বেতন স্কেলে বেতন নির্ধারণ করা হবে এবং নির্ধারিত হারে লাঞ্চভাতা পাবেন। এছাড়া সংস্থার নিয়মানুযায়ী অন্যান্য সুবিধাদি প্রদান করা হবে। "</Value>
                        <Style>
                          <FontFamily>SolaimanLipi</FontFamily>
                        </Style>
                      </TextRun>
