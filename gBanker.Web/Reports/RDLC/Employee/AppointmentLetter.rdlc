              <Textbox Name="Textbox19">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>="সংস্থার মাইক্রোফাইন্যান্স কর্মসূচিতে অফিসার (এমএফপি) পদে নিয়োগের জন্য আপনার আবেদন ও নির্বাচনী পরিক্ষারভিত্তিতে আপনাকে উক্ত পদে নিয়োগের জন্য মনোনীত করা হয়েছে। আপনাকে নিম্নলিখিত শর্তসাপেক্ষে " + First(CStr(Fields!FirstJoiningDate.Value), "PersonalInfo") + " তারিখ হতে জাগরণী চক্র ফাউন্ডেশনের মাইক্রোফাইন্যান্স কর্মসূচির " + First(Fields!UnitOfficeName.Value) + " অফিসে অফিসার (এমএফপি) পদে শিক্ষানবিশ হিসেবে নিয়োগ প্রদান করা হলো।"</Value>
                        <Style>
                          <FontFamily>SolaimanLipi</FontFamily>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style />
                  </Paragraph>
                </Paragraphs>
