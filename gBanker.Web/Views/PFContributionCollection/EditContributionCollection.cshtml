@model gHRM.Web.ViewModels.PF.ContributionCollectionViewModel

@{
    ViewBag.Title = "EditContributionCollection";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">
    function isNumber(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&      // “-” CHECK MINUS, AND ONLY ONE.
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&      // “.” CHECK DOT, AND ONLY ONE.
            (charCode < 48 || charCode > 57))
            return false;
        return true;
    }
    
    function UpdateContributionCollection(collectionId, employeeId, selfContribution, orgContribution) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdateContributionCollection", "PFContributionCollection", "http")',
            data: { collectionId: collectionId, employeeId: employeeId, selfContribution: selfContribution, orgContribution: orgContribution },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", data.message);
                setTimeout(function () {
                    window.location.href = "/PFContributionCollection/ContributionCollectionList";
                }, 1500);
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Saved");
            }
        });
    }

    function clear() {
        $("#CollectionId").val('');
        $("#EmployeeId").val('');
        $("#SelfContribution").val('');
        $("#OrgContribution").val('');
    }

    function DisableAll(flag)
    {
        $('#SelfContribution').prop('disabled', flag);
        $('#OrgContribution').prop('disabled', flag);
        $('#btnUpdateContribution').prop('disabled', flag);
    }

    function Update() {
        var collectionId = $("#CollectionId").val();
        var employeeId = $("#EmployeeId").val();
        var selfContribution = $("#SelfContribution").val();
        var orgContribution = $("#OrgContribution").val();

        if (collectionId == '' || employeeId == '') {
            $.alert.open("Please enter valid data");
            return;
        }
        UpdateContributionCollection(collectionId, employeeId, selfContribution, orgContribution);
    }

    $(document).ready(function () {
         $("input[type=text]:visible:enabled").first().focus();
       

        //PF Setup
        @if(Model.PFType == "GPF"){
             <text>
             $("#divOrgContribution").hide();
             </text>
         }
        @if(Model.PFType == "CPF"){
             <text>
             $("#divOrgContribution").show();
             </text>
         }

        //Day Status
        @if (Model.IsOpen == true)
         {
             <text>
             DisableAll(false); 
             </text>
         }
        
        @if(Model.IsOpen == false){
             <text>
             DisableAll(true); 
             </text>
         }
   
        $('#SelfContribution').keypress(function (event) {
            return isNumber(event, this)
        });
        $('#OrgContribution').keypress(function (event) {
            return isNumber(event, this)
        });

        $("#btnUpdateContribution").click(function () {

            $.alert.open('confirm', 'Are you sure you want to update?', function (button) {
                if (button == 'yes') {
                    Update();
                    return true;
                }
                else {
                    return false;
                }
            });
        });
    });
</script>


@Html.ActionLink("Back to List", "ContributionCollectionList", null, new { @class = "pull-right   btn btn-success" })
