            type: 'GET',
            contentType: "application/json; charset=utf-8",
            @*url: '@Url.Action("GetZOOfficeList", "Employee", "http")',*@
            url: '@Url.Action("GetZOOfficeList", "Financial", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlZOOffice.html('');
                $.each(data, function (id, option) {
                    ddlZOOffice.append($('<option></option>').val(option.Value).html(option.Text));
                });

                var OffcTyp = @Html.Raw(Json.Encode(ViewData["OfficeType"]));
                var OffcId = @Html.Raw(Json.Encode(ViewData["LoggedInOfficeId"]));

                if(OffcTyp == 2){
                    $('#ddlSearchZOOffice').val(OffcId);
                    //alert($('#ddlZOOffice').val());
                    GetSearchAOOfficeByZO($("#ddlSearchZOOffice option:selected").text().split("-")[0]);
                    //GetSearchAOOfficeByZO($("#ddlZOOffice option:selected").text().split("-")[0]);
                    //alert($('#hfZoCode').val());
                }
                else if(OffcTyp != 2 && OffcTyp != 1){

                    $("#ddlSearchZOOffice").val($('#hfSecondLevelId').html());
                    GetSearchAOOfficeByZO($("#ddlSearchZOOffice option:selected").text().split("-")[0]);
                }
                //$("#ddlSearchZOOffice option[value='2580']").attr("disabled", true);
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

