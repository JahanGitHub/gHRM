    function PopulateOrganaization() {
        var ddlOrgList = $("#ddlOrgList");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetOrgList", "Financial", "http")',
            data: {},
            dataType: 'json',
            async: true,
