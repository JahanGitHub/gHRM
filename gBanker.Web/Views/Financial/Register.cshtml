    function AreaRadioSearchChk() {
        if ($("#radSearchAO").is(":checked")) {

            var OffcId = @Html.Raw(Json.Encode(ViewData["LoggedInOfficeId"]));
            var OffcName = @Html.Raw(Json.Encode(ViewData["LoggedInOfficeName"]));
            $('#selectedOfficeId').val(OffcId);
            $('#selectedOfficeName').val(OffcName);

            $("#ddlSearchBOOffice")[0].selectedIndex = 0;

            $("#ddlSearchBOOffice").attr("disabled", true);

            $("#selectedOfficeTypeId").val(4);

        }
        else if($("#radSearchBO").is(":checked")){
            $("#selectedOfficeId").val("");
            $('#selectedOfficeName').val("");

            $("#ddlSearchBOOffice").attr("disabled", false);

            $("#selectedOfficeTypeId").val(5);
        }

    }//End Function

    function radioSearchChk() {
        if ($("#radSearchHO").is(":checked")) {
            //loaddept
            $("#SearchHO").show();
            $("#SearchZO").hide();
            $("#SearchZAO").hide();
            GetSearchHOOffice();

            var OffcId = @Html.Raw(Json.Encode(ViewData["LoggedInOfficeId"]));
            var OffcName = @Html.Raw(Json.Encode(ViewData["LoggedInOfficeName"]));
            $('#selectedOfficeId').val(OffcId);
            $('#selectedOfficeName').val(OffcName);

        }
        else if ($("#radSearchZO").is(":checked")) {
            //load zone,area,branch
            $("#SearchHO").hide();
            $("#SearchZO").show();
            $("#SearchZAO").hide();

            GetSearchZOOffice();


            var ddlSearchAOOffice = $("#ddlSearchAOOffice");
            ddlSearchAOOffice.html('');

            var ddlSearchBOOffice = $("#ddlSearchBOOffice");
            ddlSearchBOOffice.html('');


        }
        else if ($("#radSearchZAO").is(":checked")) {
            //load zonal audit
            $("#SearchHO").hide();
            $("#SearchZO").hide();
            $("#SearchZAO").show();

            GetSearchZAOOffice();

        }
        else {
            $("#SearchHO").hide();
            $("#SearchZO").hide();
            $("#SearchZAO").hide();

        }
    }
