    //// Office Load

    function GetSearchHOOffice() {
        var ddlHOOffice = $("#ddlSearchHOOffice");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            @*//url: '@Url.Action("GetHOOfficeList", "Employee", "http")',*@
            url: '@Url.Action("GetHOOfficeList", "Financial", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlHOOffice.html('');
                $.each(data, function (id, option) {
                    ddlHOOffice.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetSearchZOOffice() {
        var ddlZOOffice = $("#ddlSearchZOOffice");
