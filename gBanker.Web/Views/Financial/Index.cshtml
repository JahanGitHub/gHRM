@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>

<script type="text/javascript">

    function GenerateDetails(ApplicationNo) {

        var url = '/eRecruit/ApplicationInfoReportById?ApplicationId=' + ApplicationNo;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }


    function summation()
    {
       var arr = document.getElementsByName('hdnDepositAmount');
        var tot=0.00;
        for(var i=0;i<arr.length;i++){
            if(parseInt(arr[i].value))
                tot += parseFloat(arr[i].value);
        }
   // alert(tot);
       document.getElementById('txtTotal').value = tot;
    
    }


    $(document).ready(function () {

        $("#txtDepositSendDateFrom").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: "1920:2100"

         });

     $("#txtDepositSendDateTo").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: "1920:2100"

         });

      //  $("#DepositSendDate").datepicker(
      //'setDate', new Date());


        $("#btnSearch").click(function () {
            var txtZoneCode = "";
            txtZoneCode = $('#txtZoneCode').val();
            if (txtZoneCode == "") {
                txtZoneCode = null;
            }

            var txtSlipDraftNo = "";
            txtSlipDraftNo = $('#txtSlipDraftNo').val();
            if (txtSlipDraftNo == "") {
                txtSlipDraftNo = null;
            }

            var txtDepositSendDateFrom = "";
            txtDepositSendDateFrom = $('#txtDepositSendDateFrom').val();
      var txtDepositSendDateTo = "";
            txtDepositSendDateTo = $('#txtDepositSendDateTo').val();
            if (txtDepositSendDateFrom == "") {
                txtDepositSendDateFrom = null;
            }
     if (txtDepositSendDateTo == "") {
                txtDepositSendDateTo = null;
            }


    var ReferenceNo = "";
     ReferenceNo = $('#ReferenceNo').val();
            if (ReferenceNo == "") {
                ReferenceNo = null;
            }
            $('#grid').jtable('load', { ZoneCode: txtZoneCode, SlipDraftNo: txtSlipDraftNo, DepositSendDateFrom: txtDepositSendDateFrom, DepositSendDateTo: txtDepositSendDateTo, ReferenceNo: ReferenceNo });
               // summation();
        });



        $('#grid').jtable({
            // title: 'Investor List',
            paging: true,
            pageSize: 100,
            sorting: false,
            defaultSorting: 'Name ASC',
             async: false,
           //actions: {
           //  listAction: '/Financial/GetRegisterList',
        
          // },
    actions:{
    
    listAction: function (postData, jtParams) {
    return $.Deferred(function ($dfd) {
        $.ajax({
            url: '/Financial/GetRegisterList?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
            type: 'POST',
            dataType: 'json',
            data: postData,
            success: function (data) {
                $dfd.resolve(data);
    summation();
            },
            error: function () {
                $dfd.reject();
            }
        });
    });
}
    },
   
            fields: {
                rowSl: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                OrgName: {
                    title: 'Org Name',
                    width: '8%',
                },
                OfficeName: {
                    title: 'Office Name',
                    width: '10%',

                },
                ZoneCode: {
                    title: 'Zone Code',
                    width: '6%'
                },
                ServiceCharge: {
                    title: 'Service Charge',
                    width: '8%'
                },
                LBUNetTaka: {
                    title: 'L.B.U. Net ',
                    width: '9%'
                },
                Deduction: {
                    title: 'Deduction',
                    width: '8%'
                },
                DeductionOthers: {
                    title: 'Deduction Others',
                    width: '10%'
                },
                DepositDraftAmount: {
                    title: 'Deposit/Draft Amount',
                    width: '10%',
                    display: function (data) {
                        return '<label class="text-center">' + data.record.DepositDraftAmount  + '</label>'
                             + '<input type="hidden" name="hdnDepositAmount" value= ' + data.record.DepositDraftAmount + ' /> ';
                    }
                },
                SlipDraftNo: {
                    title: 'Slip/Draft No',
                    width: '9%'
                },

                ReferenceNo: {
                    title: 'Reference No',
                    width: '3%'
                },
                SendedBy: {
                    title: 'Sended By',
                    width: '3%'
                },
                DepositSendDate: {
                    title: 'Deposit Send Date',
                    width: '10%'
                },
                Remarks: {
                    title: 'Remarks',
                    width: '6%'
                },

                //PostingPrint: {
                //    title: "Print",
                //    display: function (data) {
                //        return '<div class="text-center"><a href="#" title="View Details" OnClick="GenerateDetails(' + "'" + data.record.ApplicationId + "'" + ');"><i class="fa fa-print"></i></a></div>';
                //    }
                //}

                DeleteLink: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Delete(' + data.record.Id + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }
                }
            }
        });
        reloadGrid();
        //$('#grid').jtable('load');
        $("#filterColumn").change(function () {
            if ($(this).val() === "ViewAll") {
                $("#filterValue").val('');
            }
        });

     


    }); // END Document Ready
    function reloadGrid() {
        //$("#loading").show();
        $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
        //$("#loading").hide();
    }


   







    function Delete(id) {

        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                DeleteData(id);
                return true;
            }
            else {

                return false;
            }
        });

    }


    function DeleteData(Id) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("Delete", "Financial", "http")', //Create(long EmployeeID, int PRComponentID, decimal ComponentAmount, string EffectiveStartDate, string EffectiveEndDate)
            data: { Id: Id },
            dataType: 'json',
            async: true,
            success: function (data) {

                $('#AjaxLoader').hide();
                $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
                $.alert.open("Message", data);
            },
            error: function (request, status, error) {
                $('#AjaxLoader').hide();
                $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
                $.alert.open("Message", error);
            }

        });
         
    }// End of Function



</script>



@Html.ActionLink("Add New", "Register", null, new { @class = "btn btn-success btn-sm pull-right" })
&nbsp;
<h2 class="page-title"> Service Charge Register </h2>
&nbsp;

<div class="row">

    <div class="row">

        <div class="col-sm-4">
            <label class="control-label col-md-4">Zone Code</label>
            <div class="form-group">
                <div class="col-md-8">
                    <input type="text" placeholder="Zone Code" id="txtZoneCode" value="" class="form-control" />
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="form-group">
                <label class="control-label col-md-4">Slip/Draf No</label>
                <div class="col-sm-8">
                    <input type="text" placeholder="Slip/Draft No" id="txtSlipDraftNo" value="" class="form-control" />
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="form-group">
                <label class="control-label col-md-4">Reference No</label>
                <div class="col-sm-8">
                    <input type="text" id="ReferenceNo" placeholder="Reference No" value="" class="form-control" />
                </div>
            </div>
        </div>


    </div>
    <br />
    <div class="row">
        <fieldset>
            <legend>Deposit/ Send Date</legend>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label col-md-4">From</label>
                    <div class="col-md-8">
                        <input type="text" id="txtDepositSendDateFrom" value="" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="form-group">
                    <label class="control-label col-md-4">To</label>
                    <div class="col-md-8">
                        <input type="text" id="txtDepositSendDateTo" value="" class="form-control" />
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <br />
        <hr />
        <div class="row">

            <div class="col-sm-8">
                <div class="form-group">
                    &nbsp;
                    <div class="col-sm-4">
                        <input type="button" id="btnSearch" value="Search" class="btn btn-bitbucket" />
                    </div>
                        <div class="col-sm-4">
                            <label class="form-control"> Total Deposit/Draft Amount </label>  <input type="text" id="txtTotal" readonly="readonly" value="0.00" class="form-control" />
                        </div>
                    </div>
            </div>

        </div>
        &nbsp;
        <div id="grid">

        </div>

    </div>

    @section Scripts {

        @Scripts.Render("~/bundles/jqueryui")
        @Scripts.Render("~/bundles/jtable")
        @Scripts.Render("~/bundles/alert")
    }
