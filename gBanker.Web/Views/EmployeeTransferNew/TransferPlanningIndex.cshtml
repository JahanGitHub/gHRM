@model gHRM.Web.ViewModels.EmployeeTransferViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    $(document).ready(function () {
        loadPlanList();
    });


    function loadPlanList() {

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("loadTransferPlanList", "EmployeeTransferNew", "http")',
                    dataType: 'json',
                    //data: { FilterBy: filterBy, FilterValue: filterValue }
                }
            }
        });


        $("#grid").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,
            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "Id",
                     hidden: true,
                     filterable: false
                 }, {
                     field: "EmployeeId",
                     hidden: true,
                     filterable: false
                 },
                 {
                     field: "RowSl",
                     title: "Sl No.",
                     width: "5%",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                     //locked: true,
                     //lockable: false,
                 },
                 {
                     width: "8%",
                     field: "EmployeeCode",
                     title: "Code"
                 },
                 {
                     width: "15%",
                     field: "EmployeeName",
                     title: "Name",
                     filterable: false
                     //locked: true
                 },
                {
                    width: "15%",
                    field: "OfficeName",
                    title: "Office",
                    //locked: true
                },
                {
                    width: "15%",
                    field: "DepartmentName",
                    title: "Department",
                    //locked: true
                },
                {
                    width: "10%",
                    field: "OfficeDesignationName",
                    title: "Responsibility",
                    //locked: true
                },
                {
                    width: "10%",
                    field: "OrderNo",
                    title: "Order No",
                    //locked: true
                },
                {
                    width: "10%",
                    field: "PlannedReleaseDate",
                    title: "Planned Release Date",
                    filterable: false,
                    template: "#= kendo.toString(kendo.parseDate(PlannedReleaseDate, 'yyyy-MM-dd'), 'dd-MMM-yyyy') #"
                },
                {
                    width: "10%",
                    field: "PlannedJoiningDate",
                    title: "Palnned Joining Date",
                    filterable: false,
                    template: "#= kendo.toString(kendo.parseDate(PlannedJoiningDate, 'yyyy-MM-dd'), 'dd-MMM-yyyy') #"
                },
                {
                    width: "7%",
                    title: 'Details',
                    template: function (dataItem) {
                        return "<a href='/EmployeeTransferNew/TransferPlanningEntry/?Id=" + dataItem.Id + "&EmployeeCode=" + dataItem.EmployeeCode + "''><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },
                 {
                     width: "8%",
                     title: 'Delete',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='DeleteTransferInformation(" + dataItem.Id + ");'><i class='fa fa-trash-o'></i></a>";
                     }
                 }
            ]
        });
    }


    function DeleteTransferInformation(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this plan?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteTransferInformation", "EmployeeTransferNew", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: false,
                    success: function (data) {
                        if (data.result == 1) {
                            loadPlanList();
                            $.alert.open("Success", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                return false;
            }
        });
    }


</script>


@Html.ActionLink("Add New", "TransferPlanningEntry", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Transfer Planning List</h2>
<br />


<div id="grid"></div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}


