    function PrintReport(printUrl) {
        window.open(printUrl, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function btnPrintinput(EmployeeCode) {
        var month = $("#Month").val();
        var year = $("#Year").val();
        if (EmployeeCode != "") {
            url = '/AttendanceReport/EmployeeCodeReportBySingleCode?EmployeeCode=' + EmployeeCode + '&month=' + month + '&year=' + year;
            PrintReport(url);
        } else {
            $.alert.open("Error", "Please Select Date");
            return false;
        }
    }

    function ApproveLeaveDeduction(EmployeeId, EmployeeCode, LeaveDeduction, LeaveTypeId) {

        var LeavePenalty = new Array();
        if (EmployeeId > 0 && EmployeeCode != "" && LeaveDeduction > 0 && LeaveTypeId > 0) {
            var obj = CreateLeaveDeductionObject(EmployeeId, EmployeeCode, LeaveDeduction, LeaveTypeId);
            LeavePenalty.push(obj);

            if (LeavePenalty.length > 0) {
                SaveLeavePenalty(LeavePenalty);
            } else {
                $.alert.open("Error", "No Data found");
                return false;
            }
        }
    }

    function CreateLeaveDeductionObject(EmployeeId, EmployeeCode, LeaveDeduction, LeaveTypeId) {

        var fromDate = $("#FromDate" + EmployeeId).val();
        var dateTo = $("#ToDate" + EmployeeId).val();
        if (fromDate != "" && dateTo != "" && LeaveDeduction > 0) {
            var startDate = new Date(MakeDate(fromDate));
            var endDate = new Date(MakeDate(dateTo));
            var start = moment(endDate);
            var end = moment(startDate);
            var totDay = start.diff(end, "days") + 1;
            if (LeaveDeduction == totDay) {
                var deductionObject = {
                    EmployeeId: EmployeeId,
                    LeaveTypeId: LeaveTypeId,
                    LeaveRequestDate: fromDate,
                    LeaveStartDate: fromDate,
                    LeaveEndDate: dateTo,
                    TotalDays: LeaveDeduction
                }
                return deductionObject;

            } else {
                $.alert.open("Error", "Total deduction day(s) for " + EmployeeCode + "not given");
                return false;
            }
        } else {
            $.alert.open("Error", "Please provide dates");
            return false;
        }
    }


    function SaveLeavePenalty(LeavePenalty) {
        $.alert.open('confirm', 'Are you sure to Apply & Approve Leave for this employee?', function (button) {
            if (button == 'yes') {

                $.ajax({
                    type: 'POST',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("ApproveLeaveDeduction", "AttendancePenalty", "http")',
                    data: JSON.stringify({ LeavePenalty: LeavePenalty }),
                    dataType: 'json',
                    async: true,
                    success: function (Data) {
                        if (Data.result == 1) {
                            $.alert.open("Success", Data.message);
                            loadSearchData();
                        } else {
                            $.alert.open("Error", Data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function CheckDayDifference(serialNo,dayCount) {

        var dateFrom = $("#FromDate" + serialNo).val();
        var dateTo = $("#ToDate" + serialNo).val();        
        if (dateFrom != "" && dateTo != "") {           
            var startDate = new Date(MakeDate(dateFrom));
            var endDate = new Date(MakeDate(dateTo));
            var start = moment(endDate);
            var end = moment(startDate);
            var totDay = start.diff(end, "days") + 1;
            //alert(totDay + '=' + dayCount);
            if (totDay === dayCount) {
                return true
            } else {
                $.alert.open("Error","This leave will be for " + dayCount + " day(s). Please check the dates.")
                $("#ToDate" + serialNo).val("");
            }
        }
    }

    function GetTotalDays() {
        var startDate = new Date(MakeDate($('#LeaveStartDate').val()));
        var endDate = new Date(MakeDate($('#LeaveEndDate').val()));
        var start = moment(endDate);
        var end = moment(startDate);
        var totDay = start.diff(end, "days") + 1;
        return totDay;
    }

