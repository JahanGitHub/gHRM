                         return "<input type='text' id='FromDate" + dataItem.EmployeeId + "' style='width:100%' class='k-textbox DtPicker' value='' onchange='CheckDayDifference(" + dataItem.EmployeeId + "," + dataItem.LeaveDeduction + ")'></input>";
