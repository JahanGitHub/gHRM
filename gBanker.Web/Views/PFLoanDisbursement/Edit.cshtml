@model gHRM.Web.ViewModels.PF.LoanDisbursementViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">


    function UpdateDisbursement(loanId, employeeId) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdateLoanDisbursement", "PFLoanDisbursement", "http")',
            data: { loanId: loanId, employeeId: employeeId },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", data.message);
                setTimeout(function () {
                    window.location.href = "/PFLoanDisbursement/Index";
                }, 1500);
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Saved");

            }
        });
    }

    function GetLoanInfoByEmpId(employeeId, loanTypeId, disburseAmount) {
        // alert(employeeId + ' '+ loanTypeId + ' ' + disburseAmount)
        var message = '';
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetLoanInfoByEmpId", "PFLoanDisbursement", "http")',
            data: { employeeId: employeeId, loanTypeId: loanTypeId },
            dataType: 'json',
            async: false,
            success: function (data) {
                if (data.RunningLoan > 0) {
                    message = 'Unpaid loan exist.';
                }
                if (disburseAmount > data.MaxLoanLimit) {
                    message = 'Loan limit exceeded, you are unable to re-assign to other people';
                }
                if (data.EmployeeExit != 'Yes') {
                    message = 'Employee does not exist.'
                }
                $('#EmployeeName').val(data.EmployeeName);
                $('#FinishedLoan').val(data.FinishedLoan);
                $('#MaxLoanLimit').val(data.MaxLoanLimit);
            },
            error: function (request, status, error) {
            }
        });
        return message;
    }

    function DisableAll(flag) {
        $('#EmployeeId').prop('disabled', flag);
        $('#btnUpdateDisbursement').prop('disabled', flag);
    }

    function Update() {
        var loanId = $("#LoanId").val();
        var employeeId = $("#EmployeeId").val();
        UpdateDisbursement(loanId, employeeId);
    }
    //New
    function GetEmployeeByEmployeeCode(employeeCode) {
        var employeeId = '';
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmployeeByEmployeeCode", "Employee", "http")',
            data: { employeeCode: employeeCode },
            dataType: 'json',
            async: false,
            success: function (data) {
                $('#EmployeeId').val(data.EmployeeId);
                // $('#EmployeeName').val(data.EmployeeName);
                employeeId = data.EmployeeId;
            },
            error: function (request, status, error) {
            }
        });
        return employeeId;
    }
    $(document).ready(function () {
        $("input[type=text]:visible:enabled").first().focus();

        @if (Model.IsOpen == true){
            <text>
        DisableAll(false);
        </text>
            }

        @if(Model.IsOpen == false){
            <text>
        DisableAll(true);
        </text>
            }
        $('#btnUpdateDisbursement').prop('disabled', true);
        var loanTypeId = $('#LoanTypeId').val();
        $('#LoanTypeList').val(loanTypeId);

        //New
        $('#EmployeeCode').change(function () {
            var message = '';

            $('#EmployeeId').val('');
            $('#EmployeeName').val('');
            $('#FinishedLoan').val('');
            $('#MaxLoanLimit').val('');

            var employeeCode = $('#EmployeeCode').val();
            var employeeId = GetEmployeeByEmployeeCode(employeeCode);

            if (employeeId == '' || employeeId == undefined) {
                alert('Employee does not exist');
                return;
            }

            var loanTypeId = $('#LoanTypeList option:selected').val();
            var disburseAmount = $('#DisburseAmount').val();

            if (employeeId == '') {
                alert('Enter Employee Id.');
                return;
            }
            if (loanTypeId != '') {
                message = GetLoanInfoByEmpId(employeeId, loanTypeId, disburseAmount);
                if (message != '')  //False
                {
                    alert(message);
                    $('#btnUpdateDisbursement').prop("disabled", true);
                }
                else {
                    $('#btnUpdateDisbursement').prop("disabled", false);
                }
            }
        });

        //Old
        //$('#EmployeeId').change(function () {
        //    var message = '';

        //    $('#EmployeeName').val('');
        //    $('#FinishedLoan').val('');
        //    $('#MaxLoanLimit').val('');

        //    var employeeId = $('#EmployeeId').val();
        //    var loanTypeId = $('#LoanTypeList option:selected').val();
        //    var disburseAmount = $('#DisburseAmount').val();

        //    if (employeeId == '') {
        //        alert('Enter Employee Id.');
        //        return;
        //    }
        //    if (loanTypeId != '') {
        //        message = GetLoanInfoByEmpId(employeeId, loanTypeId, disburseAmount);
        //        if(message!='')  //False
        //        {
        //            alert(message);
        //            $('#btnUpdateDisbursement').prop("disabled", true);
        //        }
        //        else {
        //            $('#btnUpdateDisbursement').prop("disabled", false);
        //        }
        //    }
        //});


        $("#btnUpdateDisbursement").click(function () {

            $.alert.open('confirm', 'Are you sure you want to update?', function (button) {
                if (button == 'yes') {
                    Update();
                    return true;
                }
                else {
                    return false;
                }
            });


            //var loanId = $("#LoanId").val();
            //var employeeId = $("#EmployeeId").val();
            //UpdateDisbursement(loanId, employeeId);

        });

    });
</script>


