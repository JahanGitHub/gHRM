
@model gHRM.Web.ViewModels.Dashboard.HomePageViewModel

@using gHRM.Web.ViewModels;
@{
    ViewBag.Title = "gHRM+";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var employeeMaping = ViewBag.EmployeeOfficeMappings as List<SelectListItem> ?? new List<SelectListItem>();
    var showBranchPopup = (bool)ViewBag.ShowPopup;

    HRDashboardViewModel Data = ViewBag.Data;
    List<string> GenderNames = new List<string>();
    List<int> GenderCounts = new List<int>();
    List<string> Leave6MonthsCountMonthNames = new List<string>();
    List<int> Leave6MonthsCounts = new List<int>();
    GenderNames.Add("Male");
    GenderCounts.Add(Data.GenderCountList["M"]);
    GenderNames.Add("Female");
    GenderCounts.Add(Data.GenderCountList["F"]);
    int OtherGenderCount = 0;

    foreach (KeyValuePair<string, int> Obj in Data.GenderCountList)
    {
        if ("M" != Obj.Key && "F" != Obj.Key)
        {
            OtherGenderCount += Data.GenderCountList[Obj.Key];
        }
    }
    if (OtherGenderCount > 0)
    {
        GenderNames.Add("Unknown");
        GenderCounts.Add(OtherGenderCount);
    }
    string GenderNamesStr = Newtonsoft.Json.JsonConvert.SerializeObject(GenderNames);
    string GenderCountsStr = Newtonsoft.Json.JsonConvert.SerializeObject(GenderCounts);

    foreach (KeyValuePair<int, int> Obj in Data.Leave6MonthsCountList)
    {
        string[] MonthNames = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        Leave6MonthsCountMonthNames.Add(MonthNames[Obj.Key - 1]);
        Leave6MonthsCounts.Add(Obj.Value);
    }
    string Leave6MonthsCountMonthNamesStr = Newtonsoft.Json.JsonConvert.SerializeObject(Leave6MonthsCountMonthNames);
    string Leave6MonthsCountsStr = Newtonsoft.Json.JsonConvert.SerializeObject(Leave6MonthsCounts);
}

<div class="bg-img">
    <div class="row">
        <div class="col-md-12">
            <div class="employee-overview-title">Overview</div>
        </div>
        <div class="col-md-3">
            <div class="card-container" style="background: #c000ff; border-color: #a402da;">
                <span class="card-head">Total Branches</span>
                <span class="card-body"><span class="fa fa-building-o"></span> @String.Format("{0:n0}", Data.TotalBranches)</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-container" style="background: #06c836; border-color: #00b02c;">
                <span class="card-head">Total Employee</span>
                <span class="card-body"><span class="fa fa-users" /> @String.Format("{0:n0}", Data.TotalEmployees)</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-container" style="background: #ff6a00; border-color: #e86000;">
                <span class="card-head">Joined this Month</span>
                <span class="card-body"><span class="fa fa-sign-in" /> @String.Format("{0:n0}", Data.TotalJoinedThisMonth)</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-container" style="background: #008fff; border-color: #007fe2;">
                <span class="card-head">Left this Month</span>
                <span class="card-body"><span class="fa fa-sign-out" /> @String.Format("{0:n0}", Data.TotalLeftThisMonth)</span>
            </div>
        </div>
    </div>
    <div class="row" style="padding-top: 40px;">
        <div class="col-md-12">
            <div class="page-card">
                <div class="page-card-header">Employee Overview</div>
                <div class="page-card-body">
                    <canvas id="gender-wise-employee"></canvas>
                </div>
            </div>
            <div class="page-card pull-right">
                <div class="page-card-header">Leave Overview</div>
                <div class="page-card-body">
                    <canvas id="leave-overview"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!--SSO Enabling-->
    @Html.Partial("_SSOTriggeringPartial", Model)
    <div style="display:none" id="RedirectUrl" RedirectUrl="@Model.ReturnUrl"></div>
</div>

@section Styles {
    @Styles.Render("/Assets/css/dashboard.css?v=" + @gHRM.Core.Utilities.CommonHelper.DEV_VERSION())
}

@section Scripts {
    <script type="text/javascript">
        var GenderNamesArr = @Html.Raw(GenderNamesStr);
        var GenderCountsArr = @Html.Raw(GenderCountsStr);
        var Leave6MonthsCountMonthNamesArr = @Html.Raw(Leave6MonthsCountMonthNamesStr);
        var Leave6MonthsCountsArr = @Html.Raw(Leave6MonthsCountsStr);
    </script>
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    <script src="~/Assets/js/app/dashboard/dashboardManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    <script src="~/Assets/plugins/Chart.js-2.9.4/dist/Chart.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    <script src="~/Assets/js/app/dashboard.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}