<h2 class="page-title">Dashboard</h2>
<br />
<div class="row">
    <div class="col-sm-4">
        <div class="form-group">
            <label class="control-label col-md-4">Date From</label>
            <div class="col-sm-8">
                <input type="text" id="txtDtFrom" class="form-control" />
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="form-group">
            <label class="control-label col-md-4">Date To</label>
            <div class="col-sm-8">
                <input type="text" id="txtDtTo" class="form-control" />
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="form-group">
            <input type="submit" value="Search" id="btnSearch" class="btn btn-primary" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-2"></div>
    <div class="col-sm-8">
        <div id="grid"></div>
    </div>
    <div class="col-sm-2"></div>
</div>
@section Scripts {
@Scripts.Render("~/bundles/jqueryval")
@Scripts.Render("~/bundles/jqueryui")
}




