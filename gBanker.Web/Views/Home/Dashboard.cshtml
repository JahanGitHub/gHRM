
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var employeeMaping = ViewBag.EmployeeOfficeMappings as List<SelectListItem> ?? new List<SelectListItem>();
    var showBranchPopup = (bool)ViewBag.ShowPopup; 
}

<script type="text/javascript">
    $(document).ready(function () {

        var date = new Date();
        var firstDay = new Date(date.getFullYear(), date.getMonth(), 1);
        var lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0);

        var monthNames = [
              "Jan", "Feb", "Mar",
              "Apr", "May", "Jun", "Jul",
              "Aug", "Sep", "Oct",
              "Nov", "Dec"
        ];
        
        var FromDay = firstDay.getDate();
        var FromMonthIndex = firstDay.getMonth();
        var FromYear = firstDay.getFullYear();

        var ToDay = lastDay.getDate();
        var ToMonthIndex = lastDay.getMonth();
        var ToYear = lastDay.getFullYear();


        $("#txtDtFrom").val(FromDay + '-' + monthNames[FromMonthIndex] + '-' + FromYear);
        $("#txtDtTo").val(ToDay + '-' + monthNames[ToMonthIndex] + '-' + ToYear);

        $("#txtDtFrom").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
         });
        $("#txtDtTo").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
         });

        $("#btnSearch").click(function (e) {
            e.preventDefault();           
            $('#grid').jtable('load', { DtFrom: $("#txtDtFrom").val(), DtTo: $("#txtDtTo").val() });
        });

        $('#grid').jtable({
            paging: false,
            pageSize: 50,
            sorting: false,           
            actions: {
                listAction: '/Home/GetZoneDashboard?DtFrom=' + $("#txtDtFrom").val() + '&DtTo=' + $("#txtDtTo").val()
            },
            fields: {                
                ZoneName: {
                    title: 'Zone'                    
                },
                TotalPO: {
                    title: 'Total Posting',
                    display: function (data) {
                        if (data.record.TotalPO != 0)
                            return "<label>" + data.record.TotalPO + "</label>";
                        else
                            return "<label style='color:red; font-weight:bold;'>" + data.record.TotalPO + "</label>";
                    }
                },
                TotalJoin: {
                    title: 'Total Join',
                    display: function (data) {
                        if (data.record.TotalJoin != 0)
                            return "<label>" + data.record.TotalJoin + "</label>";
                        else
                            return "<label style='color:red; font-weight:bold;'>" + data.record.TotalJoin + "</label>";
                    }
                },
                TotalLeaveSale: {
                    title: 'EL Encashment',
                    display: function (data) {
                        if (data.record.TotalLeaveSale != 0)
                            return "<label>" + data.record.TotalLeaveSale + "</label>";
                        else
                            return "<label style='color:red; font-weight:bold;'>" + data.record.TotalLeaveSale + "</label>";
                    }
                }                                
            }
        });
        $('#grid').jtable('load');
    });

