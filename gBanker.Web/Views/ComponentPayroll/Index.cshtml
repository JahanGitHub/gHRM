@{
    ViewBag.Title = "Component Payroll";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">

    //create
    function GenerateComponentPayroll() {
        var item = {};
        item.ComponentName = $("#ComponentName").val();
        item.ComponentCategory = $("#ComponentCategory").val();
        //item.IsChangeable = $("#IsChangeable").val();
        return item;
    }

    function GenerateUpdateComponentPayroll() {
        var item = {};
        item.Id = $("#Id").val();
        item.ComponentName = $("#ComponentName").val();
        item.ComponentCategory = $("#ComponentCategory").val();
        //item.IsChangeable = $("#IsChangeable").val();
        return item;
    }

    function ClearControl() {
        $("#ComponentName").val('');
        $("#ComponentCategory").val('');
        //$("#IsChangeable").val('');

    }

    function SaveComponentPayroll() {


        var cp = GenerateComponentPayroll();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveComponentPayroll", "ComponentPayroll")',
            data: JSON.stringify({ cp: cp }),
            contentType: "application/json; charset=utf-8",
            success: function(data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    $('#grid').jtable('load');
                }

            },
            error: function(xhr, status, error) {
                alert(error);
            }

        });

    }

    function UpdateComponentPayroll() {


        var cp = GenerateUpdateComponentPayroll();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateComponentPayroll", "ComponentPayroll")',
            data: JSON.stringify({ cp: cp }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Update Successfull") {
                    ClearControl();
                    $('#grid').jtable('load');
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }

</script>


<h2 class="page-title">Component Payroll</h2>
@using (Html.BeginForm("SaveComponentPayroll", "ComponentPayroll", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Component Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.ComponentName, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Component Category</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.ComponentCategory, Model.ComponentCategoryList, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @*<div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">IsChangeable</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.IsChangeable, Model.IsChangeableList, new { @class = "form-control" })
                </div>
            </div>
        </div>*@
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveComponentPayroll()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateComponentPayroll()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetComponentPayroll()" />
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-sm-8">
            @Html.HiddenFor(model => model.Id)
        </div>
    </div>
}


