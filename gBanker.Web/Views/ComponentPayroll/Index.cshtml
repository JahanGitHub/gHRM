        debugger;
        $("#Id").val(Id);
        $("#ComponentName").val(ComponentName);
        $("#ComponentCategory").val(ComponentCategory);
        $("#IsChangeable").val(IsChangeable);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }



    $(document).ready(function () {
        //$("#IsChangeable").text('Please Select');
        $("#btnUpdate").hide();
