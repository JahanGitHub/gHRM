                    url: '@Url.Action("leaveDelete", "LeaveHistoryNew", "http")',
                    data: { LeaveId: LeaveId },
                    dataType: 'json',
                    async: false,
                    success: function (Result) {
                        $("#btnLeaveSave").show();
