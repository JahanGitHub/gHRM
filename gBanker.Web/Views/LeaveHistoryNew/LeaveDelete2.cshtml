    function getDepartmentWiseEmployee() {

        var DepartmentId = $('#DepartmentId').val();
        var OfficeId = $("#OfficeId").val();
        if (DepartmentId != "" && OfficeId != "") {
            LoadDropDown('/CommonDropdown/GetOfficeAndDepartmentWiseEmployeeList', { OfficeId: OfficeId, DepartmentId: DepartmentId }, '', '#ReplacementEmployee');
        } else {
            $('#ReplacementEmployee').html("<option value=''>Please Select</option>");
        }
    }


    function GetLeaveType(gender, employeeStatusId) {
        LoadDropDown('/CommonDropdown/GetLeaveTypeListByEmployeeStatusAndGender', { EmployeeGender: gender, EmployeeStatusId: employeeStatusId }, '', '#LeaveTypeId');
    }

    function leavedayCalC() {

        var startDate = new Date(MakeDate($('#LeaveStartDate').val()));
        var endDate = new Date(MakeDate($('#LeaveEndDate').val()));
        var leaveTyp = $('#LeaveTypeId').val();
        var leaveTypeTxt = $('#LeaveTypeId option:selected').text();
        var maxLeaveAtaTime = $("#hdnMaxAvailDays").val();
        var hdnAvailableDays = $("#hdnAvailableDays").val();
        if (startDate != '' && endDate != '') {
            if (startDate.getYear == endDate.getYear) {
                Page.CalculateLeaveTotalDaysStart();
                var LeaveTypeId = $("#LeaveTypeId").val();
                var LeaveStartDate = $("#LeaveStartDate").val();
                var LeaveEndDate = $("#LeaveEndDate").val();
                var LeaveDayDuration = $("#LeaveDayDuration").val();
                LeaveTypeId = Page.IsNumber(LeaveTypeId) ? parseFloat(LeaveTypeId) : 0;
                if (LeaveTypeId == 0 || LeaveStartDate == "" || LeaveEndDate == "") return;
                debugger
                var CalculateLeaveTotalDaysData = {
                    LeaveTypeId: LeaveTypeId,
                    LeaveStartDate: LeaveStartDate,
                    LeaveEndDate: LeaveEndDate,
                    leaveStatus: LeaveDayDuration
                };
                Req.POST.CalculateLeaveTotalDays(JSON.stringify(CalculateLeaveTotalDaysData), function (totalDays) {
                    Page.CalculateLeaveTotalDaysEnd();
                    if (totalDays > 0) {
                        if (leaveTypeTxt != "Leave Without Pay") {

                            if (totalDays > hdnAvailableDays) {
                                $("#LeaveEndDate").val('');
                                $.alert.open("Error", "Leave count exceeds available balance");
                            } else {
                                console.log('totalDays: ')
                                console.log(totalDays)

                                console.log('maxLeaveAtaTime: ')
                                console.log(maxLeaveAtaTime)

                                if (totalDays > maxLeaveAtaTime) {

                                    $.alert.open("Error", leaveTypeTxt + " Can't allow more than " + maxLeaveAtaTime + " days at a timer");// maxLeave,,maxLeaveAtaTime
                                    $("#LeaveEndDate").val("");
                                    $("#TotalDays").val(0);
                                }
                                else {
                                    $("#TotalDays").val(totalDays);
                                }
                            }
                        } else {
                            $("#TotalDays").val(totalDays);
                        }
                    }
                    else {
                        $("#TotalDays").val(0);
                        $("#LeaveEndDate").val("");
                    }
                }, function () {
                    Page.CalculateLeaveTotalDaysEnd();
                });
            }
            else {
                $.alert.open("error", "Date diffrence must be within a year");
                $("#LeaveEndDate").val('');
                $("#TotalDays").val(0);
            }
        }
    }

    function LoadMaxLeaveDay(leaveTypeId, employeeId, UpTodate) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMaxLeaveDay", "LeaveHistoryNew", "http")',
            data: { leaveTypeId: leaveTypeId, employeeId: employeeId, UpTodate: UpTodate },
            dataType: 'json',
            async: true,
            success: function (data) {
                debugger;
                if (data != null) {
                    var leaveGain = data.leaveGain;
                    if (data.LeaveCategory == "CL" || data.LeaveCategory == "AL" || data.LeaveCategory == "MEL" || data.LeaveCategory == "SL") {
                        var maxLeaveAndAva = "Max Leave available " + data.leaveGain + ",  Used Leave " + data.LeaveCount + "/" + data.TotalDays + "";
                        $("#MaxLeaveDaysInfo").val(maxLeaveAndAva);

                    }
                    else if (data.LeaveCategory == "ML" || data.LeaveCategory == "PL") {
                        var maxLeaveAndAva = "Max Leave available " + data.leaveGain + ",  Used " + data.LeaveCount + " time(s).";
                        $("#MaxLeaveDaysInfo").val(maxLeaveAndAva);
                        leaveGain = maxLeaveAndAva;
                    }
                    else {
                        var maxLeaveAndAva = "Used Leave " + data.LeaveCount + " out of " + data.leaveGain;
                        $("#MaxLeaveDaysInfo").val(maxLeaveAndAva);
                    }
                    if (data.leaveGain > 0) {
                        $("#LeaveStartDate").removeAttr('disabled');
                        $("#LeaveEndDate").removeAttr('disabled');

                    } else {
                        $.alert.open("Alert", "No leave available of this type")
                        $("#LeaveStartDate").attr('disabled', true);
                        $("#LeaveEndDate").attr('disabled', true);
                    }

                    $("#hdnMaxAvailDays").val(data.MaxAvailDays);
                    //$("#hdnAvailableDays").val(data.leaveGain);
                    $("#hdnAvailableDays").val(leaveGain);

                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetTotalDays() {
        var startDate = new Date(MakeDate($('#LeaveStartDate').val()));
        var endDate = new Date(MakeDate($('#LeaveEndDate').val()));
        var start = moment(endDate);
        var end = moment(startDate);
        var totDay = start.diff(end, "days") + 1;
        return totDay;
    }

    function MakeDate(stringDate) {
        var monName = stringDate.substring(3, 6);
        var dd = stringDate.substring(0, 2);
        var yy = stringDate.substring(11, 7);
        var makeDt = '';
        var monSl;
        switch (monName) {
            case 'Jan':
                monSl = '01';
                break;
            case 'Feb':
                monSl = '02';
                break;
            case 'Mar':
                monSl = '03';
                break;
            case 'Apr':
                monSl = '04';
                break;
            case 'May':
                monSl = '05';
                break;
            case 'Jun':
                monSl = '06';
                break;
            case 'Jul':
                monSl = '07';
                break;
            case 'Aug':
                monSl = '08';
                break;
            case 'Sep':
                monSl = '09';
                break;
            case 'Oct':
                monSl = '10';
                break;
            case 'Nov':
                monSl = '11';
                break;
            case 'Dec':
                monSl = '12';
                break;
            default:
                monSl = '0';
        }
        if (monSl != '0') {
            makeDt = yy + ' ' + monSl + ' ' + dd;
        }
        return makeDt;
    }


    function leaveDelete(LeaveId) {

        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {

                $.ajax({
                    type: 'GET',
