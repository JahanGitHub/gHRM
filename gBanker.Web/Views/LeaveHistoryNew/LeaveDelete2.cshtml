@model gHRM.Web.ViewModels.LeaveHistoryViewModel

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/LeaveHistory">LeaveHistory</a></li>
        <li><a href="/LeaveHistory/LeaveEntry">LeaveEntry</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Leave Delete";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var empList = Model == null ? null : Model.EmployeeList;
    //var leaveTypList = Model == null ? null : Model.LeaveTypeList;
}

<script src="http://momentjs.com/downloads/moment.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<script src="~/Scripts/momentjs.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<script src="http://malsup.github.com/jquery.form.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>

<style>
    .modal-backdrop {
        z-index: 900;
    }

    .vertical-alignment-helper {
        display: table;
        height: 100%;
        width: 100%;
        pointer-events: none; /* This makes sure that we can still click outside of the modal to close it */
    }

    .vertical-align-center {
        /* To center vertically */
        display: table-cell;
        vertical-align: middle;
        pointer-events: none;
    }

    .modal-content {
        /* Bootstrap sets the size of the modal in the modal-dialog class, we need to inherit it */
        width: inherit;
        max-width: inherit; /* For Bootstrap 4 - to avoid the modal window stretching full width */
        height: inherit;
        /* To center horizontally */
        margin: 0 auto;
        pointer-events: all;
    }

    .list-group-item {
        cursor: pointer;
    }

    .list-group-item:hover {
        background-color: #3e7fb8;
        color: #fff;
    }
</style>

<script type="text/javascript">

    var maxLeaveAtaTime = 0;
    var MaxLeaveDays = 0;
    var MaxLeaveAccType = 0;
    var leaCount = 0;
    var OfficeTypeId = "@ViewData["OfficeTypeId"]";
    var AL_LeaveTypeIdList = @ViewBag.AL_LeaveTypeIdList;

    function CheckSameYearForCL() {
        var startDate = $("#LeaveStartDate").val();
        var endDate = $("#LeaveEndDate").val();
        if (startDate != "" && endDate!="") {
            var startYear = new Date(startDate).getFullYear();
            var endYear = new Date(endDate).getFullYear();
            if (startYear != endYear) {
                $("#LeaveEndDate").val("");
                $.alert.open("Error", "CL must be in same year");
            }
        }
    }

    function OpenLeaveAttachmentModal(LeaveId, e) {
        e.preventDefault();
        Req.POST.GetLeaveAttachmentList(JSON.stringify({ LeaveHistoryId: LeaveId }), function (response) {
            if (0 == response.length) {
                $.alert.open("Alert", "No attachments were found");
                return;
            }
            var html = response.reduce(function (t, x) {
                return t +
                    "<li class='list-group-item' data-url='" + x.Location + "'>" + x.Name + "</li>";
            }, "");
            $("#AttachmentListContainer").html(html);
            $("#AttachmentListModal").modal("show");
        });
    }

    var Page = {
        IsNumber: function (Value) {
            return ![null, ""].includes(Value) && !isNaN(Value);
        },
        CalculateLeaveTotalDaysStart: function () {
            $("#LeaveStartDate").prop("disabled", true);
            $("#LeaveEndDate").prop("disabled", true);
            $("#TotalDays").val("");
        },
        CalculateLeaveTotalDaysEnd: function () {
            $("#LeaveStartDate").prop("disabled", false);
            $("#LeaveEndDate").prop("disabled", false);
        },
        LeaveDayDurationRefresh: function () {
            $("LeaveDayDuration").val("Full");
            var LeaveTypeId = parseFloat($("#LeaveTypeId").val());

            if (AL_LeaveTypeIdList.includes(LeaveTypeId) && $("#LeaveStartDate").val() == $("#LeaveEndDate").val()) {
                $("#LeaveDayDurationContainer").show();
            } else {
                $("#LeaveDayDurationContainer").hide();
            }
        }
    };

    var Req = {
        POST: {
            GetLeaveAttachmentList: function (Data, callback, err_callback) {
                $.ajax({
                    url: '/LeaveHistoryNew/GetLeaveAttachmentList',
                    type: 'Post',
                    data: Data,
                    dataType: 'json',
                    async: true,
                    contentType: 'application/json',
                    success: function (response) {

                        if (!response.success) {
                            $.alert.open("Alert", response.message);
                            if (null != err_callback) { err_callback(); }
                            return;
                        }
                        if (null != callback) { callback(response.data); }
                    },
                    error: function (data, textStatus, jqXHR) {
                        $.alert.open("Alert", data + ": " + textStatus + ": " + jqXHR, 'Error!!!');
                        if (null != err_callback) { err_callback(); }
                    }
                });
            },
            CalculateLeaveTotalDays: function (Data, callback, err_callback) {
                $.ajax({
                    url: '/LeaveHistoryNew/CalculateLeaveTotalDays',
                    type: 'Post',
                    data: Data,
                    async: true,
                    contentType: 'application/json',
                    success: function (response) {
                        if (!response.success) {
                            $.alert.open("Error", response.message);
                            if (null != err_callback) { err_callback(); }
                            return;
                        }
                        if (null != callback) { callback(response.data); }
                    },
                    error: function (data, textStatus, jqXHR) {
                        $.alert.open("Error", data + ": " + textStatus + ": " + jqXHR, 'Error!!!');
                        if (null != err_callback) { err_callback(); }
                    }
                });
            }
        }
    };

    $(document).ready(function () {
        $("#TotalDays").val(0);
        $("#MaxLeaveDays").val(0);

        $("#LeaveStartDate").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "-1:+1"
        });

        $("#LeaveEndDate").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "-1:+1"
        });

        $("#LeaveRequestDate").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "+0:+0",
            maxDate: new Date()
        });
        $("#LeaveRequestDate").datepicker("setDate", new Date());

        $(document).on("click", "#AttachmentListModal .list-group-item", function () {
            var url = $(this).attr("data-url");
            window.open(url, '_blank');
        });

       // LoadEmpInfo();

        $("#LeaveTypeId").change(function () {
            var leaveTypeId = $('#LeaveTypeId').val();
            var employeeId = $('#EmployeeId').val();

            if (leaveTypeId != 0 && employeeId != "0") {
                var strtDt = $('#LeaveStartDate').val();
                var endDt = $('#LeaveEndDate').val();
                if (leaveTypeId == '1') {
                    CheckSameYearForCL();
                }
                var startDate = new Date(MakeDate(strtDt));
                var endDate = new Date(MakeDate(endDt));
                if (strtDt != '' && endDt != '') {
                    leavedayCalC();
                }
                LoadMaxLeaveDay(leaveTypeId, employeeId, strtDt);
            }
            else {
                //$.alert.open("error", "Name Or Leave type has not selected.");
                $('#MaxLeaveDaysInfo').val('');
            }
            Page.LeaveDayDurationRefresh();
        });

        $("#LeaveStartDate").change(function () {
            var EmpId = $("#EmployeeId").val();
            var StartDt = MakeDate($("#LeaveStartDate").val());
            var EndDt = MakeDate($("#LeaveEndDate").val());
            var year = new Date($("#LeaveStartDate").val()).getFullYear();
            var leaveType = $("#LeaveTypeId").val();
            Page.LeaveDayDurationRefresh();
            if (leaveType=='1') {
                CheckSameYearForCL();
            }
            LoadMaxLeaveDay(leaveType, EmpId, StartDt);

            if (leaveType != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("getValidLeaveDate", "LeaveHistoryNew", "http")',
                    data: { EmpId: EmpId, StartDt: StartDt, EndDt: EndDt },
                    dataType: 'json',
                    async: false,
                    success: function (Result) {

                        if (Result == '0') {
                            $.alert.open("error", "Leave already taken in this date");
                            $("#LeaveStartDate").val('')
                            $('#LeaveEndDate').val('')
                        } else if (Result == '2') {
                            $.alert.open("error", "Assigned as replacemnet employee for this date");
                            $("#LeaveStartDate").val('')
                            $("#TotalDays").val('0')
                        }
                        else {
                            //var endDate = new Date($('#LeaveEndDate').val());
                            var endDate = $('#LeaveEndDate').val()
                            if (endDate != "") {
                                leavedayCalC();
                                // getDepartmentWiseEmployee();
                            }
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            } else {
                $.alert.open("Error", "Please select leave type first");
                $("#LeaveStartDate").val('');
            }
        });
        $("#LeaveEndDate").change(function () {
            var startDate = new Date(MakeDate($('#LeaveStartDate').val()));
            var endDate = new Date(MakeDate($('#LeaveEndDate').val()));
            var leaveType = $("#LeaveTypeId").val();
            Page.LeaveDayDurationRefresh();
            if (leaveType == '1') {
                CheckSameYearForCL();
            }
            if (leaveType != "") {
                if (startDate <= endDate) {

                    var EmpId = $("#EmployeeId").val();
                    var StartDt = MakeDate($("#LeaveStartDate").val());
                    var EndDt = MakeDate($("#LeaveEndDate").val());
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("getValidLeaveDate", "LeaveHistoryNew", "http")',
                        data: { EmpId: EmpId, StartDt: StartDt, EndDt: EndDt },
                        dataType: 'json',
                        async: false,
                        success: function (Result) {

                            if (Result == '0') {
                                $.alert.open("error", "Leave already taken in this date");
                                $("#LeaveStartDate").val('')
                                $('#LeaveEndDate').val('')
                            }
                            else if (Result == '2') {
                                $.alert.open("error", "Assigned as replacemnet employee for this date");
                                $("#LeaveEndDate").val('');
                                $("#TotalDays").val('0');
                            }
                            else {
                                var endDate = $('#LeaveEndDate').val()
                                if (endDate != "") {
                                    leavedayCalC();
                                }
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                }
                else {
                    $.alert.open("error", " Start Date is not greater than End Date.");
                    $("#LeaveEndDate").val('');
                }
            }
            else {
                $.alert.open("Error", "Please select leave type first");
                $("#LeaveEndDate").val('');
            }
        });

        $("#LeaveDayDuration").change(function () {
            var LeaveDayDuration = $("#LeaveDayDuration").val();
            var startDate = new Date(MakeDate($('#LeaveStartDate').val()));
            var endDate = new Date(MakeDate($('#LeaveEndDate').val()));
            var leaveType = $("#LeaveTypeId").val();
            Page.LeaveDayDurationRefresh();
            if (leaveType == '1') {
                CheckSameYearForCL();
            }
            if (leaveType != "") {
                if (startDate <= endDate) {

                    var EmpId = $("#EmployeeId").val();
                    var StartDt = MakeDate($("#LeaveStartDate").val());
                    var EndDt = MakeDate($("#LeaveEndDate").val());
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("getValidLeaveDate", "LeaveHistoryNew", "http")',
                        data: { EmpId: EmpId, StartDt: StartDt, EndDt: EndDt },
                        dataType: 'json',
                        async: false,
                        success: function (Result) {

                            if (Result == '0') {
                                $.alert.open("error", "Leave already taken in this date");
                                $("#LeaveStartDate").val('')
                                $('#LeaveEndDate').val('')
                            }
                            else if (Result == '2') {
                                $.alert.open("error", "Assigned as replacemnet employee for this date");
                                $("#LeaveEndDate").val('');
                                $("#TotalDays").val('0');
                            }
                            else {
                                var endDate = $('#LeaveEndDate').val()
                                if (endDate != "") {
                                    leavedayCalC();
                                }
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                }
                else {
                    $.alert.open("error", " Start Date is not greater than End Date.");
                    $("#LeaveEndDate").val('');
                }
            }
            else {
                $.alert.open("Error", "Please select leave type first");
                $("#LeaveEndDate").val('');
            }
        });


        $('#btnLeaveSave').click(function (e) {
            e.preventDefault();

            var totDays = $('#TotalDays').val();
            var LeaveType = $('#LeaveTypeId').val();
            var leaveTypeText = $('#LeaveTypeId option:selected').text();
            var EmpId = $('#EmployeeId').val();
            var LeaveStartDate = $("#LeaveStartDate").val();
            var LeaveEndDate = $("#LeaveEndDate").val();
            var LeaveReqDate = $("#LeaveRequestDate").val();
            var LeaveReason = $("#LeaveReason").val();
            var AddressDuringLeave = $("#AddressDuringLeave").val();
            var employeeCode = $("#txtEmployeeCode").val();
            var employeeName = $("#EmployeeName").val();
            var officeName = $("#OfficeName").val();
            var employeeRank = $("#EmployeeRank").val();
            var departmentName = $("#DepartmentName").val();
            var designationName = $("#DesignationName").val();
            var offcDesignation = $("#OffcDesignName").val();
            var replacementEmployee = $("#ReplacementEmployee").val();
            var LeaveDayDuration = $("#LeaveDayDuration").val();
            maxLeaveAtaTime = $("#hdnMaxAvailDays").val();

            const files = $('#AttachmentDocs')[0].files;

            if (LeaveType === '12' && files.length === 0) {
                e.preventDefault();
                $.alert.open("Warning","Medical certificate is required for sick leave");
                return;
            }



            if (parseInt(totDays) > parseInt(maxLeaveAtaTime) && leaveTypeText != "Leave Without Pay") {
                $.alert.open("Warning", "Sorry your are not eligible for " + totDays + " days " + $("#LeaveTypeId option:selected").text());
                return;
            }
            
            if (totDays != "" && LeaveType != "" && EmpId != "" && LeaveStartDate != "" && LeaveEndDate != "" && LeaveReqDate != "" && LeaveReason != "" && AddressDuringLeave != "" && replacementEmployee != "") {
                if (parseFloat(totDays) > 0 && EmpId > 0) {
                    $("#btnLeaveSave").hide();                    
                    $('#AjaxLoader').show();
                   
                    $('#LeaveEntry').ajaxSubmit({
                        type: "POST",
                        target: '#thumbnil',
                        data: {},
                        dataType: 'json',
                        resetForm: true,
                        success: function (data) {
                            $('#LeaveTypeId').val('');
                            $("#txtEmployeeCode").val(employeeCode);
                            $("#EmployeeName").val(employeeName);
                            $("#OfficeName").val(officeName);
                            $("#EmployeeRank").val(employeeRank);
                            $("#DepartmentName").val(departmentName);
                            $("#DesignationName").val(designationName);
                            $("#OffcDesignName").val(offcDesignation);
                            if (data.Result > 0) {
                                $('#AjaxLoader').hide();
                                $(".save-success").html(data.Message).show(800).fadeToggle(3000);
                                $("#btnLeaveSave").hide();

                                GetEmployeeWiseLeaveHistory();
                                GetEmployeeWiseLeave();
                            }
                            else {
                                $('#AjaxLoader').hide();
                                $(".save-fail").html(data.Message).show(800).fadeToggle(3000);
                                $("#btnLeaveSave").show();
                            }
                        },
                        error: function () {
                            $('#AjaxLoader').hide();
                            $("#btnLeaveSave").show();
                            $("#dialog-message").html('<p>Error, Fail to Save.</p>');
                            $("#dialog-message").dialog({
                                modal: true,
                                buttons: {
                                    Ok: function () {
                                        $(this).dialog("close");
                                    }
                                }
                            });
                        }
                    });
                }
                else {
                    $('#AjaxLoader').hide();
                    $.alert.open("error", "Please insert correct date");
                    $("#btnLeaveSave").show();
                }
            }
            else {
                $.alert.open("error", " Insert All Required Information.");
                $('#AjaxLoader').hide();
                $("#btnLeaveSave").show();
            }
        });

        $("#txtEmployeeCode").keyup(function (e) {
            var keycode = e.keyCode ? e.keyCode : e.which;
            if (keycode == 8) { // backspace
                $("#EmployeeRank").val("");
                $("#OfficeName").val("");
                $('#OfficeName').val("");
                $('#DepartmentName').val("");
                $('#DesignationName').val("");
                $('#LeaveTypeId').val("");
                $('#MaxLeaveDaysInfo').val("");
                $('#LeaveStartDate').val("");
                $('#LeaveEndDate').val("");
                $('#TotalDays').val("");
                $('#LeaveReason').val("");
                $("#AddressDuringLeave").val("");
                $("#EmpGender").val("");
                $('#employeeWiseLeaveGrid').empty();
                $('#employeeWiseLeaveHistoryGrid').empty();

            }
            else {
                $('#txtEmployeeCode').val();
               // LoadEmpInfo();
            }
        });

        $("#txtEmployeeCode").blur(function (e) {
            LoadEmpInfo();
        });

    });




