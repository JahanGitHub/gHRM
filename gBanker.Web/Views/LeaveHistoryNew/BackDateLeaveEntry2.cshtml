@using (Html.BeginForm("BackDateLeaveEntry", "LeaveHistoryNew", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "BackDateLeaveEntry" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="create-success create-content alert alert-success alert-dismissible" role="alert" style="display: none;">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <p class="message-content">  </p>
    </div>
    <div id="AjaxLoader" class="ajaxLoader"></div>
    <div class="container-fluid">
        <fieldset>
            <legend>Employee Info</legend>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4", id = "employeeCode" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtEmpCode", "", new { @class = "form-control", id = "txtEmployeeCode" })
                            @Html.HiddenFor(model => model.EmployeeId)
                            @Html.HiddenFor(model => model.EmpGender)
                            @Html.HiddenFor(model => model.DepartmentId)
                            @Html.HiddenFor(model => model.OfficeId)

                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OfficeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.OfficeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DepartmentName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DepartmentName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DesignationName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OffcDesignName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.OffcDesignName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>
        <div class="row">
            <div class="col-md-12">
                &nbsp;
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                &nbsp;
            </div>
        </div>
        <fieldset>
            <legend>Leave Information</legend>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaveRequestDate, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.LeaveRequestDate, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaveTypeId, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.LeaveTypeId, Model.LeaveTypeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ReplacementEmployee, htmlAttributes: new { @class = "control-label col-md-4 required" })
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.ReplacementEmployee, Model.EmployeeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.MaxLeaveDaysInfo, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.MaxLeaveDaysInfo, new { htmlAttributes = new { @class = "form-control", @readOnly = true } })
                            @Html.HiddenFor(model => model.MaxLeaveDays)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaveStartDate, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.LeaveStartDate, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.LeaveStartDate)
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaveEndDate, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.LeaveEndDate, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.LeaveStartDate)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.TotalDays, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.TotalDays, new { htmlAttributes = new { @class = "form-control", @readOnly = true } })
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LeaveReason, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.LeaveReason, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AddressDuringLeave, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.AddressDuringLeave, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        <div class="save-success alert alert-success alert-dismissable" role="alert" style="display:none">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <p class="message-content">Saved Sucessfully</p>
                        </div>
                        <div class="save-fail alert alert-danger alert-dismissable" role="alert" style="display:none">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <p class="message-content">Fail to save</p>
                        </div>
                        <input type="submit" value="Save" id="btnLeaveSave" class="btn btn-primary" />
                        <input type="hidden" value="" id="hdnLeaveSave" />
                        <input type="hidden" value="" id="hdnLeaveId" />
                        <input type="hidden" value="" id="hdnMaxAvailDays" />

                    </div>
                </div>
            </div>
        </fieldset>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/alert")
}
