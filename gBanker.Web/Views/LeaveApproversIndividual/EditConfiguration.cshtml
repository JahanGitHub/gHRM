

@model gHRM.Web.ViewModels.LeaveApproversViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Office">Office</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Edit Configuration";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<link href="~/Content/bpopup/bpopupStyle.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" type="text/css" />
<script src="~/Content/bpopup/jquery.bpopup.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" type="text/javascript"></script>

<script type="text/javascript">

    function getOfficeList(officeTypeId) {
        if (officeTypeId != "" && officeTypeId > 0) {
            var ddlOffice = $("#ApproverOfficeId");
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("getOfficeList", "LeaveApproversIndividual", "http")',
                data: { OfficeTypeId: officeTypeId },
                dataType: 'json',
                async: false,
                success: function (data) {
                    ddlOffice.html('');
                    $.each(data, function (id, option) {
                        ddlOffice.append($('<option></option>').val(option.Value).html(option.Text));
                    });
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
    }

    function getDepartmentList(officeTypeId) {
        if (officeTypeId != "" && officeTypeId > 0) {
            var ddlDepartment = $("#ApproverDepartmentId");
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("getDepartmentList", "LeaveApproversIndividual", "http")',
                data: { OfficeTypeId: officeTypeId },
                dataType: 'json',
                async: false,
                success: function (data) {
                    ddlDepartment.html('');
                    $.each(data, function (id, option) {
                        ddlDepartment.append($('<option></option>').val(option.Value).html(option.Text));
                    });
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
    }

    function getOfficeEmployeeList(approverOfficeId, approverDepartmentId, approverDesignationId) {
        var ddlEmployee = $("#ApproverEmpId");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("getOfficeEmployeeList", "LeaveApproversIndividual", "http")',
            data: { ApproverOfficeId: approverOfficeId, ApproverDepartmentId: approverDepartmentId, ApproverDesignationId: approverDesignationId },
            dataType: 'json',
            async: false,
            success: function (data) {
                ddlEmployee.html('');
                $.each(data, function (id, option) {
                    ddlEmployee.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function ConfigurationDelete(ID, EmployeeId) {

        if (ID > 0 && EmployeeId > 0) {
            $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
                if (button == 'yes') {
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("ConfigurationDelete", "LeaveApproversIndividual", "http")',
                        data: { ID: ID },
                        dataType: 'json',
                        async: false,
                        success: function (Result) {
                            if (Result == 1) {
                                getApprovalListDashboard(EmployeeId);
                                $.alert.open("Success", "Approver Deleted Successfully");

                            } else {
                                $.alert.open("Error", Result);
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                    return true;
                }
                else {
                    hiddenField.value = 'false';
                    return false;
                }
            });
        }
    }


    function LeaveApproversIndividualUpdate(EmployeeId) {

        if (EmployeeId > 0) {
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("LeaveApproversIndividualUpdate", "LeaveApproversIndividual", "http")',
                        data: { EmployeeId: EmployeeId },
                        dataType: 'json',
                        async: false,
                        success: function (data) {
                            if (data.result == 1) {
                                getApprovalListDashboard(EmployeeId);

                            } else {
                                $.alert.open("Error", data.message);
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                    return true;
                }
    }

    function getApprovalListDashboard(EmployeeId) {
        $('#gridKendoApprover').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("getApprovalDetailListDashboard", "LeaveApproversIndividual", "http")',
                    dataType: 'json',
                    data: { EmployeeId: EmployeeId }
                }
            }
        });
        $("#gridKendoApprover").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "ID",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "EmployeeId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "ApproverEmpId",
                    hidden: true,
                    filterable: false
                },
                //{
                //    field: "ApplicantDetail",
                //    hidden: true,
                //    filterable: false,
                //    template: function (dataItem) {
                //        $("#ApplicantDetail").html(dataItem.ApplicantDetail);
                //    }
                //},
                {
                    field: "ApprovalLevel",
                    title: "Level",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "ApproverDetail",
                    title: "Approver Detail",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "OfficeTypeName",
                    title: "Office Type",
                    width: "50px",
                    filterable: true,
                },

               {
                   field: "OfficeName",
                   title: "Office Name",
                   width: "50px",
                   filterable: true,
               },
                {
                    field: "DepartmentName",
                    title: "Department Name",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "DesignationName",
                    title: "Designation Name",
                    width: "50px",
                    filterable: true,
                }, {
                    title: "Edit",
                    width: "20px",
                    template: function (dataItem) {
                        $("#txtApplicantDetail").html(dataItem.ApplicantDetail);
                        return "<a href='#' OnClick='ConfigurationEdit(" + dataItem.ID + "," + dataItem.EmployeeId + "," + dataItem.ApproverEmpId + "," + dataItem.ApprovalLevel + "," + dataItem.ApproverOfficeTypeId + "," + dataItem.ApproverOfficeId + "," + dataItem.ApproverDepartmentId + "," + dataItem.ApproverDesignationId + ");'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },
            {
                title: "Delete",
                width: "25px",
                template: function (dataItem) {
                    return "<a href='#' OnClick='ConfigurationDelete(" + dataItem.ID + "," + dataItem.EmployeeId + ");'><i class='fa fa-trash-o'></i></a>";
                }
            }
            ]
        });
    }

    function ConfigurationEdit(ID, EmployeeId, ApproverEmpId, ApprovalLevel, ApproverOfficeTypeId, ApproverOfficeId, ApproverDepartmentId, ApproverDesignationId) {
        $("#ID").val(ID);
        $("#EmployeeId").val(EmployeeId);
        $("#ApproverOfficeTypeId").val(ApproverOfficeTypeId).trigger("change");
        $("#ApproverOfficeId").val(ApproverOfficeId);
        $("#ApproverDepartmentId").val(ApproverDepartmentId);
        $("#ApproverDesignationId").val(ApproverDesignationId).trigger("change");
        if (ApproverEmpId > 0) {
            $("#ApproverEmpId").val(ApproverEmpId);
        } else {
            $("#ApproverEmpId").val("");
        }

        $("#ApprovalLevel").val(ApprovalLevel);
    }


    $(document).ready(function () {
        debugger
        var EmployeeId = $("#EmployeeId").val();

        if (EmployeeId != "" && EmployeeId > 0) {
            //LeaveApproversIndividualUpdate(EmployeeId);
             getApprovalListDashboard(EmployeeId);
        }

        $("#ApproverOfficeTypeId").change(function () {
            var officeTypeId = $("#ApproverOfficeTypeId").val();
            if (officeTypeId != "" && officeTypeId > 0) {
                getOfficeList(officeTypeId);
                getDepartmentList(officeTypeId);
                $("#ApproverDesignationId").val("");
            }
        });

        $("#ApproverOfficeId").change(function () {
            $("#ApproverDesignationId").val("");
        });

        $("#ApproverDepartmentId").change(function () {
            $("#ApproverDesignationId").val("");
        });

        $("#ApproverDesignationId").change(function () {
            var approverOfficeId = $("#ApproverOfficeId").val();
            var approverDepartmentId = $("#ApproverDepartmentId").val();
            var approverDesignationId = $("#ApproverDesignationId").val();

            if (approverOfficeId > 0 && approverDepartmentId > 0 && approverDesignationId > 0) {
                getOfficeEmployeeList(approverOfficeId, approverDepartmentId, approverDesignationId);
            }
        });

        $("#btnSave").click(function () {

            var id = $("#ID").val();
            if (id == "") {
                id = 0;
            }

            var empId = parseInt($("#EmployeeId").val());
            var approverOfficeId = parseInt($("#ApproverOfficeId").val());
            var approverDepartmentId = parseInt($("#ApproverDepartmentId").val());
            var approverDesignationId = parseInt($("#ApproverDesignationId").val());
            var approverEmpId = parseInt($("#ApproverEmpId").val());
            var approvalLevel = parseInt($("#ApprovalLevel").val());
            if (id >= 0
                && empId > 0
                && approverOfficeId > 0
                && approverDepartmentId > 0
                && approverDesignationId > 0
                && approverEmpId > 0
                && approvalLevel > 0) {
                var entity = {
                    ID: id,
                    EmployeeId: empId,
                    ApproverOfficeId: approverOfficeId,
                    ApproverDepartmentId: approverDepartmentId,
                    ApproverDesignationId: approverDesignationId,
                    ApproverEmpId: approverEmpId,
                    ApprovalLevel: approvalLevel
                };
                $.ajax({
                    type: 'POST',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("SaveConfiguration", "LeaveApproversIndividual", "http")',
                    data: JSON.stringify({ Entity: entity }),
                    dataType: 'json',
                    async: false,
                    success: function (data) {
                        if (data.result == 1) {

                            var EmployeeId = $("#EmployeeId").val();
                            getApprovalListDashboard(EmployeeId);
                            $("#ID").val("");
                            $.alert.open("Success", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            } else {
                alert("Please Select All required field");
            }
        });
    });

</script>




