@using (Html.BeginForm("EditConfiguration", "LeaveApproversIndividual", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "EditConfiguration" }))
{
    @Html.AntiForgeryToken()
    <div class="container-fluid">
        @Html.HiddenFor(model => model.EmployeeId)
        @Html.HiddenFor(model => model.ID)
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApplicantDetail, htmlAttributes: new { @class = "control-label  col-sm-2" })
                    <div class="col-sm-10">
                        <label id="txtApplicantDetail" class="control-label col-sm-12" style="text-align:left;font-size:20px;color:red"></label>
                    </div>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApproverOfficeTypeId, htmlAttributes: new { @class = "control-label  col-sm-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ApproverOfficeTypeId, Model.ApproverOfficeTypeList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApproverOfficeId, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ApproverOfficeId, Model.ApproverOfficeList, new { @class = "form-control" })
                    </div>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApproverDepartmentId, htmlAttributes: new { @class = "control-label  col-sm-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ApproverDepartmentId, Model.ApproverDepartmentList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApproverDesignationId, htmlAttributes: new { @class = "control-label  col-sm-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ApproverDesignationId, Model.ApproverDesignationList, new { @class = "form-control" })
                    </div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApproverEmpId, htmlAttributes: new { @class = "control-label  col-sm-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ApproverEmpId, Model.ApproverEmployeeList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ApprovalLevel, htmlAttributes: new { @class = "control-label  col-sm-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ApprovalLevel, Model.ApprovalLevelList, new { @class = "form-control" })
                    </div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <button type="button" class="btn btn-success col-sm-offset-5" id="btnSave">Save</button>
                </div>
            </div>
        </div>

        <div class="box-content">

            <div class="table-responsive">
                <div id="gridKendoApprover"></div>
            </div>
        </div>
    </div>
}

