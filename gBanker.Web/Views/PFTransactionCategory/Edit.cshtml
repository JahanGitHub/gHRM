@model gHRM.Web.ViewModels.PF.TransactionCategoryViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    //Update PF

    function UpdateTransactionCategory(transCatId, TransCatName, transGroup, accountId, transType, particulars, revAccountId, revTransType, revParticulars) {
     
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdateTransactionCategory", "PFTransactionCategory", "http")',
            data: {
                transCatId: transCatId,
                TransCatName: TransCatName,
                transGroup: transGroup,
                accountId: accountId,
                transType: transType,
                particulars: particulars,
                revAccountId: revAccountId,
                revTransType: revTransType,
                revParticulars: revParticulars
                },
            dataType: 'json',
            async: false,
            success: function (data) {
                $.alert.open("Message", data.message);
                if (data.status == 'ok') {
                    setTimeout(function () {
                        window.location.href = "/PFTransactionCategory/Index";
                    }, 1500);
                }
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");
            }
        });
    }

    function Update() {
        var transCatId = $("#TransCategoryId").val();
        var TransCatName = $("#TransCategoryName").val();
        var transGroup = $("#TransactionGroupList option:selected").val();

        var accountId = $("#AccountChartList option:selected").val();
        var transType = $("#TransactionTypeList option:selected").val();
        var particulars = $("#Particulars").val();

        var revAccountId = $("#ReverseAccountChartList option:selected").val();
        var revTransType = $("#ReverseTransactionType").val();
        var revParticulars = $("#ReverseParticulars").val();

        if (revTransType == 'Credit') {
            revTransType = 'Cr'
        }
        if (revTransType == 'Debit') {
            revTransType = 'Dr'
        }
        if (transCatId == '' || TransCatName == '' || transGroup == '' || accountId == '' || transType == '' || particulars == '' || revAccountId == '' || revTransType == '' || revParticulars == '') {
            alert('Enter valid data');
            return;
        }
        UpdateTransactionCategory(transCatId, TransCatName, transGroup, accountId, transType, particulars, revAccountId, revTransType, revParticulars);
    }

    //End Save Work Area
    $(document).ready(function () {

        
        var transGroupName =  $('#TransGroupName').val();
        $('#TransactionGroupList').val(transGroupName);

        var accountId = $('#AccountId').val();
        $('#AccountChartList').val(accountId);

        var transactionType = $('#TransactionType').val();
        $('#TransactionTypeList').val(transactionType);

        var reverseAccountId = $('#ReverseAccountId').val();
        $('#ReverseAccountChartList').val(reverseAccountId);

        $("#btnUpdateTransCategory").click(function () {

            $.alert.open('confirm', 'Are you sure you want to update?', function (button) {
                if (button == 'yes') {
                    Update();
                    return true;
                }
                else {
                    return false;
                }
            });
        });
    });
</script>

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })
&nbsp;
<h2 class="page-title">Edit Transaction Category</h2>
