    $(document).ready(function () {               
        $("#SartDate").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",            
         });

        $("#btnoffiDesSave").click(function () {            
            if ($("#EmployeeId").val() == '0' && $("#SartDate").val() == '') {
                $("#SartDate").addClass("errorClass");
                $("#EmployeeId").addClass("errorClass");
                return false;
            }
            else if ($("#EmployeeId").val() != '0' && $("#SartDate").val() == '')
            {
                $("#SartDate").addClass("errorClass");
                return false;
            }
            else if ($("#EmployeeId").val() == '0' && $("#SartDate").val() != '') {
                $("#EmployeeId").addClass("errorClass");
                return false;
            }
            else
            {
                return true;
            }           
        });
    });

</script>

@using (Html.BeginForm("Edit", "EmployeeOfficeDesignation", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "EmployeeOfficeDesignationProfile" }))
{    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="container-fluid">
        <h2 class="page-title">Employee Designation Edit</h2>
        <br />
        <br />         
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OfficeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">                           
                            @Html.EditorFor(model => model.OfficeName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.HiddenFor(model=> model.EmpOfficeDesigId)
                            @Html.HiddenFor(model => model.EmployeeId)
                        </div>
                    </div>
                </div>
            </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.OfficeDesignationId, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.OfficeDesignationId, OfficeDesignationName, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.SartDate, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.SartDate, new { htmlAttributes = new { @class = "form-control", @placeholder = "Date" } })
                    </div>
                </div>
            </div>
        </div>  
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group form-action" style="padding:10px;margin-left:50px;">
                    <input type="submit" value="Save" id="btnofDesSave" class="btn btn-primary" />
                    @*<input type="hidden" value="" id="btnBranchSave" />
                    <input type="hidden" value="" id="btnBranchSave" />*@
                </div>
            </div>
        </div>             
        </div>

}
@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}




