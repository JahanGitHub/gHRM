@model gHRM.Web.ViewModels.OfficeViewModel
@*@model IEnumerable<gHRM.Web.ViewModels.OfficeViewModel>*@

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Office">Office</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Office List";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">

    $(document).ready(function () {
        getOfficeDashboard();
        $("#officeType").hide();
        $("#filterColumn").change(function () {
            var filterColumn = $("#filterColumn").val();
            if (filterColumn == "OfficeType") {
                $("#officeType").show();
                $("#filterTxt").hide();
            } else {
                $("#officeType").hide();
                $("#filterTxt").show();
                $("#filterValue").val('');
            }
        });
    });


    function OfficeDelete(officeId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("OfficeDelete", "Office", "http")',
                    data: { officeId: officeId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            getOfficeDashboard();
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function Print(id) {
        console.log(id);
        var url = "/Office/OfficeReport?id=" + id
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    ////// Kendo Grid Integration

    function getOfficeDashboard() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("getOfficeDashboard", "Office", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "OfficeId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "20px",
                    filterable: false,
                },
                {
                    field: "OfficeTypeName",
                    title: "Office Type",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "OfficeCode",
                    title: "Office Code",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "OfficeName",
                    title: "Office Name",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "OfficeAddress",
                    title: "Office Address",
                    width: "150px",
                    filterable: false,
                },
                {
                    field: "Phone",
                    title: "Phone",
                    width: "40px",
                    filterable: false,
                },
                {
                    field: "OperationStartDateMsg",
                    title: "Start Date",
                    width: "50px",
                    filterable: false,
                },
                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.OfficeTypeId != 1) {
                             return "<a href='/Office/Create/?OfficeId=" + dataItem.OfficeId + "'><i class='fa fa-pencil-square-o'></i></a>";
                         } else {
                             return "";
                         }
                     }
                 },
            {
                title: "Delete",
                width: "25px",
                template: function (dataItem) {
                    if (dataItem.OfficeTypeId != 1) {
                        return "<a href='#' OnClick='OfficeDelete(" + dataItem.OfficeId + ");'><i class='fa fa-trash-o'></i></a>";
                        //return '<a href="/Office/OfficeDelete/?OfficeId="' + dataItem.OfficeId + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '><i class="fa fa-trash-o"></i></a>';
                    } else {
                        return "";
                    }
                }
                }
               , {
                    title: "Print Report ",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' OnClick='Print(" + dataItem.OfficeId + ");'><i class='fa fa-print'></i></a>";
                    }
                }
            ]
        });
    }

</script>

@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-success btn-sm pull-right" })
&nbsp;
<h2 class="page-title">Office List (অফিসের তালিকা)</h2>
&nbsp;

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-horizontal">
        <hr />
        <div class="box-content">
            <div class="table-responsive">
                <div id="gridKendo"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}