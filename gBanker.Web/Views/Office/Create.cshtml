                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ZoneCode, Model.ZoneList, new { @class = "form-control", @required = "required" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row frmRow" id="AreaDiv">
            <div class="col-sm-6">
                <div class="item form-group">
                    @Html.LabelFor(model => model.AreaCode, new { @class = "control-label col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.AreaCode, Model.AreaList, new { @class = "form-control", @required = "required" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.OfficeCode, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                    <div class="col-sm-8">
