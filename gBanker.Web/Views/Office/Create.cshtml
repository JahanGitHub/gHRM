@using (Html.BeginForm("Create", "Office", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "OfficeProfile" }))
{
    @Html.AntiForgeryToken()

    <div class="">
        @*@Html.Partial("~/Views/Shared/_OfficeNevigationPane.cshtml", pvOfficeNevigation)*@
        
        @*<hr/>*@
