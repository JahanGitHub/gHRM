@model gHRM.Web.ViewModels.EmployeeStatusViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeStatus/Index">EmployeeStatus</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Employee Status";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">
    function GenerateEmployeeStatus() {
        var item = {};
        item.StatusName = $("#StatusName").val();
        item.StatusValue = $("#StatusValue").val();
        item.ViewOrder = $("#ViewOrder").val();
        return item;
    }

    function GenerateUpdateEmployeeStatus() {
        var item = {};
        item.StatusId = $("#StatusId").val();
        item.StatusName = $("#StatusName").val();
        item.StatusValue = $("#StatusValue").val();
        item.ViewOrder = $("#ViewOrder").val();
        return item;
    }

    function ClearControl() {
        $("#StatusName").val('');
        $("#StatusValue").val('');
        $("#ViewOrder").val('');
    }

    function SaveEmployeeStatus() {


        var employeeStatus = GenerateEmployeeStatus();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveEmployeeStatus", "EmployeeStatus")',
            data: JSON.stringify({ employeeStatus: employeeStatus }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    //$('#grid').jtable('load');
                    LoadMainGrid();
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }

    function UpdateEmployeeStatus() {


        var employeeStatus = GenerateUpdateEmployeeStatus();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateEmployeeStatus", "EmployeeStatus")',
            data: JSON.stringify({ employeeStatus: employeeStatus }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Update Successfull") {
                    ClearControl();
                    //$('#grid').jtable('load');
                    LoadMainGrid();
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }





</script>


<h2 class="page-title">Employee Status</h2>
@using (Html.BeginForm("SaveEmployeeStatus", "EmployeeStatus", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Status Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.StatusName, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Status Value</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.StatusValue, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">View Order</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.ViewOrder, new { @class = "form-control required" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveEmployeeStatus()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateEmployeeStatus()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetEmployeeStatus()" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
            @Html.HiddenFor(model => model.StatusId)
        </div>
    </div>
}


