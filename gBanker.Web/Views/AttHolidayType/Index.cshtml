@model gHRM.Web.ViewModels.Basic.AttHolidayTypeViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/AttHolidayType/index">Index</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "AttHoliday Type";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">

    $(document).ready(function () {
        loadAttHolidayType();

        $("#btnSave").click(function () {
            SaveAttHolidayType();
        });
        $("#btnUpdate").click(function () {
            UpdateAttHolidayType();
        });
        $("#btnReset").click(function () {
            ResetAttHolidayType();
        });
    });

    function loadAttHolidayType() {
        $("#btnUpdate").hide();
        $("#btnReset").hide();

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("ListAttHolidayType", "AttHolidayType", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "AttHolidayTypeId",
                     hidden: true,
                     filterable: false
                 },
                 {
                     width: "150px",
                     field: "HolidayTypeShortName",
                     filterable: true,
                     title: "HolidayType ShortName"
                 },
                 {
                     width: "80px",
                     filterable: true,
                     field: "HolidayTypeFullName",
                     title: "HolidayType FullName"
                 },
                 {
                     width: "50px",
                     title: 'Edit',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='EditAttHolidayType(" + dataItem.AttHolidayTypeId + ",\"" + dataItem.HolidayTypeShortName + "\",\"" + dataItem.HolidayTypeFullName + "\");'><i class='fa fa-pencil-square-o'></i></a>";
                     }
                 },
                 {
                     width: "50px",
                     title: 'Delete (বাদ)',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='InformationDelete(" + dataItem.AttHolidayTypeId + ");'><i class='fa fa-trash-o'></i></a>";
                     }
                 }
            ]
        });
    }

    function GenerateAttHolidayType() {
        var item = {};
        item.HolidayTypeShortName = $("#HolidayTypeShortName").val();
        item.HolidayTypeFullName = $("#HolidayTypeFullName").val();
        return item;
    }

    function GenerateUpdateAttHolidayType() {
        var item = {};
        item.AttHolidayTypeId = $("#AttHolidayTypeId").val();
        item.HolidayTypeShortName = $("#HolidayTypeShortName").val();
        item.HolidayTypeFullName = $("#HolidayTypeFullName").val();
        return item;
    }

    function EditAttHolidayType(AttHolidayTypeId, HolidayTypeShortName, HolidayTypeFullName) {
        $("#AttHolidayTypeId").val(AttHolidayTypeId);
        $("#HolidayTypeShortName").val(HolidayTypeShortName);
        $("#HolidayTypeFullName").val(HolidayTypeFullName);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }

    function ResetAttHolidayType() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }

    function ClearControl() {
        $("#HolidayTypeShortName").val('');
        $("#HolidayTypeFullName").val('');
    }


    function SaveAttHolidayType() {
        var AttHolidayType = GenerateAttHolidayType();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveAttHolidayType", "AttHolidayType")',
            data: JSON.stringify({ AttHolidayType: AttHolidayType }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    loadAttHolidayType();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function UpdateAttHolidayType() {
        var AttHolidayType = GenerateUpdateAttHolidayType();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateAttHolidayType", "AttHolidayType")',
            data: JSON.stringify({ AttHolidayType: AttHolidayType }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Update Successfull") {
                    ClearControl();
                    loadAttHolidayType();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteAttHolidayType", "AttHolidayType", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            loadAttHolidayType();
                            $.alert.open("Success", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


</script>

<div class="row">
    <div class="col-sm-9"><h4 class="text-blue">Attendance Holiday Type</h4></div>
    <div class="col-sm-3"><a href="/AttHoliday/HoliDayEntry" class="pull-right btn btn-success">Back To List</i></a></div>
</div><hr />

@using (Html.BeginForm("SaveAttHolidayType", "AttHolidayType", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal " }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">HolidayType ShortName</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.HolidayTypeShortName, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">HolidayType FullName</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.HolidayTypeFullName, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <div class="col-sm-8 pull-right">
                        <input type="button" value="Save" id="btnSave" class="btn btn-primary" />
                        <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" />
                        <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-8">
                @Html.HiddenFor(model => model.AttHolidayTypeId)
            </div>
        </div>
}

<br />
<h2 class="page-title">AttHoliday Type List</h2>
<div id="grid"></div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
}
