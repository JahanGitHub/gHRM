@model gHRM.Web.ViewModels.Payroll.EmployeeSalaryBonusViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeSalaryBonus">Employee Salary Bonus</a></li>
        <li><a href="/EmployeeSalaryBonus/BonusApprovedReports">BonusApprovedReports</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Employee Salary Bonus";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    function LoadBankAccounts(branchId) {
        var ddlAccount = $("#AreaList");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetBankAccountList", "PRSalaryStatement", "http")',
            data: { BranchId: branchId },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlAccount.html('');
                $.each(data, function (id, option) {
                    ddlAccount.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function LoadBankBranch(bankCode) {
        var ddlBranch = $("#ZoneList");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetBankBranchList", "PRSalaryStatement", "http")',
            data: { BankCode: bankCode },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlBranch.html('');
                $.each(data, function (id, option) {
                    ddlBranch.append($('<option></option>').val(option.Value).html(option.Text));
                });
                ddlBranch.trigger('change');
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function PrintBonusBankSummaryReportBeforeApproval(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportBeforeApproval2?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName + '&BranchId=' + branchId + '&AccountId=' + accountId + '&SalaryType=' + salaryType + '&PersonToContactFromBankId=' + PersonToContactFromBankId + '&ReportName=' + ReportName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintBonusBankSummaryReportBeforeApprovalPDF(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportBeforeApprovalPDF2?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName + '&BranchId=' + branchId + '&AccountId=' + accountId + '&SalaryType=' + salaryType + '&PersonToContactFromBankId=' + PersonToContactFromBankId + '&ReportName=' + ReportName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintBonusBankSummaryReportAfterApproval(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportAfterApproval2?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName + '&BranchId=' + branchId + '&AccountId=' + accountId + '&SalaryType=' + salaryType + '&PersonToContactFromBankId=' + PersonToContactFromBankId + '&ReportName=' + ReportName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintBonusBankSummaryReportAfterApprovalPDF(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName ) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportAfterApprovalPDF2?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName + '&BranchId=' + branchId + '&AccountId=' + accountId + '&SalaryType=' + salaryType + '&PersonToContactFromBankId=' + PersonToContactFromBankId + '&ReportName=' + ReportName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    // GSSB
    function PrintBonusBankSummaryReportBeforeApprovalPDF_GSSB(year, month, officeTypeId, bankName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportBeforeApprovalForGSSBPDF?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }



    $(document).ready(function () {

        $("#BankCode").change(function () {
            var code = $("#BankCode").val();
            if (code != "") {
                LoadBankBranch(code);
            } else {
                $("#ZoneList").html('<option value="">Please Select</option>');

            }
        });
        $("#ZoneList").change(function () {
            var branchId = $("#ZoneList").val();

            if (branchId != "" && branchId > 0) {
                LoadBankAccounts(branchId);
            } else {
                $("#AccountId").html('<option value="">Please Select</option>');
            }
        });

        $("#ZoneDiv").hide();

        //$("#OfficeTypeId").change(function () {
        //    var OfficeTypeId = $("#OfficeTypeId").val();
        //    if (OfficeTypeId == 4) {
        //        $("#ZoneDiv").show();
        //    } else {
        //        $("#ZoneDiv").hide();
        //    }
        //});


        $("#Process1Date").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: "1920:2100"
          });

        $("#Process1Date").datepicker('setDate', new Date());


        $("#btnBonusAtBankBeforeApprovalExcel").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();

            // new four vairable 
            var branchId = $("#ZoneList").val();
            console.log(branchId);
            var accountId = $("#AreaList").val();
            console.log(accountId);

            var salaryType = $("#SalaryType").val();

            var PersonToContactFromBankId = $("#PersonToContactFromBankId").val();
            var ReportName = $('#ReportName').val();

            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportBeforeApproval(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#btnBonusAtBankBeforeApprovalPDF").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }

            // new four vairable 
            var branchId = $("#ZoneList").val();
            console.log(branchId);
            var accountId = $("#AreaList").val();
            console.log(accountId);

            var salaryType = $("#SalaryType").val();

            var PersonToContactFromBankId = $("#PersonToContactFromBankId").val();
            var ReportName = $('#ReportName').val();

            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportBeforeApprovalPDF(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#btnBonusAtBankAfterApprovalExcel").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }

            // new four vairable 
            var branchId = $("#ZoneList").val();
            console.log(branchId);
            var accountId = $("#AreaList").val();
            console.log(accountId);

            var salaryType = $("#SalaryType").val();

            var PersonToContactFromBankId = $("#PersonToContactFromBankId").val();

            var ReportName = $('#ReportName').val();

            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportAfterApproval(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#btnBonusAtBankAfterApprovalPDF").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }

            // new four vairable 
            var branchId = $("#ZoneList").val();
            console.log(branchId);
            var accountId = $("#AreaList").val();
            console.log(accountId);

            var salaryType = $("#SalaryType").val();

            var PersonToContactFromBankId = $("#PersonToContactFromBankId").val();

            var ReportName = $('#ReportName').val();

            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportAfterApprovalPDF(year, month, officeTypeId, bankName, branchId, accountId, salaryType, PersonToContactFromBankId, ReportName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });


        //GSSB
        $("#btnBonusAtBankBeforeApprovalPDFGSSB").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportBeforeApprovalPDF_GSSB(year, month, officeTypeId, bankName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#PersonToContactFromBank_Code").blur(function () {
            $("#PersonToContactFromBankDetail").html("");
            var data = JSON.stringify({ Code: $("#PersonToContactFromBank_Code").val() });
            Req.POST.GetEmployeeShortInfoByCode(data, function (response) {
                if (response.EmployeeId == 0) {
                    $("#PersonToContactFromBankId").val(0);
                    $("#PersonToContactFromBankDetail").html("");
                    return;
                }
                $("#PersonToContactFromBankId").val(response.EmployeeId);
                var Html = "Name: <b>" + response.EmployeeName + "</b>, " +
                    "Office: <b>" + response.OfficeName + "</b>, " +
                    "Department: <b>" + response.DepartmentName + "</b>, " +
                    "DesignationName: <b>" + response.DesignationName + "</b>";
                $("#PersonToContactFromBankDetail").html(Html);
            }, function () {
                $("#PersonToContactFromBankId").val(0);
            });
        });

    });


    var Req = {
        POST: {
            GetEmployeeShortInfoByCode: function (Data, callback, err_callback) {
                $.ajax({
                    url: '/Employee/GetEmployeeShortInfoByCode',
                    type: 'Post',
                    data: Data,
                    dataType: 'json',
                    async: true,
                    contentType: 'application/json',
                    success: function (response) {

                        if (!response.success) {
                            $.alert.open("Error", response.message);
                            if (null != err_callback) { err_callback(); }
                            return;
                        }
                        if (null != callback) { callback(response.data); }
                    },
                    error: function (data, textStatus, jqXHR) {
                        $.alert.open("Error", data + ": " + textStatus + ": " + jqXHR, 'Error!!!');
                        if (null != err_callback) { err_callback(); }
                    }
                });
            }
        }
    };

</script>

