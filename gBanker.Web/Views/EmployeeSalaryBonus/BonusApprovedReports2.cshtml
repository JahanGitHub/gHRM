                                <label class="control-label col-md-4">Bank Name</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.BankCode, Model.BankList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>


                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4">Bank Branch</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.ZoneList, Model.ZoneList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>

                    </div>


                    <div class="row">

                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4">Account</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.AreaList, Model.AreaList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>


                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4">Date</label>
                                <div class="col-sm-8">
                                    <input type="text" id="Process1Date" class="form-control" />
                                </div>
                            </div>
                        </div>

                    </div>


                    <div id="PersonToContactFromBankContainer" class="row" >
