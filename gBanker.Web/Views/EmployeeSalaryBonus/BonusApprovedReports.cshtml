@model gHRM.Web.ViewModels.Payroll.EmployeeSalaryBonusViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeSalaryBonus">Employee Salary Bonus</a></li>
        <li><a href="/EmployeeSalaryBonus/BonusApprovedReports">BonusApprovedReports</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Employee Salary Bonus";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    function PrintBonusBankSummaryReportBeforeApproval(year, month, officeTypeId, bankName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportBeforeApproval?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintBonusBankSummaryReportBeforeApprovalPDF(year, month, officeTypeId, bankName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportBeforeApprovalPDF?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintBonusBankSummaryReportAfterApproval(year, month, officeTypeId, bankName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportAfterApproval?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintBonusBankSummaryReportAfterApprovalPDF(year, month, officeTypeId, bankName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportAfterApprovalPDF?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    // GSSB
    function PrintBonusBankSummaryReportBeforeApprovalPDF_GSSB(year, month, officeTypeId, bankName) {
        url = '/EmployeeSalaryBonus/PrintBonusBankSummaryReportBeforeApprovalForGSSBPDF?Year=' + year + '&Month=' + month + '&OfficeTypeId=' + officeTypeId + '&BankName=' + bankName;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }



    $(document).ready(function () {
        $("#ZoneDiv").hide();

        $("#OfficeTypeId").change(function () {
            var OfficeTypeId = $("#OfficeTypeId").val();
            if (OfficeTypeId == 4) {
                $("#ZoneDiv").show();
            } else {
                $("#ZoneDiv").hide();
            }
        });

      
        $("#Process1Date").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: "1920:2100"
          });

        $("#Process1Date").datepicker('setDate', new Date());


        $("#btnBonusAtBankBeforeApprovalExcel").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportBeforeApproval(year, month, officeTypeId, bankName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#btnBonusAtBankBeforeApprovalPDF").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportBeforeApprovalPDF(year, month, officeTypeId, bankName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#btnBonusAtBankAfterApprovalExcel").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportAfterApproval(year, month, officeTypeId, bankName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

        $("#btnBonusAtBankAfterApprovalPDF").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportAfterApprovalPDF(year, month, officeTypeId, bankName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });


        //GSSB 
        $("#btnBonusAtBankBeforeApprovalPDFGSSB").click(function () {
            var year = $("#Year1").val();
            var month = $("#Month1").val();
            var bankName = $("#BankCode").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            if (year != "" && year != '0' && month != "" && month != '0' && bankName != "") {
                PrintBonusBankSummaryReportBeforeApprovalPDF_GSSB(year, month, officeTypeId, bankName);
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });



    });

</script>

<h2 class="page-title">Bonus at Bank</h2>
&nbsp;

@using (Html.BeginForm())
{
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container-fluid">

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Office Type</label>
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.OfficeTypeId, Model.OfficeTypeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6" id="ZoneDiv">
                    <div class="form-group">
                        <label class="control-label col-md-4">Zone Name</label>
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.ZoneId, Model.ZoneList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div id="MonthlySalaryProcess">

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4"> Year</label>
                                <div class="col-md-8">
                                    @*<input type="number" id="SalaryYear" value="1987" class="form-control" />*@
                                    @Html.DropDownList("Years", null, new { @ID = "Year1", @class = "form-control" })
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4"> Month</label>
                                <div class="col-md-8">
                                    @*<input type="number" id="SalaryMonth" value="1" class="form-control" />*@
                                    @Html.DropDownList("Months", null, new { @ID = "Month1", @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4">Date</label>
                                <div class="col-sm-8">
                                    <input type="text" id="Process1Date" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-md-4">Bank Name</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.BankCode, Model.BankList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <div class="form-group" style="margin:5px;">
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Bonus At Bank Before Approval (Excel)" id="btnBonusAtBankBeforeApprovalExcel" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Bonus At Bank Before Approval (PDF)" id="btnBonusAtBankBeforeApprovalPDF" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Bonus At Bank After Approval (Excel)" id="btnBonusAtBankAfterApprovalExcel" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Bonus At Bank After Approval (PDF)" id="btnBonusAtBankAfterApprovalPDF" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp; <br />
                                <input type="button" value="Bonus At Bank Before Approval (PDF) For Test" id="btnBonusAtBankBeforeApprovalPDFGSSB" class="btn btn-success" style="margin-top:10px; margin-left:10px;" />

                            </div>
                        </div>
                    </div>
                    @*<div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label col-md-4">Summary</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.SummaryType, Model.SummaryList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label col-md-4">Report</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.ReportType, Model.ReportList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>*@
                </div> <!--New Div-->
                @*<div id="grid">
                        <h4><label id="beforeApprovalLbl">Before Approval</label></h4>
                    </div>*@
                <br />


            </div> <!-- End of Monthly Salary Process -->


        </div>

    </div> <!--Main Container Fluid-->


    <!--Form Horizontal-->
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


