                    };
                    url = '/EmployeeSalaryBonus/BonusRejectedReportAfterSendForApprovalPdf?ComponentName=' + obj.ComponentName + '&Year=' + obj.SalaryYear + '&Month=' + obj.SalaryMonth + '&officeId=' + officeId + '&OfficeTypeId=' + OfficeTypeId;
                    PrintReport(url);
