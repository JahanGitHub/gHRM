@model gHRM.Web.ViewModels.Payroll.EmployeeSalaryBonusViewModel
@{
    ViewBag.Title = "AttendancePenaltyLeaveDeduction";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var pvOfficeNevigation = new gHRM.Web.ViewModels.OfficeNevigationPartialViewModel();
    pvOfficeNevigation.OfficeTypeList = Model.OfficeTypeList;
    pvOfficeNevigation.ZoneList = Model.ZoneList;
    pvOfficeNevigation.AreaList = Model.AreaList;
    pvOfficeNevigation.UnitList = Model.UnitList;
}

<script>

    $(document).ready(function () {
        $(".divUpdate").hide();
        $("#btnPrint").hide();
        $("#btnExelPrint").hide();

        function CheckRequiredFieldvalidation() {
            var ComponentName = $("#ComponentName").val();
            var year = $("#SalaryYear").val();
            var month = $("#SalaryMonth").val();           
            var revStampDeduction = $("#RevStampDeduction").val();

            var object = {};

            if (ComponentName != "" && year != "" && month != "") {
                object = {
                    ComponentName: ComponentName,
                    SalaryYear: year,
                    SalaryMonth: month,
                    RevStampDeduction: revStampDeduction ? revStampDeduction : 0
                }

                return object;
            }
        }

        $("#btnViewBonus").click(function () {

            var obj = CheckRequiredFieldvalidation();
            if (obj != null) {
                ViewBonusInGrid();
            } else {
                $.alert.open("Error", "Please insert required fields");
            }
        });


        $("#btnGenerateBonus").click(function () {
            var obj = CheckRequiredFieldvalidation();
            if (obj != null) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    async: true,
                    cache: false,
                    url: '@Url.Action("SaveEmployeeSalaryBonus", "EmployeeSalaryBonus")',
                    data: JSON.stringify({ obj: obj }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        $('#AjaxLoader').hide();
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });

            } else {
                $.alert.open("Error", "Please insert required fields");
            }

        });

        $("#btnSendForApproval").click(function () {

            var obj = CheckRequiredFieldvalidation();
            if (obj != null) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    async: true,
                    cache: false,
                    url: '@Url.Action("SendForApproval", "EmployeeSalaryBonus")',
                    data: JSON.stringify({ obj: obj }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        $('#AjaxLoader').hide();
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            ViewBonusInGrid();
                        } else {
                            $.alert.open("Error", data.message);
                        }
