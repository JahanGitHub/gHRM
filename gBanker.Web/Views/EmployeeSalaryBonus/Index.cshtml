    function PrintReport(PrintUrl) {
        var url;
        url = PrintUrl;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
        //window.location.href = "/LeaveHistory/Index";
    }


    function ViewBonusInGrid() {

        var componentName = $("#ComponentName").val();
        var year = $("#SalaryYear").val();
        var month = $("#SalaryMonth").val();

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetGeneratedBonus", "EmployeeSalaryBonus", "http")',
                    dataType: 'json',
                    data: function () {
                        return {
                            componentName: componentName, year: year, month: month
                        };
                    }
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            // height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "ESBonusId",
                     hidden: true,
                     filterable: false
                 },

                  {
                      width: "150px",
                      field: "EmployeeId",
                      hidden: true,
                      filterable: true,
                      title: "EmployeeId",
                      //locked: true
                  },

                 {
                     field: "rowSl",
                     title: "Sl No.",
                     width: "20px",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                     //locked: true,
                     //lockable: false,
                 },

                 {
                     width: "40px",
                     field: "EmployeeCode",
                     title: "Employee Code",
                     //locked: true
                 },
                {
                    width: "80px",
                    field: "EmployeeName",
                    title: "EmployeeName",
                    //locked: true
                },

                {
                    width: "100px",
                    hidden: true,
                    field: "ComponentId",
                    title: "Component Id"
                },

                {
                    width: "100px",
                    hidden: true,
                    field: "ComponentName",
                    title: "Component Id"
                },

                 {
                     width: "80px",
                     hidden: true,
                     field: "DesignationName",
                     title: "Designation Name"
                 },

                 {
                     width: "80px",
                     field: "DepartmentName",
                     title: "Department Name"
                 },

                  {
                      width: "50px",
                      field: "BonusAmount",
                      title: "Bonus Amount"
                  },
                  {
                      width: "40px",
                      field: "RevStampDeduction",
                      title: "RevStamp"
                  },
                  {
                      width: "80px",
                      field: "BonusProcessingDate",
                      title: "Bonus Processing Date"
                  },

                 {
                     width: "50px",
                     title: 'Edit',
                     template: function (dataItem) {
                         return '<div class="text-center"><a href="#" OnClick="EditGrid(' + "'" + dataItem.ESBonusId + "'" + ',' + "'" + dataItem.EmployeeId + "'" + ',' + "'" + dataItem.ComponentId + "'" + ',' + "'" + dataItem.BonusAmount + "'" + ',' + "'" + dataItem.SalaryYear + "'" + ',' + "'" + dataItem.SalaryMonth + "'" + ',' + "'" + dataItem.BonusProcessingDate + "'" + ',' + "'" + dataItem.EmployeeName + "'" + ',' + "'" + dataItem.ComponentName + "'" + ',' + "'" + dataItem.RevStampDeduction + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                     }
                 },
                 {
                     width: "50px",
                     title: 'Hold',
                     template: function (dataItem) {
                         return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + dataItem.ESBonusId + ');"><i class="fa fa-pause"></i></a></div>';
                     }
                 }
            ]
        });
    }




    function EditGrid(ESBonusId, EmployeeId, ComponentId, BonusAmount, SalaryYear, SalaryMonth, BonusProcessingDate, EmployeeName, ComponentName, RevStampDeduction) {
        debugger;

        $(".divUpdate").show();
        $(".divSave").hide();
        $("#ESBonusId").val(ESBonusId);
        $("#EmployeeId").val(EmployeeId);
        $("#EmployeeName").val(EmployeeName);
        $("#ComponentId").val(ComponentId);
        $("#ComponentNameMsg").val(ComponentName);
        $("#BonusAmount").val(BonusAmount);
        $(".RevStampDeduction").val(RevStampDeduction);
        $("#SalaryYear").val(SalaryYear);
        $("#SalaryMonthMsg").val(SalaryMonth);
        $("#SalaryYearMsg").val(SalaryYear);
        $("#BonusProcessingDate").val(BonusProcessingDate);

    }

    function UpdateEmployeeSalaryBonus() {
        var bonusId = $("#ESBonusId").val();
        var bonusAmt = $("#BonusAmount").val();
        var revStampDeduction = $(".RevStampDeduction").val();

        var obj = {
            ESBonusId: bonusId,
            BonusAmount: bonusAmt,
            revStampDeduction: revStampDeduction
        }

        $('#AjaxLoader').show();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateEmployeeSalaryBonus", "EmployeeSalaryBonus")',
            data: JSON.stringify({ obj: obj }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $('#AjaxLoader').hide();
                if (data.result == 1) {
                    $.alert.open("Success", data.message);
                    //$('#grid').jtable('load');
                    ViewBonusInGrid();
                } else {
                    $.alert.open("Error", data.message);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function InformationDelete(ESBonusId) {
        $.alert.open('confirm', 'Are you sure you want to hold this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteEmployeeSalaryBonus", "EmployeeSalaryBonus", "http")',
                    data: { ESBonusId: ESBonusId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            ViewBonusInGrid();
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    };

</script>

