                    url = '/EmployeeSalaryBonus/BonusRejectedReportBeforeSendForApprovalPdf?ComponentName=' + obj.ComponentName + '&Year=' + obj.SalaryYear + '&Month=' + obj.SalaryMonth + '&officeId=' + officeId + '&OfficeTypeId=' + OfficeTypeId;
