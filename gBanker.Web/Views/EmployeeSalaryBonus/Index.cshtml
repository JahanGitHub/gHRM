                    };
                    url = '/EmployeeSalaryBonus/BonusReportBeforeSendForApprovalExel?ComponentName=' + obj.ComponentName + '&Year=' + obj.SalaryYear + '&Month=' + obj.SalaryMonth + '&officeId=' + officeId + '&OfficeTypeId=' + OfficeTypeId;
                    PrintReport(url);
                } else {
                    $.alert.open("Error", "Please insert required fields");
                }
            }
            if (type == "5") {
                var obj = CheckRequiredFieldvalidation();
                if (obj != null) {
                    var office_TypeId = $("#OfficeTypeId").val();
                    if (office_TypeId == 1) {
                        OfficeTypeId = office_TypeId;
                        officeId = $("#PVHeadOfficeId").val();
                    } else if (office_TypeId == 3) {
                        OfficeTypeId = office_TypeId;
                        officeId = $("#PVProjectId").val();
                    }
                    else if (office_TypeId == 4) {
