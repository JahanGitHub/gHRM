
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        getOverTimeNotPaidList();
    });

    ////// Kendo Grid Integration

    function getOverTimeNotPaidList() {
        $('#gridKendo').html("");
        dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    //url: baseURL + '/ProcessCategory/GetProcessCategoryList?QueryOption=' + 1,
                    url: '@Url.Action("getOvertimeNotPaid", "OvertimeBill", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "EmployeeCode",
                     title: "Employee Code.",
                     width: "20px",
                     filterable: false,
                 },
                {
                    field: "TotalWorkHour",
                    title: "Total Work Hour",
                    width: "20px",
                    filterable: true,
                },
                {
                    field: "TotalOTHour",
                    title: "Total OT THour",
                    width: "20px",
                    filterable: true,
                },
                {
                    field: "TotalOTAmount",
                    title: "Total OT Amount",
                    width: "20px",
                    filterable: true,
                },
                 {
                     title: "Remark",
                     width: "30px",
                     template: function (dataItem) {
                         if (dataItem.IsAmountPaid == true) {
                             return '<div class="text-center"><label>' + dataItem.Id + '</label></div>';
                         } else {
                             return '<div class="text-center"><input type="text" id="txtRemarks' + dataItem.Id + '"></input></div>';
                         }
                         // return "<a href='#' OnClick='RegisterResetPassword(" + '"' + dataItem.Id + '"' + ");'><i class='fa fa-pencil-square-o'></i></a>";
                     }
                 },
                  {
                      title: "Approved",
                      width: "20px",
                      template: function (dataItem) {
                          if (dataItem.IsAmountPaid != true) {
                              return '<div class="text-center"><a href="#" OnClick="PayOvertime(' + dataItem.Id + ');"><i class="fa fa-check"></i></a></div>';
                          }
                          // return '<a href="/OvertimeBill/Approved/' + dataItem.Id + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '><i class="fa fa-trash-o"></i></a>';
                          // return "<a href='#' OnClick='OfficeDelete(" + dataItem.OfficeId + ");'><i class='fa fa-trash-o'></i></a>";
                      }
                  },
                 {
                     title: "Reject",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.IsAmountPaid != true) {
                             return '<div class="text-center"><a href="#" OnClick="RejectOvertime(' + dataItem.Id + ');"><i class="fa fa-trash-o"></i></a></div>';
                         }
                         //return '<a href="/OvertimeBill/Delete/' + dataItem.Id + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '><i class="fa fa-trash-o"></i></a>';
                         // return "<a href='#' OnClick='OfficeDelete(" + dataItem.OfficeId + ");'><i class='fa fa-trash-o'></i></a>";
                     }
                 }
            ]
        });
    }

    ////// Kendo Grid Integration END

    function PayOvertime(id) {

        var Remarks = $("#txtRemarks" + id).val();

        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("PayOvertime", "OvertimeBill", "http")',
            data: JSON.stringify({ 'id': id, 'Remarks': Remarks }),
            dataType: 'json',
            async: true,
            success: function (data) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
                getOverTimeNotPaidList();
            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }

    function RejectOvertime(id) {
        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("RejectOvertime", "OvertimeBill", "http")',
            data: JSON.stringify({ 'id': id }),
            dataType: 'json',
            async: true,
            success: function (data) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
                getOverTimeNotPaidList();
            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }


</script>


<div class="row">
    <h2 class="page-title">Overtime Not paid List</h2>
</div>

@using (Html.BeginForm("Index", "OvertimeBill", FormMethod.Get, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-horizontal">
            <hr />
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
}




