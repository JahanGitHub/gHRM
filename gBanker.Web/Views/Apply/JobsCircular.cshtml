@model gHRM.Web.ViewModels.Apply.JobsCircularViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Apply/JobsCircular">JobsCircular</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "JobsCircular";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

}

<script src="~/Scripts/siteJs.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<style>
    @@import url('//netdna.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css');

    .frmRow {
        margin-bottom: 10px;
    }

    .accordion-toggle:after {
        font-family: 'FontAwesome';
        content: "\f078";
        float: right;
    }

    .accordion-opened .accordion-toggle:after {
        content: "\f054";
    }


    .k-grid-header, .k-grid-header .k-header {
        /*      background-color: #00a65a;*/
        color: red;
        font-size: 13px;
        font-weight: 600
    }
</style>



<script type="text/javascript">

    function clearData() {
        //$("#OfficeTypeId").val("").trigger('change');
        $("#PostName").val("");
        $("#PostDescription").val("");
        $("#PDF").val("");
    }

    function showPdf(fileInput) {
        var files = fileInput.files;
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var Type = /.pdf/;

            if (file.type.match(Type)) {
                var size = Math.round(file.size / 1024);
                if (size <= 600) {
                    var img = document.getElementById("thumbnil");
                    img.file = file;
                    var reader = new FileReader();
                    reader.onload = (function (aImg) {
                        return function (e) {
                            aImg.src = e.target.result;
                        };
                    })(img);
                    reader.readAsDataURL(file);
                }
                else
                    alert('file cannot be greater than 50 KB.');
            }
            else {
                $("#PDF").replaceWith($("#PDF").clone(true));
                alert('Please select a valid PDF file');
            }
        }
    }

    function SaveInfo() {
      var PostName = $("#PostName").val();
      var PostDescription = $("#PostDescription").val();
      var JobId = $("#JobId").val();


        var img = document.getElementById("PDF").value;

            $.ajax({
                type: "POST",
                dataType: "json",
                async: false,
                cache: false,
                url: '@Url.Action("SaveJobsCircular", "Apply")',
                data: JSON.stringify({ PostName: PostName, PostDescription: PostDescription, JobId: JobId }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    if (data.result > 0) {
                        var ID = data.result;
                        var xhr = new XMLHttpRequest();
                        var fd = new FormData();
                        fd.append("file", document.getElementById("PDF").files[0]);
                        fd.append("ID", ID);
                        xhr.open("POST", "/Apply/UploadPdf/", true);
                        xhr.send(fd);
                        xhr.addEventListener("load", function (event) {
                            if (event.target.response > 0) {
                                $(".panel-body .create-success").show(800).fadeToggle(3000);
                            } else {
                                $.alert.open("Error", "Image couldn't Save");
                            }
                        }, false);

                        $.alert.open('Success', data.message);
                        location.href = "/Apply/JobsCircular"
                    } else {
                        $.alert.open('Error', data.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert(error);
                }
            });
    }
    $(document).ready(function () {
        //CheckInputLengthLessOrEqual("#Phone", "11");

        GetJobsCircularInfoDashBoard();

        $(function () { // will trigger when the document is ready
            $('.datepicker').datepicker(); //Initialise any date pickers
        });


    });

    function GetJobsCircularInfoDashBoard() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetJobsCircularByCreatedId", "Apply", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "JobId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "50px",
                    filterable: false,
                },
                {
                    field: "PostName",
                    title: "Post Name",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "PostDescription",
                    title: "Post Description",
                    width: "100px",
                    filterable: true,
                },

                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.JobId > 0) {
                             return "<a href='/Apply/JobsCircular/?Id=" + dataItem.JobId + "'><i class='fa fa-pencil-square-o'></i></a>";
                         } else {
                             return "";
                         }
                     }
                 },
            {
                title: "Delete",
                width: "25px",
                template: function (dataItem) {
                    if (dataItem.JobId > 0) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + dataItem.JobId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    } else {
                        return "";
                    }
                }
            }
            ]
        });
    }

     function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteJobCircularInfo", "Apply", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open(data.message);
                            GetJobsCircularInfoDashBoard();
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


</script>


