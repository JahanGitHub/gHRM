@using (Html.BeginForm("JobsCircular", "Apply", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "References" }))

{
    @Html.AntiForgeryToken()

    if(ViewBag.IsPDF ==1)
    {
        ViewBag.label = "Want to change Uploaded PDF";
    }
    else
    {
        ViewBag.label = "Upload PDF";
    }
    <form id="InputForm">
        <div class="container-fluid">
            <button class='togglePersonalInfo btn btn-success col-sm-offset' style="width:340px">Jobs Circular</button>
            <fieldset>
                <input type="hidden" id="ApplicantId" value="@ViewBag.ApplicantId" />
                <legend>jobs Circular</legend>
                <div class="">
                    @*@Html.Partial("~/Views/Shared/_OfficeNevigationPane.cshtml", pvOfficeNevigation)*@

                    @*<hr/>*@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(m => m.JobId)
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.PostName, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.PostName, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.PostName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.PostDescription, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.PostDescription, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.PostDescription, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                   
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.Label((string)ViewBag.label, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.PDF, new
                                    {
                                        type = "file",
                                        @id = "PDF",
                                   @onchange = "showPdf(this);",
                                        @class = "form -control"
                                    })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </fieldset>
        </div>
    </form>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                &nbsp;
                <button type="button" id="btnSave" class="btn btn-success btn-sm" style="float:right;" onclick="SaveInfo()"><i class="fa fa-check-circle-o"></i> Save</button>
            </div>
        </div>
    </div>

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-horizontal">
            <hr />
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}










