<script type="text/javascript">

    function InputShowHide(allInputList, targetInputList) {
        for (var i = 0; i < allInputList.length; i++) {
            var element = allInputList[i];
            if (targetInputList.includes(element)) {
                $(element).show();
            } else {
                $(element).hide();
            }
        }
    }
    function clearData() {
        $("#OfficeTypeId").val("").trigger('change');
        $("#ZoneCode").val("").trigger('change');
        //$("#OfficeTypeId").val("").trigger('change');
        $("#OfficeCode").val("");
        $("#OfficeName").val("");
        $("#OfficeNameBn").val("");
        $("#DateofBirth").datepicker('setDate', new Date());
        $("#OfficeAddress").val("");
        $("#Phone").val("");
        $("#Email").val("");
    }

    function test() {
        location.href = "/Apply/Info?AppplicantId=" + 4;
    }

    $(document).ready(function () {
        //CheckInputLengthLessOrEqual("#Phone", "11");

        $("#Phone").blur(function () {
            var phoneNo = $("#Phone").val();
            if (phoneNo != "" && phoneNo != '' && phoneNo != null && phoneNo.length > 0) {
                if (phoneNo.length != 11) {
                    $.alert.open("Alert", "Phone number must be 11 digit");
                    $("#Phone").val('');
                }
                else {
                    return false;
                }
                //CheckInputLengthEqual("#Phone", "11");
            }
        });


        $("#DateofBirth").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:2025",
        });
        $("#btnSave").click(function (e) {
            e.preventDefault();
            debugger;

            var FirstName = $("#FirstName").val();
            var LastName = $("#LastName").val();
            var FatherName = $("#FatherName").val();
            var MotherName = $("#MotherName").val();
            var GuardianName = $("#GuardianName").val();
            var DateofBirth = $("#DateofBirth").val();
            var Gender = $("#Gender").val();
            var Religion = $("#Religion").val();
            var MaritalStatus = $("#MaritalStatus").val();
            var Nationality = $("#Nationality").val();
            var NationalId = $("#NationalId").val();
            var PassportNumber = $("#PassportNumber").val();
            var PrimaryMobile = $("#PrimaryMobile").val();
            var SecondaryMobile = $("#SecondaryMobile").val();
            var BloodGroup = $("#BloodGroup").val();
            //if ($("#OfficeLocationId").val() == "") {
            //    $.alert.open("Error", "Please Insert Office Location.");
            //    return false;
            //}
            //if (officeTypeId == 5) {
            //    if ($("#ZoneCode").val() == "") {
            //        $.alert.open("Error", "Please Insert Zone Name");
            //        return false;
            //    }
            //} else if (officeTypeId == 6) {
            //    if ($("#ZoneCode").val() == "") {
            //        $.alert.open("Error", "Please Insert Zone Name");
            //        return false;
            //    }
            //    if ($("#AreaCode").val() == "") {
            //        $.alert.open("Error", "Please Insert Area Name");
            //        return false;
            //    }
            //}

            /*if (officeCode != "" && officeName != "" && officeNameBn != "" && OfficeLocationId != "") {*/
            $('#AjaxLoader').show();
            $.ajax({
                type: "GET", //GET or POST or PUT or DELETE verb
                url: '/Apply/SavePersonalInfo', // Location of the service
                data: {
                    FirstName: FirstName, LastName: LastName, FatherName: FatherName, MotherName: MotherName, GuardianName: GuardianName, DateofBirth: DateofBirth, Gender: Gender,
                    Religion: Religion, MaritalStatus: MaritalStatus, Nationality: Nationality, NationalId: NationalId, PassportNumber: PassportNumber, PrimaryMobile: PrimaryMobile, SecondaryMobile: SecondaryMobile,
                    BloodGroup: BloodGroup
                }, //Data sent to server
                dataType: "json", //Expected data format from server
                processdata: false, //True or False
                success: function (data) { //On Successful service call
                    $('#AjaxLoader').hide();
                    $.alert.open("Alert", data.message);
                    clearData();
                },
                error: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
            //} else {
            //    $.alert.open("Error", "Please Insert required fields");
            //}

        });
        $("#btnEdit").click(function (e) {
            e.preventDefault();
            debugger;

            var ApplicantId =3;
  
            //if ($("#OfficeLocationId").val() == "") {
            //    $.alert.open("Error", "Please Insert Office Location.");
            //    return false;
            //}
            //if (officeTypeId == 5) {
            //    if ($("#ZoneCode").val() == "") {
            //        $.alert.open("Error", "Please Insert Zone Name");
            //        return false;
            //    }
            //} else if (officeTypeId == 6) {
            //    if ($("#ZoneCode").val() == "") {
            //        $.alert.open("Error", "Please Insert Zone Name");
            //        return false;
            //    }
            //    if ($("#AreaCode").val() == "") {
            //        $.alert.open("Error", "Please Insert Area Name");
            //        return false;
            //    }
            //}

            /*if (officeCode != "" && officeName != "" && officeNameBn != "" && OfficeLocationId != "") {*/
            $('#AjaxLoader').show();
            $.ajax({
                type: "GET", //GET or POST or PUT or DELETE verb
                url: '/Apply/Info', // Location of the service
                data: {
                    AppplicantId: ApplicantId
                }, //Data sent to server
                dataType: "json", //Expected data format from server
                processdata: false, //True or False
                success: function (data) { //On Successful service call
                    $('#AjaxLoader').hide();
                    $.alert.open("Alert", data.message);
                    clearData();
                },
                error: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
            //} else {
            //    $.alert.open("Error", "Please Insert required fields");
            //}

        });

    });


</script>
