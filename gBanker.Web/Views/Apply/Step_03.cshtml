<script type="text/javascript">

    function clearData() {
        //$("#OfficeTypeId").val("").trigger('change');
        $("#Id").val("");
        $("#CompanyName").val("");
        $("#CompanyBusiness").val("");
        $("#Designation").val("");
        $("#AreaofExperiences").val("");
        $("#Responsibilities").val("");
        $("#CompanyLocation").val("");
        $("#JobStartDateMsg").val("");
        $("#JobEndDateMsg").val("");

    }

    function Step_04() {
        location.href = "/Apply/Step_04"
    }
    function Step_02() {
        location.href = "/Apply/Step_02"
    }
    $(document).ready(function () {
        //CheckInputLengthLessOrEqual("#Phone", "11");

        GetJobExperienceInfoDashBoard();

        $(function () { // will trigger when the document is ready
            $('.datepicker').datepicker(); //Initialise any date pickers
        });
        $("#btnSave").click(function (e) {
            e.preventDefault();

            debugger;

            var Id = $("#Id").val();
            var CompanyName = $("#CompanyName").val();
            var CompanyBusiness = $("#CompanyBusiness").val();
            var Designation = $("#Designation").val();
            var AreaofExperiences = $("#AreaofExperiences").val();
            var Responsibilities = $("#Responsibilities").val();
            var CompanyLocation = $("#CompanyLocation").val();
            var JobStartDateMsg = $("#JobStartDateMsg").val();
            var JobEndDateMsg = $("#JobEndDateMsg").val();
            var Continuing = $('#continuing').val();

            if ($("#CompanyName").val() == "" || $("#Designation").val() == "" || $("#AreaofExperiences").val() == "" || $("#JobStartDateMsg").val() == "") {
                $.alert.open("Error", "Please Insert Required fields");
                return false;
            }

            $('#AjaxLoader').show();
            $.ajax({
                type: "GET", //GET or POST or PUT or DELETE verb
                 url: '/Apply/SaveJobExperienceInfo',
                data: {
                    Id: Id, CompanyName: CompanyName, CompanyBusiness: CompanyBusiness,
                    Designation: Designation, AreaofExperiences: AreaofExperiences, JobStartDateMsg: JobStartDateMsg, JobEndDateMsg: JobEndDateMsg,
                    Responsibilities: Responsibilities, CompanyLocation: CompanyLocation, Continuing: Continuing
                },
                dataType: "json", //Expected data format from server
                processdata: false, //True or False
                success: function (data) { //On Successful service call
                    $('#AjaxLoader').hide();
                    $.alert.open("Alert", data.message);
                    clearData();
                    GetJobExperienceInfoDashBoard();
                },
                error: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
            //} else {
            //    $.alert.open("Error", "Please Insert required fields");
            //}

        });

    });

    function GetJobExperienceInfoDashBoard() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetJobExperienceInfo", "Apply", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "Id",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "50px",
                    filterable: false,
                },
                {
                    field: "CompanyName",
                    title: "Company Name",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "Designation",
                    title: "Designation",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "AreaofExperiences",
                    title: "Area of Experiences",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "Responsibilities",
                    title: "Responsibilities",
                    width: "120px",
                    filterable: false,
                },

                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.Id > 0) {
                             return "<a href='/Apply/Step_03/?Id=" + dataItem.Id + "'><i class='fa fa-pencil-square-o'></i></a>";
                         } else {
                             return "";
                         }
                     }
                 },
            {
                title: "Delete",
                width: "25px",
                template: function (dataItem) {
                    if (dataItem.Id > 0) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + dataItem.Id + ');"><i class="fa fa-trash-o"></i></a></div>';
                    } else {
                        return "";
                    }
                }
            }
            ]
        });
    }

     function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteJobExperience", "Apply", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open(data.message);
                            GetJobExperienceInfoDashBoard();
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


</script>


