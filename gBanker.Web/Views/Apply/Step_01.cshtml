    function showImage(fileInput) {
        $("#blaImage").show();
        $("#imgApplicant").hide();
        var files = fileInput.files;
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var imageType = /image.*/;

            if (file.type.match(imageType)) {
                var size = Math.round(file.size / 1024);
                if (size <= 50) {
                    var img = document.getElementById("thumbnil");
                    img.file = file;
                    var reader = new FileReader();
                    reader.onload = (function (aImg) {
                        return function (e) {
                            aImg.src = e.target.result;
                        };
                    })(img);
                    reader.readAsDataURL(file);
                }
                else
                    alert('Image file cannot be greater than 50 KB.');
            }
            else {
                $("#Image").replaceWith($("#Image").clone(true));
                alert('Please select a valid image file');
            }
        }
    }

    function showCoverLetter(fileInput) {
        var files = fileInput.files;
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var Type = /.pdf/;

            if (file.type.match(Type)) {
                var size = Math.round(file.size / 1024);
                if (size <= 600) {
                    var img = document.getElementById("thumbnil");
                    img.file = file;
                    var reader = new FileReader();
                    reader.onload = (function (aImg) {
                        return function (e) {
                            aImg.src = e.target.result;
                        };
                    })(img);
                    reader.readAsDataURL(file);
                }
                else
                    alert('file cannot be greater than 50 KB.');
            }
            else {
                $("#PDF").replaceWith($("#PDF").clone(true));
                alert('Please select a valid PDF file');
         
                $("#ExtraCoverLetter").val("");
                $("#AttachedCV").val("");
            }
        }
    }

    function SaveCoverLetter() {
             var ID = $("#ID").val();

             if (ID > 0) {
                 var CoverLetter = document.getElementById("CoverLetter").value;

            $.ajax({
                type: "POST",
                dataType: "json",
                async: false,
                cache: false,
                url: '@Url.Action("SavedApplicantModel", "Apply")',
                data: JSON.stringify({ AppplicantId: ID }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    if (data.result > 0) {
                        var ID = data.result;
                        var xhr = new XMLHttpRequest();
                        var fd = new FormData();
                        fd.append("file", document.getElementById("CoverLetter").files[0]);
                        fd.append("ID", ID);
                        xhr.open("POST", "/Apply/UploadCoverLetter/", true);
                        xhr.send(fd);
                        xhr.addEventListener("load", function (event) {
                            if (event.target.response > 0) {
                                $(".panel-body .create-success").show(800).fadeToggle(3000);
                            } else {
                                $.alert.open("Error", "CoverLetter couldn't Save");
                            }
                        }, false);

                        $.alert.open('Success', data.message);
                        $("#ÄpplyforJobs").hide();
                    } else {
                        $.alert.open('Error', data.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert(error);
                }
            });
        } else {
                 $.alert.open("Please Save Personal Details First");
        }
    }

