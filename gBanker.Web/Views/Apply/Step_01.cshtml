    function SubmitApplication() {

        debugger;

        var JobId = $('#JobId').val();

        if (JobId == "") {
            $.alert.open("Error", "Please Apply again from Job Apply Menu");
            return false;
        }

        var QAnswerList = [], obj,
            count = 1;

        $('#AdderTable tr').each(function () {
            var cID = $(this).find("td:eq(1) input").attr("id").match(/\d+/);
            obj = {};
            obj["QId"] = $("#QId" + cID).val();
            obj["QAnswer"] = $("#QAnswer" + cID).val();

            QAnswerList.push(obj);
            count = count + 1;
        });
        var val = [];
        var i = 0;

        $('input[name="locationthemes"]:checked').each(function () {
            /*          console.log(this.value);*/
            val.push($(this).val());
        });

        if (val[0] != 1 && val[1] != 1) {
            $.alert.open("Error", "Please Complete your profile & Cover letter then Apply again from Job Apply Menu");
            return false;
        }
        else {
            $('#AjaxLoader').show();
            $.ajax({
                type: "POST", //GET or POST or PUT or DELETE verb
                url: '/Apply/SubmitApplication',
                data: {
                    JobId: JobId, 'QAnswerList': QAnswerList
                },
                dataType: "json", //Expected data format from server
                processdata: false, //True or False
                success: function (data) { //On Successful service call
                    $('#AjaxLoader').hide();
                    $("#ÄpplyforJobs").hide();
                    Swal.fire({
                        icon: 'success',
                        html: '<b>'+ data.message + '</b>',
                        type: "success"
                    }).then(function () {
                        window.location = "/Apply/ApplyJobs";
                    });
                },
                error: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
        }
    }

