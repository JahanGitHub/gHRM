@model gHRM.Web.ViewModels.Apply.ApplicantAccademicViewModel
@*  *@
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Apply/Step_01">Apply</a></li>
        <li><a href="/Apply/Step_01">PersonalInformation</a></li>
        <li><a href="/Apply/Step_02">AccademicInformation</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Accademic Information";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

}

<script src="~/Scripts/siteJs.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<style>
    @@import url('//netdna.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css');

    .frmRow {
        margin-bottom: 10px;
    }

    .accordion-toggle:after {
        font-family: 'FontAwesome';
        content: "\f078";
        float: right;
    }

    .accordion-opened .accordion-toggle:after {
        content: "\f054";
    }


    .k-grid-header, .k-grid-header .k-header {
        /*    background-color: #00a65a;*/
        color: red;
        font-size: 13px;
        font-weight: 600
    }
</style>



<script type="text/javascript">

  
    function clearData() {
        $("#LevelofEducationId").val("").trigger('change');
        $("#ExamTitleId").val("").trigger('change');
        $("#ID").val("");
        $("#InstituteName").val("");
        $("#ResultType").val("");
        $("#Group").val("");
        $("#CompanyLocation").val("");
        $("#CGPA").val("");
        $("#Scale").val("");
        $("#YearsofPassingMsg").val("");
        $("#Duration_Years").val("");

    }

    function Step_03() {
        location.href = "/Apply/Step_03"
    }
    function Step_01() {
        location.href = "/Apply/Step_01"
    }
    $(document).ready(function () {
        //CheckInputLengthLessOrEqual("#Phone", "11");

        GetAccademicInfoDashBoard();

        $(function () { // will trigger when the document is ready
            $('.datepicker').datepicker(); //Initialise any date pickers
        });
        $("#btnSave").click(function (e) {
            e.preventDefault();

            debugger;

            var Id = $("#ID").val();
            var LevelofEducationId = $("#LevelofEducationId").val();
            var ExamTitleId = $("#ExamTitleId").val();
            var InstituteName = $("#InstituteName").val();
            var ResultType = $("#ResultType").val();
            var Group = $("#Group").val();
            var CGPA = $("#CGPA").val();
            var Scale = $("#Scale").val();
            var YearsofPassingMsg = $("#YearsofPassingMsg").val();
            var Duration_Years = $("#Duration_Years").val();

            if ($("#LevelofEducationId").val() == "") {
                $.alert.open("Error", "Please Insert Level of Education");
                return false;
            }
            if ($("#ExamTitleId").val() == "") {
                $.alert.open("Error", "Please Insert Exam Title");
                return false;
            }
            if ($("#Group").val() == "") {
                $.alert.open("Error", "Please Insert Group");
                return false;
            }
            if ($("#InstituteName").val() == "") {
                $.alert.open("Error", "Please Insert Institute");
                return false;
            }
            if ($("#CGPA").val() == "" || $("#Scale").val() == "" || $("#YearsofPassingMsg").val() == "") {
                $.alert.open("Error", "Please Insert Required fields");
                return false;
            }
          

            $('#AjaxLoader').show();
            $.ajax({
                type: "GET", //GET or POST or PUT or DELETE verb
                url: '/Apply/SaveAccademicInfo',
                data: {
                    Id: Id, LevelofEducationId: LevelofEducationId, ExamTitleId: ExamTitleId,
                    InstituteName: InstituteName, ResultType: ResultType, CGPA: CGPA, Scale: Scale, Group: Group,
                    YearsofPassingMsg: YearsofPassingMsg, Duration_Years: Duration_Years
                },
                dataType: "json", //Expected data format from server
                processdata: false, //True or False
                success: function (data) { //On Successful service call
                    $('#AjaxLoader').hide();
                    $.alert.open("Alert", data.message);
                    clearData();
                    GetAccademicInfoDashBoard();
                },
                error: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
        });

    });

    function GetAccademicInfoDashBoard() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetAccdemicInfo", "Apply", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "ID",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "50px",
                    filterable: false,
                },
                {
                    field: "LevelofEducation",
                    title: "Level of Education",
                    width: "80px",
                    filterable: true,
                },
                {
                    field: "ExamTitle",
                    title: "Exam Title",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "InstituteName",
                    title: "Institute Name",
                    width: "120px",
                    filterable: false,
                },
                {
                    field: "ExamTitle",
                    title: "Exam Title",
                    width: "80px",
                    filterable: true,
                },
                {
                    field: "ResultType",
                    title: "Result Type",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "CGPA",
                    title: "CGPA ",
                    width: "50px",
                    filterable: false,
                },

                {
                    field: "YearsofPassingMsg",
                    title: "Years of Passing ",
                    width: "60px",
                    filterable: false,
                },

                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.ID > 0) {
                             return "<a href='/Apply/Step_02/?Id=" + dataItem.ID + "'><i class='fa fa-pencil-square-o'></i></a>";
                         } else {
                             return "";
                         }
                     }
                 },
            {
                title: "Delete",
                width: "25px",
                template: function (dataItem) {
                    if (dataItem.ID > 0) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + dataItem.ID + ');"><i class="fa fa-trash-o"></i></a></div>';
                    } else {
                        return "";
                    }
                }
            }
            ]
        });
    }

     function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteAccademicInfo", "Apply", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open(data.message);
                            GetAccademicInfoDashBoard();
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


</script>


