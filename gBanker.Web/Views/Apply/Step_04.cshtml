@using (Html.BeginForm("Step_04", "Apply", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "TrainingHistory" }))

{
    @Html.AntiForgeryToken()
    <form id="InputForm">
        <div class="container-fluid">
            <button class='togglePersonalInfo btn btn-success col-sm-offset' style="width:340px">Training History</button>
            <fieldset>
                <legend>Training History</legend>
                <div class="">
                    @*@Html.Partial("~/Views/Shared/_OfficeNevigationPane.cshtml", pvOfficeNevigation)*@

                    @*<hr/>*@
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(m => m.Id)
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TrainingTitle, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.TrainingTitle, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TrainingTitle, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TopicsCovered, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.TopicsCovered, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TopicsCovered, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TrainingYear, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.TrainingYearMsg, new { @class = "form-control datepicker" })
                                    @Html.ValidationMessageFor(model => model.TrainingYear, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Institute, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.Institute, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Institute, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Duration, htmlAttributes: new { @class = "control-label col-sm-4 " })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.Duration, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>


                </div>

            </fieldset>
        </div>
    </form>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                &nbsp;
                <button type="button" id="btnSave" class="btn btn-success btn-sm" style="float:right;"><i class="fa fa-check-circle-o"></i> Save</button>
            </div>
        </div>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-horizontal">
            <hr />
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                &nbsp;
                <button type="button" class="btn btn-success col-sm-offset-5" onclick="Step_05()" style="float: right;">Next Page</button>
            </div>
        </div>

    </div>

}


