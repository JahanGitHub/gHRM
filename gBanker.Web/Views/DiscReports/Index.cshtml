    function rptValidation()
    {
        var ReportType = $("#filterColumn option:selected").val();
        var DateFrom = $("#txtDateFrom").val();
        var DateTo = $("#txtDateTo").val();

        var EmployeeCode = $("#txtEmpCode").val();
        var kMessage = $("#KMessage").val();
        if (ReportType == "cddzwcc" && DateFrom == "") {
            $.alert.open("error", "Insert Date");
            return false;
        }
        else if (ReportType == "eddzwe" && DateFrom == "" && DateTo == "") {
            $.alert.open("error", "Insert Date from and date to");
            return false;
        }
        else if (ReportType == "eddzwe" && DateFrom != "" && DateTo == "") {
            $.alert.open("error", "Insert  date to");
            return false;
        }
        else if (ReportType == "eddzwe" && DateFrom == "" && DateTo != "") {
            $.alert.open("error", "Insert  From date");
            return false;
        }
        else if (ReportType == "rddmywrcc" && DateFrom == "") {
            $.alert.open("error", "Insert Date");
            return false;
        }
        else if (ReportType == "mddmywccc" && DateFrom == "") {
            $.alert.open("error", "Insert Date");
            return false;
        }
        else if (ReportType == "yddmywcrcc" && DateFrom == "") {
            $.alert.open("error", "Insert Date");
            return false;
        }
        else if (ReportType == "ddemppun" && EmployeeCode == "") {
            $.alert.open("error", "Insert employee code");
            return false;
        }
        else if (ReportType == "ddemppun" && kMessage == "No Punishment") { //khalid
            $.alert.open("Message", "No Punishment");
            return false;
        }
            //else if (ReportType == "ddemppun" && DateFrom != "" && EmployeeCode == "") {
            //    $.alert.open("error", "Insert  employee code");
            //    return false;
            //}
            //else if (ReportType == "ddemppun" && DateFrom == "" && EmployeeCode != "") {
            //    $.alert.open("error", "Insert Date");
            //    return false;
            //}
        else if (ReportType == "ddpunishEmp" && DateFrom == "" && DateTo == "") {
            $.alert.open("error", "Insert Date from and date to");
            return false;
        }
        else if (ReportType == "ddpunishEmp" && DateFrom != "" && DateTo == "") {
            $.alert.open("error", "Insert  date to");
            return false;
        }
        else if (ReportType == "ddpunishEmp" && DateFrom == "" && DateTo != "") {
            $.alert.open("error", "Insert  From date");
            return false;
        }
        else if (ReportType == "ddpunishEmp" && $("#ddPunishmentList").val() == "0") {
            $.alert.open("error", "Selct punishment");
            return false;
        }

        else {
            return true;
        }
    }

    function LoadEmpInfoByCode(PFEmployeeStatusID) {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "DiscReports", "http")',
            data: { employee_code: PFEmployeeStatusID },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (index, data) {
                    if (data != "Error") {

                        if (data.EmployeeName == "") {
                            $("#EmployeeName").val('');
                            //$("#EmployeeID").val('');EmployeeId
                        }

                        $("#EmployeeName").val(data.EmployeeName);
                        $("#KMessage").val(data.kMessage);

                        if( data.kMessage == 'Punishment Exist')
                        {
                            $("#KMessage").css("background-color","red");
                            $("#KMessage").css("color","white");


                        }
                        else
                        {
                            $("#KMessage").css("background-color","green");
                            $("#KMessage").css("color","white");

                        }



                    } // End of if data found
                    else {

                        $("#txtEmpCode").val('');
                        $("#KMessage").val('');
                        //$("#EmployeeID").val('');

                        alert("Something went Wrong.");
                        $("#txtEmpName").focus();
                    }
                });
            },
            error: function (request, status, error) {

                $("#EmployeeName").val('');
                $("#KMessage").val('');
                $("#txtEmpName").focus();
                alert("Employee Not Found." + "/" + request.statusText + "/" + error);
            }
        });
    }


    function LoadPunishment() {

        var ddPunishment = $("#ddPunishmentList")
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPunishmentList", "DiscCaseEntry", "http")',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (data) {
                ddPunishment.html("");
                ddPunishment.append($('<option></option>').val("0").html("Please Select"));
                $.each(data.Options, function () {
                    ddPunishment.append($('<option></option>').val(this.Value).text(this.DisplayText));
                });
            },
            failure: function () {
                alert("Failed!");
            }
        });
    }


