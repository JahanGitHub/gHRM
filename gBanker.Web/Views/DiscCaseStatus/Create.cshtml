        $("#btnCaseStatusSave").click(function (e) {
            e.preventDefault();
            var case_no = $("#txtCaseNo").val();
            var DespatchNo = $("#txtDespatch").val();
            $('#CaseStatusProfile').ajaxSubmit({
                type: "POST",
                target: '#thumbnil',
                data: { CaseMasterId: $("#hdnCaseMasterId").val() },
                dataType: 'json',
                resetForm: true,
                success: function (data) {
                    //alert(data.data.EvaluationId)
                    if (data.data.CaseStatusId > 0) {
                        $(".save-success").show(800).fadeToggle(3000);
                        $('#grdStatus').jtable('load', { case_no: case_no, DespatchNo: DespatchNo });
                    }
                    else {
                        $(".save-fail").show(800).fadeToggle(3000);
                    }

                },
                error: function () {
                    $("#dialog-message").html('<p>Error, Fail to Save.</p>');
                    $("#dialog-message").dialog({
                        modal: true,
                        buttons: {
                            Ok: function () {
                                $(this).dialog("close");
                            }
                        }
                    });
                }
            });

        });

    });


    function showIndividualAnnexationAmount() {
        if ($("#individualAnnexationChk").is(":checked") == true) {

            $('#TotalAnnexationAmount').prop('readonly', true);
            $("#IndividualAnnexationAmount").show();
        }
        else {
            $("#IndividualAnnexationAmount").hide();
            $('#TotalAnnexationAmount').prop('readonly', false);
        }
    }

