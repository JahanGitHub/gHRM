<script type="text/javascript">

    function LoadEmpInfoByCode(employee_code) { // Get EmpName For Grid Search
        $('#AjaxLoader').show();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "EmployeeTransferNew", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {
                        $("#txtEmpNames").val(data.EmployeeName);
                        $("#EmployeeId").val(data.EmployeeId);

                    });

                }

                else {

                    $("#txtEmpName").val("");
                    $("#txtEmpNames").val("");
                    $("#EmployeeId").val("");

                    $.alert.open("Wrong Employe Code");
                }

            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
         
    } // Employee Data





    function LoadCaseInfoByCaseNo(case_no, DespatchNo) {
        //alert('ready');
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCaseInfoByCaseNo", "DiscCaseStatus", "http")',
            data: { case_no: case_no, DespatchNo: DespatchNo },
            dataType: 'json',
            async: true,
            success: function (data) {
                //if (data != null)
                //{

                    $.each(data, function (index, data) {
                        if (data != "Error") {
                            $("#hdnCaseMasterId").val(data.CaseMasterId);
                            $("#txtCaseType").val(data.CaseType);
                            $("#txtCaseDt").val(data.CaseDateFromMsg);
                            $("#txtDealOfficer").val(data.DealerName);
                            $("#txtEnquiryOfficer").val(data.EnquiryName);
                            $("#txtCrimeLoc").val(data.CrimeLocationName);
                            $("#txtDesc").val(data.CaseDescription);
                            $("#txtTotAnnexAmt").val(data.TotalAnnexationAmountMsg);
                            $("#txtTotReturnAmt").val(data.TotReturnAmountMsg);
                            $("#ddlStatus").focus();
                        }
                        else {
                            $("#hdnCaseMasterId").empty();
                            $("#txtCaseType").empty();
                            $("#txtCaseDt").empty();
                            $("#txtDealOfficer").empty();
                            $("#txtEnquiryOfficer").empty();
                            $("#txtCrimeLoc").empty();
                            $("#txtDesc").empty();
                            $("#txtTotAnnexAmt").empty();
                            $("#txtTotReturnAmt").empty();
                            alert("Wrong Case number");
                            $("#txtCaseNo").focus();
                        }
                    });
                //}
                //else
                //{
                //    $alert.open("error","Invalid search value");
                //}
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    ///////////////////////End Employee ///////////////
    function ValidateAddRequirement() {
        var txtEmpName = $("#txtEmpName").val();
        var DealOfficerId = $("#DealOfficerId").val();
        var CrimeDate = $("#CrimeDate").val();
        var CrimeId = $("#ddlCrimeId").val();

        if (txtEmpName == '' && DealOfficerId == '0' && CrimeDate == '' && CrimeId == '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeDate").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId == '0' && CrimeDate == '' && CrimeId != '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeDate").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId == '0' && CrimeDate != '' && CrimeId == '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId == '0' && CrimeDate != '' && CrimeId != '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#DealOfficerId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId != '0' && CrimeDate == '' && CrimeId == '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#CrimeDate").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId != '0' && CrimeDate == '' && CrimeId != '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#CrimeDate").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId != '0' && CrimeDate != '' && CrimeId == '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId != '0' && CrimeDate != '' && CrimeId != '0') {
            $("#txtEmpName").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == '0' && CrimeDate == '' && CrimeId == '0') {
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeDate").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == '0' && CrimeDate == '' && CrimeId != '0') {
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeDate").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == '0' && CrimeDate != '' && CrimeId == '0') {
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == '0' && CrimeDate != '' && CrimeId != '0') {
            $("#DealOfficerId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId != '0' && CrimeDate == '' && CrimeId == '0') {
            $("#CrimeDate").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId != '0' && CrimeDate == '' && CrimeId != '0') {
            $("#CrimeDate").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId != '0' && CrimeDate != '' && CrimeId == '0') {
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else
            return true;
    }

    function ValidateSaveRequirement() {
        var CaseNo = $("#CaseNo").val();
        var CaseDescription = $("#CaseDescription").val();

        if (CaseNo == '' && CaseDescription == '') {
            $("#CaseNo").addClass("errorClass");
            $("#CaseDescription").addClass("errorClass");
            return false;
        }
        else if (CaseNo == '' && CaseDescription != '') {
            $("#CaseNo").addClass("errorClass");
            return false;
        }
        else if (CaseNo != '' && CaseDescription == '') {
            $("#CaseDescription").addClass("errorClass");
            return false;
        }
        else
            return true;
    }
    //////////////////////End Validation ///////////////////
    function DeleteStatus(CaseStatusId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("StatusDelete", "DiscCaseStatus", "http")',
                    data: { CaseStatusId: CaseStatusId },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        $('#grdStatus').jtable('load', { case_no: $("#txtCaseNo").val(), DespatchNo: $("#txtDespatch").val() });
                    },
                    error: function (request, status, error) {
                        alert('Fail to delete');
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

