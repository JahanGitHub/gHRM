@model gHRM.Web.ViewModels.DistrictViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var countryList = Model == null ? null : Model.CountryList;
    var stateList = Model == null ? null : Model.StateOrProvinceList;
}

<h2></h2>
<script type="text/javascript">

    function LoadState(country_id) {
        var ddlState = $("#division_Id");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetStateList", "District", "http")',
            data: { country_id: country_id },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlState.html('');
                $.each(data, function (id, option) {
                    ddlState.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    $(document).ready(function () {
        $("#CountrtyId").change(function () {
            var country_id = $("#CountrtyId").val();
            if (country_id > 0) {
                LoadState(country_id);
            }
            else {
                $("#division_Id").empty();
            }
        });

        $("#btnDistrictSave").click(function (e) {
            if ($("#CountrtyId").val() == '0' && $("#division_Id").val() == '0' && $("#district_name_eng").val() == '') {
                $("#CountrtyId").addClass("errorClass");
                $("#division_Id").addClass("errorClass");
                $("#district_name_eng").addClass("errorClass");
                if ($("#division_Id").val() == '') {
                    $("#division_Id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountrtyId").val() == '0' && $("#division_Id").val() == '0' && $("#district_name_eng").val() != '') {
                $("#CountrtyId").addClass("errorClass");
                $("#division_Id").addClass("errorClass");
                if ($("#division_Id").val() == '') {
                    $("#division_Id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountrtyId").val() == '0' && $("#division_Id").val() != '0' && $("#district_name_eng").val() == '') {
                $("#CountrtyId").addClass("errorClass");
                $("#district_name_eng").addClass("errorClass");
                if ($("#division_Id").val() == '') {
                    $("#division_Id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountrtyId").val() != '0' && $("#division_Id").val() == '0' && $("#district_name_eng").val() == '') {
                $("#division_Id").addClass("errorClass");
                $("#district_name_eng").addClass("errorClass");
                return false;
            }
            else if ($("#CountrtyId").val() == '0' && $("#division_Id").val() != '0' && $("#district_name_eng").val() != '') {
                $("#CountrtyId").addClass("errorClass");
                if ($("#division_Id").val() == '') {
                    $("#division_Id").addClass("errorClass");
                    if ($("#division_Id").val() == '') {
                        $("#division_Id").addClass("errorClass");
                    }
                }
                return false;
            }
            else if ($("#CountrtyId").val() != '0' && $("#division_Id").val() != '0' && $("#district_name_eng").val() == '') {
                $("#district_name_eng").addClass("errorClass");
                return false;
            }
            else if ($("#CountrtyId").val() == '0' && $("#division_Id").val() != '0' && $("#district_name_eng").val() != '') {
                $("#division_Id").addClass("errorClass");
                $("#district_name_eng").addClass("errorClass");
                if ($("#division_Id").val() == '') {
                    $("#division_Id").addClass("errorClass");
                }
                return false;
            }
            else return true;
        });
    });
</script>

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Add District (জেলা সংযুক্তি করুন)</h2>
<div style="padding:5px">
    @* Here I will add Language Switcher *@
    @{
        foreach (var i in gHRM.Web.SiteLanguages.AvailableLanguages)
        {
            @Html.ActionLink(i.LangFullName, "ChangeLanguage", "District", new { lang = i.LangCultureName }, null) <text>&nbsp;</text>
        }
    }
</div>

@using (Html.BeginForm("Create", "District", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "DistrictProfile" }))
{
    @Html.AntiForgeryToken()
    <div class="container-fluid">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @*<div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="col-sm-8">
                        </div>
                    </div>
                </div>
            </div>*@
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.CountrtyId, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                    <div class="col-sm-7">
                        @Html.DropDownListFor(model => model.CountrtyId, countryList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.CountrtyId, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.division_Id, htmlAttributes: new { @class = "control-label col-sm-5 required" })
                    <div class="col-sm-7">
                        @Html.DropDownListFor(model => model.division_Id, stateList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.division_Id, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.district_name_eng, new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-7">
                        @Html.EditorFor(model => model.district_name_eng, new { htmlAttributes = new { @class = "form-control", @placeholder = "District Name" } })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    <input type="submit" value="Save" id="btnDistrictSave" class="btn btn-primary" />
                    <input type="hidden" value="" id="hdnDistrictSave" />
                    <input type="hidden" value="" id="hdnDistrictId" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}