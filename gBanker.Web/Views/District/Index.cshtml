@model IEnumerable<gHRM.Web.ViewModels.DistrictViewModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    
}

<script type="text/javascript">
    function deleteConfirm(status) {
        if (status == "true") {
            return confirm('Are you sure you want to delete this record');
        }
        else {
            alert("You cannot delete this record because it is already disabled.");
            return false;
        }
    }
    function loadDistrictList() {

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetDistrictList", "District", "http")',
                    dataType: 'json',
                    //data: { FilterBy: filterBy, FilterValue: filterValue }
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            height: 500,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "district_id",
                     hidden: true,
                     filterable: false
                 },
                 {
                     field: "rowSl",
                     title: "Sl No.",
                     width: "50px",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                     //locked: true,
                     //lockable: false,
                 },
                 {
                     width: "150px",
                     field: "division_name",
                     filterable: true,
                     title: "Division Name",
                     //locked: true
                 },
                 {
                     width: "80px",
                     field: "district_code",
                     title: "District Code",
                     //locked: true
                 },
                {
                    width: "150px",
                    field: "district_name_eng",
                    title: "District Name",
                    //locked: true
                },
                
                 {
                     width: "50px",
                     title: 'Edit',
                     template: function (dataItem) {
                         return "<a href='/District/Edit/" + dataItem.district_id + "'><i class='fa fa-pencil-square-o'></i></a>";///Office/Create/?OfficeId=" + dataItem.EntrepreneurId + "
                         //return "<div class='text-center'><a href='/EmployeeDesignation/Edit/" + data.record.DesignationId + "'><i class='fa fa-pencil-square-o'></i></a></div>";
                     }
                 },
                 //{
                 //    width: "50px",
                 //    title: 'Delete',
                 //    template: function (dataItem) {
                 //        return "<a href='#' OnClick='DesignationDelete(" + dataItem.DesignationId + ");'><i class='fa fa-trash-o'></i></a>";///Office/Create/?OfficeId=" + dataItem.EntrepreneurId + "
                 //        //return '<div class="text-center"><a href="#" OnClick="DesignationDelete(' + data.record.DesignationId + ');"><i class="fa fa-trash-o"></i></a></div>';
                 //    }
                 //}
            ]
        });
    }
