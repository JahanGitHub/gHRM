        var ddlCountry = $("#ddlCountry");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCountryList", "District", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlCountry.html('');
                $.each(data, function (id, option) {
                    ddlCountry.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }*@

    $(document).ready(function () {
        loadDistrictList();
        
    });  
   
    
</script>


@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">District List(জেলার তালিকা)</h2>
<br />




<div id="grid"></div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
