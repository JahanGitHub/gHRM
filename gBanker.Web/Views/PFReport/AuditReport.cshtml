@model gHRM.Web.ViewModels.PF.LoanCollectionViewModel

@{
    ViewBag.Title = "AuditReport";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    function setDefault(selector, defaultValue, defaultText) {
        $(selector).empty();
        $(selector).append('<option value="' + defaultValue + '">' + defaultText + '</option>');
    }
    
    function PrintAuditReport(reportType, fromDate, toDate) {
        var url = "/PFReport/PrintAuditReport?reportType= " + reportType + "&fromDate=" + fromDate + "&toDate=" + toDate;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function clear() {
    
    }
    
    $(document).ready(function () {
        
        $("#FromDate").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: '1980:2050'
         });

        $("#ToDate").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: '1980:2050'
          });
        
        $('#ReportType').change(function () {
            var reportType = $('#ReportType option:selected').val();
        });

        $("#btnPrintReport").click(function () {
            var reportType = $('#ReportType option:selected').val();
            
            var fromDate = $('#FromDate').val();
            var toDate = $('#ToDate').val();

                    

            if (fromDate == '') {
                $.alert.open('Message', 'Please Select From Date');
                return;
            }
            if (toDate == '') {
                $.alert.open('Message', 'Please Select To Date');
                return;
            }

            var fDate = new Date(fromDate);
            var tDate = new Date(toDate);
            if (fDate > tDate) {
                $.alert.open('Info', 'From Date should not be greater than To Date');
                return;
            }
            
            $.alert.open('confirm', 'Are you sure you want to see report?', function (button) {
                if (button == 'yes') {
                    PrintAuditReport(reportType, fromDate, toDate);
                }
                else {
                    return false;
                }
            });
        });

        $("#btnReset").click(function () { 
            clear();
        });
});
</script>

<h2 class="page-title">PF Audit Reports</h2>
&nbsp

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true)

        <div class="panel panel-default" style="width:90%;">
            <div class="panel-heading">
                <h2 class="panel-title">See Reports</h2>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="form-group">
                        @Html.Label("Report Type", new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            <select id="ReportType" class="form-control">
                                <option value="">Select Report Type</option>
                                <option value="1">Contribution Statement Summary</option>
                                <option value="2">Loan Statement Summary</option>
                                <option value="3">Payment Statement Summary</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row" id="dvFromDate">
                    <div class="form-group">
                        <label for="FromDate" class="control-label col-md-2">Start Date</label>
                        <div class="col-md-4">
                            @Html.Editor("FromDate", new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Start date" } })
                        </div>
                    </div>
                </div>
                <div class="row" id="dvToDate">
                    <div class="form-group">
                        <label for="ToDate" class="control-label col-md-2">End Date</label>
                        <div class="col-md-4">
                            @Html.Editor("ToDate", new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter End date" } })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2"></div>
                        <div class="col-md-4">
                            <input type="button" value="Show" id="btnPrintReport" class="btn btn-success" />
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
