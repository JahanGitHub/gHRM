<h2 class="page-title">PF Contribution Reports</h2>
&nbsp

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true)
        
        <div class="panel panel-default" style="width:90%;">
            <div class="panel-heading">
                <h2 class="panel-title">Office Wise Contribution</h2>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="form-group">
                        @Html.Label("Office Type", new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.DropDownList("OfficeType", Model.OfficeTypeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
        
                <div class="row" id="dvFromDateNew">
                    <div class="form-group">
                        <label for="FromDateNew" class="control-label col-md-2">Start Date</label>
                        <div class="col-md-4">
                            @Html.Editor("FromDateNew", new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Start date" } })
                        </div>
                    </div>
                </div>
                <div class="row" id="dvToDateNew">
                    <div class="form-group">
                        <label for="ToDateNew" class="control-label col-md-2">End Date</label>
                        <div class="col-md-4">
                            @Html.Editor("ToDateNew", new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter End date" } })
                        </div>
                    </div>
                </div>

                
                <div class="row" id="dvZone">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ZoneOfficeList, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.ZoneOfficeList, Model.ZoneOfficeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>

                <div class="row" id="dvArea">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AreaOfficeList, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.AreaOfficeList, new List<SelectListItem>(), new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row" id="dvBranch">
                    <div class="form-group">
                        @Html.LabelFor(model => model.BranchOfficeList, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.BranchOfficeList, new List<SelectListItem>(), new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row" id="dvHODeparement" style="display:none;">
                    <div class="form-group">
                        @Html.LabelFor(model => model.HODeparementList, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.HODeparementList, new List<SelectListItem>(), new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row" id="dvZoneAudit" style="display:none;">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ZoneAuditList, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.DropDownListFor(model => model.ZoneAuditList, new List<SelectListItem>(), new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group">
                        <div class="col-md-2"></div>
                        <div class="col-md-4">
                            <input type="button" value="Show" id="btnOfficeType" class="btn btn-success" />&nbsp;&nbsp;
                            <input type="button" value="Employee Wise" id="btnPrintEmployeeWiseNew" class="btn btn-success" style="display:none;"/>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
        <div class="panel panel-default" style="width:90%;">
            <div class="panel-heading">
                <h2 class="panel-title">Contribution</h2>
            </div>
            <div class="panel-body">

                <div class="row">
                    <div class="form-group">
                        @Html.Label("Contribution Type", new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            <select id="ContributionTypeES" class="form-control">
                                <option value="">Select Report Type</option>
                                <option value="1">Indivisual Contribution Ledger</option>
                                <option value="2">PF Collection for the Month</option>
                                @*<option value="3">Contribution Voucher Details</option>*@
                                <option value="4">Statement of PF Balance</option>
                                <option value="5">Employee Wise Contribution List</option>
                                <option value="6">Office Wise Contribution Summary</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row" id="dvEmployeeCodeES">
                    <div class="form-group">
                        <label for="EmployeeCodeES" class="control-label col-md-2">Employee Code</label>
                        <div class="col-md-4">
                            @Html.Editor("EmployeeCodeES", new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>

                <div class="row" id="dvStartDateES">
                    <div class="form-group">
                        <label for="StartDateES" class="control-label col-md-2">Start Date</label>
                        <div class="col-md-4">
                            @Html.Editor("StartDateES", new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                <div class="row" id="dvEndDateES">
                    <div class="form-group">
                        <label for="EndDateES" class="control-label col-md-2">End Date</label>
                        <div class="col-md-4">
                            @Html.Editor("EndDateES", new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                
                <div class="row" id="dvMonthES">
                    <div class="form-group">
