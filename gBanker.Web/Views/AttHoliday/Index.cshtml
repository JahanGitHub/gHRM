    function Save() {

        debugger;

        var AttHolidayDeclarationId = $("#AttHolidayDeclarationId").val();
        var HolidayYear = $("#HolidayYear option:selected").val();
        var AttHolidayTypeId = $("#AttHolidayTypeId option:selected").val();
        var HolidayDate = $("#HolidayDate").val();

        var OfficeTypeId = $("#OfficeTypeId").val();
        var OfficeIdList = 0;
        if (OfficeTypeId == "1") {
            OfficeIdList = $("#PVHeadOfficeId").val();
        } else if (OfficeTypeId == "3") {
            OfficeIdList = $("#typeFilterColumn").val();
        } else if (OfficeTypeId == "4") {
            OfficeIdList = $("#ZoneId").val();
        } else if (OfficeTypeId == "5") {
            OfficeIdList = $("#AreaId").val();
        } else if (OfficeTypeId == "6") {
            OfficeIdList = $("#UnitId").val();
        }

        if (HolidayYear == 0) {
            $.alert.open("Please Select Year.");
            return false;
        }
        if (AttHolidayTypeId == "") {
            $.alert.open("Please Select Weekend Day.");
            return false;
        }

        var radio_button_all = $('input[name=All]:checked').val();
        if (radio_button_all == "All") {
            radio_button_all = 1;
        } else {
            radio_button_all = 0;
        }

        var allTrx = new Object();
        allTrx.AttHolidayDeclarationId = AttHolidayDeclarationId;
        allTrx.HolidayYear = HolidayYear;
        allTrx.AttHolidayTypeId = AttHolidayTypeId;
        allTrx.HolidayDate = HolidayDate;
        allTrx.OfficeIdList = OfficeIdList;
        allTrx.OfficeTypeId = OfficeTypeId;
        allTrx.radio_button_all = radio_button_all;

        var json = JSON.stringify(allTrx);
        $('#AjaxLoader').show();
        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("Create", "AttHoliday", "http")',
            type: "POST",
            dataType: 'json',
            async: true,
            data: json,
            success: function (data) {
                $("#btnSave").removeAttr('disabled');
                $('#AjaxLoader').hide();
                LoadAttHolidayList(HolidayYear = 0, AttHolidayTypeId = "", OfficeIdList = [], OfficeTypeId = 0, radio_button_all = "1");
                $.alert.open("Message", "Data Saved Successfully");
            },
            error: function (request, status, error) {
                $("#btnSave").removeAttr('disabled');
                $('#AjaxLoader').hide();
                $.alert.open("Message", "Data Not Saved");
            }
        });
    }// End of Function

    function clear() {
        $("#OfficeTypeId").val("").trigger('change');
        $("#HolidayYear").prop("disabled", false);

        $("#AttHolidayDeclarationId").val("");
        $("#HolidayYear").prop('selectedIndex', 0);
        $("#AttHolidayTypeId").prop('selectedIndex', 0);
        $("#HolidayDate").datepicker('setDate', new Date());

        LoadAttHolidayList(HolidayYear = 0, AttHolidayTypeId = "", OfficeIdList = [], OfficeTypeId = 0, radio_button_all = "1");
    }

    function Delete(AttHolidayDeclarationId) {
        debugger;
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("Delete", "AttHoliday", "http")',
                    data: { AttHolidayDeclarationId: AttHolidayDeclarationId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result = "OK") {
                            LoadAttHolidayList(HolidayYear = 0, AttHolidayTypeId = "", OfficeIdList = [], OfficeTypeId = 0, radio_button_all = "1");
                            $.alert.open("Message", "Data Delete Successfully");
                        } else {
                            $.alert.open("Message", "Data Not Delete");
                        }
                    },
                    error: function (request, status, error) {
                        $.alert.open("Message", "Data Not Delete");
                    }
                });
            }
            else {
                return false;
            }
        });
    }

    

    $(document).ready(function () {
        LoadAttHolidayList(HolidayYear = 0, AttHolidayTypeId = "", OfficeIdList = [], OfficeTypeId = 0, radio_button_all = "1");
        //$('#ProjectDiv input[name=All]').prop("checked", true);
        //$('#ZoneDiv input[name=All]').prop("checked", true);

        $('input[name=All]').click(function () {
            var status_text = $('input[name=All]:checked').val();
            if (status_text == "All") {
                $('.selectpicker').selectpicker('deselectAll');
                $('.selectpicker').selectpicker('refresh');

                $('#ZoneId').val("");
                $('#AreaId').val("");
                $('#UnitId').val("");

            }
        });

        $('#typeFilterColumn').change(function () {
            var status_text = $('#typeFilterColumn option:selected').val();
            if (status_text != null) {
                $('#ProjectDiv input[name=All]').prop("checked", false);
            } else {
                $('#ProjectDiv input[name=All]').prop("checked", true);
            }
        });

        $('#ZoneId').change(function () {
            var status_text = $('#ZoneId option:selected').val();
            if (status_text != "") {
                $('#ZoneDiv input[name=All]').prop("checked", false);
            } else {
                $('#ZoneDiv input[name=All]').prop("checked", true);
            }
        });


        $("#HeadOfficeDiv").hide();
        $("#ProjectDiv").hide();
        $("#ZoneDiv").hide();
        $("#AreaDiv").hide();
        $("#UnitDiv").hide();



        $("#OfficeTypeId").change(function () {
            $('#ProjectDiv input[name=All]').prop("checked", true);
            $('#ZoneDiv input[name=All]').prop("checked", true);
            var officeType = $("#OfficeTypeId").val();
            if (officeType != "") {
                $("#ZoneId").val('');
                $("#AreaId").html('<option value="">Please Select</option>');
                $("#UnitId").html('<option value="">Please Select</option>');
                if (officeType == 1) {
                    GetHeadOfficeByOfficeType();
                    $("#HeadOfficeDiv").show();

                    $("#ProjectDiv").hide();
                    $("#ZoneDiv").hide();
                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();
                } else if (officeType == 3) { //project
                    $("#HeadOfficeDiv").hide();

                    GetProjectsByOfficeType();
                    $("#ProjectDiv").show();
                    $("#ZoneDiv").hide();
                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();

                } else if (officeType == 4) { //zone
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();

                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();
                    $("#ZoneDiv").show();
                } else if (officeType == 5) { //area
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();
                    $("#UnitDiv").hide();

                    $("#ZoneDiv").show();
                    $("#AreaDiv").show();
                } else if (officeType == 6) { //field
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();
                    $("#UnitDiv").show();
                    $("#ZoneDiv").show();
                    $("#AreaDiv").show();
                }
            } else {
                $("#HeadOfficeDiv").hide();
                $("#ProjectDiv").hide();
                $("#ZoneDiv").hide();
                $("#AreaDiv").hide();
                //$("#AreaId").html('<option value="">Please Select</option>');
                $("#UnitDiv").hide();
                //$("#UnitId").html('<option value="">Please Select</option>');
            }
        });

        $("#ZoneId").change(function () {

            var zoneId = $("#ZoneId").val();
            var ddlArea = $("#AreaId");
            var officeTypeId = $("#OfficeTypeId").val();

            if (zoneId != "" && (officeTypeId == 5 || officeTypeId == 6)) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "GET", //GET or POST or PUT or DELETE verb
                    url: '/Office/getAllAreaIdByZoneCode', // Location of the service
                    data: { ZoneId: zoneId }, //Data sent to server
                    dataType: "json",
                    async: false,//Expected data format from server
                    processdata: false, //True or False
                    success: function (data) { //On Successful service call
                        $('#AjaxLoader').hide();
                        ddlArea.html('');
                        if (data.length > 0) {
                            $.each(data, function (i, option) {
                                ddlArea.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                            });
                        }
                        $("#UnitId").html('<option value="">Please Select</option>');
                    },
                    error: function (data) {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', 'Error');
                    }
                });
            } else {
                ddlArea.html('<option value="">Please Select</option>');
                $("#UnitId").html('<option value="">Please Select</option>');

            }
        });

        $("#AreaId").change(function () {

            var areaId = $("#AreaId").val();
            var ddlUnit = $("#UnitId");
            var officeTypeId = $("#OfficeTypeId").val();

            if (areaId != "" && (officeTypeId == 6)) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "GET", //GET or POST or PUT or DELETE verb
                    url: '/Office/getAllUnitIdByAreaCode', // Location of the service
                    data: { AreaId: areaId }, //Data sent to server
                    dataType: "json", //Expected data format from server
                    async: false,
                    processdata: false, //True or False
                    success: function (data) { //On Successful service call
                        $('#AjaxLoader').hide();
                        ddlUnit.html('');
                        if (data.length > 0) {
                            $.each(data, function (i, option) {
                                ddlUnit.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                            });
                        }
                    },
                    error: function (data) {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', 'Error');
                    }
                });
            } else {
                $("#UnitId").html('<option value="">Please Select</option>');

            }
        });

        var _OfficeTypeId = '@Model.OfficeTypeId';
        if (parseInt(_OfficeTypeId) > 0) {

            $("#OfficeTypeId").val(_OfficeTypeId);
            $('#OfficeTypeId').val(_OfficeTypeId).trigger('change');
            $('#OfficeTypeId').change();
            if (parseInt(_OfficeTypeId) == 1) {
                $("#PVHeadOfficeId").val('@Model.PVHeadOfficeId');
            }
            else if (parseInt(_OfficeTypeId) == 3) {
                $("#PVProjectId").val(@Model.PVProjectId);
            }
            else if (parseInt(_OfficeTypeId) == 4) {
                $("#ZoneId").val(@Model.ZoneId);
            }
            else if (parseInt(_OfficeTypeId) == 5) {
                $("#ZoneId").val(@Model.ZoneId);
                $("#ZoneId").val(@Model.ZoneId).trigger('change');

                $("#AreaId").val('@Model.AreaId');
            } else if (parseInt(_OfficeTypeId) == 6) {
                $("#ZoneId").val(@Model.ZoneId);
                $("#ZoneId").val(@Model.ZoneId).trigger('change');
                $("#AreaId").val(@Model.AreaId);
                $("#AreaId").val(@Model.AreaId).trigger('change');
                $("#UnitId").val(@Model.UnitId);
            }

        } else {
            $("#OfficeTypeId").val("");
        }


        @*if ('@Model.IfDataExists' == 'True') {
            $(".generalConfig").show();
            $("#firstTimeConfig").hide();
        } else {
            $(".generalConfig").hide();
            $("#firstTimeConfig").show();
        }*@
        $(".generalConfig").show();
        $("#firstTimeConfig").hide();

        $("#HolidayDate").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: "1920:2050"

          });
        $("#HolidayDate").datepicker('setDate', new Date());

        $("#PVHeadOfficeId").click(function () {
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "1") {
                var officeId = $("#PVHeadOfficeId").val();
                reloadGrid2(officeId);
            }
        });

        $("#PVProjectId").click(function () {
            var officeTypeId = $("#OfficeTypeId").val();
            var officeId = $("#PVProjectId").val();
            if (officeTypeId == "3" && officeId != "") {
                reloadGrid2(officeId);
            }
        });

        $("#ZoneId").change(function () {
            var officeTypeId = $("#OfficeTypeId").val();
            var officeId = $("#ZoneId").val();
            if (officeTypeId == "4" && officeId != "") {
                reloadGrid2(officeId);
            }
        });

        $("#AreaId").click(function () {
            var officeTypeId = $("#OfficeTypeId").val();
            var officeId = $("#AreaId").val();
            if (officeTypeId == "5" && officeId != "") {
                reloadGrid2(officeId);
            }
        });

        $("#UnitId").click(function () {
            var officeTypeId = $("#OfficeTypeId").val();
            var officeId = $("#UnitId").val();
            if (officeTypeId == "6" && officeId != "") {
                reloadGrid2(officeId);
            }
        });

        $("#btnReset").click(function () {
            clear();
        });

        $("#btnSave").click(function () {
            Save();
            clear();

        });

        $("#btnSearch").click(function () {
            SetSearchParameters();
        });

    });// End Document Rready




    function SetSearchParameters() {
        debugger
        var AttHolidayDeclarationId = $("#AttHolidayDeclarationId").val();
        var HolidayYear = $("#HolidayYear option:selected").val();
        var AttHolidayTypeId = $("#AttHolidayTypeId option:selected").val();
        if (AttHolidayTypeId == "") { AttHolidayTypeId = ""; }

        var OfficeId = "";
        var OfficeTypeId = $("#OfficeTypeId").val();
        if (OfficeTypeId == "") { OfficeTypeId = 0; }
        var OfficeIdList = "";
        if (OfficeTypeId == "1") {
            OfficeIdList = $("#PVHeadOfficeId").val();
        } else if (OfficeTypeId == "3") {
            OfficeIdList = $("#typeFilterColumn").val();
        } else if (OfficeTypeId == "4") {
            OfficeIdList = $("#ZoneId").val();
        } else if (OfficeTypeId == "5") {
            OfficeIdList = $("#AreaId").val();
        } else if (OfficeTypeId == "6") {
            OfficeIdList = $("#UnitId").val();
        }

        var radio_button_all = $('input[name=All]:checked').val();
        if (radio_button_all == "All") {
            radio_button_all = 1;
        } else {
            radio_button_all = 0;
        }
        LoadAttHolidayList(HolidayYear, AttHolidayTypeId, OfficeIdList, OfficeTypeId, radio_button_all);
    }
    function LoadAttHolidayList(HolidayYear, AttHolidayTypeId, OfficeIdList, OfficeTypeId, radio_button_all) {
        debugger;
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("LoadAttHolidayList", "AttHoliday", "http")',
                    dataType: 'json',
                    data: { HolidayYear: HolidayYear, AttHolidayTypeId: AttHolidayTypeId, OfficeIdList: OfficeIdList, OfficeTypeId: OfficeTypeId, radio_button_all: radio_button_all }
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "AttHolidayDeclarationId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "SlNo",
                    title: "SlNo",
                    width: "25px",
                    filterable: true,
                },
                {
                    field: "OfficeName",
                    title: "Office Name",
                    width: "35px",
                    filterable: true,
                },
                {
                    field: "HolidayYear",
                    title: "Year",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "HolidayTypeFullName",
                    title: "AttHoliday Type",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "DayName",
                    title: "Day",
                    width: "40px",
                    filterable: true,
                },
                {
                    field: "HolidayDateForView",
                    title: "Holiday Date",
                    width: "35px",
                    filterable: false,
                },
                 {
                     title: "Delete",
                     width: "25px",
                     template: function (dataItem) {
                         if (dataItem.OfficeTypeId != 1) {
                             return "<a href='#' OnClick='Delete(" + dataItem.AttHolidayDeclarationId + ");'><i class='fa fa-trash-o'></i></a>";
                         } else {
                             return "";
                         }
                     }
                 }
            ]
        });
    }


</script>

