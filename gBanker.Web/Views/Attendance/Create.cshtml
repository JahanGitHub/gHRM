@model gHRM.Web.ViewModels.AttAttendanceViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Attendance">Attendance</a></li>
        <li><a href="/Attendance/Create">AttendanceCreate</a></li>
    </ol>
</div>

@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right   btn btn-success" })
&nbsp;
<h2 class="page-title">Time Entry</h2>
&nbsp;

@Html.AntiForgeryToken()
<input type="hidden" id="errFound" />
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="container-fluid">
        <div class="row">
            <div class="form-group">
                <center> <label style="font-size:xx-large;color:green;" id="DigiClock"></label></center>
                <center>  <label style="font-size:large;color:green;" id="DigiDate"></label> </center>
            </div>
            @Html.HiddenFor(model => model.Clock)
            @Html.HiddenFor(model => model.CurrentDate)

            @Html.HiddenFor(model => model.EmployeeCode)
            @Html.HiddenFor(model => model.CompanyCode)

            <input type="hidden" id="isInLeave" />
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4 required">Employee Code</label>
                    <div class="col-sm-8">
                        @Html.TextBox("txtEmpName", "", new { @class = "form-control" })
                        @Html.HiddenFor(model => model.EmployeeId)
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Employee Name</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>            
        </div>
        <div class="row">            
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Remarks</label>
                    <div class="col-sm-8">
                        @Html.TextAreaFor(model => model.Remarks, new { @class = "form-control"  })
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="panel-body">
            <div class="create-success create-content alert alert-success alert-dismissable" role="alert" style="display:none;">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <p class="message-content">Time Saved Successfully.</p>
            </div>
        </div>
        <div class="danger">
            <div class="create-content create-content alert alert-error alert-dismissable" role="alert" style="display:none;">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <p class="message-content">Employee Code/Name Missing...</p>
            </div>
        </div>
        <div class="col-sm-12">
            <div class="form-group">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    <input type="button" value="Save" id="btnEntrySave" onclick="takeManualAttendance();" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Assets/js/app/time-kepping/attendanceManualEnryManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}
