@model gHRM.Web.ViewModels.Payroll.OvertimeHourEmployeeViewModel

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/OvertimeProcess">Overtime Process</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Overtime Process";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    $(document).ready(function () {
        $("#Year").change(function () {
            year = $("#Year").val();
            month = $("#Month").val();

            if (year != "" && month != "") {
                GetMonthlyOvertime(year, month);
            }
        });

        $("#Month").change(function () {
            year = $("#Year").val();
            month = $("#Month").val();

            if (year != "" && month != "") {
                GetMonthlyOvertime(year, month);
            }
        });

        $("#btnProcessMonthlyOvertime").click(function () {
            var year = $("#Year").val();
            var month = $("#Month").val();

            if (year == "" || month == "") {
                $.alert.open("Message", "Please Fill All required Data.");
                return false;
            }
            $.alert.open('confirm', "Are you sure you want to perform monthly Overtime process?", function (button) {
                if (button == 'yes') {
                    //ProcessMonthlyOvetime(year, month);
                    OverTimeProcessEntrys(year, month);
                }
            });
        });


        $("#btnSendForApproval").click(function () {
            var year = $("#Year").val();
            var month = $("#Month").val();

            if (year == "" || month == "") {
                $.alert.open("Message", "Please Fill All required Data.");
                return false;
            }
            $.alert.open('confirm', "Are you sure you want to send overtime for approve?", function (button) {
                if (button == 'yes') {
                    SendForApproval(year, month);
                }
            });
        });


        $("#btnApproved").click(function () {
            var year = $("#Year").val();
            var month = $("#Month").val();

            if (year == "" || month == "") {
                $.alert.open("Message", "Please Fill All required Data.");
                return false;
            }
            $.alert.open('confirm', "Are you sure you want to approve overtime?", function (button) {
                if (button == 'yes') {
                    OvertimeApprove(year, month);
                }
            });
        });

        $("#btnReject").click(function () {
            var year = $("#Year").val();
            var month = $("#Month").val();

            if (year == "" || month == "") {
                $.alert.open("Message", "Please Fill All required Data.");
                return false;
            }
            $.alert.open('confirm', "Are you sure you want to reject ovetime?", function (button) {
                if (button == 'yes') {
                    OvertimeReject(year, month);
                }
            });
        });


    });

    ////// Kendo Grid Integration

    function OverTimeProcessEntrys(year, month) {
        $("#AjaxLoader").show();
        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("OverTimeProcessEntry", "AttendanceReport", "http")',
            data: JSON.stringify({ 'year': year, 'month': month }),
            dataType: 'json',
            async: true,
            success: function (data) {
                $("#AjaxLoader").hide();
                //$.alert.open("Message", data);
                $.alert.open("Message", data.message);
            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }

    function GetMonthlyOvertime(year, month) {
        //OverTimeProcessEntrys(year, month);
        $('#gridKendo').html("");
        dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    @*url: '@Url.Action("getOverTimeConfurations", "OvertimeConfiguration", "http")',*@
                    url: '/OvertimeProcess/GetMonthlyOvertime?year=' + year + '&month=' + month,
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "EmployeeCode",
                     title: "Employee Code",
                     width: "20px",
                     filterable: false,
                 },
                {
                    field: "TotalWorkHour",
                    title: "Total Work Hour",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "TotalOTHour",
                    title: "Total OT THour",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "TotalOTAmount",
                    title: "Total OT Amount",
                    width: "50px",
                    filterable: true,
                },
                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         return "<a href='/OvertimeProcess/Edit/?id=" + dataItem.OvertimeConfigId + "'><i class='fa fa-pencil-square-o'></i></a>";
                     }
                 },

                 {
                     title: "Delete",
                     width: "25px",
                     template: function (dataItem) {
                         return '<a href="/OvertimeProcess/Delete/' + dataItem.Id + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '><i class="fa fa-trash-o"></i></a>';
                         // return "<a href='#' OnClick='OfficeDelete(" + dataItem.OfficeId + ");'><i class='fa fa-trash-o'></i></a>";
                     }
                 }
            ]
        });
    }

    function ProcessMonthlyOvetime(year, month) {
        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("Process", "OvertimeProcess", "http")',
            data: JSON.stringify({ 'salaryYear': year, 'salaryMonth': month }),
            dataType: 'json',
            async: true,
            success: function (data) {
                //$("#btnProcessMonthlyOvertime").show();
                $("#AjaxLoader").hide();
                $.alert.open("Message", data.message);

                var year = $("#Year").val();
                var month = $("#Month").val();
                GetMonthlyOvertime(year, month);
                //$.alert.open("Alert", "HourTo must be greater than " + hourFrom);
            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }

    function SendForApproval(year, month) {
        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SendForApproval", "OvertimeProcess", "http")',
            data: JSON.stringify({ 'salaryYear': year, 'salaryMonth': month }),
            dataType: 'json',
            async: true,
            success: function (data) {
                $("#AjaxLoader").hide();
                //$.alert.open("Message", data);
                $.alert.open("Message", data.message);
            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }

    function OvertimeApprove(year, month) {
        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("OvertimeApprove", "OvertimeProcess", "http")',
            data: JSON.stringify({ 'salaryYear': year, 'salaryMonth': month }),
            dataType: 'json',
            async: true,
            success: function (data) {
                $("#AjaxLoader").hide();
                //$.alert.open("Message", data);
                $.alert.open("Message", data.message);

            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }

    function OvertimeReject(year, month) {
        $.ajax({
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("OvertimeReject", "OvertimeProcess", "http")',
            data: JSON.stringify({ 'salaryYear': year, 'salaryMonth': month }),
            dataType: 'json',
            async: true,
            success: function (data) {
                $("#AjaxLoader").hide();
                //$.alert.open("Message", data);
                $.alert.open("Message", data.message);

            },
            error: function (request, status, error) {
                $("#AjaxLoader").hide();
                $.alert.open("Message", data);
            }
        });
    }


</script>

<h2 class="page-title">Overtime Process</h2>

@using (Html.BeginForm(new { @class = "form-horizontal" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="container-fluid">
        <div id="AjaxLoader" class="ajaxLoader"></div>
        <div class="row">
            <div id="MonthlySalaryProcess">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(model => model.Year, Model.YearList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Month, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(model => model.Month, Model.MonthList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <div class="form-group form-action" style="padding-top:10px;margin:5px;">
                                <input type="button" value="Overtime process" id="btnProcessMonthlyOvertime" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Send for Approval" id="btnSendForApproval" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Reject" id="btnReject" class="btn btn-success" />
                                &nbsp;&nbsp;&nbsp;
                                <input type="button" value="Approved" id="btnApproved" class="btn btn-success" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="box-content">
                    <div class="table-responsive">
                        <div id="gridKendo"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}