@model gHRM.Web.ViewModels.Payroll.AddOrEditCompanyWisePayrollConfigViewModel

@{
    ViewBag.Title = "Company Wise Payroll Config";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/companywisepayrollconfig/manage">Company Wise Payroll Config</a></li>
    </ol>
</div>

<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>

&nbsp;
<h2 class="page-title">Company Wise Payroll Config</h2>
&nbsp;
<div class="container-fluid">
    @using (Html.BeginForm("AddNew", "CompanyWisePayrollConfig", FormMethod.Post, new { @role = "form", @class = "form-horizontal", @id = "add-or-edit-form" }))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.CompanyCode, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                       @Html.DropDownListFor(m => m.CompanyCode, DropdownListHelper.GetDropdownList(DropdownListTypes.GHRMPlusCompany, Model.CompanyCode), "Please Select", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.CompanyCode)
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.PayrollType, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(m => m.PayrollType, DropdownListHelper.GetDropdownList(DropdownListTypes.PayrollType, Model.PayrollType), "Please  Select", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.PayrollType)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Description)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class = "control-label col-md-4"></label>
                    <div class="col-sm-8">
                        
                        <button type="submit" class="btn btn-success">Save</button>
                        &nbsp;
                        <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" onclick="companyWisePayrollConfigManager.clearform()" />
                    </div>
                </div>
            </div>
        </div>       
    }

    <h2 class="page-title">Company Wise Payroll Config List</h2><br>
    <!--To view Listings-->
    <div id="grid"></div>
</div>


@section Scripts {
    <script src="~/Assets/js/app/payroll/companyWisePayrollConfigManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
