@model gHRM.Web.ViewModels.EmployeeDepartmentSectionViewModel
@{
    ViewBag.Title = "Department Section";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script>
    $(document).ready(function () {

        ResetDepartmentSection()
          
        $("#OfficeType").change(function () {
            var ddlDepartmentId = $("#DepartmentId");
            var officeType = $("#OfficeType").val();
            if (officeType != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetOfficeTypeWiseDepartment", "EmployeeDepartment", "http")',
                    data: { officeType: officeType },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            ddlDepartmentId.html("");
                            $.each(data, function (id, option) {
                                ddlDepartmentId.append($('<option></option>').val(option.Value).html(option.Text));
                            });
                        } else {
                            ddlDepartmentId.html("Please Select");
                        }
                    },
                });
            }
            $("#DepartmentId").html('<option value="">Please Select</option>');
        });


        $("#DepartmentId").change(function () {
            var dept = $("#DepartmentId").val();
            if (dept != "") {
                GetDepartmentSectionInfo();
            }
        });

    });

    function SaveDepartmentSection() {
        var offType = $("#OfficeType").val();
        var deptId = $("#DepartmentId").val();
        var secCode = $("#SectionCode").val();
        var secName = $("#SectionName").val();

        //var vmCarType = GenerateVMCartype();
        //var isValid = EducationValidation(vmCarType);


        if (offType != "" && deptId != "" && secCode != "" && secName != "") {
            var obj = {
                OfficeType: offType,
                DepartmentId: deptId,
                SectionCode: secCode,
                SectionName: secName,
            }

            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SaveDepartmentSection", "EmployeeDepartment", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: false,
                cache: false,
                success: function (data) {
                    if (data.result == 1) {
                        //$(".panel-body .create-success").show(800).fadeToggle(3000);
                        $.alert.open('Success', data.message);
                        GetDepartmentSectionInfo();
                        Clearform();
                    } else {
                        $.alert.open('Error', data.message);
                    }
                },
            });
        }
    }

    function GetDepartmentSectionInfo() {
        var deptId = $("#DepartmentId").val();
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetDepartmentSectionInfo", "EmployeeDepartment", "http")',
                    dataType: 'json',
                    data: { DeptId: deptId }
                }
            }
        });

        $("#kendoGrid").kendoGrid({
            dataSource: dataSource,
            // height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "SectionId",
                     hidden: true,
                     filterable: false
                 },

                 {
                     field: "SectionCode",
                     title: "Section Code",
                     width: "50px",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                     //locked: true,
                     //lockable: false,
                 },
                 {
                     width: "100px",
                     field: "SectionName",
                     filterable: true,
                     title: "Section Name",
                     //locked: true
                 },
                 {
                     width: "50px",
                     title: 'Edit',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='EditGrid(" + dataItem.SectionId + ",\"" + dataItem.DepartmentId + "\",\"" + dataItem.SectionCode + "\",\"" + dataItem.SectionName + "\");'><i class='fa fa-pencil-square-o'></i></a>";///Office/Create/?OfficeId=" + dataItem.EntrepreneurId + "
                     }
                 },
                 {
                     width: "50px",
                     title: 'Delete',
                     template: function (dataItem) {
                         return '<div class="text-center"><a href="#" OnClick="DeleteGrid(' + dataItem.SectionId + ');"><i class="fa fa-trash-o"></i></a></div>';
                     }
                 }
            ]
        });
    }


    function EditGrid(SectionId, DepartmentId, SectionCode, SectionName) {
        //$("#OfficeType").val(1);
        $("#SectionId").val(SectionId);
        $("#DepartmentId").val(DepartmentId);
        $("#SectionCode").val(SectionCode);
        $("#SectionName").val(SectionName);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }

    function UpdateDepartmentSection() {
        var secId = $("#SectionId").val();
        var offType = $("#OfficeType").val();
        var deptId = $("#DepartmentId").val();
        var secCode = $("#SectionCode").val();
        var secName = $("#SectionName").val();

        if (offType != "" && deptId != "" && secCode != "" && secName != "") {
            var obj = {
                SectionId: secId,
                OfficeType: offType,
                DepartmentId: deptId,
                SectionCode: secCode,
                SectionName: secName,
            }
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateDepartmentSection", "EmployeeDepartment", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        $(".panel-body .create-success").show(800).fadeToggle(3000);
                        $.alert.open('Success', data.message);
                        ResetDepartmentSection();
                        GetDepartmentSectionInfo();

                    } else {
                        $.alert.open('Error', data.message);
                    }
                },
            });
        }
    }

    function DeleteGrid(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteDepartmentSection", "EmployeeDepartment", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            GetDepartmentSectionInfo();
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                });
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function Clearform() {
        //$("#OfficeType").val('');
        //$("#DepartmentId").val('');
        $("#SectionCode").val('');
        $("#SectionName").val('');
    }

    function ResetDepartmentSection() {
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        $("#btnSave").show();
        Clearform();
    }


</script>


<h2 class="page-title"> Department Section </h2> <br />
@using (Html.BeginForm("DepartmentSection", "EmployeeDepartmentController", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", @id = "Create" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.SectionId)

    <div id="AjaxLoader" class="ajaxLoader"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Office Type</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.OfficeType, Model.OfficeTypeList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Department Name</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.DepartmentId, Model.DepartmentList, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Section Code</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.SectionCode, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Section Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.SectionName, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-10 col-md-offset-2">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveDepartmentSection()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateDepartmentSection()" /> &nbsp;
                    <input type="button" value="Reset" id="btnReset" class="btn btn-primary" onclick="ResetDepartmentSection()" />
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div id="kendoGrid"></div>
    </div>
}

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}

