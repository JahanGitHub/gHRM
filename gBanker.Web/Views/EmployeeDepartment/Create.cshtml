@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.OfficeTypeId, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.OfficeTypeId, Model.OfficeTypeList, new { @class = "selectpicker form-control", @multiple = "multiple", @Id = "OfficeTypeIdList", @Name = "OfficeTypeIdList" })
                        @*@Html.DropDownListFor(model => model.EmployeeStatus, Model.EmployeeStatusList, new { @class = "selectpicker form-control", @multiple = "multiple", @Id = "EmpStatusList", @Name = "EmpStatusList" })*@
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.DepartmentName, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.DepartmentName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Department Name" } })
                        @*@Html.ValidationMessageFor(model => model.EmployeeDeparmentName, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.DepartmentCode, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.DepartmentCode, new { htmlAttributes = new { @class = "form-control", @placeholder = "Department Code" } })
                        @*@Html.ValidationMessageFor(model => model.EmployeeDeparmentCode, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.DepartmentShortName, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.DepartmentShortName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Department Short Name" } })
                        @*@Html.ValidationMessageFor(model => model.EmployeeDeparmentShortName, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                &nbsp;
