@{
    ViewBag.Title = "Department Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var deptList = Model == null ? null : Model.OfficeTypeList;
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#btnEmployeeDepartmentSave").click(function (e) {
            var OfficeTypeIdList = $("#OfficeTypeIdList").val();
            if (OfficeTypeIdList == null || OfficeTypeIdList == "") {
                $.alert.open("Error", "Please Provide Office Type");
                return false;
            }
            else if ($("#DepartmentCode").val() == '' && $("#DepartmentName").val() == '') {
                $("#DepartmentCode").addClass("errorClass");
                $("#DepartmentName").addClass("errorClass");
                return false;
            }
            else if ($("#DepartmentCode").val() == '' && $("#DepartmentName").val() != '') {
                $("#DepartmentCode").addClass("errorClass");
                return false;
            }
            else if ($("#DepartmentName").val() != '' && $("#DepartmentName").val() == '') {
                $("#DepartmentName").addClass("errorClass");
                return false;
            }
            else {
                var objDept = {
                    DepartmentCode: $("#DepartmentCode").val(),
                    DepartmentName: $("#DepartmentName").val(),
                    DepartmentShortName: $("#DepartmentShortName").val(),
                    OfficeTypeIdList: $("#OfficeTypeIdList").val()
                };
                //$('#AjaxLoader').show();
                $.ajax({
                    type: 'POST',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("OfficeTypeWiseDepartmentAddLoop", "EmployeeDepartment", "http")',
                    data: JSON.stringify({ model: objDept }),
                    dataType: 'json',
                    async: true,
                    success: function (data) {                     
                        //$('#AjaxLoader').hide();
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                        }
                        else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {                   
                        //$('#AjaxLoader').hide();
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
            }
        });
    });

</script>

@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right   btn btn-success" })
