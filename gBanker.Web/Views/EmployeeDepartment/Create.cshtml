            <div class="form-group form-action" style="padding:10px;margin:5px;">
                <input type="button" value="Save" id="btnEmployeeDepartmentSave" class="btn btn-primary" />
                <input type="hidden" value="" id="hdnEmployeeDepartmentSave" />
                <input type="hidden" value="" id="hdnEmployeeDepartmentId" />
            </div>
