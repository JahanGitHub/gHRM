@model gHRM.Web.ViewModels.DocumentTypeViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/DocumentType">DocumentType</a></li>
        <li class="active"><span>Index</span></li>

    </ol>
</div>
@{
    ViewBag.Title = "DocumentType";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
    //var DocumentTypeNameList = Model == null ? null : Model.DocumentTypeNameList;
}

<script type="text/javascript">

    //create
    function GenerateDT() {
        var item = {};
        item.TypeName = $("#TypeName").val();
        item.DocumentTypeModuleName = $("#DocumentTypeModuleName").val();
        return item;
    }

    function GenerateDTUpdate() {
        var item = {};
        item.DocumentTypeId = $("#DocumentTypeId").val();
        item.TypeName = $("#TypeName").val();
        item.DocumentTypeModuleName = $("#DocumentTypeModuleName").val();
        return item;
    }

    function ClearControl() {
        $("#DocumentTypeId").val('');
        $("#TypeName").val('');
        $("#DocumentTypeModuleName").val('');

    }

    function SaveDocumentType() {


        var documentType = GenerateDT();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveDocumentType", "DocumentType")',
            data: JSON.stringify({ documentType: documentType }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $('#AjaxLoader').hide();
                if (data.result == 1) {
                    $('#grid').jtable('load');
                    $.alert.open("Success", data.message);
                    Clearform();
                } else {
                    $.alert.open("Error", data.message);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }

        });

    }

    function UpdateDocumentType() {


        var documentType = GenerateDTUpdate();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateDocumentType", "DocumentType")',
            data: JSON.stringify({ documentType: documentType }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $('#AjaxLoader').hide();
                if (data.result == 1) {
                    $('#grid').jtable('load');
                    $.alert.open("Success", data.message);
                    Clearform();
                } else {
                    $.alert.open("Error", data.message);
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }

        });

    }





</script>


<h2 class="page-title">Document Type</h2>
@using (Html.BeginForm("SaveDocumentType", "DocumentType", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DocumentTypeModuleName, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.DocumentTypeModuleName, Model.DocumentTypeNameList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">TypeName</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.TypeName, new { @class = "form-control required" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveDocumentType()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateDocumentType()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetEASSManagment()" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            @Html.HiddenFor(model => model.DocumentTypeId)
        </div>
    </div>
}


@*list*@

<script type="text/javascript">

    // delete
    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteDocumentType", "DocumentType", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $('#grid').jtable('load');
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    //edit using jtable

    function ResetEASSManagment() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }

    function EditTada(DocumentTypeId, TypeName, DocumentTypeModuleName) {
        $("#DocumentTypeId").val(DocumentTypeId);
        $("#TypeName").val(TypeName);
        $("#DocumentTypeModuleName").val(DocumentTypeModuleName);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }



    $(document).ready(function () {
        $("#btnUpdate").hide();
        $("#btnReset").hide();

        var RowNumber = 0;
        $('#grid').jtable({

            paging: true,
            pageSize: 20,
            sorting: true,
            //defaultSorting: 'TypeName ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    //var eCode = $("#Ecode").val();
                    var RowNumber = 0;
                    return $.Deferred(function ($dfd) {

                        $.ajax({
                            url: '/DocumentType/ListDocumentType?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,

                            type: 'POST',
                            dataType: 'json',
                            data: postData,

                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                RowNumber: {
                    title: 'Sl. No',
                    sorting: false,
                    display: function () {
                        RowNumber++;
                        return RowNumber;
                    }
                },
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false,
                    width: '10%'
                },
                DocumentTypeModuleName: {
                    title: 'Module Name',
                    width: '50%',
                    display: function (data) {
                        if (data.record.DocumentTypeModuleName == "EP") {
                            return "Employee Profile"
                        } else if (data.record.DocumentTypeModuleName == "DA") {
                            return "Disciplinary Action"
                        }else if (data.record.DocumentTypeModuleName == "CF") {
                            return "Case Follow-up"
                        }
                    }
                },
                TypeName: {
                    title: 'TypeName',
                    width: '50%'
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    width: '20%',
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EditTada(' + "'" + data.record.DocumentTypeId + "'" + ',' + "'" + data.record.TypeName + "'" + ',' + "'" + data.record.DocumentTypeModuleName + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                Delete: {
                    title: "Delete",
                    width: '20%',
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + data.record.DocumentTypeId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#grid').jtable('load');
    });


</script>

