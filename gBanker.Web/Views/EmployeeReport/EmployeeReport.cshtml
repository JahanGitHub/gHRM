<script>

    $(document).ready(function () {

        InformationStatus(true);

        $('input[name=empStatus]').click(function () {
            $('.selectpicker').selectpicker('deselectAll');
            let status_text = $('input[name=empStatus]:checked').val();

            if (status_text == "Active") {
                InformationStatus(true);
            }
            else if (status_text == "InActive") {
                InformationStatus(false);
            }
            else {
                $('.selectpicker').selectpicker('selectAll');
                //$('.selectpicker').selectpicker('val', statusArray);
                //$('.selectpicker').selectpicker('val', 'Probationary');
                //$('#typeFilterColumn').val(['1', '2', '3', '4', '9']);
                //$("#typeFilterColumn option:contains('Probationary')").val();
                //$("#typeFilterColumn option:contains('Probationary')").attr('selected', true);
                $('.selectpicker').selectpicker('refresh');
            }
        });

         $("#DepartmentId").change(function () {
             var deptId = $("#DepartmentId").val();
             var ddlSection = $("#Section");
             if (deptId != "") {
                 $.ajax({
                     type: 'GET',
                     contentType: "application/json; charset=utf-8",
                     url: '@Url.Action("GetDepartmentWiseSection", "Employee", "http")',
                     data: { deptId: deptId },
                     dataType: 'json',
                     async: true,
                     success: function (data) {
                         if (data.length > 0) {
                             ddlSection.html("");
                             $.each(data, function (id, option) {
                                 ddlSection.append($('<option></option>').val(option.Value).html(option.Text));
                             });
                         } else {
                             ddlSection.html("<option value=''>Please Select</option>");
                         }
                     },
                 });
             } else {

                 ddlSection.html("<option value='0'>Please Select</option>");
             }
         });

                    $("#filterColumn").change(function () {
                    $("#filterValue").val('');
                        if ($(this).val() != "ViewAll") {
                            if ($(this).val() == "Joining") {
                                $("#filterValue").datepicker(
                                    {
                                        dateFormat: "dd-M-yy",
                                        showAnim: "scale",
                                    });
                            }
                            else if ($(this).val() == "Posting") {
                                $("#filterValue").datepicker(
                                    {
                                        dateFormat: "dd-M-yy",
                                        showAnim: "scale",
                                    });
                            }
                            else if ($(this).val() == "Promotion") {
                                $("#filterValue").datepicker(
                                    {
                                        dateFormat: "dd-M-yy",
                                        showAnim: "scale",
                                    });
                            }
                            else {
                                $("#filterValue").datepicker("destroy");

                            }
                        }

                    });
         $("#DegreeLevel").change(function () {
             GetDegreesByDegreeLevel();
         });

         $("#DegreeTitle").change(function () {
             GetSubjectsByDegree();
         });

        var system = '@SessionHelper.CompanyName';
        console.log(system);
        if (system != 'Mousumi') {
            var selectElement = document.getElementById("ReportTypeOther");
            var options = selectElement.options;
            for (var i = 0; i < options.length; i++) {
                if (options[i].value === "DropoutByReasonForMousumi") {
                    selectElement.remove(i);
                    break;
                }
            }
        }



     });// END Document Ready


    function InformationStatus(stsvalue) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("InformationStatus", "Employee", "http")',
            data: { stsvalue: stsvalue },
            dataType: 'json',
            async: true,
            success: function (response) {
                $.each(response.Data, function (index, status) {
                    if (status.Value) {
                        $("#typeFilterColumn option").filter(function () {
                            return $(this).text() == status.Text;
                        }).prop("selected", true);
                    }
                });

                $('.selectpicker').selectpicker('refresh');

            },
        });
    }

    function GetDegreesByDegreeLevel() {

        var degreeLevelId = $("#DegreeLevel").val();
        var ddlDegreeTitle = $("#DegreeTitle");

        if (degreeLevelId != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetDegreesByDegreeLevel", "EducationSubjects", "http")',
                data: { degreeLevelId: degreeLevelId },
                dataType: 'json',
                async: false,
                success: function (data) {
                    if (data.length > 0) {
                        ddlDegreeTitle.html("");
                        ddlDegreeTitle.html('<option value="">Please Select</option>');
                        $.each(data, function (id, option) {
                            ddlDegreeTitle.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlDegreeTitle.html('<option value="">Please Select</option>');
                    }
                },
            });
        } else {
            ddlDegreeTitle.html('<option value="">Please Select</option>');
        }
    };

    function GetSubjectsByDegree() {

        var degreeCode = $("#DegreeTitle").val();
        var ddlConcentration = $("#Concentration");

        if (degreeCode != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetSubjectsByDegree", "EducationSubjects", "http")',
                data: { degreeCode: degreeCode },
                dataType: 'json',
                async: false,
                success: function (data) {
                    if (data.length > 0) {
                        ddlConcentration.html("");
                        ddlConcentration.html('<option value="">Please Select</option>');
                        $.each(data, function (id, option) {
                            ddlConcentration.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlConcentration.html('<option value="">Please Select</option>');
                    }
                },
            });
        } else {
            ddlConcentration.html('<option value="">Please Select</option>');
        }
    }





</script>


@section Scripts {
