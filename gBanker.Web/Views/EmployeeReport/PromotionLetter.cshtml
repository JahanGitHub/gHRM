@{
    ViewBag.Title = "Promotion Letter";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var EmployeeCode = ViewBag.EmpCode;
    var Edit = ViewBag.EditSattlement ?? "True";
}


<h2>Promotion Letter</h2>

<br />

<div class="form-horizontal">

    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    @Html.Label("Employee Code (কর্মকর্তা/কর্মচারী পরিচিতি নং)", htmlAttributes: new { @class = "control-label col-md-2 required" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeCode", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    @Html.Label("রিপোর্টের  তারিখ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                    <div class="col-md-8">
                        @Html.TextBox("Date", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>



        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        <input type="button" id="btnSave" value="Save" class="btn btn-primary" formtarget="_blank" />
                        @*<input style="margin-left:10px;" type="button" id="btnBack"  value="Back" class="btn btn-success" />*@
                    </div>
                </div>
            </div>
        </div>


        <div class="row">

            <h2 class="page-title">Employee Promotion Letter List</h2>
            &nbsp;
            &nbsp;
            &nbsp;


            <br />
            <div class="box-content">


                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>

        </div>


    </div>
</div>

<script>


    $(document).ready(function () {
                getPromotionLetterList();

                $('#btnSave').click(function () {

                    var Date = $("#Date").val();                   
                    var EmployeeCode = $("#EmployeeCode").val();

                    if (Date == '') {
                        $.alert.open('Report date is needed!');
                        return false;
                    }

                    if (EmployeeCode == '') {
                        $.alert.open('EmployeeCode is needed!');
                        return false;
                    }

                    $.ajax({
                        type: "POST",
                        url: '/EmployeeReport/PromotionLetterSave?Date=' + Date + '&EmployeeCode=' + EmployeeCode,
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'Employee Code Invalid!');
                            }

                            if (data.result == 1) {
                                $.alert.open('Success', 'Saved Successfully!');
                                getPromotionLetterList();
                            }

                        },
                        error: function (xhr, status, error) {
                            // Handle the error here
                            console.log(error);
                        }
                    });
                });


                $("#Date").datepicker({
                    dateFormat: "dd/mm/yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1950:2050"
                });
                $("#Date").datepicker('setDate', new Date());

    });

    ////// Kendo Grid Integration

    function getPromotionLetterList() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {

                    url: '@Url.Action("getPromotionLetterList", "EmployeeReport", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });
        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,


            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "LoanId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "20px",
                    filterable: false,
                },//OfficeTypeName
                {
                    field: "EmployeeCode",
                    title: "Code",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "70px",
                    filterable: true,
                },
                {
                    field: "OfficeName",
                    title: "Office Name",
                    width: "40px",
                    filterable: true,
                },
                {
                    field: "DepartmentName",
                    title: "Department",
                    width: "40px",
                    filterable: true,
                },
                {
                    field: "DesignationName",
                    title: "Designation",
                    width: "40px",
                    filterable: false,
                },
                {
                    field: "LoanStartDateMsg",
                    title: "Report Date",
                    width: "40px",
                    filterable: false,
                },

                 {
                     title: "Edit",
                     width: "20px",

                         template: function (dataItem) {
                             return "<a href='#' OnClick='Edit(" + dataItem.LoanId + ");'><i class='fa fa-edit'></i></a>";
                         }


                 },
                    {
                        title: "Delete",
                        width: "20px",
                        template: function (dataItem) {
                            return "<a href='#' OnClick='Delete(" + dataItem.LoanId + ");'><i class='fa fa-trash-o'></i></a>";
                        }
                }
                , {
                    title: "Print",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' OnClick='Print(" + dataItem.LoanId + ");'><i class='fa fa-print'></i></a>";
                    }
                }
            ]
        });
    }

    function Edit(id) {
        console.log(id);
         $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("GetEmployeePromotionLetter", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            $.each(data, function (index, data) {
                                if (data != "Error") {
                                    // alert(data.PermanentAddress);
                                    $('#Date').val(data.DateOfBirthMsg);
                                    $("#EmployeeCode").val(data.EmployeeCode);                                    
                                }
                                else {

                                    $("#EmployeeCode").val('');
                                    alert("Wrong Employe Code");
                                    $("#EmployeeCode").focus();
                                }
                            });
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
    }
    function Delete(id) {
        console.log(id);
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
              $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("DeletePromotionLetter", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'Employee Code Invalid!');
                            }

                            if (data.result == 1) {
                                $.alert.open('Success', 'Deleted Successfully!');
                                getPromotionLetterList();
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                return true;
            }
            else {
                return false;
            }
        });

     }
    function Print(id) {
        console.log(id);
          var url = "/EmployeeReport/PromotionLetterReport?id="+id
          window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

</script>


@section Scripts {


    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
