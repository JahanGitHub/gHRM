@{
    ViewBag.Title = "Final Payment To Bank";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var EmployeeCode = ViewBag.EmpCode;
    var Edit = ViewBag.EditSattlement ?? "True";
}


<h2>Approval Final Payment To Bank/  প্রাপ্তি স্বীকার পত্র </h2>

<br />

<div class="form-horizontal">

    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Purpose", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        <select id="Purpose" name="Purpose" class="form-control">
                        </select>
                    </div>
                </div>
            </div>
       
           </div>


     

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Payment Date From", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("IssueDate", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
      
     
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Payment Date To", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("PaymentDate", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        <input style="margin-left:10px;" type="button" id="btnBack" value="View" class="btn btn-success" />
                        <input style="margin-left:10px;" type="button" id="btnSave" value="Approve" class="btn btn-primary" formtarget="_blank" />
                     </div>
                </div>
            </div>
        </div>


        <div class="row">

            <h2 class="page-title">Final Payment  List(Pending for Approval)</h2>
            &nbsp;
            &nbsp;
            &nbsp;


            <br />
            <div class="box-content">


                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>

        </div>


    </div>
</div>

<script>


    $(document).ready(function () {


        $("#EmployeeCode").blur(function (e) {
            debugger;
            var employeeCode = $("#EmployeeCode").val();
            if (employeeCode != '') {
                LoadEmpInfoByCode(employeeCode);
            }
        });

         function LoadEmpInfoByCode(employee_code) {
        $("#EmployeeId").val(0);
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "EmployeeProfileReport", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: false,
            success: function (data) {
                debugger;
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {
                        //$("#EmployeeId").val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        //$("#CurrentOfficeType").val(data.CurrentOfficeType);
                        //$("#EmployeeCurrentOfficeName").val(data.EmployeeCurrentOfficeName);
                        //$("#EmployeeCurrenOfficeId").val(data.OfficeId);
                        //$("#EmployeeCurrentDepartmentName").val(data.EmployeeCurrentDepartmentName);
                        //$("#EmployeeCurrentDesignation").val(data.EmployeeCurrentDesignation);
                    });
                    //LoadPreviousDataList($("#EmployeeId").val());
                }

                else {
                    ClearControl();
                    $.alert.open("Error", "Invalid code");
                }
            },
        });
    }



        var ddlSection = $("#Purpose");
        var ddlSection2 = $("#Bank");

         $.ajax({
                     type: 'GET',
                     contentType: "application/json; charset=utf-8",
                     url: '@Url.Action("GetPurposeNameList", "EmployeeReport", "http")',
                     //data: { deptId: deptId },
                     dataType: 'json',
                     async: true,
                     success: function (data) {
                         if (data.length > 0) {
                             ddlSection.html("");
                             $.each(data, function (id, option) {
                                 ddlSection.append($('<option></option>').val(option.Value).html(option.Text));
                             });
                         } else {
                             ddlSection.html("<option value=''>Please Select</option>");
                         }
                     },
                });


         $.ajax({
                     type: 'GET',
                     contentType: "application/json; charset=utf-8",
                     url: '@Url.Action("GetBankList", "EmployeeReport", "http")',
                     //data: { deptId: deptId },
                     dataType: 'json',
                     async: true,
                     success: function (data) {
                         if (data.length > 0) {
                             ddlSection2.html("");
                             $.each(data, function (id, option) {
                                 ddlSection2.append($('<option></option>').val(option.Value).html(option.Text));
                             });
                         } else {
                             ddlSection2.html("<option value=''>Please Select</option>");
                         }
                     },
         });

              // getExperienceLetterList();

                $('#btnSave').click(function () {

                    var PaymentDate = $("#PaymentDate").val();
                    var IssueDate = $("#IssueDate").val();
                    var Purpose = $("#Purpose").val();
                   
                    if (Purpose == '') {
                        $.alert.open('Purpose is needed!');
                        return false;
                    }

                   
                    $.ajax({
                        type: "POST",
                        url: '/EmployeeReport/FinalPaymentVoucherApprove?PaymentDate=' + PaymentDate + '&IssueDate=' + IssueDate  + '&Purpose=' + Purpose,
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'Sorry Not Approved!');
                            }
                            else {
                                $.alert.open('Success', 'Approved Done Successfully');
                                getExperienceLetterList(Purpose, IssueDate, PaymentDate);
                            }

                           

                        },
                        error: function (xhr, status, error) {
                            // Handle the error here
                            console.log(error);
                        }
                    });
                });

                $('#btnBack').click(function () {

            var PaymentDate = $("#PaymentDate").val();
            var IssueDate = $("#IssueDate").val();
            var Purpose = $("#Purpose").val();
           
            if (Purpose == '') {
                $.alert.open('Purpose is needed!');
                return false;
            }



                    if (Purpose != "" && IssueDate != '' && PaymentDate != "") {
                        getExperienceLetterList(Purpose, IssueDate, PaymentDate);
                    } else {
                        $.alert.open("Error", "Please Select Required Fields");
                    }

        });


                $("#IssueDate").datepicker({
                dateFormat: "dd/mm/yy",
                showAnim: "scale",
                changeMonth: true,
                changeYear: true,
                yearRange: "1950:2050"
                });
                // const fixedDate = new Date(2023, 7, 31);
                $("#IssueDate").datepicker('setDate', new Date());

                $("#PaymentDate").datepicker({
                    dateFormat: "dd/mm/yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1950:2050"
                });
                // const fixedDate = new Date(2023, 7, 31);
               $("#PaymentDate").datepicker('setDate', new Date());

    });

    ////// Kendo Grid Integration

    function getExperienceLetterList(purpose, fromDate, toDate) {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {

                    url: '@Url.Action("getFinalPaymentToBankListNotApprove", "EmployeeReport", "http")',
                    dataType: 'json',
                    data: { Purpose: purpose, fromDate: fromDate, toDate: toDate }
                }
            }
        });
        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,


            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "LoanId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "15px",
                    filterable: false,
                },//OfficeTypeName
                {
                    field: "EmployeeCode",
                    title: "ID",
                    width: "25px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "OfficeName",
                    title: "Office Name",
                    width: "25px",
                    filterable: true,
                },
                {
                    field: "DepartmentName",
                    title: "Department",
                    width: "25px",
                    filterable: true,
                },
                {
                    field: "DesignationName",
                    title: "Designation",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "ApprovedStatus",
                    title: "Status",
                    width: "40px",
                    filterable: false,
                },
                {
                    field: "LoanStartDateMsg",
                    title: "Purpose",
                    width: "40px",
                    filterable: false,
                },

                {
                    field: "InstallmentAmount",
                    title: "Amount",
                    width: "40px",
                    filterable: false,
                }
                ,

                {
                    field: "LoanEndDateMsg",
                    title: "Cheque No",
                    width: "40px",
                    filterable: false,
                }
                ,
                {
                    field: "LoanStatus",
                    title: "Bank Name",
                    width: "40px",
                    filterable: false,
                }
                ,
                {
                    field: "LoanType",
                    title: "Issue Date",
                    width: "40px",
                    filterable: false,
                }
                ,
                {
                    field: "LoanScheme",
                    title: "Payment Date",
                    width: "40px",
                    filterable: false,
                }
                //,

                //{
                //    title: "Edit",
                //    width: "20px",

                //    template: function (dataItem) {
                //        return "<a href='#' OnClick='Edit(" + dataItem.LoanId + ");'><i class='fa fa-edit'></i></a>";
                //    }


                //},
                //{
                //    title: "Delete",
                //    width: "20px",
                //    template: function (dataItem) {
                //        return "<a href='#' OnClick='Delete(" + dataItem.LoanId + ");'><i class='fa fa-trash-o'></i></a>";
                //    }
                //}
                , {
                    title: "Print Report ",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' OnClick='Print(" + dataItem.LoanId + ");'><i class='fa fa-print'></i></a>";
                    }
                }
                , {
                    title: "Print Cheque",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' OnClick='PrintCheque(" + dataItem.LoanId + ");'><i class='fa fa-print'></i></a>";
                    }
                }
            ]
        });
    }

    function Edit(id) {
        console.log(id);
         $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("GetFinalPaymentDataEdit", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            $.each(data, function (index, data) {
                                if (data != "Error") {
                                    // alert(data.PermanentAddress);
                                    $('#Cheque').val(data.DateOfBirthMsg);
                                    $("#EmployeeCode").val(data.EmployeeCode);

                                }
                                else {

                                    $("#EmployeeCode").val('');
                                    alert("Wrong Employe Code");
                                    $("#EmployeeCode").focus();
                                }
                            });
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
    }
    function Delete(id) {
        console.log(id);
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
              $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("DeleteEmployeeExperienceLetter", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'Payment Already Approved, No Delete Possible !');
                            }

                            if (data.result == 1) {
                                $.alert.open('Success', 'Deleted Successfully!');
                                getExperienceLetterList();
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                return true;
            }
            else {
                return false;
            }
        });

     }
    function Print(id) {
        console.log(id);
        var url = "/EmployeeReport/FinalPaymentVoucherReport?id="+id
          window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintCheque(id) {
        console.log(id);
        var url = "/EmployeeReport/FinalPaymentChequeReport?id=" + id
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }
</script>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
