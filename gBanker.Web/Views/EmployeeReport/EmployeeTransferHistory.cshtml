@model gHRM.Web.ViewModels.EmployeeOtherInformationViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeOtherInformation/EmployeeOtherInfo">EmployeeReport</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Employee Transfer History";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";


}

<style type="text/css">
    .ui-autocomplete {
        overflow: auto;
        max-height: 100px;
    }
</style>


<script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.14.1/moment.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment-duration-format/1.3.0/moment-duration-format.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>

<script>

    $(document).ready(function () {

        $("#EmployeeCode").blur(function () {

            var empCode = $("#EmployeeCode").val();
            if (empCode != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetEmployeeInfoByCode", "EmployeeOtherInformation", "http")',
                    data: { empCode: empCode },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.Result == "OK") {
                            $("#Department").val(data.dataList[0].Department);
                            $("#Designation").val(data.dataList[0].Designation);
                            $("#EmployeeName").val(data.dataList[0].EmployeeName);

                            $("#SelectedEmployeeCode").val(data.dataList[0].EmployeeCode);

                            $("#ZoneOfficeName").val(data.dataList[0].ZoneOfficeName);
                            $("#AreaOfficeName").val(data.dataList[0].AreaOfficeName);
                            $("#UnitOfficeName").val(data.dataList[0].UnitOfficeName);

                        }
                        else {
                            $("#Department").val('');
                            $("#Designation").val('');
                            $("#EmployeeName").val('');


                        }
                    },
                    error: function (request, status, error) {
                        alert(error);
                    }
                });
            }
        }); // END blur

    $("#btnViewReport").click(function () {
        //IndividualEmployeePostingHistory(string EmployeeCode)
    var SelectedEmployeeCode = $("#SelectedEmployeeCode").val();
              var  otherReportURL = '/EmployeeReport/IndividualEmployeePostingHistory?EmployeeCode=' + SelectedEmployeeCode ;
                PrintReport(otherReportURL);
            
        
    });// END Click




		}); // END Document REady

    function PrintReport(printUrl) {
    window.open(printUrl, 'mywindow', 'fullscreen=yes, scrollbars=auto');
}


        var EmpCode = '@Model.EmployeeCode';
        if (EmpCode != "") {
            $("#EmployeeCode").val(EmpCode).trigger("blur");
        }


</script>

<h2> Employee Transfer History </h2> &nbsp;
<div class="form-group form-action" style="padding:10px;margin:5px;">
    <br />

    <input type="hidden" id="SelectedEmployeeCode" value="" />

    <div class="form-horizontal">
        <div class="container-fluid">
            <div id="AjaxLoader" class="ajaxLoader"></div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4 required">Employee Code</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4"> Employee Name </label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4"> Department </label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.Department, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">Designation</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.Designation, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4"> Zone </label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.ZoneOfficeName, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4">Area</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.AreaOfficeName, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4"> Branch </label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.UnitOfficeName, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-sm-4"> &nbsp; </label>
                        <div class="col-sm-8">
                            <input type="button" value="View" id="btnViewReport" class="btn btn-success" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                </div>
            </div>

        </div>
    </div>

    


</div>
