@{
    ViewBag.Title = "Final Payment To Bank";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var EmployeeCode = ViewBag.EmpCode;
    var Edit = ViewBag.EditSattlement ?? "True";
}


<h2>Final Payment To Bank Report </h2>

<br />

<div class="form-horizontal">

    <div class="container-fluid">

     

        <div class="row">

      
     
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Issue Date", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("IssueDate", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        <input type="button" id="btnSave" value="Print" class="btn btn-primary" formtarget="_blank" />
                        <input style="margin-left:10px;" type="button" id="btnBack"  value="Excel" class="btn btn-success" />
                    </div>
                </div>
            </div>
        </div>



    </div>
</div>

<script>


    $(document).ready(function () {



                $('#btnSave').click(function () {

                    var IssueDate = $("#IssueDate").val();

                    console.log(IssueDate);
                    var url = "/EmployeeReport/FinalPaymentToBankReportPrint?IssueDate=" + IssueDate
                    window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');

                });

                 $('#btnBack').click(function () {

                    var IssueDate = $("#IssueDate").val();

                    console.log(IssueDate);
                    var url = "/EmployeeReport/FinalPaymentToBankReportPrintExcel?IssueDate=" + IssueDate
                    window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');

                });


                $("#IssueDate").datepicker({
                    dateFormat: "dd/mm/yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1950:2050"
                });
                // const fixedDate = new Date(2023, 7, 31);
        $("#IssueDate").datepicker('setDate', new Date());

    });

  
    function Print(id) {
        console.log(id);
        var url = "/EmployeeReport/FinalPaymentVoucherReport?id="+id
          window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintCheque(id) {
        console.log(id);
        var url = "/EmployeeReport/FinalPaymentChequeReport?id=" + id
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

</script>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
