                            <div class="col-md-4 ">
                                @*text-right*@
                                <label class="control-label" style="padding-top:8px;">Payroll Designation (পদবী)</label>
                            </div>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.DesignationId, desigList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <div class="col-md-4">
                                <label class="control-label" style="padding-top:8px;">Responsibility (অফিস পদবী)</label>
                            </div>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.OfficeDesignationId, offcDesigList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                </div>

