<div class="form-horizontal" style="padding-top: 15px;">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="container-fluid">
        <div class="row hideReportType">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4" style="text-align: left;">Report Type (রিপোর্টের ধরন)</label>
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.ReportType, Model.ReportList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row hideEmpCode">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4" style="text-align: left;">Employee Code (কর্মকর্তা/কর্মচারী পরিচিতি নং)</label>
                    <div class="col-md-8">
                        @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <div class="row ManualOfficeTypeDiv" style="display: none;">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4" style="text-align: left;">Office Type</label>
                    <div class="col-md-8">
                        <select id="ManualOfficeType" class="form-control">
                            <option value="0">All</option>
                            <option value="1">Head Office</option>
                            <option value="2">Field Office</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row hideBloodGroup">
            <div class="row" style="margin-top:15px; margin:15px;">
                @Html.Partial("~/Views/Shared/_OfficeNevigationPane.cshtml", pvOfficeNevigation)
            </div>
                <div class="row" style="margin: 0;">
                    <div class="col-sm-6">
