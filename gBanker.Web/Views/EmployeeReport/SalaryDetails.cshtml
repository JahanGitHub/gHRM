@{
    ViewBag.Title = "SalaryDetails";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var EmployeeCode = ViewBag.EmpCode;
}

<h2>Salary Details</h2>
<br />

<div class="form-horizontal">
    <input type="hidden" id="SalaryIncrementId" />

    <div class="container-fluid">
        <!-- Employee Information Section -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Employee ID", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeCode", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Employee Name", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeName", "", new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Salary Section -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Increment Amount", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("IncrementAmount", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Increment Amount Date", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("IncrementAmountDate", "", new { @class = "form-control datepicker" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Current Salary and Total Increment -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Current Salary", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("CurrentSalary", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Total Increment", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("TotalIncrement", "", new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    <input type="button" id="btnSave" value="Save" class="btn btn-primary" />
                    <input type="button" id="btnClear" value="Clear" class="btn btn-warning" style="margin-left:10px;" />
                    <input type="button" id="btnReport" value="Report" class="btn btn-info" style="margin-left:10px;" />
                </div>
            </div>
        </div>

        <!-- Grid Section -->
        <div class="row">
            <h2 class="page-title">Salary Increment Details</h2>
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Date Range Popup -->
<div id="datePopup" style="display:none; position:fixed; top:30%; left:40%; background:white; border:1px solid #ccc; padding:20px; z-index:9999;">
    <h5>Select Date Range</h5>
    <label>From Date:</label>
    <input type="date" id="fromDate" class="form-control" /><br />
    <label>To Date:</label>
    <input type="date" id="toDate" class="form-control" /><br />
    <button class="btn btn-success" onclick="submitReport()">Submit</button>
    <button class="btn btn-secondary" onclick="closePopup()">Cancel</button>
</div>

<script>
    $(document).ready(function () {

        $(".datepicker").datepicker({
            dateFormat: "dd/mm/yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:2050"
        });
        $("#IncrementAmountDate").datepicker('setDate', new Date());

        // Load employee info on blur
        $("#EmployeeCode").blur(function () {
            var employeeCode = $("#EmployeeCode").val();
            if (employeeCode) LoadEmpInfoByCode(employeeCode);
        });

        function LoadEmpInfoByCode(employee_code) {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetEmpInfoByCode", "EmployeeProfileReport")',
                data: { employee_code: employee_code },
                dataType: 'json',
                async: false,
                success: function (data) {
                    if (data?.result == 1 && data.data?.length > 0) {
                        $("#EmployeeName").val(data.data[0].EmployeeName);
                    } else {
                        clearForm();
                        $.alert.open("Error", "Invalid code");
                    }
                }
            });
        }

        // Save button
        $("#btnSave").click(function () {
            var payload = {
                Id: $("#SalaryIncrementId").val(),
                EmployeeCode: $("#EmployeeCode").val(),
                IncrementAmount: $("#IncrementAmount").val(),
                IncrementAmountDate: $("#IncrementAmountDate").val(),
                CurrentSalary: $("#CurrentSalary").val(),
                TotalIncrement: $("#TotalIncrement").val()
            };

            if (!validateForm()) return;

            $.ajax({
                type: "POST",
                url: '/EmployeeReport/SaveIncrementAmount',
                data: payload,
                dataType: 'json',
                success: function (data) {
                    if (data.result == 0) {
                        $.alert.open('Error', data.Message || 'Something went wrong!');
                    } else {
                        $.alert.open('Success', 'Saved Successfully!');
                        getIncrementList();
                        clearForm();
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Error:", error);
                }
            });
        });

        // Clear form
        $("#btnClear").click(clearForm);

        function validateForm() {
            if (!$("#EmployeeCode").val()) { alert("Employee ID is required!"); return false; }
            if (!$("#IncrementAmount").val() || !$("#IncrementAmountDate").val()) { alert("Amount and Date are required!"); return false; }
            return true;
        }

        function clearForm() {
            $("#SalaryIncrementId").val("");
            $("#EmployeeCode").val("");
            $("#EmployeeName").val("");
            $("#IncrementAmount").val("");
            $("#IncrementAmountDate").val("");
            $("#CurrentSalary").val("");
            $("#TotalIncrement").val("");
            $(".datepicker").datepicker('setDate', new Date());
        }

        // Report popup
        $("#btnReport").click(openDatePopup);
        function openDatePopup() { $('#datePopup').show(); }
        function closePopup() { $('#datePopup').hide(); }
        function submitReport() {
            var fromDate = $('#fromDate').val();
            var toDate = $('#toDate').val();
            if (!fromDate || !toDate) { alert("Please select both dates."); return; }
            window.open("/EmployeeReport/SalaryIncrementReport_YPSA?DateFrom=" + encodeURIComponent(fromDate) + "&DateTo=" + encodeURIComponent(toDate), '_blank');
            closePopup();
        }

        getIncrementList();
    });

    function getIncrementList() {
        var grid = $("#gridKendo").data("kendoGrid");
        if (grid) {
            grid.dataSource.read(); grid.refresh();
        } else {
            $("#gridKendo").kendoGrid({
                dataSource: {
                    transport: { read: { url: '/EmployeeReport/GetIncrementList', dataType: 'json' } },
                    schema: { model: { id: "Id" }, data: "data", total: "total" },
                    pageSize: 20,
                    serverPaging: false
                },
                pageable: true,
                sortable: true,
                filterable: true,
                columns: [
                    { field: "EmployeeCode", title: "ID" },
                    { field: "EmployeeName", title: "Name" },
                    { field: "OfficeName", title: "Office" },
                    { field: "DepartmentName", title: "Department" },
                    { field: "DesignationName", title: "Designation" },
                    { field: "GrossSalary", title: "GrossSalary" },
                    { field: "IncrementAmount", title: "Increment Amount" },
                    { field: "IncrementAmountDate", title: "Increment Date" },
                    { field: "CurrentSalary", title: "Current Salary" },
                    { field: "TotalIncrement", title: "Total Increment" },
                    { title: "Edit", template: function (d) { return "<a href='#' onclick='editIncrement(" + d.Id + ")'><i class='fa fa-edit'></i></a>"; }, width: "50px" },
                    { title: "Delete", template: function (d) { return "<a href='#' onclick='deleteIncrement(" + d.Id + ")'><i class='fa fa-trash text-danger'></i></a>"; }, width: "50px" }
                ]
            });
        }
    }

    function editIncrement(id) {
        var grid = $("#gridKendo").data("kendoGrid");
        var dataItem = grid.dataSource.get(id);
        if (dataItem) {
            $("#SalaryIncrementId").val(dataItem.Id);
            $("#EmployeeCode").val(dataItem.EmployeeCode);
            $("#EmployeeName").val(dataItem.EmployeeName);
            $("#IncrementAmount").val(dataItem.IncrementAmount);
            $("#IncrementAmountDate").val(dataItem.IncrementAmountDate);
            $("#CurrentSalary").val(dataItem.CurrentSalary);
            $("#TotalIncrement").val(dataItem.TotalIncrement);
        }
    }

    function deleteIncrement(id) {
        if (!confirm('Are you sure you want to delete this record?')) return;
        $.ajax({
            url: '/EmployeeReport/DeleteIncrement',
            type: 'POST',
            data: { id: id },
            success: function (response) {
                if (response.result === 1) { alert('Deleted successfully'); getIncrementList(); }
                else { alert('Delete failed: ' + response.Message); }
            },
            error: function () { alert('Error deleting record.'); }
        });
    }
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
