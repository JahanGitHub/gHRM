@{
    ViewBag.Title = "PF & Gratuity Payment";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var EmployeeCode = ViewBag.EmpCode;
}

<h2>PF & Gratuity Payment</h2>
<br />

<div class="form-horizontal">
    <div class="container-fluid">
        <!-- Employee Information Section -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Employee ID", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeCode", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Employee Name", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeName", "", new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>
        </div>

        <!-- PF Payment Section -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("PF Amount", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("PFAmount", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("PF Payment Date", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("PFPaymentDate", "", new { @class = "form-control datepicker" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Gratuity Payment Section -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Gratuity Amount", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("GratuityAmount", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Gratuity Payment Date", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("GratuityPaymentDate", "", new { @class = "form-control datepicker" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Resignation Effective Date", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("ResignationEffectiveDate", "", new { @class = "form-control datepicker" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        <input type="button" id="btnSave" value="Save" class="btn btn-primary" formtarget="_blank" />
                        <input type="button" id="btnClear" value="Clear" class="btn btn-warning" style="margin-left:10px;" />
                        <input type="button" id="btnReport" value="Report" class="btn btn-primary" formtarget="_blank" style="margin-left:10px;" />

                    </div>
                </div>
            </div>
        </div>

        <!-- Existing Records Grid -->
        <div class="row">
            <h2 class="page-title">Pending PF & Gratuity Payments</h2>
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="datePopup" style="display:none; position:fixed; top:30%; left:40%; background:white; border:1px solid #ccc; padding:20px; z-index:9999;">
    <h5>Select Date Range</h5>
    <label>From Date:</label>
    <input type="date" id="fromDate" class="form-control" /><br />
    <label>To Date:</label>
    <input type="date" id="toDate" class="form-control" /><br />
    <button class="btn btn-success" onclick="submitReport()">Submit</button>
    <button class="btn btn-secondary" onclick="closePopup()">Cancel</button>
</div>



<script>
    $(document).ready(function () {

        // Initialize datepickers
        $(".datepicker").datepicker({
            dateFormat: "dd/mm/yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:2050"
        });
        $("#PFPaymentDate").datepicker('setDate', new Date());
        $("#GratuityPaymentDate").datepicker('setDate', new Date());
        $("#ResignationEffectiveDate").datepicker('setDate', new Date());
        // Employee ID lookup
        $("#EmployeeCode").blur(function () {

                $.ajax({
                    type: "GET",
                    url: '@Url.Action("GetEmpInfoByCode", "EmployeeProfileReport", "http")',
                    data: { employee_code: $("#EmployeeCode").val() },
                    success: function (data) {
                        if (data.result == 1) {
                            $.each(data.data, function (index, data) {

                                $("#EmployeeName").val(data.EmployeeName);

                            });
                            //LoadPreviousDataList($("#EmployeeId").val());
                        }
                    }
                });

        });

        // Save button handler
        $("#btnSave").click(function () {
            var EmployeeCode = $("#EmployeeCode").val();
            var PFAmount = $("#PFAmount").val();
            var PFPaymentDate = $("#PFPaymentDate").val();
            var GratuityAmount = $("#GratuityAmount").val();
            var GratuityPaymentDate = $("#GratuityPaymentDate").val();
            var ResignationEffectiveDate = $("#ResignationEffectiveDate").val();
            $.ajax({
                type: "POST",
                url: '/EmployeeReport/SavePFGratuit?PFAmount=' + PFAmount + '&EmployeeCode=' + EmployeeCode + '&PFPaymentDate=' + PFPaymentDate + '&GratuityAmount=' + GratuityAmount + '&GratuityPaymentDate=' + GratuityPaymentDate + '&ResignationEffectiveDate=' + ResignationEffectiveDate ,
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 0) {
                        $.alert.open('Error', 'Employee Code Invalid!');
                    }

                    if (data.result == 1) {

                        // var url = "/EmployeeReport/FinalPaymentVoucherReport?id=" + data.data
                        //  window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
                        $.alert.open('Success', 'Saved Successfully!');
                        loadPFGratuityData();
                    }

                },
                error: function (xhr, status, error) {
                    // Handle the error here
                    console.log(error);
                }
            });
        });


        // Clear form
        $("#btnClear").click(clearForm);


        loadPFGratuityData();

        $('#btnReport').click(function () {
            openDatePopup();
          
        });


    });


    // Form validation
    function validateForm() {
        if (!$("#EmployeeCode").val()) {
            alert("Employee ID is required!");
            return false;
        }
        if (!$("#PFAmount").val() && !$("#GratuityAmount").val() && !$("#ResignationEffectiveDate").val()) {
            alert("At least one payment amount is required!");
            return false;
        }
        return true;
    }

    // Clear form fields
    function clearForm() {
        $("#EmployeeCode").val("");
        $("#EmployeeName").val("");
        $("#PFAmount").val("");
        $("#GratuityAmount").val("");
        $("#ResignationEffectiveDate").val("");
        $(".datepicker").datepicker('setDate', new Date());
    }

    // Load grid data
    function loadPFGratuityData() {
         $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {

                    url: '@Url.Action("GetPFGratuityList", "EmployeeReport", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });
        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,


            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                //{
                //    field: "LoanId",
                //    hidden: true,
                //    filterable: false
                //},
                {
                    field: "SL",
                    title: "SL",
                    width: "10px",
                    filterable: false,
                },//OfficeTypeName
                {
                    field: "EmployeeCode",
                    title: "ID",
                    width: "20px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "50px",
                    filterable: true,
                },
                //{
                //    field: "OfficeName",
                //    title: "Batch No",
                //    width: "25px",
                //    filterable: true,
                //},
                //{
                //    field: "DepartmentName",
                //    title: "Department",
                //    width: "25px",
                //    filterable: true,
                //},
                {
                    field: "DesignationName",
                    title: "Designation",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "FirstJoinDate",
                    title: "Join Date",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "ResignationEffectiveDate",
                    title: "Resignation effective date",
                    width: "30px",
                    filterable: false,
                },
                {
                    field: "PFAmount",
                    title: "PF Amount",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "PFPaymentDate",
                    title: "PFPayment Date",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "GratuityAmount",
                    title: "Gratuity Amount",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "GratuityPaymentDate",
                    title: "Gratuity PaymentDate",
                    width: "25px",
                    filterable: false,
                },
                {
                     title: "Edit",
                     width: "20px",

                         template: function (dataItem) {
                             return "<a href='#' OnClick='Edit(" + dataItem.ID + ");'><i class='fa fa-edit'></i></a>";
                         }
                 },
                 {
                        title: "Delete",
                        width: "20px",
                        template: function (dataItem) {
                            return "<a href='#' OnClick='Delete(" + dataItem.ID + ");'><i class='fa fa-trash-o'></i></a>";
                        }
                },
                //, {
                //    title: "Print Report ",
                //    width: "20px",
                //    template: function (dataItem) {
                //        return "<a href='#' OnClick='Print(" + dataItem.ID + ");'><i class='fa fa-print'></i></a>";
                //    }
                //}
                //, {
                //    title: "Print Cheque",
                //    width: "20px",
                //    template: function (dataItem) {
                //        return "<a href='#' OnClick='PrintCheque(" + dataItem.LoanId + ");'><i class='fa fa-print'></i></a>";
                //    }
                //}
            ]
        });
    }


    function Edit(id) {
        console.log(id);
         $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("GetFinalPaymentDataEdit_YPSA", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            $.each(data, function (index, data) {
                                if (data != "Error") {
                                    // alert(data.PermanentAddress);
                                    $("#PFAmount").val(data.GrossSalary);
                                    $("#GratuityAmount").val(data.BasicSalary);

                                    $("#PFPaymentDate").val(data.Date);
                                    $("#GratuityPaymentDate").val(data.OfficeDesignationName);
                                    $("#ResignationEffectiveDate").val(data.DepartmentName);
                                   
                                    $("#EmployeeName").val(data.EmployeeName);
                                    $("#EmployeeCode").val(data.EmployeeCode);
                                }
                                else {

                                    $("#EmployeeCode").val('');
                                    alert("Wrong Employe Code");
                                    $("#EmployeeCode").focus();
                                }
                            });
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
    }
    function Delete(id) {
        console.log(id);
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
              $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("DeleteFinalPaymentVoucher_YPSA", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'No Delete Possible !');
                            }

                            if (data.result == 1) {
                                $.alert.open('Success', 'Deleted Successfully!');
                                loadPFGratuityData();
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                return true;
            }
            else {
                return false;
            }
        });

     }
    function Print(id) {
        console.log(id);
        var url = "/EmployeeReport/FinalPaymentReport_YPSA?id="+id
          window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    function PrintCheque(id) {
        console.log(id);
        var url = "/EmployeeReport/FinalPaymentChequeReport?id=" + id
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }


    function openDatePopup() {
        document.getElementById('datePopup').style.display = 'block';
    }

    function closePopup() {
        document.getElementById('datePopup').style.display = 'none';
    }

    function submitReport() {
        var fromDate = document.getElementById('fromDate').value;
        var toDate = document.getElementById('toDate').value;

        if (!fromDate || !toDate) {
            alert("Please select both dates.");
            return;
        }

        // Example: Redirect to report URL (pass dates as query parameters)
        var reportUrl = "/EmployeeReport/FinalPaymentReport_YPSA?DateFrom=" + encodeURIComponent(fromDate) + "&DateTo=" + encodeURIComponent(toDate);

        // Open in new tab
        window.open(reportUrl, '_blank');

        closePopup();
    }

</script>



@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
