<script>


    $(document).ready(function () {

        $("#SalaryScaleList").change(function () {

            var scale = $("#SalaryScaleList").val();
            var EmployeeCode = $("#EmployeeCode").val();
            var IncrementAmount = $("#IncrementAmount").val();
            var GrossSalary = $("#GrossSalary").val();
            var step = $('#SalaryScaleList').val();
            var hiddenStep = $('#hiddenStep').val();
            if (scale != "") {
                
                if (EmployeeCode != "" && IncrementAmount != "" && GrossSalary !="" ) {

                    step = parseFloat(step);
                    hiddenStep = parseFloat(hiddenStep);
                    IncrementAmount = parseFloat(IncrementAmount);
                    GrossSalary = parseFloat(GrossSalary);
                    if (step > hiddenStep) {
                        var stepIncrement = step - hiddenStep
                        $('#IncrementStep').val(stepIncrement);
                        $("#IncrementAmount").val(IncrementAmount);
                        IncrementAmount = IncrementAmount * stepIncrement;                       
                        GrossSalary = GrossSalary + IncrementAmount;
                        $("#GrossSalary").val(GrossSalary);
                    }

                } else {
                    $.alert.open("Message", "Please select step ");
                    return false;
                }
            } else {
                return false;
            }
        });



        $("#GradeList").change(function (e) {
            console.log('gradechange');
            console.log($('#GradeList').val());
        });


        $("#EmployeeCode").blur(function (e) {
            var employee_code = $("#EmployeeCode").val();
            if ($("#EmployeeCode").val() !== '') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '/EmployeeReport/GetExistingSalaryConfigurationListbyEmployeeCode',
                    data: { employeeCode: employee_code },
                    dataType: 'json',
                    async: false,
                    cache: false,
                    success: function (data) {
                        if (data.Result === "OK") {
                            if (data.dataList.length > 0) {
                                //GenerateTableWithData(data.dataList);
                            }

                            if (data.dataList !== null) {
                                if (data.dataList.length > 0 && data.dataList[0].GradeId == 0) {
                                    $("#SalaryGenerationType").val("NPS");
                                    $("#GradeList").val("");
                                    $("#GrossSalary").attr('Disabled', false);
                                } else {
                                    $("#SalaryGenerationType").val("PS");
                                }


                                $("#JoiningDate").val(data.JoiningDate);
                                $("#ConfirmationDate").val(data.ConfirmationDate);                             
                                
                                $("#DepartmentName").val(data.DepartmentName);
                                $("#DesignationName").val(data.DesignationName);
                            
                                $("#EmployeeName").val(data.dataList[0].EmployeeName);
                                $("#txtEmpStatus").val(data.dataList[0].EmployeeStatusName);
                                $("#IncrementAmount").val(data.dataList[0].CalculatedAmount);
                           
                                if (data.dataList[0].Step === 0) {
                                    $("#SalaryScaleList").val("");
                                } else {
                                    $("#SalaryScaleList").val(data.dataList[0].Step);
                                    $("#hiddenStep").val(data.dataList[0].Step);
                                }                            
                                $("#EffectiveDate").val(data.dataList[0].EmployeeNameBng);
                                $("#GradeList").val(data.GradeId);
                                $("#GrossSalary").val(data.dataList[0].GrossSalary);
                               
                            }
                        }
                    },
                    error: function (request, status, error) {
                    }
                });
            }
            else {
                $("#EmployeeCode").empty();
                $("#EmployeeName").val('');              
                $("#GrossSalary").val('');
            }        
        });


                getPromotionLetterList();

                $('#btnSave').click(function () {

                    var Date = $("#Date").val();                   
                    var EmployeeCode = $("#EmployeeCode").val();
                    var IncrementAmount = $("#IncrementAmount").val();
                    var GrossSalary = $("#GrossSalary").val();
                    var step = $('#SalaryScaleList').val();
                    var hiddenStep = $('#IncrementStep').val();
                    var EffectiveDate = $("#EffectiveDate").val();

                    if (Date == '') {
                        $.alert.open('Report date is needed!');
                        return false;
                    }

                    if (EmployeeCode == '') {
                        $.alert.open('EmployeeCode is needed!');
                        return false;
                    }

                    if (IncrementAmount == '') {
                        $.alert.open('Increment Amount is needed!');
                        return false;
                    }


                    if (hiddenStep == '') {
                        $.alert.open('Add Step is needed!');
                        return false;
                    }
                

                    if (GrossSalary == '') {
                        $.alert.open('Gross Salary is needed!');
                        return false;
                    }


                    $.ajax({
                        type: "POST",
                        url: '/EmployeeReport/IncrementLetterSave?Date=' + Date + '&EmployeeCode=' + EmployeeCode + '&IncrementAmount=' + IncrementAmount + '&hiddenStep=' + hiddenStep + '&GrossSalary=' + GrossSalary + '&EffectiveDate=' + EffectiveDate,
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'Employee Code Invalid!');
                            }

                            if (data.result == 1) {
                                $.alert.open('Success', 'Saved Successfully!');
                                getPromotionLetterList();
                            }

                        },
                        error: function (xhr, status, error) {
                            // Handle the error here
                            console.log(error);
                        }
                    });
                });


                $("#Date").datepicker({
                    dateFormat: "dd/mm/yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1950:2050"
                });
                $("#Date").datepicker('setDate', new Date());

    });

    ////// Kendo Grid Integration

    function getPromotionLetterList() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {

                    url: '@Url.Action("getIncrementLetterList", "EmployeeReport", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });
        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,


            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "LoanId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "20px",
                    filterable: false,
                },//OfficeTypeName
                {
                    field: "EmployeeCode",
                    title: "Code",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "70px",
                    filterable: true,
                },
                {
                    field: "OfficeName",
                    title: "Office Name",
                    width: "40px",
                    filterable: true,
                },
                {
                    field: "DepartmentName",
                    title: "Department",
                    width: "40px",
                    filterable: true,
                },
                {
                    field: "DesignationName",
                    title: "Designation",
                    width: "40px",
                    filterable: false,
                },
                {
                    field: "LoanStartDateMsg",
                    title: "Report Date",
                    width: "40px",
                    filterable: false,
                },

                 {
                     title: "Edit",
                     width: "20px",

                         template: function (dataItem) {
                             return "<a href='#' OnClick='Edit(" + dataItem.LoanId + ");'><i class='fa fa-edit'></i></a>";
                         }


                 },
                    {
                        title: "Delete",
                        width: "20px",
                        template: function (dataItem) {
                            return "<a href='#' OnClick='Delete(" + dataItem.LoanId + ");'><i class='fa fa-trash-o'></i></a>";
                        }
                }
                , {
                    title: "Print",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' OnClick='Print(" + dataItem.LoanId + ");'><i class='fa fa-print'></i></a>";
                    }
                }
            ]
        });
    }

    function Edit(id) {
        console.log(id);
         $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("GetEmployeeIncrementLetter", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            $.each(data, function (index, data) {
                                if (data != "Error") {
                                    // alert(data.PermanentAddress);
                                    $('#Date').val(data.DateOfBirthMsg);
                                    $("#EmployeeCode").val(data.EmployeeCode);                                    
                                }
                                else {

                                    $("#EmployeeCode").val('');
                                    alert("Wrong Employe Code");
                                    $("#EmployeeCode").focus();
                                }
                            });
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
    }
    function Delete(id) {
        console.log(id);
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
              $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("DeleteIncrementLetter", "EmployeeReport", "http")',
                        data: { Id: id },
                        dataType: 'json',
                        async: true,
                        success: function (data) {
                            if (data.result == 0) {
                                $.alert.open('Error', 'Employee Code Invalid!');
                            }

                            if (data.result == 1) {
                                $.alert.open('Success', 'Deleted Successfully!');
                                getPromotionLetterList();
                            }
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                return true;
            }
            else {
                return false;
            }
        });

     }
    function Print(id) {
        console.log(id);
        var url = "/EmployeeReport/IncrementLetterReport?id="+id
          window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

</script>


@section Scripts {


    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
