            </div>




            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("গ্রুপ জীবন বীমা", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            <select id="groupjibonbima" class="form-control">
                                <option value="প্রযোজ্য">Yes</option>
                                <option value="প্রযোজ্য নয়" selected>No</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>




            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("ছুটির পরির্বতে বেতন", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            <select id="chutirporibortebeton" class="form-control">
                                <option value="প্রযোজ্য">Yes</option>
                                <option value="প্রযোজ্য নয়">No</option>
                            </select>

                        </div>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("বকেয়া বেতন  ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            <select id="bokyeabeton" class="form-control">
                                <option value="প্রযোজ্য">Yes</option>
                                <option value="প্রযোজ্য নয়">No</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>




            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("বকেয়া  ভাতা ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            <select id="bokyeavata" class="form-control">
                                <option value="প্রযোজ্য">Yes</option>
                                <option value="প্রযোজ্য নয়">No</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("অন্যান্য বকেয়া", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            @Html.TextBox("onnannobokyea", "", new { @class = "form-control" })

                        </div>
                    </div>
                </div>
            </div>

        </fieldset>

        <fieldset>
            <legend class="text-info" id="rpt_name">কর্তন সমূহ :</legend>

            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("নোটিশ পে ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            <select id="noticepay" class="form-control">
                                <option value="প্রযোজ্য">Yes</option>
                                <option value="প্রযোজ্য নয়">No</option>
                            </select>

                        </div>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("মোবাইল লোন ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            @Html.TextBox("mobileloan", "", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("প্রভিডেন্ট ফান্ড লোন ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            @Html.TextBox("providentfundloan", "", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("মোবাইল বিল ", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            <select id="mobilebill" class="form-control">
                                <option value="প্রযোজ্য">Yes</option>
                                <option value="প্রযোজ্য নয়">No</option>
                            </select>

                        </div>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("অন্যান্য পাওনা", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">
                            @Html.TextBox("onnannopauna", "", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>

        <fieldset>
            <legend class="text-info" id="rpt_name"> মন্তব্য (যদি থাকে): </legend>

            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.Label("মন্তব্য (যদি থাকে):", htmlAttributes: new { @class = "control-label col-md-2 required" })
                        <div class="col-md-8">

                            <textarea id="comments" name="comments" rows="4" cols="50" class="form-control"> </textarea>
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>

        <fieldset>
            <legend class="text-info" id="rpt_name">সংরক্ষণ , সংযোজন , বিয়োজন</legend>


            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="form-group form-action" style="padding:10px;margin:5px;">
                            <input type="button" id="btnPrint" value="Save" class="btn btn-primary" formtarget="_blank" />
                            @*<input style="margin-left:10px;" type="button" id="btnBack"  value="Back" class="btn btn-success" />*@
                        </div>
                    </div>
                </div>
            </div>

            </fieldset>

    </div>
</div>

<script>
           

    $(document).ready(function () {

                //$('#btnBack').click(function ()
                //{
                //    window.location.href = '/EmployeeReport/EmployeeReport?FinalSattlement=True';
                //});

                $('#btnPrint').click(function () {

                    var Date = $("#Date").val();
                    var Prapok = $("#Prapok").val();
                    var Prerok = $("#Prerok").val();
                    var Bishoy = $("#Bishoy").val();
                    var podtagpotraDhakilerDate = $("#podtagpotraDhakilerDate").val();
                    var nimnokotobisoyadi = $("#nimnokotobisoyadi").val();
                    var name = $("#name").val();
                    var kormosthol = $("#kormosthol").val();
                    var jogdanertarikh = $("#jogdanertarikh").val();
                    var podotagpotrokarjokordate = $("#podotagpotrokarjokordate").val();
                    var sorboshesbeton = $("#sorboshesbeton").val();
                    var nishchitkoronertarikh = $("#nishchitkoronertarikh").val();
                    var vata = $("#vata").val();
                    var podotagpotrerbiboron = $("#podotagpotrerbiboron").val();
                    var rilizorderbiboron = $("#rilizorderbiboron").val();
                    var mohargonai = $("#mohargonai").val();
                    var providentfundenijertaka = $("#providentfundenijertaka").val();
                    var providentfundenijerjomatakarsud = $("#providentfundenijerjomatakarsud").val();
                    var providentfundeprotisthanerobodan = $("#providentfundeprotisthanerobodan").val();
                    var providentfundeprotisthaneronudanrsud = $("#providentfundeprotisthaneronudanrsud").val();
                    var gratuitytohobillejomakritotaka = $("#gratuitytohobillejomakritotaka").val();
                    var groupjibonbima = $("#groupjibonbima").val();
                    var chutirporibortebeton = $("#chutirporibortebeton").val();
                    var bokyeavata = $("#bokyeavata").val();
                    var bokyeabeton = $("#bokyeabeton").val();
                    var onnannobokyea = $("#onnannobokyea").val();
                    var noticepay = $("#noticepay").val();
                    var mobileloan = $("#mobileloan").val();
                    var providentfundloan = $("#providentfundloan").val();
                    var mobilebill = $("#mobilebill").val();
                    var onnannopauna = $("#onnannopauna").val();
                    var comments = $("#comments").val();
                    var lastworkingday = $("#lastworkingday").val();
                    var providendfundeprotisthaneronudanersud = $("#providendfundeprotisthaneronudanersud").val();

                    var sattlement = {
                        EmployeeCode: '@EmployeeCode',
                        Date: Date,
                        OfficeTypeName: nimnokotobisoyadi,
                        PassportNo: kormosthol,
                        BloodGroup: sorboshesbeton,
                        EmployeeName: name,
                        FirstJoiningDateMsg: jogdanertarikh,
                        EmployeeStatusValue:nishchitkoronertarikh,
                        BatchNo: Prapok,
                        kMessage: Prerok,
                        BirthPlace: Bishoy,
                        PermanentAddress: podtagpotraDhakilerDate,
                        OfficialEmail: podotagpotrokarjokordate,
                        EmployeeStatusName: bokyeabeton,
                        Marks: vata,
                        CompanyName: podotagpotrerbiboron,
                        CompanyAddress: rilizorderbiboron,
                        RosterName: mohargonai,
                        Section: providentfundenijertaka,
                        IsSameAsPresentAddress: providentfundenijerjomatakarsud,
                        AttendanceDateFrom: providentfundeprotisthanerobodan,
                        AttendanceDateTo: providentfundeprotisthaneronudanrsud,
                        PABXExtension: gratuitytohobillejomakritotaka,
                        ETinNo: groupjibonbima,
                        AddressDetail: chutirporibortebeton,
                        PresentAddressDetailForGuarantor: bokyeavata,
                        PermanentAddressDetailForGuarantor: onnannobokyea,
                        EmployeeImageBase64: noticepay,
                        ImageFilePath: mobileloan,
                        EmployeeImageLink: providentfundloan,
                        ReferenceORGuarantorDetail: mobilebill,
                        BankAccountNo: onnannopauna,
                        BirthCertificateNo: comments,
                        Nationality: lastworkingday,
                        NationalId: providendfundeprotisthaneronudanersud,
                    };

                    console.log(sattlement);

                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("FinalSattlementSave", "EmployeeReport", "http")',
                        data: JSON.stringify(sattlement),
                        dataType: "json",
                        contentType: "application/json",
                        success: function (data) {
                            var url = "/EmployeeReport/FinalSattlementReport?EmployeeCode=@EmployeeCode"
                            window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
                        },
                        error: function (xhr, status, error) {
                            // Handle the error here
                            console.log(error);
                        }
                    });
                });



                $("#Date").datepicker({
                    dateFormat: "dd/mm/yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1950:2050"
                });
                $("#Date").datepicker('setDate', new Date());

                $("#podtagpotraDhakilerDate").datepicker({
                    dateFormat: "dd/mm/yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1950:2050"
                });
                $("#podtagpotraDhakilerDate").datepicker('setDate', new Date());


    

                $("#podotagpotrokarjokordate").datepicker({
                    dateFormat: "dd/mm/yy",
