                        <div class="col-md-8">
                            @Html.TextBox("gratuitytohobillejomakritotaka", "প্রযোজ্য ( ...... থেকে  ......... সাল পর্যন্ত ...... টি মূল বেতন )** ", new { @class = "form-control" })
                        </div>
