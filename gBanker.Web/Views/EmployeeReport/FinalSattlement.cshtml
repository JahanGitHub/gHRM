@{
    ViewBag.Title = "Final Sattlement";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var EmployeeCode = ViewBag.EmpCode;
    var Edit = ViewBag.EditSattlement??"True";   
}

<h2>Final Salttlement</h2>

<br />

<div class="form-horizontal">

    <div class="container-fluid">

        <fieldset>
