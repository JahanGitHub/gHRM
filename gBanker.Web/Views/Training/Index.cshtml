    //employee Promotion Evaluation Qualitie Marking End

</script>
@Html.HiddenFor(model => model.EmployeeId)
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Employee Code</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4"> Department </label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.Department, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
    </div>
    <br/>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Designation</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.Designation, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4"> Employee Name </label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
    </div>
</div>

    @*Employee Training*@
    <div class="panel panel-default">
        <div class="panel-heading">
            <h4 class="panel-title panel-title-Training">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseTraining">
                    <i class="fa fa-plus"></i>&nbsp;Employee Training Info
                </a>
            </h4>
        </div>
        <div id="collapseTraining" class="panel-collapse collapse">
            <div class="panel-body">
                <h4 class="text-info">Training Info</h4>
                <br /><br />
                <div id="AjaxLoader" class="ajaxLoader"></div>
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-sm-4 required">TrainingTitle</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.TrainingTitle, new { @class = "form-control required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-sm-4 required">InstituteName</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.InstituteName, new { @class = "form-control required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-sm-4">Country</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.TrainingCountryId, countryList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-sm-4 required">TrainingTopics</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.TrainingTopics, new { @class = "form-control required" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-sm-4">Result</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.Result, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TrainingDateFrom, htmlAttributes: new { @class = "control-label col-sm-4" })
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.TrainingDateFrom, new { htmlAttributes = new { @class = "form-control", @placeholder = "dd/mm/yyyy" } })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.TrainingDateTo, htmlAttributes: new { @class = "control-label col-sm-4" })
                                <div class="col-sm-8">
                                    @Html.EditorFor(model => model.TrainingDateTo, new { htmlAttributes = new { @class = "form-control", @placeholder = "dd/mm/yyyy" } })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="control-label col-sm-4">Current Office Training</label>
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.CurrentOfficeTraining, Model.CurrentOfficeTrainingList, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="col-sm-8">
                                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveTraining()" />
                                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateTraining()" />
                                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetTraining()" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-8">
                            @Html.HiddenFor(model => model.EmployeeTrainingId)
                        </div>
                    </div>


                    <h2 class="page-title"> Training List</h2>
                    &nbsp;

                    <div class="row">
                        <div class="col-sm-12">
                            &nbsp;
                        </div>
                    </div>

                    <div id="gridTraining"></div>

                    <div class="row">
                        <div class="col-sm-12">
                            &nbsp;
                        </div>
                    </div>
                </div>
        </div>
    </div>
