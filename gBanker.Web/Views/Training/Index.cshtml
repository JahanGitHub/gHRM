@model gHRM.Web.ViewModels.EmployeeViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Training/Index">Training</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Training";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
    var countryList = Model == null ? null : Model.CountryList;
}
<style type="text/css">
    .btn span.glyphicon {
        opacity: 0;
    }

    .btn.active span.glyphicon {
        opacity: 1;
    }
</style>
<script type="text/javascript">

    $(document).ready(function () {
        debugger;
        $("#EmployeeCode").blur(function () {
            var empCode = $("#EmployeeCode").val();
            if (empCode != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetEmployeeInfoByCode", "Training", "http")',
                    data: { empCode: empCode },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        $.each(data, function (index, data) {
                            if (data != "") {
                                $("#Department").val(data.Department);
                                $("#Designation").val(data.Designation);
                                $("#EmployeeName").val(data.EmployeeName);
                            } else {
                                $("#Department").val('');
                                $("#Designation").val('');
                                $("#EmployeeName").val('');
                            }
                        });

                    },
                    error: function (request, status, error) {
                        alert(error);
                    }
                });
            }
        });

        getEmployeeTraning();
        getPromotionEvaluationQualitieMarking();

        //for training information start

        $("#isapproved").change(function () {
            $("#isrejected").hide();
        });
        $("#isrejected").change(function () {
            $("#isapproved").hide();
        });

        $("#TrainingDateTo").change(function () {
            var TrainingDateTo = $("#TrainingDateTo").val();
            var TrainingDateFrom = $("#TrainingDateFrom").val();
            if (TrainingDateTo != "" && TrainingDateFrom == "") {
                $.alert.open("Please select Also TrainingDate From");
            } else if (TrainingDateTo != "" && TrainingDateFrom != "") {
                GETTraningTimeTrainingDateTos(TrainingDateTo);
            }
        });

        $("#TrainingDateFrom").change(function () {
            var TrainingDateTo = $("#TrainingDateTo").val();
            var TrainingDateFrom = $("#TrainingDateFrom").val();
            if (TrainingDateTo != "" && TrainingDateFrom == "") {
            } else if (TrainingDateTo != "" && TrainingDateFrom != "") {
                GETTraningTimeTrainingDateTos(TrainingDateTo);
            }
        });
        $("#TrainingDateFrom").datepicker(
                   {
                       dateFormat: "dd-M-yy",
                       showAnim: "scale",
                   });
        $("#TrainingDateFrom").datepicker(
               'setDate', new Date());

        $("#TrainingDateTo").datepicker(
                   {
                       dateFormat: "dd-M-yy",
                       showAnim: "scale",
                   });
        $("#TrainingDateTo").datepicker(
               'setDate', new Date());

        //for training information end

    });


    //employee tranning informatio
    function getEmployeeTraning() {
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        var RowNumber = 0;

        $('#gridTraining').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            //defaultSorting: 'InventoryId ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    var RowNumber = 0;

                    return $.Deferred(function ($dfd) {
                        var employeId = '@Model.EmployeeId';
                        $.ajax({
                            url: '/Training/ListTraning?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&EmployeeId=' + employeId,

                            type: 'POST',
                            dataType: 'json',
                            data: postData,

                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                //RowNumber: {
                //    title: 'Sl. No',
                //    sorting: false,
                //    display: function () {
                //        RowNumber++;
                //        return RowNumber;
                //    }
                //},
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                EmployeeCode: {
                    title: 'EmployeeCode',
                    width: '10%'
                },
                EmployeeName: {
                    title: 'EmployeeName',
                    width: '15%'
                },
                TrainingTitle: {
                    title: 'TrainingTitle',
                    width: '15%'
                },
                InstituteName: {
                    title: 'InstituteName',
                    width: '15%'
                },
                CountryName: {
                    title: 'CountryName',
                    width: '15%'
                },
                TrainingTopics: {
                    title: 'TrainingTopics',
                    width: '15%'
                },
                Result: {
                    title: 'Result',
                    width: '15%'
                },
                TDF: {
                    title: 'TrainingDateFrom',
                    width: '15%'
                },
                TDT: {
                    title: 'TrainingDateTo',
                    width: '15%'
                },
                CurrentOfficeTraining: {
                    title: 'OfficeTraining',
                    width: '15%',
                    display: function (data) {
                        if (data.record.CurrentOfficeTraining == "1") {
                            return "Yes"
                        } else if (data.record.CurrentOfficeTraining == "0") {
                            return "No"
                        }
                    }
                },
                //isapproved: {
                //    title: 'isapproved',
                //    width: '15%',
                //    display: function (data) {
                //        if (data.record.isapproved == "1") {
                //            return "Approved"
                //        } else if (data.record.isapproved == "0") {
                //            return "NonApproved"
                //        }
                //    }
                //},
                //isrejected: {
                //    title: 'isrejected',
                //    width: '15%',
                //    display: function (data) {
                //        if (data.record.isrejected == "1") {
                //            return "Rejected"
                //        } else if (data.record.isrejected == "0") {
                //            return "NonRejected"
                //        }
                //    }
                //},
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EditTraning(' + "'" + data.record.EmployeeCode + "'" + ',' + "'" + data.record.EmployeeTrainingId + "'" + ',' + "'" + data.record.TrainingTitle + "'" + ',' + "'" + data.record.InstituteName + "'" + ',' + "'" + data.record.TrainingCountryId + "'" + ',' + "'" + data.record.TrainingTopics + "'" + ',' + "'" + data.record.Result + "'" + ',' + "'" + data.record.TDF + "'" + ',' + "'" + data.record.TDT + "'" + ',' + "'" + data.record.CurrentOfficeTraining + "'" + ',' + "'" + data.record.isapproved + "'" + ',' + "'" + data.record.isrejected + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                Delete: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDeleteTraning(' + data.record.EmployeeTrainingId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#gridTraining').jtable('load');
    }


    function GenerateEmployeeTraning() {
        var item = {};
        item.EmployeeId = '@Model.EmployeeId';
        item.EmployeeCode = $("#EmployeeCode").val();
        item.TrainingTitle = $("#TrainingTitle").val();
        item.InstituteName = $("#InstituteName").val();
        item.TrainingCountryId = $("#TrainingCountryId").val();
        item.TrainingTopics = $("#TrainingTopics").val();
        item.Result = $("#Result").val();
        item.TrainingDateFrom = $("#TrainingDateFrom").val();
        item.TrainingDateTo = $("#TrainingDateTo").val();
        item.CurrentOfficeTraining = $("#CurrentOfficeTraining").val();
        item.isapproved = $("#isapproved").val();
        item.isrejected = $("#isrejected").val();
        return item;
    }

    function GenerateUpdateEmployeeTraning() {
        var item = {};
        item.EmployeeTrainingId = $("#EmployeeTrainingId").val();
        item.TrainingTitle = $("#TrainingTitle").val();
        item.InstituteName = $("#InstituteName").val();
        item.TrainingCountryId = $("#TrainingCountryId").val();
        item.TrainingTopics = $("#TrainingTopics").val();
        item.Result = $("#Result").val();
        item.TrainingDateFrom = $("#TrainingDateFrom").val();
        item.TrainingDateTo = $("#TrainingDateTo").val();
        item.CurrentOfficeTraining = $("#CurrentOfficeTraining").val();
        item.isapproved = $("#isapproved").val();
        item.isrejected = $("#isrejected").val();
        return item;
    }

    function ClearControlTraining() {
        $("#EmployeeCode").val('');
        $("#EmployeeTrainingId").val('');
        $("#TrainingTitle").val('');
        $("#InstituteName").val('');
        $("#TrainingCountryId").val('');
        $("#TrainingTopics").val('');
        $("#Result").val('');
        $("#TrainingDateFrom").val('');
        $("#TrainingDateTo").val('');
        $("#CurrentOfficeTraining").val('');
        $("#isapproved").val('').show();
        $("#isrejected").val('').show();
    }

    function SaveTraining() {//job


        var employeeTraining = GenerateEmployeeTraning();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: false,
            cache: false,
            url: '@Url.Action("SaveTraining", "Training")',
            data: JSON.stringify({ employeeTraining: employeeTraining }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.result == "Save Successfull") {
                    ClearControlTraining();
                    $('#gridTraining').jtable('load');
                    $.alert.open("Success", "Save Successfull");
                } else {
                    $.alert.open('Error');
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }

    function UpdateTraining() {


        var employeeTraining = GenerateUpdateEmployeeTraning();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateTraining", "Training")',
            data: JSON.stringify({ employeeTraining: employeeTraining }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $('#gridTraining').jtable('load');
                if (data.result == "Update Successfull") {
                    ClearControlTraining();
                    $('#gridTraining').jtable('load');
                    $.alert.open('Success');
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }


    function InformationDeleteTraning(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteTraning", "Training", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $('#gridTraining').jtable('load');
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


    function ResetTraining() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControlTraining();
    }

    function EditTraning(EmployeeCode, EmployeeTrainingId, TrainingTitle, InstituteName, TrainingCountryId, TrainingTopics, Result, TrainingDateFrom,
                                        TrainingDateTo, CurrentOfficeTraining, isapproved, isrejected) {
        $("#EmployeeCode").val(EmployeeCode);
        $("#EmployeeTrainingId").val(EmployeeTrainingId);
        $("#TrainingTitle").val(TrainingTitle);
        $("#InstituteName").val(InstituteName);
        $("#TrainingCountryId").val(TrainingCountryId);
        $("#TrainingTopics").val(TrainingTopics);
        $("#Result").val(Result);
        $("#TrainingDateFrom").val(TrainingDateFrom);
        $("#TrainingDateTo").val(TrainingDateTo);
        $("#CurrentOfficeTraining").val(CurrentOfficeTraining);
        $("#isapproved").val(isapproved);
        $("#isrejected").val(isrejected);
        $("#isapproved").show();
        $("#isrejected").show();
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();

    }

    function GETTraningTimeTrainingDateTos(TrainingDateTo) {
        var TrainingDateFrom = $("#TrainingDateFrom").val();
        if (TrainingDateTo != "" && TrainingDateFrom != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GETTraningTimeTrainingDateTo", "Training", "http")',
                data: { TrainingDateFrom: TrainingDateFrom, TrainingDateTo: TrainingDateTo },
                dataType: 'json',
                success: function (data) {
                    if (data.result == "1") {
                        //$.alert.open('Success', "Now Date Perfect");
                    } else {
                        $("#TrainingDateFrom").val('');
                        $("#TrainingDateTo").val('');
                        $.alert.open('Error', "Please Select Form Date Less then To Date");
                    }
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
    }
    //employeetranninginformationend


