                data: { EmployeeId: EmployeeId },
                dataType: 'json',
                success: function (data) {
                    //if (data.result == "1") {
                    //    $.alert.open('Success');
                    //} else {
                    //    $.alert.open('Error', "Please Select Form Date Less then To Date");
                    //}
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
    }



    //employee Promotion Evaluation Qualitie Marking start
    function getPromotionEvaluationQualitieMarking() {
        $("#collapseQualitie #btnUpdate").hide();
        $("#collapseQualitie #btnReset").hide();

        $('#GridQualities').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            //defaultSorting: 'InventoryId ASC',
            actions: {
                listAction: function (postData, jtParams) {

                    return $.Deferred(function ($dfd) {
                        var employeId = '@Model.EmployeeId';
                        $.ajax({
                            url: '/Training/ListPromotionEvaluationQualitieMarking?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&EmployeeId=' + employeId,

                            type: 'POST',
                            dataType: 'json',
                            data: postData,

                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                PersonalQualification: {
                    title: 'PersonalQualification',
                    width: '15%'
                },
                Marks: {
                    title: 'Marks',
                    width: '15%',
                    display: function (data) {
                        if (data.record.Marks == "1") {
                            return "1"
                        }else if (data.record.Marks == "2") {
                            return "2"
                        }
                        else if (data.record.Marks == "3") {
                            return "3"
                        }
                        else if (data.record.Marks == "4") {
                            return "4"
                        }
                        else if (data.record.Marks == "5") {
                            return "5"
                        } 
                    }
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EditPromotionEvaluationQualitieMarking(' + "'" + data.record.EmployeeCode + "'" + ',' + "'" + data.record.EmployeeQualitiesId + "'" + ',' + "'" + data.record.PersonalQualificationPromotionId + "'" + ',' + "'" + data.record.Marks + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                Delete: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDeletePromotionEvaluationQualitieMarking(' + data.record.EmployeeQualitiesId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#GridQualities').jtable('load');
    }


    function GeneratePromotionEvaluationQualitieMarking() {
        debugger;
        var item = {};
        item.EmployeeId = '@Model.EmployeeId';
        item.EmployeeCode = $("#EmployeeCode").val();
        item.PersonalQualificationPromotionId = $("#PersonalQualificationPromotionId").val();
        item.Marks = $("#Marks").val();
        return item;
    }

    function GenerateupdatePromotionEvaluationQualitieMarking() {
        var item = {};
        item.EmployeeQualitiesId = $("#EmployeeQualitiesId").val();
        item.PersonalQualificationPromotionId = $("#PersonalQualificationPromotionId").val();
        item.Marks = $("#Marks").val();
        return item;
    }

