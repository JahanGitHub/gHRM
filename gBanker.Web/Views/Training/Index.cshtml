    function GETTraningTimeTrainingDateTos(TrainingDateTo) {
        var TrainingDateFrom = $("#TrainingDateFrom").val();
        if (TrainingDateTo != "" && TrainingDateFrom != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GETTraningTimeTrainingDateTo", "Training", "http")',
                data: { TrainingDateFrom: TrainingDateFrom, TrainingDateTo: TrainingDateTo },
                dataType: 'json',
