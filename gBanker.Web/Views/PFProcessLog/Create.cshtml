@model gHRM.Web.ViewModels.PF.ProcessLogViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right   btn btn-success" })
&nbsp;
<h2 class="page-title">Day Initialization</h2>
&nbsp;

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.IsOpen)

        <div class="panel panel-default">
            <div class="panel-heading">
                <h2 class="panel-title">Day Status</h2>
            </div>
            <div class="panel-body">

                <div class="row">
                    <div class="form-group">

                        @Html.LabelFor(model => model.DayStatus, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.EditorFor(model => model.DayStatus, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                        </div>

                        <label id="lblTransDate" class="control-label col-md-1">Date</label>
                        <div class="col-md-4">
                            @Html.EditorFor(model => model.TransactionDate, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h2 class="panel-title">Open Day</h2>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="form-group">
                        @Html.LabelFor(model => model.StartDate, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-4">
                            @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" }, @tanindex = 2 })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2"></div>
                    <div class="col-md-4">
                        <div class="form-group" style="padding-left:5px;">
                            <input type="button" value="Save" id="btnSaveProcessLog" class="btn btn-success" tabindex="2" />
                            &nbsp;
                            <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" tabindex="3" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="row" style="margin-left:2px; margin-right:2px;">
            <div id="grid2">
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Assets/js/app/pf/processLogManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}
