@model gHRM.Web.ViewModels.PF.ProcessLogViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<script type="text/javascript">

    function UpdateProcessLog(processLogId, startDate, isOpen) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdateProcessLog", "PFProcessLog", "http")',
            data: { processLogId: processLogId, startDate: startDate, isOpen: isOpen },
            dataType: 'json',
            async: false,
            success: function (data) {
                $.alert.open("Message", data.message);
                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");
                //$.alert.open("Error", request.statusText);
                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }
        });
    }

    $(document).ready(function () {

        $("#StartDate").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
         });

        $("#btnUpdateProcessLog").click(function () {
           
            var processLogId = $('#ProcessLogId').val();
            var startDate = $("#StartDate").val();
            var isOpen = $("#IsOpen").is(":checked");

            if (processLogId == '') {
              
                return;
            }
            if (startDate == '') {
                $.alert.open("Please enter Start Date");
                return;
            }
            
            UpdateProcessLog(processLogId, startDate, isOpen);
        });

        });
   // });
</script>


@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right   btn btn-success" })
