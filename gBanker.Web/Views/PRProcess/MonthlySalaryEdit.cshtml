    function LoadEmpInfo(employeeCode) {
        debugger;
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmployeeInfoByCode", "EmployeeLoan", "http")',
            data: { employeeCode: employeeCode },
            dataType: 'json',
            async: true,
            success: function (data) {


                if (data == null) {
                    $.alert.open("Error", "No Employee Found");
                    return false;
                } else {
                    
                    $('#EmployeeId').val(data.EmployeeId);
                    $("#EmployeeName").val(data.EmployeeName);
                    $("#OfficeName").val(data.OfficeName);
                    $("#DesignationName").val(data.DesignationName);
                    $("#OffcDesignName").val(data.OffcDesignName);
                    $("#DepartmentName").val(data.DepartmentName);
                }
            },
            error: function (request, status, error) {
                $.alert.open('Alert', request.statusText + "/" + request.statusText + "/" + error);
            }
        });

    }
    $(document).ready(function () {

        $("#btnSearch").click(function () {

            var month = $("#Month").val();
            var year = $("#Year").val();
            var EmployeeId = $("#EmployeeId").val();
            if (month != "" && year != "" && EmployeeId != "") {
                getSalaryInformation(month, year, EmployeeId);
            } else {
                $.alert.open("Error", "Please provide all required fields");
            }
        });
        $("#txtEmployeeCode").blur(function () {
            var employeeCode = $("#txtEmployeeCode").val();
            if (employeeCode != "") {
                LoadEmpInfo(employeeCode);
            }

        });

    });

</script>


