@using (Html.BeginForm("Create", "LeaveHistory", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "LeaveHistory" }))
{
    @Html.AntiForgeryToken()


    <div id="AjaxLoader" class="ajaxLoader"></div>
    <div class="container-fluid">
        <fieldset>
            <legend>Employee Info</legend>
            @Html.HiddenFor(model => model.EmployeeId)
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4", id = "employeeCode" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtEmpCode", "", new { @class = "form-control", id = "txtEmployeeCode" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OfficeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.OfficeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DepartmentName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DepartmentName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DesignationName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OffcDesignName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.OffcDesignName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>
        <div class="row">
            <div class="col-md-12">
                &nbsp;
            </div>
        </div>
        <h2 class="page-title">Salary Details</h2>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Month, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.Month, Model.MonthList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.Year, Model.YearList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <input type="button" id="btnSearch" value="Search" class="btn btn-primary" />
            </div>
        </div>
        <div class="table-responsive">
            <div id="gridKendo"></div>
        </div>




    </div>
}

