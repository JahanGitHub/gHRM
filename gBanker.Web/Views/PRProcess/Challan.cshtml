@model gHRM.Web.ViewModels.ChallanViewModel

@{
    ViewBag.Title = "Challan No";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var officeTypeid = SessionHelper.LoggedInOfficeTypeId;
    var system = SessionHelper.CompanyInfo.CompanyShortName;
}
<input id="system" value="@system" type="hidden">

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/PRProcess/Challan">Challan</a></li>
    </ol>
</div>

<h2 class="page-title">Challan No </h2>
&nbsp;

@using (Html.BeginForm())
{
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        

        @*@Html.TextBoxFor( model=> model.SalaryDay)*@

        <div class="container-fluid">
            <div id="AjaxLoader" class="ajaxLoader"></div>

