                            <div class="col-sm-8">
                                @Html.DropDownListFor(model => model.PVHeadOfficeId, Model.AreaList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6" id="ProjectDiv">
                        <div class="item form-group">
                            @Html.LabelFor(model => model.PVProjectId, new { @class = "control-label col-sm-4 required" })
                            <div class="col-sm-8">
                                @Html.DropDownListFor(model => model.PVProjectId, Model.AreaList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6" id="ZoneDiv">
                        <div class="item form-group">
                            @Html.LabelFor(model => model.ZoneId, new { @class = "control-label col-sm-4 required" })
                            <div class="col-sm-8">
                                @Html.DropDownListFor(model => model.ZoneId, Model.ZoneList, new { @class = "form-control", @required = "required" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6" id="AreaDiv">
                        <div class="item form-group">
                            @Html.LabelFor(model => model.AreaId, new { @class = "control-label col-sm-4 required" })
                            <div class="col-sm-8">
                                @Html.DropDownListFor(model => model.AreaId, Model.AreaList, new { @class = "form-control", @required = "required" })
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6" id="UnitDiv">
                        <div class="item form-group">
                            @Html.LabelFor(model => model.UnitId, new { @class = "control-label col-sm-4 required" })
                            <div class="col-sm-8">
                                @Html.DropDownListFor(model => model.UnitId, Model.UnitList, new { @class = "form-control", @required = "required" })
                            </div>
                        </div>
                    </div>
                </div>



                <div class="row">

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="control-label col-md-4"> Year</label>
                            <div class="col-md-8">
                                @Html.DropDownList("Years", null, new { @ID = "Year", @class = "form-control" })
                            </div>
                        </div>
                    </div>



                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="control-label col-md-4"> Month</label>
                            <div class="col-md-8">
                                @Html.DropDownList("Months", null, new { @ID = "Month", @class = "form-control" })
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="control-label col-md-4"> Challan No</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" id="ChallnNo" name="ChallnNo" />
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label class="control-label col-md-4"> Challan Date</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" id="ChallanDate" name="ChallanDate" />
                            </div>
                        </div>
                    </div>

                </div>

            </div>



            <div class="row" id="dvButton">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="form-group form-action" style="padding-top:10px ;padding-left:10px;margin:5px;">
                            <input type="button" id="btnSave" value="Save" class="btn btn-primary" /> &nbsp;&nbsp;
                            <input type="button" id="btnView" value="View" class="btn btn-primary" />&nbsp;&nbsp;

                        </div>
                    </div>
                </div>
            </div>

            <div class="box-content">
                <h4><label id="beforeApprovalLbl">Challan List</label></h4>
                <div class="table-responsive">
                    <div id="beforeApprovalGridKendo"></div>
                </div>
            </div>

        </div>
    </div>
}

<script type="text/javascript">


    function GenerateDropDownList(dorpDownFieldId, controllerName, functionName) {
        var ddlName = $("#'" + dorpDownFieldId + "");
        var dataUrl = '/' + controllerName + '/' + functionName + '';

        $('#AjaxLoader').show();
        $.ajax({
            type: "GET", //GET or POST or PUT or DELETE verb
            url: dataUrl, // Location of the service
            data: {}, //Data sent to server
            dataType: "json", //Expected data format from server
            processdata: false, //True or False
            success: function (data) { //On Successful service call
                $('#AjaxLoader').hide();
                ddlName.html('');
                if (data.length > 0) {
                    $.each(data, function (i, option) {
                        ddlName.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                    });
                }
            },
            error: function (data) {
                $('#AjaxLoader').hide();
                $.alert.open('error', 'Error');
            }
        });
    }

