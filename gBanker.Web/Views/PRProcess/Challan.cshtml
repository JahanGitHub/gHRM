    $(document).ready(function () {
        $("#HeadOfficeDiv").hide();
        $("#ProjectDiv").hide();
        $("#ZoneDiv").hide();
        $("#AreaDiv").hide();
        $("#UnitDiv").hide();

        // GetAllOfficeType();
        //GetAllZoneOffice();




        $("#OfficeTypeId").change(function () {

            var officeType = $("#OfficeTypeId").val();
            if (officeType != "") {
                $("#ZoneId").val('');
                $("#AreaId").html('<option value="">Please Select</option>');
                $("#UnitId").html('<option value="">Please Select</option>');

                if (officeType == 1) {
                    GetHeadOfficeByOfficeType();
                    $("#HeadOfficeDiv").show();

                    $("#ProjectDiv").hide();
                    $("#ZoneDiv").hide();
                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();
                } else if (officeType == 3) { //project
                    $("#HeadOfficeDiv").hide();

                    GetProjectsByOfficeType();
                    $("#ProjectDiv").show();
                    $("#ZoneDiv").hide();
                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();

                } else if (officeType == 4) { //zone
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();

                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();
                    $("#ZoneDiv").show();
                } else if (officeType == 5) { //area
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();
                    $("#UnitDiv").hide();

                    $("#ZoneDiv").show();
                    $("#AreaDiv").show();
                } else if (officeType == 6) { //field
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();
                    $("#UnitDiv").show();
                    $("#ZoneDiv").show();
                    $("#AreaDiv").show();
                }
            } else {
                $("#HeadOfficeDiv").hide();
                $("#ProjectDiv").hide();
                $("#ZoneDiv").hide();
                $("#AreaDiv").hide();
                //$("#AreaId").html('<option value="">Please Select</option>');
                $("#UnitDiv").hide();
                //$("#UnitId").html('<option value="">Please Select</option>');
            }
        });

        $("#ZoneId").change(function () {

            var zoneId = $("#ZoneId").val();
            var ddlArea = $("#AreaId");
            var officeTypeId = $("#OfficeTypeId").val();

            if (zoneId != "" && (officeTypeId == 5 || officeTypeId == 6)) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "GET", //GET or POST or PUT or DELETE verb
                    url: '/Office/getAllAreaIdByZoneCode', // Location of the service
                    data: { ZoneId: zoneId }, //Data sent to server
                    dataType: "json",
                    async: false,//Expected data format from server
                    processdata: false, //True or False
                    success: function (data) { //On Successful service call
                        $('#AjaxLoader').hide();
                        ddlArea.html('');
                        if (data.length > 0) {
                            $.each(data, function (i, option) {
                                ddlArea.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                            });
                        }
                        $("#UnitId").html('<option value="">Please Select</option>');
                    },
                    error: function (data) {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', 'Error');
                    }
                });
            } else {
                ddlArea.html('<option value="">Please Select</option>');
                $("#UnitId").html('<option value="">Please Select</option>');

            }
        });

        $("#AreaId").change(function () {

            var areaId = $("#AreaId").val();
            var ddlUnit = $("#UnitId");
            var officeTypeId = $("#OfficeTypeId").val();

            if (areaId != "" && (officeTypeId == 6)) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "GET", //GET or POST or PUT or DELETE verb
                    url: '/Office/getAllUnitIdByAreaCode', // Location of the service
                    data: { AreaId: areaId }, //Data sent to server
                    dataType: "json", //Expected data format from server
                    async: false,
                    processdata: false, //True or False
                    success: function (data) { //On Successful service call
                        $('#AjaxLoader').hide();
                        ddlUnit.html('');
                        if (data.length > 0) {
                            $.each(data, function (i, option) {
                                ddlUnit.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                            });
                        }
                    },
                    error: function (data) {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', 'Error');
                    }
                });
            } else {
                $("#UnitId").html('<option value="">Please Select</option>');

            }
        });

        var _OfficeTypeId = '@Model.OfficeTypeId';
        if (parseInt(_OfficeTypeId) > 0) {

            $("#OfficeTypeId").val(_OfficeTypeId);
            $('#OfficeTypeId').val(_OfficeTypeId).trigger('change');
            $('#OfficeTypeId').change();
            if (parseInt(_OfficeTypeId) == 1) {
                $("#PVHeadOfficeId").val('@Model.PVHeadOfficeId');
            }
            else if (parseInt(_OfficeTypeId) == 3) {
                $("#PVProjectId").val(@Model.PVProjectId);
            }
            else if (parseInt(_OfficeTypeId) == 4) {
                $("#ZoneId").val(@Model.ZoneId);
            }
            else if (parseInt(_OfficeTypeId) == 5) {
                $("#ZoneId").val(@Model.ZoneId);
                $("#ZoneId").val(@Model.ZoneId).trigger('change');

                $("#AreaId").val('@Model.AreaId');
            } else if (parseInt(_OfficeTypeId) == 6) {
                $("#ZoneId").val(@Model.ZoneId);
                $("#ZoneId").val(@Model.ZoneId).trigger('change');
                $("#AreaId").val(@Model.AreaId);
                $("#AreaId").val(@Model.AreaId).trigger('change');
                $("#UnitId").val(@Model.UnitId);
            }

        } else {
            $("#OfficeTypeId").val("");
        }


        $("#ChallanDate").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1920:2100"
        });

        $("#btnSave").click(function () {
            var ChallnNo = $("#ChallnNo").val();
            var year = $("#Year").val();
            var month = $("#Month").val();
            //var OfficeTypeId = $("#OfficeTypeId").val();


            var officeTypeId = $("#OfficeTypeId").val();
            //var salaryDate = $("#ProcessDate").val();

            var OfficeId = "";
            //var officeTypeId = $("#OfficeTypeId").val();
            console.log(officeTypeId);
            if (officeTypeId != "") {
                if (officeTypeId == 1) {
                    OfficeId = $("#PVHeadOfficeId").val();
                } else if (officeTypeId == 3) {
                    OfficeId = $("#PVProjectId").val();
                }
                else if (officeTypeId == 4) {
                    OfficeId = $("#ZoneId").val();
                }
                else if (officeTypeId == 5) {
                    OfficeId = $("#AreaId").val();
                }
                else if (officeTypeId == 6) {
                    OfficeId = $("#UnitId").val();
                }
            }
            console.log(OfficeId);

            //var officeID = $("#OfficeId").val();
            var ChallanDate = $('#ChallanDate').val();

            if (Year == "" || Month == 0 || ChallnNo == "" || officeTypeId == "" || OfficeId == "" || ChallanDate == "") {
                $.alert.open("Message", "Please Fill All required Data.");
                return false;
            }


            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '/PRProcess/ChallanSave',
                data: {
                    ChallnNo: ChallnNo,
                    month: month,
                    year: year,
                    OfficeTypeId: officeTypeId,
                    OfficeId: OfficeId,
                    ChallanDate: ChallanDate,

                },
                dataType: 'json',
                async: true,
                success: function (data) {
                    $.alert.open("Message", data);
                },
                error: function (request, status, error) {
                    $.alert.open("Message", error);
                }
            });


        });

        $('#btnView').click(function () {

            var ChallnNo = $("#ChallnNo").val();
            var year = $("#Year").val();
            var month = $("#Month").val();
            //var OfficeTypeId = $("#OfficeTypeId").val();


            var officeTypeId = $("#OfficeTypeId").val();
            //var salaryDate = $("#ProcessDate").val();

            var OfficeId = "";
            //var officeTypeId = $("#OfficeTypeId").val();
            console.log(officeTypeId);
            if (officeTypeId != "") {
                if (officeTypeId == 1) {
                    OfficeId = $("#PVHeadOfficeId").val();
                } else if (officeTypeId == 3) {
                    OfficeId = $("#PVProjectId").val();
                }
                else if (officeTypeId == 4) {
                    OfficeId = $("#ZoneId").val();
                }
                else if (officeTypeId == 5) {
                    OfficeId = $("#AreaId").val();
                }
                else if (officeTypeId == 6) {
                    OfficeId = $("#UnitId").val();
                }
            }
            console.log(OfficeId);
           //var officeID = $("#OfficeId").val();
            var ChallanDate = $('#ChallanDate').val();

            if (year == "0" || month == "0"  || officeTypeId == "" || OfficeId == "" ) {
                $.alert.open("Message", "Please Fill All required Data.");
                return false;
            }

             if( month != '0' && year != "0" && officeTypeId != '' && OfficeId != '' ) {
                SummaryPreview(ChallnNo, month, year, officeTypeId, OfficeId, ChallanDate );
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        });

    });

</script>

