@model gHRM.Web.ViewModels.PF.LoanCollectionViewModel

@{
    ViewBag.Title = "Loan Collection";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>

<script type="text/javascript">

    function isPositiveNumber(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode < 48 || charCode > 57)
            return false;
        return true;
    }

    $(document).ready(function () {

         @if (Model.IsOpen == true)
         {
             <text>
             $("#create").removeClass('disabled');
             </text>
         }
        
        @if(Model.IsOpen == false){
            <text>
            $("#create").addClass('disabled');
            </text>
        }
        
        $("input[type=text]:visible:enabled").first().focus();
        $('#EmployeeId').keypress(function (event) {
            return isPositiveNumber(event, this)
        });
        $('#LoanId').keypress(function (event) {
            return isPositiveNumber(event, this)
        });

        $("#btnSearch").click(function () {
            var employeeCode = $("#EmployeeCode").val();
            var employeeName = $("#EmployeeName").val();
            
            //if (employeeId == "" && employeeName == "" && loanId == "" && collectionTypeId == "") {
            //    $('#grid').jtable('load', {});
            //}
            $('#grid2').jtable('load', { employeeCode: employeeCode, employeeName: employeeName });
        });

     
        $('#grid2').jtable({
            // title: 'Investor List',
            paging: true,
            pageSize: 5,
            sorting: false,
            defaultSorting: 'Name ASC',
            actions: {
                listAction: '/PFLoanCollection/GetLoanCollectionList'
            },
            fields: {
                CollectionId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                LoanId: {
                    title: 'Loan Id',
                    width: '6%',
                },
                EmployeeCode: {
                    title: 'Emp. Code',
                    width: '8%',
                },
                EmployeeName: {
                    title: 'Employee Name',
                    width: '15%',
                },
                TransactionDate: {
                    title: 'Transaction Date',
                    width: '8%',
                },
                LoanAmount: {
                    title: 'Loan Amount',
                    width: '10%'
                },
                InterestAmount: {
                    title: 'Interest Amount',
                    width: '10%'
                },
                TotalInstallment: {
                    title: 'Total Installment',
                    width: '10%'
                },
                Sundry: {
                    title: 'Sundry',
                    width: '8%'
                },
                InterestCharge: {
                    title: 'Interest Charge',
                    width: '10%'
                },
                Comment: {
                    title: 'Comments',
                    width: '15%'
                },
                EditLink: {
                    title: "Edit",
                    width: '5%',
                    display: function (data) {
                        return "<div class='text-center'><a href='/PFLoanCollection/EditLoanCollection/" + data.record.CollectionId + "'><i title='edit' class='fa fa-pencil-square-o'></i></a></div>";
                    }
                }
            }
        });

        reloadGrid2();
        $("#filterColumn").change(function () {
            if ($(this).val() === "ViewAll") {
                $("#filterValue").val('');
            }
        });

        function reloadGrid2() {
            $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
        }
    });
</script>

@Html.ActionLink("Loan Collection", "CreateLoanCollection", null, new { @class = "btn btn-success btn-sm pull-right", id = "create" })
&nbsp;
<h2 class="page-title">Loan Collection List
    &nbsp;&nbsp;&nbsp;
    <span style="color: black; font-size:14px;">[ Day State:&nbsp;@Model.DayStatus</span>&nbsp;&nbsp;&nbsp;
    <span style="color: black; font-size: 14px; "> Transaction Date:&nbsp;@Model.TransactionDate ]</span>
</h2>
&nbsp;

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <div class="row">
            <div class="form-group">

                @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-sm-4">
                    @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control col-md-4", @Placeholder = "Employee Code" } })
                </div>

                @*@Html.LabelFor(model => model.EmployeeId, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-sm-4">
                    @Html.EditorFor(model => model.EmployeeId, new { htmlAttributes = new { @class = "form-control col-md-4", @Placeholder = "Employee Id" } })
                </div>*@
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-sm-4">
                    @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control col-md-4", @Placeholder = "Employee Name" } })
                </div>
                <div class="col-sm-4">
                    <input type="button" value="Search" id="btnSearch" class="btn btn-warning" />
                </div>
            </div>
        </div>
            
        <div id="grid2">
        </div>
    </div>
   
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
}