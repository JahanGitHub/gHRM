@model gHRM.Web.ViewModels.PF.LoanCollectionViewModel

@{
    ViewBag.Title = "CreateLoanCollection";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@Html.ActionLink("Back to List", "LoanCollectionList", null, new { @class = "pull-right   btn btn-success" })
&nbsp;
<h2 class="page-title">
    Loan Installment Entry
    &nbsp;&nbsp;&nbsp;
    <span style="color: black; font-size:14px;">[ Day State:&nbsp;@Model.DayStatus</span>&nbsp;&nbsp;&nbsp;
    <span style="color: black; font-size: 14px; "> Transaction Date:&nbsp;@Model.TransactionDate ]</span>
</h2>
&nbsp;

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.IsOpen)
        @Html.HiddenFor(model => model.TransactionDate)

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control", @tabindex = 1, @Placeholder = "Enter Employee Code" } })
                    @Html.HiddenFor(model => model.EmployeeId)
                </div>
                @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.LoanTypeId, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.DropDownListFor(model => model.LoanTypeList, new List<SelectListItem>(), new { @class = "form-control", @tabindex = 2 })
                </div>
                @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control", @tabindex = 4, @Placeholder = "Enter Amount" } })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.Comment, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-3">
                    @Html.TextAreaFor(model => model.Comment, new { @class = "form-control", @tabindex = 5, @Placeholder = "Enter Comments" })
                </div>
                <div class="col-md-2">
                </div>
                <div class="col-md-5">
                    @if (Model.IsOpen == true)
                    {
                        <input type="button" value="Save" id="btnSaveLoanCollection" class="btn btn-success" tabindex="6" />
                        @:&nbsp;
                        <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" tabindex="7" />
                    }
                    &nbsp;
                    <button type="button" id="btnPrintLoanInstallment" class="btn btn-primary" onclick="JavaScript: appLoanInsEntryManager.printLoanCollection('divPrint');" tabindex="7"><i class="fa fa-print"></i> Print</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">

                <fieldset style="border: 1px solid gray;">
                    <legend>Disburse Info</legend>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.LoanId, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.LoanId, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DisburseDate, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.DisburseDate, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.DisburseAmount, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.DisburseAmount, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.IntersetRate, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.IntersetRate, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.InterestCharge, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.InterestCharge, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.NoOfInstallment, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.NoOfInstallment, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.MonthlyInstallment, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.MonthlyInstallment, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="col-md-4">
                <fieldset style="border: 1px solid gray;">
                    <legend>Payment Info</legend>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.LoanPaid, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.LoanPaid, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.InterestPaid, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.InterestPaid, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.PrincipalDue, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.PrincipalDue, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.InterestDue, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.InterestDue, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.TotalDue, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.TotalDue, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.InterestUptoOn, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.InterestUptoOn, new { htmlAttributes = new { @class = "form-control interest-upto-datepicker" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.CurrentInterestCharge, htmlAttributes: new { @class = "control-label col-md-5" })
                            <div class="col-md-6">
                                @Html.EditorFor(model => model.CurrentInterestCharge, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <label class="control-label col-md-12 total-due-amount-upto"><span id="TotalDueAmountUpto"></span></label>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset style="border: 1px solid gray;">
                    <legend>Installment Distribution</legend>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.LoanInstallment, htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.LoanInstallment, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.InterestInstallment, htmlAttributes: new { @class = "control-label col-md-6" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.InterestInstallment, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>

    </div>
}

@Html.Partial("_PrintLoanInstallmentCollectionPartial")

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
   
    <script src="~/Assets/js/app/pf/pfLoanInstallmentEntryManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}
