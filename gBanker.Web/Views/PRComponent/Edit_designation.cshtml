                    <div class="form-group">
                        <label class="control-label col-sm-4 "> Loan Calculation Type</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.LoanCalculationId, Model.LoneCalculationList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>

            @*Salary Account Code*@
            <div class="col-sm-12">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.SalaryAccCode, htmlAttributes: new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.SalaryAccCode, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.AccountName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.AccountName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        </div>
                    </div>
                </div>
            </div>
            @*Salary Impact Row*@
            <div class="col-sm-12">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.SalaryChangesByComponent, htmlAttributes: new { @class = "control-label col-md-4" })

                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.SalaryChangesByComponent, Model.SalaryChangesByComponentList, new { @class = "form-control" })
                            <br /> <input type="button" id="btnShowDetailChangesinRegular" value="detail" />
                        </div>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.IsSalaryImpactProhibited, htmlAttributes: new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.IsSalaryImpactProhibited, Model.SalaryImpactProhibitedList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>

            </div>

        </div>
        <br />
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    &nbsp;
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdatePRComponent()" />
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/alert")
}