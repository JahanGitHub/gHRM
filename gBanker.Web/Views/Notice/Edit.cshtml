@model gHRM.Web.ViewModels.Basic.NoticeViewModel

@{ ViewBag.Title = "Edit Notice";
                Layout = "~/Views/Shared/_AdminLteLayout.cshtml"; }

<script type="text/javascript">

    $(document).ready(function () {

        $("#PublishDateMsg").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true
        });

        $("#LiveFromMsg").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true
        });

        $("#LiveToMsg").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true
        });

        $("#btnNoticeUpdate").click(function (e) {

            e.preventDefault();

            for (instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }

            $('#frmNoticeEdit').ajaxSubmit({

                type: "POST",
                dataType: 'json',

                success: function (data) {
                    if (data.Result == "OK") {
                        $.alert.open('success', 'Updated Successfully', function () {
                            window.location.href = '/Notice/Index';
                        });
                    }
                    else {
                        $.alert.open('error', data.Message);
                    }
                },

                error: function () {

                    $.alert.open('error', 'Error while updating');
                }
            });

        });

    });

</script>

@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right btn btn-success" })

