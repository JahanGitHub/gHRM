                            )
                        </div>

                    </div>

                </div>

            </div>*@

            <div class="row">
                <div class="col-sm-12">

                    <div class="form-group">

                        @Html.LabelFor(model => model.Title,
                            htmlAttributes: new { @class = "control-label col-md-2" })

                        <div class="col-sm-10">

                            @Html.EditorFor(model => model.Title,
