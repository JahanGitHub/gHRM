@model gHRM.Web.ViewModels.Basic.NoticeViewModel
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style type="text/css">
    #multiSection {
        width: 40px;
    }

    .required {
        color: red;
    }

    table.jambo_table thead {
        background: rgba(52, 73, 94, 0.94);
        color: #ECF0F1;
    }

    .table > thead > tr > th, .table > tbody > tr > th, .table > tfoot > tr > th, .table > thead > tr > td, .table > tbody > tr > td, .table > tfoot > tr > td {
        padding: 11px;
        line-height: 1.42857143;
        vertical-align: top;
        border-top: 1px solid #ddd;
    }

    .table-striped > tbody > tr:nth-of-type(odd) {
        background-color: #eee;
    }

    .table > tbody > tr:hover {
        background-color: #9E9E9E;
    }

    .table {
        width: 100%;
        counter-reset: rowNumber;
    }

        .table > tbody > tr {
            counter-increment: rowNumber;
        }

            .table > tbody > tr > td:first-child::before {
                content: counter(rowNumber);
            }
</style>
<script type="text/javascript">

    $(document).ready(function () {

        $("#btnNoticeNew").hide();

        $("#btnNoticeSave").click(function (e) {
            e.preventDefault();

            for (instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }

            $('#frmNotice').ajaxSubmit({
                    type: "POST",
                    target: '#thumbnil',
                    /*data: { CrimeLocation: CrimeLocation },*/
                    dataType: 'json',
                    resetForm: true,
                    success: function (model) {
                        $("#NoticeId").val(model.NoticeId);
                        $("#Title").val(model.Title);
                        $("#NoticeText").val(model.NoticeText);
                        $("#PublishDateMsg").val(model.PublishDateMsg);
                        $("#LiveFromMsg").val(model.LiveFromMsg);
                        $("#LiveToMsg").val(model.LiveToMsg);

                        $("#btnNoticeNew").show();
                        $("#btnNoticeSave").hide();

                        $.alert.open('success', 'Save Successfully', function () {
                            window.location.href = '/Notice/Index';
                        });
                    },
                    error: function () {
                        $("#dialog-message").html('<p>Error, Fail to Save.</p>');
                        $("#dialog-message").dialog({
                            modal: true,
                            buttons: {
                                Ok: function () {
                                    $(this).dialog("close");
                                }
                            }
                        });
                    }
                });

        });

        $("#PublishDateMsg").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: "1920:2025"
         });
        $("#LiveFromMsg").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1920:2025"
        });
        $("#LiveToMsg").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1920:2025"
        });

        $("#btnNoticeNew").click(function () {
            location.reload();
        });

    });

</script>
@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right   btn btn-success" })
<br />
<h2 class="page-title">Notice</h2>

