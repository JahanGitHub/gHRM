                            )

                        </div>

                    </div>

                </div>*@

            </div>

            @*<div class="row">

                <div class="col-sm-6">

                    <div class="form-group">

                        @Html.LabelFor(m => m.OfficeTypeId, htmlAttributes: new { @class = "control-label col-md-4" })

                        <div class="col-sm-8">

                            @Html.DropDownListFor(
                                m => m.OfficeTypeId,
