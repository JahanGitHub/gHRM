
@{
    ViewBag.Title = "Import Transfer Backlog Confirmation"; 
     Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@section AdminPageBreadCrumb {
    <div class="row">
        <ol class="breadcrumb breadcrumb-arrow">
            <li><a href="/EmployeeTransferImport/import">Import Transfer Backlog</a></li>
            <li><a href="/EmployeeTransferImport/importconfirmation">Import Exsting Transfer Backlog Confirmation</a></li>
        </ol>
    </div>
}

<h2 class="page-title">@ViewBag.Title</h2>
&nbsp;
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 text-center-force main-box small-graph-box gray-bg">
                        <h3>
                            <span class="text-success">
                                <i class="fa fa-check-circle light-gray"></i> Import Transfer Backlog Confirmation!
                            </span>
                        </h3>
                        <h4>Your transfer backlog were imported successfully!</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}
