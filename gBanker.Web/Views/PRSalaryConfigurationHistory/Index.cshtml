<script type="text/javascript">

    function LoadEmployeeSalaryHistory(employee_code) {
        if (employee_code != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("LoadEmployeeSalaryHistory", "PRSalaryConfigurationHistory", "http")',
                data: { employee_code: employee_code },
                dataType: 'json',
                async: false,
                cache: false,
                success: function (Data) {
                    if (Data.Message == "OK") {
                        var dtTable = $('#tblSalaryConfigurationForSalary');
                        dtTable.find('tbody').html("");
                        var NewSl = 0;
                        var lastSl = 0;
                        var rowValue = "";
                        if (Data.List_ViewModel[0] != null) {

                            $.each(Data.List_ViewModel, function (id, option) {
                                NewSl++;
                                rowValue += ('<tr id="tableRow' + NewSl + '">' +
                                    '<td><input type="text" value="' + NewSl + '" style="display:none;" name="NewSl" id="txtNewSl' + NewSl + '" /></td>' +
                                    '<td>' + option.EmployeeID + '<input type="text" value="' + option.EmployeeID + '" style="display:none;" name="EmployeeID" id="txtEmployeeID' + NewSl + '" /></td>' +
                                    '<td>' + option.SalaryAmount + '<input type="text" value="' + option.SalaryAmount + '" style="display:none;" name="SalaryAmount" id="txtSalaryAmount' + NewSl + '" /></td>' +
                                    '<td>' + option.CreateDateMsg + '<input type="text" value="' + option.CreateDateMsg + '" style="display:none;" name="CreateDateMsg" id="txtCreateDateMsg' + NewSl + '" /></td>' +
                                    '<td>' + '<button class="btn btn-xs btn-light" title="Salary Component Details" onclick="LoadEmployeeSalaryHistoryDetails(\'' + option.EmployeeID + '\',\'' + option.CreateDateTime + '\')"  id="txtEdit' + NewSl + '" ><i class="fa fa-search"> </button></td>' +
                                    '</tr>');
                            });
                            var tableBody = dtTable.find('tbody').html(rowValue);
                        }
                    }
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
    }

    function LoadEmployeeSalaryHistoryDetails(EmployeeId, CreateDateMsg) {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",

            url: '@Url.Action("LoadEmployeeSalaryHistoryDetails", "PRSalaryConfigurationHistory", "http")',
            data: { EmployeeId: EmployeeId, CreateDateMsg: CreateDateMsg },
            dataType: 'json',
            async: false,
            cache: false,
            success: function (Data) {
                if (Data.Message == "OK") {

                    var dtTable = $('#tblSalaryConfigurationForSalaryDetails');
                    dtTable.find('tbody').html("");
                    var NewSl = 0;
                    var lastSl = 0;
                    var rowValue = "";
                    if (Data.List_ViewModel[0] != null) {

                        $.each(Data.List_ViewModel, function (id, option) {
                            NewSl++;
                            rowValue += ('<tr id="tableRow' + NewSl + '">' +
                                '<td><input type="text" value="' + NewSl + '" style="display:none;" name="NewSl" id="txtNewSl' + NewSl + '" /></td>' +
                                //'<td>' + option.EmployeeID + '<input type="text" value="' + option.EmployeeID + '" style="display:none;" name="EmployeeID" id="txtEmployeeID' + NewSl + '" /></td>' +
                                '<td>' + option.CreateDateMsg + '<input type="text" value="' + option.CreateDateMsg + '" style="display:none;" name="CreateDateMsg" id="txtCreateDateMsg' + NewSl + '" /></td>' +

                                '<td>' + option.ComponentName + '<input type="text" value="' + option.PRComponentId + '" style="display:none;" name="PRComponentId" id="txtPRComponentId' + NewSl + '" /><input type="text" value="' + option.ComponentName + '" style="display:none;" name="ComponentName" id="ComponentName' + NewSl + '" /></td>' +
                                //'<td>' + option.PRComponentID + '<input type="text" value="' + option.PRComponentID + '" style="display:none;" name="PRComponentID" id="txtPRComponentID' + NewSl + '" /></td>' +
                                '<td>' + option.ComponentAmount + '<input type="text" value="' + option.ComponentAmount + '" style="display:none;" name="ComponentAmount" id="txtComponentAmount' + NewSl + '" /></td>' +
                                '<td>' + option.ComponentCategory + '<input type="text" value="' + option.ComponentCategory + '" style="display:none;" name="ComponentCategory" id="txtComponentCategory' + NewSl + '" /></td>' +
                                //'<td>' + option.PRSalaryConfigurationID + '<input type="text" value="' + option.PRSalaryConfigurationID + '" style="display:none;" name="PRSalaryConfigurationID" id="txtPRSalaryConfigurationID' + NewSl + '" /></td>' +

                                '<td>' + option.EffectiveStartDateMsg + '<input type="text" value="' + option.EffectiveStartDateMsg + '" style="display:none;" name="EffectiveStartDateMsg" id="txtEffectiveStartDateMsg' + NewSl + '" /></td>' +
                                '<td>' + option.EffectiveEndDateMsg + '<input type="text" value="' + option.EffectiveEndDateMsg + '" style="display:none;" name="EffectiveEndDateMsg" id="txtEffectiveEndDateMsg' + NewSl + '" /></td>' +
                                '<td>' + option.TransactionType + '<input type="text" value="' + option.TransactionType + '" style="display:none;" name="TransactionType" id="txtTransactionType' + NewSl + '" /></td>' +
                                '</tr>');
                        });
                        var tableBody = dtTable.find('tbody').html(rowValue);
                    }

                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function hideUnhideDiv() {
        var salType = $("#SalaryGenerationType").val();

        if (salType != "") {
            if (salType == "PS") {
                $("#GradeList").val('');
                $("#SalaryScaleList").val('');
                $("#gradeScaleDiv").show();
                $("#grossSalaryDiv").show();
                $("#GrossSalary").attr("readonly", true);
            }
            else if (salType == "NPS") {
                $("#gradeScaleDiv").hide();
                $("#GrossSalary").val('');
                $("#GrossSalary").removeAttr("readonly");
                $("#grossSalaryDiv").show();
            }
        } else {
            return false;
        }
    }


    function LoadEmployeeInformationbyCode(employee_code) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetExistingSalaryConfigurationListbyEmployeeCode", "PRSalaryConfigurationHistory", "http")',
            data: { employeeCode: employee_code },
            dataType: 'json',
            async: false,
            cache: false,
            success: function (data) {
                if (data.Result == "OK") {
                    if (data.dataList.length > 0) {
                        GenerateTableWithData(data.dataList);
                    }

                    if (data.dataList != null) {
                        if (data.dataList[0].EmployeeTypeId == 0) {
                            $("#EmployeeSalaryType").val("");
                        } else {
                            $("#EmployeeSalaryType").val(data.dataList[0].EmployeeTypeId);
                        }

                        $("#txtEmpStatus").val(data.dataList[0].EmployeeStatusName);
                        $("#EmployeeStatusId").val(data.dataList[0].EmployeeStatusId);
                        $("#JoiningDate").val(data.JoiningDate);
                        $("#ConfirmationDate").val(data.ConfirmationDate);
                        $("#BankAccountNo").val(data.BankAccountNo);
                        $("#DepartmentName").val(data.DepartmentName);
                        $("#DesignationName").val(data.DesignationName);
                        $("#OfficeLocationId").val(data.OfficeLocationId);
                        $("#OfficeId").val(data.OfficeId);
                        //$("#IncrementYearFrom").val(data.IncrementYear);
                        hideUnhideDiv();

                        if (data.dataList[0].GradeId == 0) {
                            $("#SalaryGenerationType").val("NPS");
                            $("#GradeList").val("");
                            $("#GrossSalary").attr('Disabled', false);
                        } else {
                            $("#SalaryGenerationType").val("PS");
                            hideUnhideDiv();
                            $("#GradeList").val(data.dataList[0].GradeId);
                        }

                        if (data.dataList[0].Step == 0) {
                            $("#SalaryScaleList").val("");
                        } else {
                            $("#SalaryScaleList").val(data.dataList[0].Step);
                        }
                        var incMonth = data.dataList[0].IncrementMonth == 0 ? "" : data.dataList[0].IncrementMonth;
                        var incYear = data.dataList[0].IncrementYearFrom == 0 ? "" : data.dataList[0].IncrementYear;

                        var bankName = data.dataList[0].BankName == null ? "" : data.dataList[0].BankName;
                        var bankBranchName = data.dataList[0].BankBranchName == null ? "" : data.dataList[0].BankBranchName;

                        $("#BankName").val(bankName);
                        $("#BankBranchName").val(bankBranchName);

                        $("#MonthList").val(incMonth);
                        $("#IncrementYearFrom").val(incYear);

                        $("#GrossSalary").val(data.dataList[0].GrossSalary);
                        $("#EffectiveStartDate").val(data.dataList[0].EffectiveStartDate);
                        $("#EffectiveEndDate").val(data.dataList[0].EffectiveEndDate);
                        $("#BankAccountNo").val(data.dataList[0].BankAccountNo);
                        $("#OvertimeHour").val(data.dataList[0].OvertimeHour);
                        $("#OvertimeRate").val(data.dataList[0].OvertimeRate);
                        $("#IsOverTime").val("" + data.dataList[0].IsOverTime + "");
                        $("#MaxOvertimePerDay").val(data.dataList[0].MaxOvertimePerDay);
                        $("#MaxOvertimePerMonth").val(data.dataList[0].MaxOvertimePerMonth);

                        if (data.dataList[0].IsOverTime == true) {
                            //$("#overtime").show();
                            $("#overtimeDuration").show();
                        } else {
                            //$("#overtime").hide();
                            $("#overtimeDuration").hide();
                        }
                        $("#LoginTime").val(data.dataList[0].LogInTime);
                        $("#LogoutTime").val(data.dataList[0].LogOutTime);
                        $("#LastLoginTime").val(data.dataList[0].LastLoginTime);
                        $("#OfficeID").val(data.dataList[0].OfficeID);
                        $("#EmployeeID").val(data.dataList[0].EmployeeID);
                        $("#EmployeeName").val(data.dataList[0].EmployeeName);
                        //alert(data.dataList[0].EmployeeStatus);
                        $("#EmployeeStatus").val(data.dataList[0].EmployeeStatus);
                        if (data.dataList[0].IncrementMonth == 0) {
                            $("#MonthList").val("");
                        } else {
                            $("#MonthList").val(data.dataList[0].IncrementMonth);
                        }

                    }
                }
            },
            error: function (request, status, error) {
                $("#ComponentAmount").val('');
                //alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function GenerateTableWithData(dataTable) {
        var dtTable = $('#tblSalaryConfiguration');
        dtTable.find('tbody').html("");
        var NewSl = 0;
        var lastSl = 0;
        var rowValue = "";
        if (dataTable[0] != null) {
            var prComponentId = dataTable[0].PRComponentId;

            if (prComponentId != "") {
                $.each(dataTable, function (id, option) {
                    NewSl++;
                    if (option.ComponentName == "Income Tax") {
                        $("#IncomeTax").val(option.CalculatedAmount);
                    }
                    rowValue += ('<tr id="tableRow' + NewSl + '">' +
                        '<td><input type="text" value="' + NewSl + '" style="display:none;" name="NewSl" id="txtNewSl' + NewSl + '" /></td>' +
                        '<td>' + option.ComponentName + '<input type="text" value="' + option.PRComponentId + '" style="display:none;" name="PRComponentId" id="txtPRComponentId' + NewSl + '" /><input type="text" value="' + option.ComponentName + '" style="display:none;" name="ComponentName" id="ComponentName' + NewSl + '" /></td>' +
                        '<td>' + option.CalculatedAmount + '<input type="text" value="' + option.CalculatedAmount + '" style="display:none;" name="CalculatedAmount" id="txtCalculatedAmount' + NewSl + '" /></td>' +
                        '<td>' + option.ComponentCategory + '<input type="text" value="' + option.ComponentCategory + '" style="display:none;" name="ComponentCategory" id="txtComponentCategory' + NewSl + '" /></td>' +
                        '<td style="display:none">' + option.TransactionType + '<input type="text" value="' + option.TransactionType + '" style="display:none;" name="TransactionType" id="txtTransactionType' + NewSl + '" /></td>' +
                        '<td>' + option.TransactionTypeView + '<input type="text" value="' + option.TransactionTypeView + '" style="display:none;" name="TransactionTypeView" id="txtTransactionTypeView' + NewSl + '" /></td>' +
                        '</tr>');
                });
                var tableBody = dtTable.find('tbody').html(rowValue);
                $("#incomeTaxDiv").show();
            } else {
                $("#incomeTaxDiv").hide();
            }
        }
    }


    $(document).ready(function () {       

        $("#txtEmpName").blur(function (e) {
            var employee_code = $("#txtEmpName").val();
            if ($("#txtEmpName").val() != '') {
                LoadEmployeeInformationbyCode(employee_code);
                LoadEmployeeSalaryHistory(employee_code);
            }
            else {
                $("#EmployeeName").empty();
                $("#EmployeeName").val('');
                $("#OfficeID").val('');
                $("#GrossSalary").val('');
            }
        });

    });

</script>

