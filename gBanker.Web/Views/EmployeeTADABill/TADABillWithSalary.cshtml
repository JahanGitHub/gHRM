@model gHRM.Web.ViewModels.TaDa.EmployeeTADABillViewModel
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .jtable > thead > tr {
        height: 40px;
