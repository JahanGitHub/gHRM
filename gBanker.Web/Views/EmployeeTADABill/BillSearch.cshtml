
@model gHRM.Web.ViewModels.LeaveSellViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script>

    var ApprovalStatus = "N";

    $(document).ready(function () {
        $("#chkNotPaid").prop('checked', true);
        GetWaitingTADABillList("", "", "", ApprovalStatus);

        $("#chkNotPaid").click(function () {
            var checkVal = $("#chkNotPaid").is(":checked");
            if (checkVal == true) {
                $("#chkPaid").prop('checked', false);

                ApprovalStatus = "N";
                reloadGrid();
            }
            else {
                $("#chkPaid").prop('checked', true);

                ApprovalStatus = "A";
                reloadGrid();
            }
        });

        $("#chkPaid").click(function () {
            var checkVal = $("#chkPaid").is(":checked");
            if (checkVal == true) {
                $("#chkNotPaid").prop('checked', false);

                ApprovalStatus = "A";
                reloadGrid();
            }
            else {
                $("#chkNotPaid").prop('checked', true);

                ApprovalStatus = "N";
                reloadGrid();
            }
        });
    });

    function GetWaitingTADABillList(filterBy, filterValue, Filter_Valuedate, ApprovalStatus) {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    //url: baseURL + '/ProcessCategory/GetProcessCategoryList?QueryOption=' + 1,
                    url: '@Url.Action("GetTADABillList", "EmployeeTADABill", "http")',
                    dataType: 'json',
                    data: { FilterBy: filterBy, FilterValue: filterValue, FilterValuedate: Filter_Valuedate, ApprovalStatus: ApprovalStatus }
                }
            }
        });
        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            //groupable: false,
            ////autoBind: true,
            //reorderable: true,
            //filterable: true,
            //sortable: true,
            //scrollable: true,
            //selectable: false,
            //resizable: true,
            //height:500,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,

            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "TADABillId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "EmployeeId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "Sl",
                    width: "10px",
                    //filterable: true,
                    filterable: false,
                    columnMenu: false,
                    groupable: false,
                    reorderable: false,
                    sortable: false,
                    //locked: true,
                    //lockable: false,
                },
                {
                    field: "EmployeeCode",
                    title: "Code",
                    width: "15px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "28px",
                    filterable: true,
                },
                {
                    field: "MemoNo",
                    title: "Memo",
                    width: "18px",
                    filterable: true,
                },
                {
                    field: "TravelDateMsg",
                    title: "TravelDate",
                    width: "18px",
                    filterable: true,
                },
                {
                    field: "TravelPlace",
                    title: "TravelPlace",
                    width: "15px",
                    //filterable: true,
                },
                {
                    field: "TravelPurpose",
                    title: "TravelPurpose",
                    width: "15px",
                    //filterable: true,
                },
                {
                    field: "ApproveDateMsg",
                    title: "ApproveDate",
                    width: "18px",
                    filterable: true,
                },
                 {
                     field: "ClaimAmount",
                     title: "ClaimAmount",
                     width: "15px",
                     filterable: true,
                 },
                 {
                     field: "ApproveAmount",
                     title: "ApprovedAmount",
                     width: "15px",
                     filterable: true,
                 },
                 {
                     field: "Remark",
                     title: "Remark",
                     filterable: false,
                     width: "28px",
                     template: function (dataItem) {
                         if (dataItem.IsAmountPaid == true) {
                             return '<div class="text-center"><label>' + dataItem.Remark + '</label></div>';
                         } else {
                             return '<div class="text-center"><input type="text" id="txtRemarks' + dataItem.TADABillId + '"></input></div>';
                         }
                     }
                 },
                {
                    field: "Approve",
                    title: "Approve",
                    filterable: false,
                    width: "12px",
                    template: function (dataItem) {
                        if (dataItem.IsAmountPaid != true) {
                            return '<div class="text-center"><a title="Provide TADA Bill" href="#" OnClick="ProvideTADABill(' + dataItem.TADABillId + ');"><i class="fa fa-check"></i></a></div>';
                        }
                        else {
                            return "";
                        }
                    }
                },
                {
                    field: "Delete",
                    title: "Delete",
                    filterable: false,
                    width: "12px",
                    template: function (dataItem) {
                        if (dataItem.IsAmountPaid != true) {
                            return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + dataItem.TADABillId + ');"><i class="fa fa-trash-o"></i></a></div>';
                        } else {
                            return "";
                        }
                    }
                }
            ]
        });
    }

    function ProvideTADABill(TADABillId) {
        $.alert.open('confirm', 'Are you sure you want to Approve this record?', function (button) {
            if (button == 'yes') {
                var remark = $("#txtRemarks" + TADABillId).val();
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("ProvideTADABill", "EmployeeTADABill", "http")',
                    data: { TADABillId: TADABillId, Remark: remark },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data == 1) {
                            $.alert.open("Success", "Status Changed Successfully");
                            GetWaitingTADABillList("", "", "", ApprovalStatus);
                        } else {
                            $.alert.open("Error", "Error Occired");
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function InformationDelete(TADABillId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {

                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteTADABill", "EmployeeTADABill", "http")',
                    data: { TADABillId: TADABillId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            GetWaitingTADABillList("", "", "", ApprovalStatus);
                        } else {
                            $.alert.open("Error", "Error Occured");
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }
    function reloadGrid() {
        var filterBy = $("#filterColumn option:selected").val();
        var filterValue = $("#filterValue").val();
        var Filter_Valuedate = $("#filterValueDate").val();
        GetWaitingTADABillList("", "", "", ApprovalStatus);
    }

</script>

@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-success btn-sm pull-right" })
&nbsp;
<h2 class="page-title">TADA Bill List</h2>
&nbsp;
<div class="row">
    <div class="col-md-12" style="float:left">
        <div class="col-md-2" style="float:left">
            <input type="checkbox" name="app" id="chkNotPaid" />&nbsp;&nbsp;&nbsp;<label>TADA Not Paid</label><br />
            <input type="checkbox" name="app" id="chkPaid" />&nbsp;&nbsp;&nbsp;<label>TADA Paid</label><br />

        </div>
    </div>

</div>

    <div class="row" style="margin-top:15px;">
        <div class="col-md-12">           
            <div class="table-responsive">
                <div id="gridKendo"></div>
            </div>
        </div>
    </div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
   
}


