<h2 class="page-title">All Employee Salary Statement Report</h2>
<div class="container-fluid">

    <div class="row" id="DateDuration">
        <hr />
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Year, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.Year, Model.YearList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Month, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.Month, Model.MonthList, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DateFrom, new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.DateFrom, new { @readonly = "readonly", @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DateTo, new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.DateTo, new { @readonly = "readonly", @class = "form-control" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <br>
        <div class="col-sm-6 ">
            <div class="form-group col-sm-offset-4">
                <div class="col-md-6">
                    <button type="button" id="btnPrint" class="btn btn-success"><i class="fa fa-print"></i> Print</button>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
