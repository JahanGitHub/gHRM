                $("#DateFrom").val(fromDate);

                let toDate = GetLastDate(year, month);
                $("#DateTo").val(toDate);
         //   }

        });


        $("#btnPrint").click(function () {

            var month = $("#Month").val();
            var year = $("#Year").val();
            if (month === "" || year === "") {
                $.alert.open("Warning", "From/To Date is Required");
                return false;
            }

            var fromDate = GetFirstDate(year, month);
            var toDate = GetLastDate(year, month);

            if (month != "" && year != "") {
               /* url = '/PRSalaryStatement/EmployeeSalaryStatementReport?DateFrom=' + dateFrom + '&DateTo=' + dateTo + '&EmployeeCode=' + EmployeeCode + '&EmployeeNameSig=' + EmployeeNameSig + '&DepartmentNameSig=' + DepartmentNameSig + '&DesignationNameSig=' + DesignationNameSig;*/
                /*url = '/PRSalaryStatement/AllEmployeeSalaryStatementReport?month=' + month + '&year=' + year;*/
                url = `/PRSalaryStatement/AllEmployeeSalaryStatementReport?month=${month}&year=${year}&fromDate=${fromDate}&toDate=${toDate}`;
                PrintReport(url);
            }
            else {
                $.alert.open("Error", "Please Select Date");
                return false;
            }
        });



        // End Script
    });

    function PrintReport(PrintUrl) {
        var url;
        url = PrintUrl;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

