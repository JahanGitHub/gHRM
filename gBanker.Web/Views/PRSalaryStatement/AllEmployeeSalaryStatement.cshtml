@model gHRM.Web.ViewModels.Payroll.PRWorkAreaViewModel
@{
    ViewBag.Title = "Payroll Report";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var tt = SessionHelper.CompanyInfo.CompanyShortName;
}




<script type="text/javascript">

    function GetFirstDate(year, month) {
        var firstDayOfMonth = new Date(year, month - 1, 2);
     //   var lastDayOfMonth = new Date(year, month, 1);

        return `${firstDayOfMonth.toISOString().substring(0, 10)}`;

    };

   //console.log( GetFirstDate(2023, 4));

    function GetLastDate(year, month) {
       // var firstDayOfMonth = new Date(year, month - 1, 2);
        var lastDayOfMonth = new Date(year, month, 1);

        return `${lastDayOfMonth.toISOString().substring(0, 10)}`;

    };


   // console.log( GetLastDate(2023, 4));

    $(document).ready(function () {

        $("#DepartmentId").change(function () {
            var DesignationId = $("#DesignationId").val();
            if (DesignationId != "" || DesignationId != null) {
                LoadInfo();
            }
        });
        $("#DesignationId").change(function () {
            LoadInfo();
        });

