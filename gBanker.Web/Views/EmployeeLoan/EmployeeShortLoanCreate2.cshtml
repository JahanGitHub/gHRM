
@model gHRM.Web.ViewModels.Loan.EmployeeLoanInstallmentDetailViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

}

<script src="http://malsup.github.com/jquery.form.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<br />
<a class = "btn btn-success btn-sm pull-right" href="/EmployeeLoan/EmployeeLoanIndex2"><i class="fa fa-backward"></i> Back to List</a>
<h2 class="page-title">New Loan Create</h2>

@using (Html.BeginForm("EmployeeLoanCreate2", "EmployeeLoan", FormMethod.Post, new { @class = "form-horizontal global-submit-form", id = "EmployeeLoanCreate" }))
{
    @Html.AntiForgeryToken()
    <div id="AjaxLoader" class="ajaxLoader"></div>
    <div class="container-fluid">
        <fieldset>
            <legend>Employee Info</legend>
            @Html.HiddenFor(model => model.EmployeeId)

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OfficeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.OfficeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DepartmentName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DepartmentName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DesignationName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset>
            <legend>Loan Detail Info</legend>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LoanTypeId, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.LoanTypeId, Model.LoanTypeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LoanStartDate, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.LoanStartDate, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.TotalLoanAmt, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.TotalLoanAmt, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.InstallmentAmount, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.InstallmentAmount, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.NoOfInstallMent, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.NoOfInstallMent, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.InstallmentDate, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.InstallmentDate, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.LoanEndDate, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.LoanEndDate, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>

        </fieldset>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    &nbsp;
                    <button type="button" id="btnSave" class="btn btn-success btn-sm"><i class="fa fa-check-circle-o"></i> Save</button>
                </div>
            </div>
        </div>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/alert")
    <script src="~/Assets/js/app/loan/employeeLoanCreateManager2.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}