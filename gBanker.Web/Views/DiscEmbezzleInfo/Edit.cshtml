<script type="text/javascript">

    var Office_Id = 0;
    var Secondoffice_Id = 0;
    var Thirdoffice_Id = 0;
    var Office_Type = 0;
    var Mode = "";

    function AccusedListSave() {
        $('#AjaxLoader').show();
        var EmployeeId = $("#EmployeeId").val();

        var Counttbl = 0;
        Counttbl = $('#tblAccusedDetails >tbody >tr').length;

        for (i = 1; i <= Counttbl; i++) {
            var Employee_Id = $("#txtEmployeeId" + i).val();
            if (EmployeeId != undefined) {
                if (EmployeeId == Employee_Id) {
                    $('#AjaxLoader').hide();
                    $.alert.open("error", "This employee has been added")
                    return false;
                }
            }

        }

        var EmbezzleId = $("#EmbezzleId").val();
        var EmployeeId = $("#EmployeeId").val();

        if (EmbezzleId != 0 && EmployeeId != 0) {
            $.ajax({
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("AccusedListSave", "DiscEmbezzleInfo", "http")',
                type: "GET",
                dataType: 'json',
                async: true,
                data: { EmbezzleId: EmbezzleId, EmployeeId: EmployeeId },
                success: function (result) {
                    $('#AjaxLoader').hide();
                    if (result >= 1) {
                        AccusedListAdd();
                        // $.alert.open("info", "Save Successfully.");
                    }
                    else {
                        $.alert.open("error", "Fail to Save");
                    }
                },
                error: function () {
                    $("#dialog-message").html('<p>Error, Fail to Save.</p>');
                    $("#dialog-message").dialog({
                        modal: true,
                        buttons: {
                            Ok: function () {
                                $(this).dialog("close");
                            }
                        }
                    });
                }
            });
        }
        else {
            $.alert.open("error", "Please Save Embezzle");
        }

    }

    function LoadEmpInfo(employee_code) {




        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "EmployeeTransferNew", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {

                        // $("#EmployeeRank").val(data.EmployeeRank);
                        $("#OfficeName").val(data.EmployeeCurrentOfficeName);
                        //$("#DepartmentName").val(data.DepartmentName);
                        $("#DesignationName").val(data.EmployeeCurrentDesignation);
                        $("#OffcDesignName").val(data.EmployeeCurrentDesignation);
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#OfficeDesignationId").val(data.EmpOfficeDesigId);
                        $("#EmployeeCode").val(data.EmployeeCode);


                    });

                }

                else {

                    $("#OfficeName").val("");
                    //$("#DepartmentName").val(data.DepartmentName);
                    $("#DesignationName").val("");
                    $("#OffcDesignName").val("");
                    $("#EmployeeId").val("");
                    $("#EmployeeName").val("");
                    $("#OfficeDesignationId").val("");
                    $("#EmployeeCode").val("");


                }

            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });



    }
    function AccusedListAdd() {

        $("#EmployeeName").val("");
        $("#DesignationName").val("");
        $("#OfficeName").val("");
        $("#txtEmployeeCode").val("");
        $('#AjaxLoader').show();

        var EmbezzleId = $("#EmbezzleId").val();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmbezzleEmplyeeList", "DiscEmbezzleInfo", "http")',
            data: { EmbezzleId: EmbezzleId },
            dataType: 'json',
            async: true,
            success: function (List_EmployeeViewModel) {
                var dtTable = $('#tblAccusedDetails');
                var NewSl = 0;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                $.each(List_EmployeeViewModel, function (index, E) {
                    NewSl = index + 1;
                    tableBody.append('<tr id="table_Row' + NewSl + '">' +
                                  '<td></td>' +
                                  '<td>' + E.EmployeeCode + ' <input type="text" value="' + E.EmployeeId + '" style="display:none;" name="EmpCode" id="txtEmployeeId' + NewSl + '" /></td>' +
                                  '<td>' + E.EmployeeName + '<input type="text" value="' + E.EmployeeName + '" style="display:none;" name="EmpName" id="txtEmpName' + NewSl + '" /></td>' +
                                  '<td>' + E.DesignationName + '<input type="text" value="' + E.DesignationName + '" style="display:none;" name="EmpDesig" id="txtEmpDesig' + NewSl + '" /></td>' +
                                  '<td>' + E.OfficeName + '<input type="text" value="' + E.OfficeName + '" style="display:none;"  name="ReportReceivedDt" id="txtEmpOffice' + NewSl + '" /></td>' +
                                  '<td style="text-align:center;"><a href="javascript:;" onclick="deleteRow(' + E.EmbezzleEmpId + ')"><i class="fa fa-trash-o fa-2x"></i></a>' +
                                  '</tr>'
                        )
                });
                $('#AjaxLoader').hide();
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });


    }



    function checkNumberic(e) {
        if (e.which != 8 && e.which != 0 && (e.which < 46 || e.which > 57)) {
            return false;
        }
        else
            return true;
    }


