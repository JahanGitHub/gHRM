    function GetHOOffice() {
        var ddlHOOffice = $("#ddlHOOffice");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetHOOfficeList", "EmployeePromotion", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlHOOffice.html('');
                $.each(data, function (id, option) {
                    ddlHOOffice.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                $.alert.open(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function GetZOOffice() {
        var ddlZOOffice = $("#ddlZOOffice");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetZOOfficeListForEmbezzle", "DiscEmbezzleInfo", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (List_OfficeViewModel) {
                ddlZOOffice.html('');
                ddlZOOffice.append($('<option></option>').val("0").html("Plese Select"));
                $.each(List_OfficeViewModel, function (id, option) {
                    ddlZOOffice.append($('<option></option>').val(option.OfficeId).html(option.OfficeName));
                });
            },
            error: function (request, status, error) {
                $.alert.open(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


