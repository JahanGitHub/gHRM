@model gHRM.Web.ViewModels.Discipline.DiscEmbezzleInfoViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>
<script type="text/javascript">
    
    
  
     

    function EmbezzleDelete(EmbezzleId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
                if (button == 'yes') {
                     $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("EmbezzleInfoDelete", "DiscEmbezzleInfo", "http")',
                    data: { EmbezzleId: EmbezzleId },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        $('#grid').jtable('load');
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                    return true;
                }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


    $(document).ready(function () {
        

        $("#txtEmbezzleDatefrm").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
          });
        $("#txtEmbezzleDateto").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
          });

        $("#btnSearch").click(function (e) {
            e.preventDefault();
            var CrimeLocation = "0";
            //Order By Embezzel Amount
            /*
             <select id="emb" class="form-control">
                            <option value="0">Please Select</option>
                            <option value="1">ASC</option>
                            <option value="2">DESC</option>
                        </select>
            */
            var emb = $('#emb :selected').val();
             
            
                
            //OfficeId, string EmbezzleDate)
            var EmbezzleDatefrm = $("#txtEmbezzleDatefrm").val();
            var EmbezzleDateto = $("#txtEmbezzleDateto").val();
            $('#grid').jtable('load', { OfficeId: CrimeLocation, EmbezzleDatefrm: EmbezzleDatefrm, EmbezzleDateto: EmbezzleDateto, EmbezzleOrderBy : emb });
        });


        $('#grid').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            //defaultSorting: 'EmployeeCode ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/DiscEmbezzleInfo/GetEmbezzleListInfo?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }
            },
            //
            fields: {
                EmbezzleId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false

                },

                rowSl: {
                    title: 'SL'
                },
                EmbezzleRcvDtMsg: {
                    title: 'Report Receive Date'
                },
                OfficeName: {
                    title: 'Office'
                },
                AuditDateFromMsg: {
                    title: 'Audit Date From'
                },
                AuditDateToMsg: {
                    title: 'Audit Date To'
                },
                BranchAuditNo: {
                    title: 'AuditNo'
                },
                NoOfBMAccused: {
                    title: 'BM Accused'
                },
                NoOfSignatoryAccussed: {
                    title: 'Signatory Accussed'
                },

                NoOfCMAccussed: {
                    title: 'CM Accussed'
                },
                TotEmbezzledAmount: {
                    title: 'Total Embezzled'
                },
                TotReturnAmount: {
                    title: 'Return Amount'
                },
                Balance: {
                    title: 'Balance'
                },
                Remarks: {
                    title: 'Remarks'
                },
                EditLink: {
                    title: "Edit",
                    width: '10%',
                    display: function (data) {
                        return "<div class='text-center'><a href='/DiscEmbezzleInfo/Edit/" + data.record.EmbezzleId + "'><i title='Edit' class='fa fa-pencil-square-o'></i></a></div>";
                    }
                },
                DeleteLink: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EmbezzleDelete(' + data.record.EmbezzleId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }
                }
            }
        });

        var EmbezzleDate = $("#txtEmbezzleDate").val();
        $('#grid').jtable('load', { OfficeId: 0, EmbezzleDate: EmbezzleDate });
    });

</script>
@Html.ActionLink("Add", "Create", null, new { @class = "pull-right   btn btn-success" })
<br />
<h2 class="page-title">Embezzle List</h2>
<br />
@using (Html.BeginForm("Index", "DiscEmbezzleInfo", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "FileDownload" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })  
    <div class="container-fluid">
        <div class="row">
            &nbsp;
        </div>
        
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4"> Order By Embezzel Amount </label>
                    <div class="col-sm-5">
                        <select id="emb" class="form-control">
                            <option value="0">Please Select</option>
                            <option value="1">Ascending</option>
                            <option value="2">Descending</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
        <div class="row">    
            <div class="col-sm-10">
                <div class="col-sm-7">
                    <div class="form-group">
                        <label class="control-label col-sm-3">Report Receive:</label>

                        <label class="control-label col-sm-1">From</label>
                        <div class="col-sm-4">
                            <input type="text" name="EmbezzleDate" id="txtEmbezzleDatefrm" class="form-control">
                        </div>
                    </div>
                </div>

                    <div class="col-sm-5">
                        <div class="form-group">
                            <label class="control-label col-sm-1"> To</label>
                            <div class="col-sm-4">
                                <input type="text" name="EmbezzleDate" id="txtEmbezzleDateto" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
           
            <div class="col-md-3">
                <div class="form-group">
                    <input type="button" id="btnSearch" value="Search" class="btn btn-primary" style="margin-left:160px;" />
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:15px;">
            <div class="col-md-12">
                <div id="grid"></div>
                <div id="gridUploade"></div>
            </div>
        </div>
    </div>
}