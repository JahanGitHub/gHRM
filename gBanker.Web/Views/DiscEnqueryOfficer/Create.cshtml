                            <td align="center">
                                <table class="table table-striped responsive-utilities jambo_table bulk_action" id="tblSelectedOffice" style="width:100%">
                                    <thead>
                                        <tr class="headings">
                                            <th>
                                                <input type="checkbox" style="width:18px;height:18px" id="check_allSelected" />
                                            </th>
                                            <th class="column-title">SL</th>
                                            <th class="column-title">Code</th>
                                            <th class="column-title">Office Name</th>
