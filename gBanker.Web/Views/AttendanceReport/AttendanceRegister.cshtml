@model gHRM.Web.ViewModels.PayrollReportViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/AttendanceReport">AttendanceReport</a></li>
        <li><a href="/AttendanceReport/AttendanceRegister">AttendanceRegister</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Attendance Register";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

}
<script type="text/javascript">


    function rptValidation() {

        return true;

    }

    $(document).ready(function () {

        $("#FromDate").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1920:2050"

        });
        $("#FromDate").datepicker(
      'setDate', new Date());

        $("#ToDate").datepicker(
      {
          dateFormat: "dd-M-yy",
          showAnim: "scale",
          changeMonth: true,
          changeYear: true,
          yearRange: "1920:2050"

      });
        $("#ToDate").datepicker(
      'setDate', new Date());


        ////////
        $("#reportView").click(function (e) {

            var FromDate = $("#FromDate").val();
            var ToDate = $("#ToDate").val();


            // var EmployeeCode = $("#EmployeeID").val();
            //var qType = $("#qType").val();
            if (rptValidation() == true) {//GenerateAttendanceRegister(string FromDate = "", string ToDate = "")
                url = '/AttendanceReport/GenerateAttendanceRegister?FromDate=' + FromDate + '&ToDate=' + ToDate;
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }

        });//// End of Button

    });
</script>

<h2 class="page-title">Attendance Register</h2>
<br />
<div class="row">

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container-fluid">
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Attendance From Date</label>
                        <div class="col-md-8">
                            <input type="text" id="FromDate" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Attendance To Date</label>
                        <div class="col-md-8">
                            <input type="text" id="ToDate" class="form-control" />
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>

</div>
<br />
<div class="row">
    <div class="col-sm-2">
    </div>
    <div class="col-sm-8">
        <input type="submit" id="reportView" value="View" class="btn btn-warning" />
    </div>
</div>
<div class="row">
    <div class="panel-body">
        <div class="create-success create-content alert alert-success alert-dismissable" role="alert" style="display:none;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <p class="message-content">Report Generated Successfully.</p>
        </div>
    </div>

    <div class="danger">
        <div class="create-content create-content alert alert-error alert-dismissable" role="alert" style="display:none;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <p class="message-content" id="messageErr"> @Html.Raw(TempData["Error"])  </p>
        </div>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <script>

        $(".panel-body .create-success").show(700).fadeToggle(2000);
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        $(".danger .create-content").show(700).fadeToggle(4000);

    </script>
}