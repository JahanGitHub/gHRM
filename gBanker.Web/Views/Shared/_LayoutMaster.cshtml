</head>
<body>
    <div id="loading" style="display:none" class="modal">

    </div>
    @{
        var parentModules = gHRM.Web.Helpers.SessionHelper.AllPrentModules ?? new List<gHRM.Data.CodeFirstMigration.Db.AspNetSecurityModule>();
        var userModules = gHRM.Web.Helpers.SessionHelper.UserSecurityModules ?? new List<gHRM.Data.CodeFirstMigration.Db.AspNetSecurityModule>();

    }
    <div class="wrapper">
        <div class="container">

            @Html.Partial("_header")
            <div class="page-content">
                @if (Request.IsAuthenticated)
                {
                    //var parentModules = gHRM.Web.Helpers.SessionHelper.AllPrentModules ?? new List<gHRM.Data.CodeFirstMigration.Db.AspNetSecurityModule>();
                    //var userModules = gHRM.Web.Helpers.SessionHelper.UserSecurityModules ?? new List<gHRM.Data.CodeFirstMigration.Db.AspNetSecurityModule>();

                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation">
                            <a href="/Home" role="tab">
                                <i class="fa fa-home"></i>
                            </a>
                        </li>
                        @foreach (var module in parentModules)
                        {
                            if (module.AspNetSecurityModuleId != 1)
                            {
                                var securityModules = userModules.Where(w => w.ParentModuleId == module.AspNetSecurityModuleId && (!w.IsMenuItem.HasValue || w.IsMenuItem.Value)).OrderBy(o => o.DisplayOrder).ToList();
                                if (securityModules.Count > 0)
                                {
                                    <li role="presentation">
                                        <a href="#@module.AspNetSecurityModuleId" aria-controls="@module.AspNetSecurityModuleId" role="tab" data-toggle="tab">
                                            <i class="fa fa-crosshairs"></i>
                                            @module.LinkText
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                    <div class="tab-content">
                        <!-- Nav tabs -->
                        @*<ul class="nav nav-tabs" role="tablist">
                                <li role="presentation"><a href='@Html.ActionLink("Home", "Index", "Home")' aria-controls="home" role="tab" data-toggle="tab"><i class="fa fa-home"></i></a></li>
                                <li role="presentation" class="active">
                                <a href="#entry" aria-controls="entry" role="tab" data-toggle="tab">
                                    <i class="fa fa-crosshairs"></i>
                                    CODE ENTRY</a>
                                </li>

                            </ul>*@

                        <!-- Tab panes -->
                        <div role="tabpanel" class="tab-pane" id="home">
                            <div class="sub-tabs">
                                <ul class="list-unstyled list-inline">
                                    <li><a href="#" onclick="showOfficeDialog();">Select Office </a></li>

                                </ul>
                            </div>
                        </div>

                        @foreach (var module in parentModules)
                        {
                            if (module.AspNetSecurityModuleId != 1)
                            {
                                var securityModules = userModules.Where(w => w.ParentModuleId == module.AspNetSecurityModuleId && (!w.IsMenuItem.HasValue || w.IsMenuItem.Value)).OrderBy(o => o.DisplayOrder).ToList();
                                if (securityModules.Count > 0)
                                {
                                    <div role="tabpanel" class="tab-pane" id="@module.AspNetSecurityModuleId">
                                        <div class="sub-tabs">
                                            <ul class="list-unstyled list-inline">
                                                @foreach (var securityModule in securityModules)
                                                {
                                                    <li>@Html.ActionLink(securityModule.LinkText, securityModule.ActionName, securityModule.ControllerName)</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }
                            }
                        }

                        <div class="sub-tabs" style="display:none">
                            <div id="carousel-example-generic" class="carousel slide" data-ride="carousel">

                                <!-- Wrapper for slides -->
                                <div class="carousel-inner" role="listbox">
                                    <div class="item active">
                                        1
                                    </div>
                                    <div class="item">
                                        2
                                    </div>
                                </div>

                                <!-- Controls -->
                                <a class="left" href="#carousel-example-generic" role="button" data-slide="prev">
                                    <span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span>
                                    <span class="sr-only">Previous</span>
                                </a>
                                <a class="right" href="#carousel-example-generic" role="button" data-slide="next">
                                    <span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span>
                                    <span class="sr-only">Next</span>
                                </a>
                            </div>
                         </div>
                            @*<div role="tabpanel" class="tab-pane" id="25">
                <div class="sub-tabs">
                    <ul class="list-unstyled list-inline">
                        <li><a href="#" class="active">OFFICE Test</a></li>
                        <li><a href="#">CENTER Test</a></li>
                    </ul>
                </div>
            </div>*@
                            <div id="dvMessage">

                            </div>
                            <div class="content">

                                @RenderBody()
                            </div>
                        </div>

                }


                <div class="footer">
                    <p>Copyright © 2015 Grameen Communications</p>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">

        function confirmDayInitiated() {
            var isDayInitiated = "@gHRM.Web.Helpers.SessionHelper.IsDayInitiated";
            if(isDayInitiated.toLowerCase()=='false')
            {
                var css = "failed";
                $("#dvMessage").attr('class', css);
                $("#dvMessage").html("Please run the start work process.");
                $("#dvMessage").show();
            }
        }
        function clearAllControls(url) {
            var splits = url.split("/");
            var edit = false;
            for (var i = 0; i < splits.length; i++) {
                if (splits[i] == "Edit") {
                    edit = true;
                    break;
                }
            }
            if (!edit) {
                $('input[type="text"]').each(function (index) {
                    var defaultValue = $(this).attr('defaultValue');
                    if (defaultValue != null && defaultValue.length > 0)
                        $(this).val(defaultValue);
                    else
                        $(this).val('');
                });
            }
        }
        $(document).ready(function () {

            $('input').bind('focus', function (e) {
                $("#dvMessage").hide();
            });
            // Handle the form submit event, and make the Ajax request:
            $("form").on("submit", function (event) {
                var _currentForm = $(this).closest('form');
                if (_currentForm.valid()) {

                    event.preventDefault();
                    $("#loading").show();
                    var url = $(this).attr("action");
                    var formData = $(this).serialize();
                    $.ajax({
                        url: url,
                        type: "POST",
                        data: formData,
                        dataType: "json",
                        success: function (resp) {
                            $("#loading").hide();
                            var result = resp.Result;
                            var msg = resp.Message;
                            var css = "failed";
                            if (result == "OK")
                                css = "success";
                            $("#dvMessage").attr('class', css);
                            $("#dvMessage").html(msg);
                            $("#dvMessage").show();
                            if (result == "OK") {
                                $("#dvMessage").toggle('fade', 1500);

                                clearAllControls(url);
                            }
                        },
                        error: function (err) {
                            $("#loading").hide();
                            var msg = err.responseText;
                            var css = "failed";
                            $("#dvMessage").attr('class', css);
                            $("#dvMessage").html(msg);
                            $("#dvMessage").show();
                            //$("#dvMessage").toggle('fade',1500);

                        }

                    })
                }
            });

        });
    </script>

</body>
</html>
