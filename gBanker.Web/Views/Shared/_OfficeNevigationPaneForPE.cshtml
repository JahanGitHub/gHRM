@model gHRM.Web.ViewModels.OfficeNevigationPartialViewModel

@{
    var pleaseSelect = new SelectListItem() { Text = "Please Select", Value = "" };
}

<script>
    function GenerateDropDownList(dorpDownFieldId, controllerName, functionName) {
        var ddlName = $("#'" + dorpDownFieldId + "");
        var dataUrl = '/' + controllerName + '/' + functionName + '';

        $('#AjaxLoader').show();
        $.ajax({
            type: "GET", //GET or POST or PUT or DELETE verb
            url: dataUrl, // Location of the service
            data: {}, //Data sent to server
            dataType: "json", //Expected data format from server
            processdata: false, //True or False
            success: function (data) { //On Successful service call
                $('#AjaxLoader').hide();
                ddlName.html('');
                if (data.length > 0) {
                    $.each(data, function (i, option) {
                        ddlName.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                    });
                }
            },
            error: function (data) {
                $('#AjaxLoader').hide();
                $.alert.open('error', 'Error');
            }
        });
    }

    function GetHeadOfficeByOfficeType() {
        var ddlName = $("#PVHeadOfficeId");

        $('#AjaxLoader').show();
        $.ajax({
            type: "GET", //GET or POST or PUT or DELETE verb
            url: '/Office/GetHeadOfficeByOfficeType', // Location of the service
            data: {}, //Data sent to server
            dataType: "json", //Expected data format from server
            async: false,
            processdata: false, //True or False
            success: function (data) { //On Successful service call
                $('#AjaxLoader').hide();
                ddlName.html('');
                if (data.length > 0) {
                    $.each(data, function (i, option) {
                        ddlName.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                    });
                }
            },
            error: function (data) {
                $('#AjaxLoader').hide();
                $.alert.open('error', 'Error');
            }
        });
    }

    function GetProjectsByOfficeType() {
        var ddlName = $("#PVProjectId");

        $('#AjaxLoader').show();
        $.ajax({
            type: "GET", //GET or POST or PUT or DELETE verb
            url: '/Office/GetProjectsByOfficeType', // Location of the service
            data: {}, //Data sent to server
            dataType: "json", //Expected data format from server
            async:false,
            processdata: false, //True or False
            success: function (data) { //On Successful service call
                $('#AjaxLoader').hide();
                ddlName.html('');
                if (data.length > 0) {
                    $.each(data, function (i, option) {
                        ddlName.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                    });
                }
            },
            error: function (data) {
                $('#AjaxLoader').hide();
                $.alert.open('error', 'Error');
            }
        });
    }

    function GetAllOfficeType() {
        var ddlOfficeType = $("#OfficeTypeId");
        $('#AjaxLoader').show();
        $.ajax({
            type: "GET", //GET or POST or PUT or DELETE verb
            url: '/Office/OfficeTypeList_JS', // Location of the service
            data: {}, //Data sent to server
            dataType: "json", //Expected data format from server
            processdata: false, //True or False
            success: function (data) { //On Successful service call
                $('#AjaxLoader').hide();
                ddlOfficeType.html('');
                if (data.length > 0) {
                    $.each(data, function (i, option) {
                        ddlOfficeType.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                    });
                }
            },
            error: function (data) {
                $('#AjaxLoader').hide();
                $.alert.open('error', 'Error');
            }
        });
    }

    function GetAllZoneOffice() {
        var ddlZone = $("#ZoneId");
        $.ajax({
            type: "GET", //GET or POST or PUT or DELETE verb
            url: '/Office/getAllZoneId', // Location of the service
            data: {}, //Data sent to server
            dataType: "json", //Expected data format from server
            processdata: false, //True or False
            success: function (data) { //On Successful service call
                $('#AjaxLoader').hide();
                ddlZone.html('');
                if (data.length > 0) {
                    $.each(data, function (i, option) {
                        ddlZone.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                    });
                }
            },
            error: function (data) {
                $('#AjaxLoader').hide();
                $.alert.open('error', 'Error');
            }
        });
    }

    function ChangeOfficeType() {
        
    }

    $(document).ready(function () {
        $("#HeadOfficeDiv").hide();
        $("#ProjectDiv").hide();
        $("#ZoneDiv").hide();
        $("#AreaDiv").hide();
        $("#UnitDiv").hide();
        
       // GetAllOfficeType();
        //GetAllZoneOffice();
        
        
        

        $("#OfficeTypeId").change(function () {
            
            var officeType = $("#OfficeTypeId").val();
            if (officeType != "") {
                $("#ZoneId").val('');
                $("#AreaId").html('<option value="">Please Select</option>');
                $("#UnitId").html('<option value="">Please Select</option>');

                if (officeType == 1) {
                    GetHeadOfficeByOfficeType();
                    $("#HeadOfficeDiv").show();

                    $("#ProjectDiv").hide();
                    $("#ZoneDiv").hide();
                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();
                } else if (officeType == 3) { //project
                    $("#HeadOfficeDiv").hide();

                    GetProjectsByOfficeType();
                    $("#ProjectDiv").show();
                    $("#ZoneDiv").hide();
                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();

                } else if (officeType == 4) { //zone
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();

                    $("#AreaDiv").hide();
                    $("#UnitDiv").hide();
                    $("#ZoneDiv").show();
                } else if (officeType == 5) { //area
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();
                    $("#UnitDiv").hide();

                    $("#ZoneDiv").show();
                    $("#AreaDiv").show();
                } else if (officeType == 6) { //field
                    $("#HeadOfficeDiv").hide();
                    $("#ProjectDiv").hide();
                    $("#UnitDiv").show();
                    $("#ZoneDiv").show();
                    $("#AreaDiv").show();
                }                
            } else {
                $("#HeadOfficeDiv").hide();
                $("#ProjectDiv").hide();
                $("#ZoneDiv").hide();
                $("#AreaDiv").hide();
                //$("#AreaId").html('<option value="">Please Select</option>');
                $("#UnitDiv").hide();
                //$("#UnitId").html('<option value="">Please Select</option>');
            }
        });

        $("#ZoneId").change(function () {
            
            var zoneId = $("#ZoneId").val();
            var ddlArea = $("#AreaId");
            var officeTypeId = $("#OfficeTypeId").val();

            if (zoneId != "" && (officeTypeId == 5 || officeTypeId == 6)) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "GET", //GET or POST or PUT or DELETE verb
                    url: '/Office/getAllAreaIdByZoneCode', // Location of the service
                    data: { ZoneId: zoneId }, //Data sent to server
                    dataType: "json",
                    async:false,//Expected data format from server
                    processdata: false, //True or False
                    success: function (data) { //On Successful service call
                        $('#AjaxLoader').hide();
                        ddlArea.html('');
                        if (data.length > 0) {
                            $.each(data, function (i, option) {
                                ddlArea.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                            });
                        }
                        $("#UnitId").html('<option value="">Please Select</option>');
                    },
                    error: function (data) {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', 'Error');
                    }
                });
            } else {
                ddlArea.html('<option value="">Please Select</option>');
                $("#UnitId").html('<option value="">Please Select</option>');

            }
        });

        $("#AreaId").change(function () {
            
            var areaId = $("#AreaId").val();
            var ddlUnit = $("#UnitId");
            var officeTypeId = $("#OfficeTypeId").val();

            if (areaId != "" && (officeTypeId == 6)) {
                $('#AjaxLoader').show();
                $.ajax({
                    type: "GET", //GET or POST or PUT or DELETE verb
                    url: '/Office/getAllUnitIdByAreaCode', // Location of the service
                    data: { AreaId: areaId }, //Data sent to server
                    dataType: "json", //Expected data format from server
                    async:false,
                    processdata: false, //True or False
                    success: function (data) { //On Successful service call
                        $('#AjaxLoader').hide();
                        ddlUnit.html('');
                        if (data.length > 0) {
                            $.each(data, function (i, option) {
                                ddlUnit.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                            });
                        }
                    },
                    error: function (data) {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', 'Error');
                    }
                });
            } else {
                $("#UnitId").html('<option value="">Please Select</option>');

            }
        });

        var _OfficeTypeId = '@Model.OfficeTypeId';
        if (parseInt(_OfficeTypeId) > 0) {

            $("#OfficeTypeId").val(_OfficeTypeId);
            $('#OfficeTypeId').val(_OfficeTypeId).trigger('change');
            $('#OfficeTypeId').change();
            if (parseInt(_OfficeTypeId) == 1) {
                $("#PVHeadOfficeId").val('@Model.PVHeadOfficeId');
            }
            else if (parseInt(_OfficeTypeId) == 3) {
                $("#PVProjectId").val(@Model.PVProjectId);
            }
            else if (parseInt(_OfficeTypeId) == 4) {
                $("#ZoneId").val(@Model.ZoneId);
            }
            else if (parseInt(_OfficeTypeId) == 5) {
                $("#ZoneId").val(@Model.ZoneId);
                $("#ZoneId").val(@Model.ZoneId).trigger('change');

                $("#AreaId").val('@Model.AreaId');
            }else if (parseInt(_OfficeTypeId) == 6) {
                $("#ZoneId").val(@Model.ZoneId);
                $("#ZoneId").val(@Model.ZoneId).trigger('change');
                $("#AreaId").val(@Model.AreaId);
                $("#AreaId").val(@Model.AreaId).trigger('change');
                $("#UnitId").val(@Model.UnitId);
            }
            
        } else {
            $("#OfficeTypeId").val("");
        }
    });
</script>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.LabelFor(model => model.OfficeTypeId, htmlAttributes: new { @class = "control-label col-sm-4" })
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.OfficeTypeId, Model.OfficeTypeList, new { @class = "form-control", @required = "true" })
            </div>
        </div>
    </div>
    <div class="col-sm-6" id="HeadOfficeDiv">
        <div class="item form-group">
            @Html.LabelFor(model => model.PVHeadOfficeId, new { @class = "control-label col-sm-4" })
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.PVHeadOfficeId, Model.AreaList, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="col-sm-6" id="ProjectDiv">
        <div class="item form-group">
            @Html.LabelFor(model => model.PVProjectId, new { @class = "control-label col-sm-4" })
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.PVProjectId, Model.AreaList, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="col-sm-6" id="ZoneDiv">
        <div class="item form-group">
            @Html.LabelFor(model => model.ZoneId, new { @class = "control-label col-sm-4" })
            <div class="col-sm-8">
                @Html.DropDownListFor(model => model.ZoneId, Model.ZoneList, new { @class = "form-control", @required = "required" })
            </div>
        </div>
    </div>
</div>
<br />
<div class="row">   
    <div class="col-sm-6" id="AreaDiv">
        <div class="item form-group">
            @Html.LabelFor(model => model.AreaId, new { @class = "control-label col-sm-4" })
            <div class="col-sm-8">
