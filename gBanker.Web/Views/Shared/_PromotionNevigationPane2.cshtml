@model gHRM.Web.ViewModels.PromotionNevigationPartialViewModel2

<style type="text/css">
    .jtable > thead > tr {
        height: 50px;
    }

    #multiSection {
        width: 40px;
    }   

    table.jambo_table thead {
        background: rgba(52, 73, 94, 0.94);
        color: #ECF0F1;
    }

    .table > thead > tr > th, .table > tbody > tr > th, .table > tfoot > tr > th, .table > thead > tr > td, .table > tbody > tr > td, .table > tfoot > tr > td {
        padding: 11px;
        line-height: 1.42857143;
        vertical-align: top;
        border-top: 1px solid #ddd;
    }

    .table-striped > tbody > tr:nth-of-type(odd) {
        background-color: #eee;
    }

    .table > tbody > tr:hover {
        background-color: #9E9E9E;
    }

    .table {
        width: 100%;
        counter-reset: rowNumber;
    }

        .table > tbody > tr {
            counter-increment: rowNumber;
        }

            .table > tbody > tr > td:first-child::before {
                content: counter(rowNumber);
            }

    .txtcapitalize {
        text-transform: capitalize;
    }
</style>

&nbsp;
<h2 class="page-title">Employee Salary Configuration</h2>
&nbsp;
<div id="AjaxLoader" class="ajaxLoader"></div>
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Employee Code</label>
                    <div class="col-sm-8">
                        @Html.TextBox("txtEmpName", "", new { @class = "form-control" })
                        @Html.HiddenFor(model => model.EmployeeID)
                        @Html.HiddenFor(model => model.EmployeeStatusName)
                        @Html.HiddenFor(model => model.PRSalaryConfigurationID)
                        @Html.HiddenFor(model => model.OfficeID)
                        @Html.HiddenFor(model => model.PRComponentID)
                        @Html.HiddenFor(model => model.OfficeLocationId)
                        @Html.HiddenFor(model => model.PRWorkAreaID)
                        @Html.HiddenFor(model => model.BasicSalary)
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Employee Name</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Employee Status</label>
                    <div class="col-sm-8">
                        @Html.TextBox("txtEmpStatus", "", new { @class = "form-control", @readonly = "readonly" })
                        @Html.HiddenFor(model => model.EmployeeStatusId)
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Department Name</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.DepartmentName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Designation Status</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
