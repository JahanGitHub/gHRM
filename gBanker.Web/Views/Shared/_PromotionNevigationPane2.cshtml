        <div class="row">
            <div class="col-sm-12">
                <div id="DivTableView">
                    <div class="box-header">
                        <h3 class="box-title">Salary Detail List</h3>
                    </div>
                    <div class="box-body no-padding table-responsive">
                        <table class="table table-striped responsive-utilities jambo_table bulk_action" id="tblSalaryConfiguration">
                            <thead>
                                <tr class="headings">

                                    <th class="column-title">Sl</th>
                                    <th class="column-title">Component Name</th>
                                    <th class="column-title">Amount</th>
                                    <th class="column-title">Category</th>
                                    <th class="column-title">Transaction Type</th>
                                    <th class="column-title">Is effective</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <br />
            </div>
        </div>

        <div class="row" id="incomeTaxDivXX" style="display: none;">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.IncomeTax, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.IncomeTax, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <button type="button" id="btnSalaryConfigurationSave" class="btn btn-success"><i class="fa fa-check-circle"></i> Save</button>
            </div>
        </div>

        <div class="row" style="display:none">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.LoginTime, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
