                <div class="form-group">
                    @Html.LabelFor(model => model.PromotionDate, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.PromotionDate, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
