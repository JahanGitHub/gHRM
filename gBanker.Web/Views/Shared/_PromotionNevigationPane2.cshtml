            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.BankBranchName, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.BankBranchName, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
         
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.RoutingNo, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.RoutingNo, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.IsOverTime, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.IsOverTime, Model.OverTimeList, new { @class = "form-control" })

                    </div>
                </div>
            </div>

            <div class="col-sm-6 section-overtime">
                <div class="form-group">
                    <label class="control-label col-md-4"></label>
                    <div class="col-sm-8">
                        <label class="switch ib switch-primary mt10">
                            @Html.CheckBoxFor(m => m.IsOvertimeException)
                            <label for="IsOvertimeException" data-on="YES" data-off="NO"></label>
                            <span>Is Overtime Exception</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="row section-overtime">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.MaxOvertimePerDay, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.MaxOvertimePerDay, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return checkDecimal(event);" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.MaxOvertimePerMonth, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.MaxOvertimePerMonth, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return checkDecimal(event);" } })
                    </div>
                </div>
            </div>
        </div>

        <div class="row" id="effectiveDuration">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.EffectiveStartDate, htmlAttributes: new { @class = "control-label col-md-4 required" })
