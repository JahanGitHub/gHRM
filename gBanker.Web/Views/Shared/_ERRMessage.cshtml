<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - gHRM Web | Log in</title>
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <link rel="shortcut icon" href="../images/LOGO_G.ico">

    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
    @*<link href="~/content/gHRM-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet">*@
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      <script src="content/ui-libs/html5shiv/3.7.2/html5shiv.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
      <script src="content/ui-libs/respond/1.4.2/respond.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    <![endif]-->

    <link href="~/content/ui-libs/font-awesome-4.3.0/css/font-awesome.min.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet">
    <!-- Theme style -->
    <link href="~/content/AdminLTE/AdminLTE.min.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/bootstrap")
    <link href="~/content/bootstrap.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet">
    <link href="~/content/gHRM-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet">

</head>

<body class="login-page">
    <div class="login-box">
        <div class="login-box-body">

            <div class="row">
                <div class="col-xs-6">
                    <div class="checkbox icheck">
                         
                    </div>
                </div>
                <div class="col-xs-6">
                    <img src="../images/gHRM-logo.png" width="111" height="30" class="pull-right">
                </div>
            </div>

            @RenderBody()
            
            @*<a href="#">I forgot my password</a>
            <br>
            <a href="register.html" class="text-center">Register a new membership</a>*@
        </div><!-- /.login-box-body -->
    
        <div class="row">
            <p style="text-align: center; color: #fdfdfd;">Copyright © @DateTime.Now.Year Grameen Communications</p>
        </div>
    
    </div><!-- /.login-box -->

    
    @*<script src="../../plugins/iCheck/icheck.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" type="text/javascript"></script>
    <script>
        $(function () {
            $('input').iCheck({
                checkboxClass: 'icheckbox_square-blue',
                radioClass: 'iradio_square-blue',
                increaseArea: '20%' // optional
            });
        });
    </script>*@
</body>
</html>
