@model gHRM.Web.ViewModels.PF.ProfitDeclarationViewModel

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">

    function UpdateProfitDeclaration(declararionId, induceRate, isDeclared) {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdateProfitDeclaration", "PFProfitDeclaration", "http")',
            data: { declararionId: declararionId, induceRate: induceRate, isDeclared: isDeclared },
            dataType: 'json',
            async: false,
            success: function (data) {
                $.alert.open("Message", data.message);
                setTimeout(function () {
                    window.location.href = "/PFProfitDeclaration/Index";
                }, 1500);
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");
            }
        });
    }

    function Update() {
        var declararionId = $('#DeclararionId').val();
        var profitRate = $("#ProfitRate").val();
        var induceRate = $("#InduceRate").val();
        var isDeclared = $("#IsDeclared").is(':checked');
      
        if (declararionId == '') {
            return;
        }

        if (profitRate == '') {
            $.alert.open("Profit rate changed");
            return;
        }
        if (induceRate == '') {
            $.alert.open("Enter Induce rate");
            return;
        }

        if (parseFloat(profitRate) < parseFloat(induceRate)) {
            $.alert.open("Induce rate exceeded Profit rate");
            return;
        }
        UpdateProfitDeclaration(declararionId, induceRate, isDeclared);
    }


    $(document).ready(function () {
       
        var isReadonly = @Html.Raw(Model.IsInduceRateReadonly == true ? "true" : "false")
        $('#InduceRate').attr('disabled', isReadonly);
        $('#btnUpdateProfitDeclaration').attr('disabled', isReadonly);
       // $('#IsDeclared').attr('disabled', true);
        

        $("#btnUpdateProfitDeclaration").click(function () {

            $.alert.open('confirm', 'Are you sure you want to update?', function (button) {
                if (button == 'yes') {
                    Update();
                    return true;
                }
                else {
                    return false;
                }
            });
        });
    });
</script>


