@{
    ViewBag.Title = "Roster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://kendo.cdn.telerik.com/2024.3.914/styles/kendo.default-v2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2024.3.914/js/kendo.all.min.js"></script>

<h2>Roster</h2>

<div>
    <input id="txtSearch" placeholder="Search name, designation, office..." style="width:300px;" />
    <button id="btnSearch" class="k-button">Search</button>
    <button id="btnAdd" class="k-button k-primary">Add New</button>
</div>

<br />

<div id="grid"></div>

<!-- Modal window for create/update -->
<div id="rosterWindow" style="display:none;">
    <form id="rosterForm">
        <div>
            <label>Employee Name</label>
            <input name="EmployeeName" class="k-textbox" required />
        </div>
        <div>
            <label>Designation</label>
            <input name="Designation" class="k-textbox" />
        </div>
        <div>
            <label>Contact</label>
            <input name="Contact" class="k-textbox" />
        </div>
        <div>
            <label>Shift</label>
            <select name="ShiftCode">
                <option value="">--</option>
                <option value="G">G</option>
                <option value="M">M</option>
                <option value="E">E</option>
                <option value="N">N</option>
                <option value="OFF">OFF</option>
            </select>
        </div>
        <div>
            <label>Office</label>
            <input name="Office" class="k-textbox" />
        </div>
        <div>
            <label>Remarks</label>
            <input name="Remarks" class="k-textbox" />
        </div>

        <div style="margin-top:10px;">
            <button type="button" id="btnSave" class="k-button k-primary">Save</button>
            <button type="button" id="btnCancel" class="k-button">Cancel</button>
        </div>
    </form>
</div>

<script>
$(document).ready(function() {

    // Kendo DataSource with server paging + CRUD URLs
    var ds = new kendo.data.DataSource({
        transport: {
            read: {
                url: '@Url.Action("Read","Roster")',
                dataType: "json",
                type: "GET",
                data: function() {
                    return {
                        search: $("#txtSearch").val()
                    };
                }
            },
            create: {
                url: '@Url.Action("Create","Roster")',
                dataType: "json",
                type: "POST"
            },
            update: {
                url: '@Url.Action("Update","Roster")',
                dataType: "json",
                type: "POST"
            },
            destroy: {
                url: function(e) { return '@Url.Action("Destroy","Roster")'; },
                dataType: "json",
                type: "POST"
            },
            parameterMap: function(data, type) {
                if (type === "read") {
                    // kendo sends skip/take - map to our action signature (page/pageSize etc)
                    return {
                        page: (data.page || 1),
                        pageSize: data.pageSize || data.take || 10,
                        search: $("#txtSearch").val(),
                        sort: (data.sort && data.sort.length>0) ? data.sort[0].field : "EmployeeName",
                        sortDir: (data.sort && data.sort.length>0) ? data.sort[0].dir : "asc"
                    };
                }
                if (type === "create" || type === "update" || type === "destroy") {
                    return data;
                }
            }
        },
        schema: {
            data: "data",
            total: "total",
            model: {
                id: "RosterId",
                fields: {
                    RosterId: { editable:false, nullable:true },
                    EmployeeName: { validation: { required:true } },
                    Designation: {},
                    Contact: {},
                    ShiftCode: {},
                    Office: {},
                    Remarks: {}
                }
            }
        },
        serverPaging: true,
        serverSorting: true,
        pageSize: 10
    });

    // Initialize grid
    $("#grid").kendoGrid({
        dataSource: ds,
        pageable: true,
        sortable: true,
        toolbar: ["excel"],
        excel: {
            fileName: "Roster.xlsx",
            allPages: true
        },
        columns: [
            { field: "EmployeeName", title: "Employee" },
            { field: "Designation", title: "Designation", width: 140 },
            { field: "Contact", title: "Contact", width: 110 },
            { field: "ShiftCode", title: "Shift", width: 80 },
            { field: "Office", title: "Office", width: 120 },
            { field: "Remarks", title: "Remarks", width: 160 },
            { command: [{ name: "edit", text: "Edit" }, { name: "destroy", text: "Delete" }], title: "&nbsp;", width: 180 }
        ],
        editable: "inline"
    });

    // Search button
    $("#btnSearch").click(function() {
        ds.page(1); // reload
    });

    // Add button -> open modal
    var wnd = $("#rosterWindow").kendoWindow({
        title: "Add / Edit Roster",
        visible: false,
        modal: true,
        width: "600px"
    }).data("kendoWindow");

    $("#btnAdd").click(function() {
        $("#rosterForm")[0].reset();
        wnd.center().open();
        wnd.element.data("roster-id", null);
    });

    $("#btnCancel").click(function() {
        wnd.close();
    });

    $("#btnSave").click(function() {
        // collect form values
        var form = $("#rosterForm");
        var dto = {};
        form.serializeArray().forEach(function(i){ dto[i.name] = i.value; });

        var id = wnd.element.data("roster-id");
        if (id) dto.RosterId = id;

        // create or update via dataSource
        if (id) {
            ds.pushUpdate(dto);
            $.post('@Url.Action("Update","Roster")', dto).done(function() {
                ds.read();
                wnd.close();
            });
        } else {
            $.post('@Url.Action("Create","Roster")', dto).done(function() {
                ds.read();
                wnd.close();
            });
        }
    });

    // When click Edit (inline), we allow inline editing (kendo's inline) OR we could open modal.
    // For simplicity above grid uses inline edit; modal is for Add only. You can adapt if you prefer.
});
</script>



@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}
















