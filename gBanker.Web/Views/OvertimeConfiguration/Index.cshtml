
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        getOverTimeConfiguredData();
    });

    ////// Kendo Grid Integration

    function getOverTimeConfiguredData() {
        $('#gridKendo').html("");
        dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    //url: baseURL + '/ProcessCategory/GetProcessCategoryList?QueryOption=' + 1,
                    url: '@Url.Action("getOverTimeConfurations", "OvertimeConfiguration", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });


        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "OvertimeConfigId",
                     title: "SL.",
                     width: "20px",
                     filterable: false,
                 },
                {
                    field: "HourFrom",
                    title: "Hour From",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "HourTo",
                    title: "Hour To",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "Amount",
                    title: "Amount",
                    width: "50px",
                    filterable: true,
                },
                 {
                     field: "DividedBy",
                     title: "Divided By",
                     width: "50px",
                     filterable: true,
                 },
                 {
                     field: "Rank",
                     title: "Rank",
                     width: "50px",
                     filterable: true,
                 },
                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         return "<a href='/OvertimeConfiguration/Edit/?id=" + dataItem.OvertimeConfigId + "'><i class='fa fa-pencil-square-o'></i></a>";
                     }
                 },
                 {
                     title: "Delete",
                     width: "25px",
                     template: function (dataItem) {
                         return '<a href="/OvertimeConfiguration/Delete/' + dataItem.OvertimeConfigId + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '><i class="fa fa-trash-o"></i></a>';
                     }
                 }
            ]
        });
    }

</script>


<div class="row">
    @Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-success btn-sm pull-right", @id = "btnAddNew" })
    <h2 class="page-title">Overtime Configuration List</h2>
</div>


@using (Html.BeginForm("Index", "OvertimeConfiguration", FormMethod.Get, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-horizontal">
            <hr />
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
}




