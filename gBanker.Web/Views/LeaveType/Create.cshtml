@model gHRM.Web.ViewModels.LeaveTypeViewModel


@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var eligible = Model == null ? null : Model.EligibleFromList;
    var status = Model == null ? null : Model.LeaveStatusList;
    var gender = Model == null ? null : Model.LeaveGenderList;
}

<!-- Latest compiled and minified CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.12.4/css/bootstrap-select.min.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()">

<!-- Latest compiled and minified JavaScript -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.12.4/js/bootstrap-select.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/LeaveType">LeaveType</a></li>
        <li><a href="/LeaveType/Create">LeaveTypeCreate</a></li>
    </ol>
</div>


<script type="text/javascript">
    var LEAVE_TYPE_TOTAL_MAX_LEAVE_DAYS_ENABLED = "True" == "@ViewBag.LEAVE_TYPE_TOTAL_MAX_LEAVE_DAYS_ENABLED";

    $(document).ready(function () {
        if (!LEAVE_TYPE_TOTAL_MAX_LEAVE_DAYS_ENABLED) {
	        $("#TotalMaxLeaveDays").prop("disabled", true);
        }

        $("#btnSave").click(function () {
            SaveLeaveType();
        });


        $("#LeaveCategory").change(function () {
            var leaveCategory = $("#LeaveCategory").val();
            if (leaveCategory != "") {
                if (leaveCategory == "AL") {
                    $("#MaxLeaveDays").val(0);
                    $("#MaxLeaveDays").attr('Disabled', true);
                    $("#DaysPerEL").removeAttr('Disabled');
                    $("#MaxAvailDays").removeAttr('Disabled');
                } else if (leaveCategory == "CL" || leaveCategory == "ML" || leaveCategory == "PL" || leaveCategory == "OL" || leaveCategory == "LWP" || leaveCategory == "MEL") {
                    $("#MaxLeaveDays").removeAttr('Disabled');
                    $("#MaxAvailDays").removeAttr('Disabled');
                    $("#DaysPerEL").val(0);
                    $("#DaysPerEL").attr('Disabled', true);
                } else if (leaveCategory == "LWP") {
                    $("#MaxLeaveDays").val(0);
                    $("#MaxLeaveDays").attr('Disabled', true);
                    $("#MaxAvailDays").val(0);
                    $("#MaxAvailDays").attr('Disabled', true);
                    $("#DaysPerEL").val(0)
                    $("#DaysPerEL").attr('Disabled', true);
                }
            } else {
                $("#MaxLeaveDays").removeAttr('Disabled');
                $("#DaysPerEL").removeAttr('Disabled');
                $("#MaxAvailDays").removeAttr('Disabled');
            }
        });

        $("#LeaveStatus").change(function () {
            var LeaveStatus = $(this).val();
            if ("C" == LeaveStatus) $("#TotalMaxLeaveDaysContainer").show();
            else $("#TotalMaxLeaveDaysContainer").hide();
        });
    });



    function validation() {
        var maxLeaveDays = $("#MaxLeaveDays").val();
        var maxAvailDays = $("#MaxAvailDays").val();
        var daysPerEl = $("#DaysPerEL").val();

        if ($("#LeaveTypeName").val() == '') {
            $.alert.open("Error", "Please Provide Type Name");
            return false;
        }
        if ($("#LeaveCategory").val() == '') {
            $.alert.open("Error", "Please Provide Leave Category");
            return false;
        }

        var leaveCategory = $("#LeaveCategory").val();
        if (leaveCategory == "") {
            $.alert.open("Error", "Please Insert Leave Type");
            return false;
        }

        var employeeStatusList = $("#EmployeeStatusIdList").val();
        if (employeeStatusList == null || employeeStatusList == "") {
            $.alert.open("Error", "Please Provide Employee Status");
            return false;
        }

        var EligibleFrom = $("#EligibleFrom").val();
        if (EligibleFrom == "") {
            $.alert.open("Error", "Please Eligible From Type");
            return false;
        }

        var LeaveGender = $("#LeaveGender").val();
        if (LeaveGender == "") {
            $.alert.open("Error", "Please Leave Gender Type");
            return false;
        }

        var LeaveStatus = $("#LeaveStatus").val();
        if (LeaveStatus == "") {
            $.alert.open("Error", "Please Leave Status Type");
            return false;
        }

        if (leaveCategory == "AL") {
            if (maxAvailDays > 0 && daysPerEl > 0) {
                return true;
            } else {
                $.alert.open("Error", "Please Insert max Avail Days and Days per EL");
                return false;
            }

        } else if (leaveCategory == "CL" || leaveCategory == "ML" || leaveCategory == "PL" || leaveCategory == "OL" || leaveCategory == "MEL") {
            if (maxAvailDays > 0 && maxLeaveDays > 0) {
                return true;
            } else {
                $.alert.open("Error", "Please Insert Max Leave Days and Max Avail Days");
                return false;
            }
        } else if (leaveCategory == "LWP") {
            return true;
        } else {
            return true;
        }

    }

    //create
    function GenerateLeaveType() {
        var item = {};
        item.LeaveTypeName = $("#LeaveTypeName").val();
        item.LeaveCategory = $("#LeaveCategory").val();
        item.EmployeeStatusId = $("#EmployeeStatusId").val();
        item.EmployeeStatusIdList = $("#EmployeeStatusIdList").val();
        item.EligibleFrom = $("#EligibleFrom").val();
        item.MaxLeaveDays = $("#MaxLeaveDays").val();
        item.MaxAvailDays = $("#MaxAvailDays").val();
        item.LeaveStatus = $("#LeaveStatus").val();
        item.LeaveGender = $("#LeaveGender").val();
        item.LeaveTypeRank = $("#LeaveTypeRank").val();
        item.DaysPerEL = $("#DaysPerEL").val();
        item.leaveQty = $("#leaveQty").val();
        item.Ledger = $('#Ledger:checked').val() ? true : false;
        item.CountWeeklyHolidaysInBetween = $("#CountWeeklyHolidaysInBetween").val();
        item.CountOtherHolidaysInBetween = $("#CountOtherHolidaysInBetween").val();
        item.TotalMaxLeaveDays = $("#TotalMaxLeaveDays").val();
        return item;
    }

    function ClearControl() {
        $("#LeaveTypeName").val('');
        $("#LeaveCategory").val('');
        $("#EmployeeStatusId").val('');
        $("#EmployeeStatusIdList").val('');
        $("#EligibleFrom").val('');
        $("#MaxLeaveDays").val('');
        $("#MaxAvailDays").val('');
        $("#LeaveStatus").val('');
        $("#LeaveGender").val('');
        $("#LeaveTypeRank").val('');
        $("#DaysPerEL").val('');
        $("#leaveQty").val('');
        $("#CountWeeklyHolidaysInBetween").val('');
        $("#CountOtherHolidaysInBetween").val('');
    }


    function SaveLeaveType() {
        var result = validation();
        if (result) {
            var leaveType = GenerateLeaveType();
            $.ajax({
                type: "POST",
                dataType: "json",
                async: true,
                cache: false,
                url: '@Url.Action("SaveLeaveType", "LeaveType")',
                data: JSON.stringify({ leaveType: leaveType }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    if (data == "Save Successfull") {
                        $.alert.open('Success', data);
                        ClearControl();
                    } else {
                        $.alert.open('Error', data);
                    }
                },
                error: function (xhr, status, error) {
                    alert(error);
                }
            });
        }
    }


</script>


@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Add Leave Type</h2>
<br />


@using (Html.BeginForm("Create", "LeaveType", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "LeaveTypeProfile" }))
{
    @Html.AntiForgeryToken()
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LeaveTypeName, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.LeaveTypeName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Leave Type Name" } })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LeaveCategory, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.LeaveCategory, Model.LeaveCategoryList, null, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeStatusId, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.EmployeeStatusId, Model.EmployeeStatusList, new { @class = "selectpicker form-control", @multiple = "multiple", @Id = "EmployeeStatusIdList", @Name = "EmployeeStatusIdList" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EligibleFrom, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.EligibleFrom, eligible, null, new { @class = "form-control" })
                </div>
            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.MaxLeaveDays, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.MaxLeaveDays, new { htmlAttributes = new { @class = "form-control", @placeholder = "Max Leave Days", @onkeypress = "return checkNumeric(event)" } })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.MaxAvailDays, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.MaxAvailDays, new { htmlAttributes = new { @class = "form-control", @placeholder = "Max Avail Days", @onkeypress = "return checkNumeric(event)" } })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LeaveStatus, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.LeaveStatus, status, null, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LeaveGender, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.LeaveGender, gender, null, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LeaveTypeRank, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.LeaveTypeRank, new { htmlAttributes = new { @class = "form-control", @placeholder = "Leave Type Rank", @onkeypress = "return checkNumeric(event)" } })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DaysPerEL, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.DaysPerEL, new { htmlAttributes = new { @class = "form-control", @onkeypress = "return checkNumeric(event)" } })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.leaveQty, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.leaveQty, new { htmlAttributes = new { @class = "form-control", @placeholder = "Leave Quantity" } })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div id="TotalMaxLeaveDaysContainer" class="form-group" style="display: none;">
                @Html.LabelFor(model => model.TotalMaxLeaveDays, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.TotalMaxLeaveDays, new { htmlAttributes = new { @class = "form-control", @placeholder = "Total Max Leave Days" } })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EffectiveStartDate, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.EffectiveStartDate, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EffectiveEndDate, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.EditorFor(model => model.EffectiveEndDate, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CountWeeklyHolidaysInBetween, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.CountWeeklyHolidaysInBetween, Model.YesNoList, null, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CountOtherHolidaysInBetween, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.CountOtherHolidaysInBetween, Model.YesNoList, null, new { @class = "form-control" })
                </div>
            </div>
        </div>
