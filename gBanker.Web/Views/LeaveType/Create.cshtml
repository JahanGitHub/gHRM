    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-md-4"></label>
                <div class="col-md-8">
                    <div class="checkbox">
                        <label>@Html.CheckBoxFor(model => model.Ledger, new { @checked = "false" })Are you save this data to the Ledger table?</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                <input type="button" value="Save" id="btnSave" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
}
