@model gHRM.Web.ViewModels.LeaveTypeViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/LeaveType">LeaveType</a></li>
    </ol>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        loadEmployeeDesignation();
    });

    function LeaveTypeDelete(LeaveTypeId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("LeaveTypeDelete", "LeaveType", "http")',
                    data: { LeaveTypeId: LeaveTypeId },
                    dataType: 'json',
                    async: true,
                    success: function (response) {
                        if (response.result = 1) {
                            $.alert.open("Success", response.message);
                            loadEmployeeDesignation();
                        }
                        else {
                            alert(response.message);
                            $.alert.open("Error", response.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function loadEmployeeDesignation() {

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetLeaveType", "LeaveType", "http")',
                    dataType: 'json',
                    //data: { FilterBy: filterBy, FilterValue: filterValue }
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            //height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "LeaveTypeId",
                     hidden: true,
                     filterable: false
                 },
                 {
                     field: "rowSl",
                     title: "Sl No.",
                     width: "40px",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                 },
                 {
                     width: "120px",
                     field: "LeaveTypeName",
                     filterable: true,
                     title: "Leave Type Name"
                 },
                 {
                     width: "120px",
                     field: "EmployeeStatus",
                     title: "Employee Status"
                 },

                {
                    width: "100px",
                    field: "EligibleFrom",
                    title: "Eligibility",
                    template: function (dataItem) {
                        var result = '';
                        if (dataItem.EligibleFrom == 'J')
                            result = 'Joining Date';
                        else
                            result = 'Confirmation Date';
                        return result;
                    }
                },
                {
                    width: "80px",
                    field: "MaxLeaveDays",
                    title: "Max Leave Days"
                },

                {
                    width: "80px",
                    field: "MaxAvailDays",
                    title: "Max Avail Days"
                },
                {
                    width: "80px",
                    field: "LeaveStatus",
                    title: "Leave Status",
                    template: function (dataItem) {
                        var result = '';
                        if (dataItem.LeaveStatus == 'L')
                            result = 'Laps';
                        else if (dataItem.LeaveStatus == 'C')
                            result = 'Carry Forward';
                        else
                            result = 'N/A';
                        return result;
                    }
                },
                {
                    width: "80px",
                    field: "LeaveGender",
                    title: "Gender",
                    template: function (dataItem) {
                        var result = '';
                        if (dataItem.LeaveGender == 'M')
                            result = 'Male';
                        else if (dataItem.LeaveGender == 'F')
                            result = 'Female';
                        else
                            result = "Both";
                        return result;
                    }
                },

                {
                    width: "50px",
                    title: 'Edit',
                    template: function (data) {
                        return "<a href='/LeaveType/Edit/" + data.LeaveTypeId + "'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },

                {
                    title: "Delete",
                    width: "50px",
                    template: function (data) {
                        return "<a href='#' OnClick='LeaveTypeDelete(" + '"' + data.LeaveTypeId + '"' + ");'><i class='fa fa-trash-o'></i></a>";
                    }
                },
            ]
        });
    }


</script>

@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Leave Type List</h2>
<br />
<div class="box-content">
    <div class="table-responsive">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
