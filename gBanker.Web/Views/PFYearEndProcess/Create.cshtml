@model gHRM.Web.ViewModels.PF.YearEndProcessViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">


    function ProcessYearEnd(yearStartDate, yearEndDate, transDate) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("ProcessYearEnd", "PFYearEndProcess", "http")',
            data: { yearStartDate: yearStartDate, yearEndDate: yearEndDate, transDate: transDate },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", data.message);
                if (data.status == 'ok') {
                    $('#btnProcessYearEnd').prop('disabled', true);
                }

                //$('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Unable to Process");
                //$('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }
        });
    }


    function clear() {
        $('#YearStartDate').val('');
        $('#YearEndDate').val('');
        $('#TransactionDate').val('');
    }

    function Process() {
        var yearStartDate = $('#YearStartDate').val();
        var yearEndDate = $('#YearEndDate').val();
        var transDate = $('#TransactionDate').val();

        if (yearStartDate == '' || yearEndDate == '' || transDate == '') {
            alert('Sorry for inconvenience! please check organization setup and day en process log');
            return;
        }
        ProcessYearEnd(yearStartDate, yearEndDate, transDate);
    }

    $(document).ready(function () {

                        
        @if (Model.IsValidYearEnd == false)
        {
            <text>
            $("#btnProcessYearEnd").prop('disabled', true);
            </text>
        }
        @if (Model.IsValidYearEnd == true)
        {
            <text>
            $("#btnProcessYearEnd").prop('disabled', false);
            </text>
        }

       $("#btnProcessYearEnd").click(function () {            

           $.alert.open('confirm', 'Are you sure you want to process year close?', function (button) {
               if (button == 'yes') {
                   Process();
                   return true;
               }
               else {
                   return false;
               }
           });

            //var yearStartDate = $('#YearStartDate').val();
            //var yearEndDate = $('#YearEndDate').val();
            //var transDate = $('#TransactionDate').val();

            //if (yearStartDate == '' || yearEndDate == '' || transDate == '') {
            //    alert('Sorry for inconvenience! please check organization setup and day en process log');
            //    return;
            //}
            //ProcessYearEnd(yearStartDate, yearEndDate, transDate);
            
        });
    });
</script>

