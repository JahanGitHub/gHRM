@model gHRM.Web.ViewModels.FeedBack.FeedbackRegisterViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

    var CategoryList = Model == null ? null : Model.FeedbackCategoryList;
    var UnitList = Model == null ? null : Model.UnitList;
}
<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>
 

<script type="text/javascript">

    function reloadGrid() {

        $('#grid').jtable('load', { QType: '1', SolvedStatus: '1' });
       // clear();

    }

    function GetDownloadFile(FileUploadId) {
        //alert("Do");
        window.location.href = '@Url.Action("DownloadFile", "FeedbackRegister")?FileUploadId=' + FileUploadId;
    }


    function LoadEmpInfoByCode(employee_code) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmployeeData", "FeedbackRegister", "http")',
            data: { EmpId: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (index, data) {
                    if (data != "Error") {
                        
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#OfficeId").val(data.OfficeId);

                    }
                    else {

                        $("#EmployeeName").val('');
                        alert("Wrong Employe Code");
                        $("#txtEmpName").focus();
                    }
                });
            },
            error: function (request, status, error) {
                $.alert.open("Message","Employee not Found.");
                //alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function Delete(id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("Delete", "FeedbackRegister", "http")',
                    data: { id: id },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        //$('#grid').jtable('load', { EmployeeId: 0 });
                        reloadGrid();
                        $.alert.open("Message","Data Deleted Successfully.");
                       
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function clear()
    {
        $("#txtEmpName").val("");
        $("#EmployeeName").val("");
        $("#EmployeeId").val("");
        $("#OfficeId").val("");
        $("#FeedbackDescription").val("");
        $("#FeedbackDate").datepicker('setDate', new Date());

        $("#FeedbackCategoryID").prop('selectedIndex', 0);
    }
 
    $(document).ready(function () {

        

        $("#btnReset").click(function () { // Reset form
           // clear();
        });
        //  $("#Effect").prop('selectedIndex', 0);

        $("#btnSubmit").click(function () { // Reset form
         // var requiredValue0 = $("#UnitId").val();
          var requiredValue1 =   $("#EmployeeName").val();
          var requiredValue2 =   $("#EmployeeId").val();
          var requiredValue3 =   $("#OfficeId").val();
          var requiredValue4 =   $("#FeedbackDescription").val();
          var requiredValue5 =   $("#FeedbackDate").val();
          //  requiredValue0 == '0' ||
            if ( requiredValue1 == '' || requiredValue2 == '' || requiredValue3 == '' || requiredValue4 == '' || requiredValue5 == '')
          { 
              $.alert.open("Message","Please Give all required data.");
              return false;
          }

            reloadGrid();

        });

        $("#FeedbackDate").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: "1920:2050"

         });

        $("#FeedbackDate").datepicker(
      'setDate', new Date());

        $("#txtEmpName").blur(function (e) {
            var employee_code = $("#txtEmpName").val();
            if ($("#txtEmpName").val() == '')
            {
                $("#EmployeeName").val('');
                $("#txtEmpName").val('');
                $("#EmployeeName").val('');
                $("#EmployeeId").val('');
                $("#OfficeId").val('');
            }
            if ($("#txtEmpName").val() != '') {
                LoadEmpInfoByCode(employee_code);
            }
            else {
                $("#EmployeeName").empty();
                $("#EmployeeName").val('');
            }
        });


    
        $('#grid').jtable({
            paging: true,
            pageSize: 100,
            sorting: false,
            defaultSorting: 'FeedbackRegisterID',
            actions: {
                listAction: function (postData, jtParams) {

                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/FeedbackRegister/FeedbackRegisterSolvedStatusWise?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }
            },


            fields: {
                OrderId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                FeedbackRegisterID: {
                    title: 'Register ID',
                    width: '10%'
                },
                OfficeName: {
                    title: 'Office Name',
                    width: '10%'
                },
                EmployeeCode: {
                    title: 'Employee Code',
                    width: '10%'
                },
                EmployeeName: {
                    title: 'Employee Name',
                    width: '20%'
                },
                FeedbackCategoryName: {
                    title: 'Country Name',
                    width: '15%'
                },
                FeedbackDescription: {
                    title: 'Feedback Description',
                    width: '15%'
                },
                FeedbackDateMsg: {
                    title: 'Feedback Date',
                    width: '15%'
                },
                SolvedStatus: {
                    title: 'Solved Status',
                    width: '20%'
                },
                DownloadLink: {
                    title: "Download",
                    sorting: false,
                    display: function (data) {     
                        return "<div class='text-center'><a href='#' OnClick= GetDownloadFile('" + data.record.FeedbackRegisterID + "'" + ");><i class='fa fa-download'></i></a></div>";
                    }
                },
                EditLink: {
                    title: "Edit",
                    disable:true,
                    sorting: false,
                    display: function (data) {
                        return "<div class='text-center'><a href='/FeedbackRegister/Edit/" + data.record.FeedbackRegisterID + "'><i class='fa fa-pencil-square-o'></i></a></div>";
                    }
                },
                DeleteLink: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Delete(' + data.record.FeedbackRegisterID + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }
                }

            }
        });

        reloadGrid();
    });
</script>

