@using (Html.BeginForm("Create", "FeedbackRegister", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", @id = "CREATE" }))
{
   
    <div class="form-horizontal">
       
        <h4>Feedback Entry</h4>
        <hr />
        <fieldset>
            <legend>Feedback Entry</legend>

            <div class="row" style="display:none;">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.UnitId, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                        <div class="col-sm-8">
                            @Html.DropDownListFor(model => model.UnitId, Model.UnitList, new { @class = "form-control", @id = "UnitId" })
                        </div>
                    </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmployeeCode, new { @class = "control-label col-md-4 required" })
                            <div class="col-md-8">
                                @Html.TextBox("txtEmpName", "", new { @class = "form-control" })
                                @Html.HiddenFor(model => model.EmployeeId)
                                @Html.HiddenFor(model => model.OfficeId)

                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmployeeName, new { @class = "control-label col-md-4 required" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FeedbackCategoryID, new { @class = "control-label col-md-2 required" })
                            <div class="col-md-10">
                                @Html.DropDownListFor(model => model.FeedbackCategoryID, CategoryList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FeedbackDescription, new { @class = "control-label col-md-2 required" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.FeedbackDescription, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.FeedbackDate, new { @class = "control-label col-md-4 required" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.FeedbackDate, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.FeedbackDate)
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.File_AttachmentU, new { @class = "control-label col-md-4" })
                            <div class="col-md-8">
                                @Html.TextBoxFor(model => model.File_AttachmentU, new { type = "file", @class = "form-control" })
                            </div>
                        </div>
                    </div>

                </div>

</fieldset>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        &nbsp;
                        @*<input type="button" value="Save" id="btnSave" class="btn btn-success" />*@
                        <input type="submit" value="Submit" id="btnSubmit" class="btn btn-success" />
                        &nbsp;
                        <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" />
                    </div>
                </div>
            </div>
        </div>


        <!-- MESSAGE -->
<div class="row">
    <div class="panel-body">
        <div class="create-success create-content alert alert-success alert-dismissable" role="alert" style="display:none;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <p class="message-content">File Uploaded Successfully.</p>
        </div>
    </div>

    <div class="danger">
        <div class="create-content create-content alert alert-error alert-dismissable" role="alert" style="display:none;">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            <p class="message-content">Error </p>
        </div>
    </div>

</div>
 
@if (TempData["Success"] != null)
{
    <script>
        $(".panel-body .create-success").show(700).fadeToggle(2000);
    </script>
}
@if (TempData["Error"] != null)
{
    <script>

        $(".danger .create-content").show(700).fadeToggle(2000);

    </script>
}
<!-- End of Message-->

 
        @*<input type="submit" value="Submit" class="btn btn-default" />*@

        &nbsp;
        <div id="grid">

        </div>
    </div>
}

