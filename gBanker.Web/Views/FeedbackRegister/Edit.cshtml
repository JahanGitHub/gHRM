@model gHRM.Web.ViewModels.FeedBack.FeedbackRegisterViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

    var CategoryList = Model == null ? null : Model.FeedbackCategoryList;

}

<script src="http://momentjs.com/downloads/moment.js"></script>
<script src="http://malsup.github.com/jquery.form.js"></script>

<script type="text/javascript">

    function reloadGrid() {

        $('#grid').jtable('load', { QType: '1', SolvedStatus: '1' });

    }

    function LoadEmpInfoByCode(employee_code) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmployeeData", "FeedbackRegister", "http")',
            data: { EmpId: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (index, data) {
                    if (data != "Error") {
                        alert(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#OfficeId").val(data.OfficeId);

                    }
                    else {

                        $("#EmployeeName").val('');
                        alert("Wrong Employe Code");
                        $("#txtEmpName").focus();
                    }
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function clear()
    {
        $("#txtEmpName").val("");
        $("#EmployeeName").val("");
        $("#EmployeeId").val("");
        $("#OfficeId").val("");
        $("#FeedbackDescription").val("");
        $("#FeedbackDate").datepicker('setDate', new Date());

        $("#FeedbackCategoryID").prop('selectedIndex', 0);
    }

    $(document).ready(function () {

        $("#btnReset").click(function () { // Reset form
            clear();
        });
        //  $("#Effect").prop('selectedIndex', 0);

        $("#btnSubmit").click(function () { // Reset form

            reloadGrid();

        });

        $("#FeedbackDate").datepicker(
         {
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: "1920:2050"

         });

        $("#FeedbackDate").datepicker(
      'setDate', new Date());

        $("#txtEmpName").blur(function (e) {
            var employee_code = $("#txtEmpName").val();
            if ($("#txtEmpName").val() != '') {
                LoadEmpInfoByCode(employee_code);
            }
            else {
                $("#EmployeeName").empty();
                $("#EmployeeName").val('');
            }
        });



        $('#grid').jtable({
            paging: true,
            pageSize: 100,
            sorting: true,
            defaultSorting: 'FeedbackRegisterID',
            actions: {
                listAction: function (postData, jtParams) {

                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/FeedbackRegister/FeedbackRegisterSolvedStatusWise?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }
            },


            fields: {
                OrderId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                FeedbackRegisterID: {
                    title: 'Register ID',
                },

                OfficeName: {
                    title: 'Office Name',
                },

                EmployeeName: {
                    title: 'Employee Name'
                },
                FeedbackCategoryName: {
                    title: 'Country Name'
                },
                FeedbackDescription: {
                    title: 'Feedback Description'
                },
                FeedbackDateMsg: {
                    title: 'Feedback Date'
                },
                SolvedStatus: {
                    title: 'Solved Status',
                },
                ChkStatus: {
                    title: 'Check Status',
                },
                EditLink: {
                    title: "Edit",
                    disable:true,
                    sorting: false,
                    display: function (data) {
                        return "<div class='text-center'><a href='/PFContributionRegister/Edit/" + data.record.FeedbackRegisterID + "'><i class='fa fa-pencil-square-o'></i></a></div>";
                    }
                },
                DeleteLink: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Delete(' + data.record.FeedbackRegisterID + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }
                }

            }
        });

        reloadGrid();
    });
</script>

<h2>FEEDBACK REGISTER Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
     
    <div class="form-horizontal">
        <h4>Feedback Entry</h4>
        <h5>@Html.ActionLink("Back to List", "Create")</h5>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <fieldset>
            <legend>Edit Feedback </legend>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeCode, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8"> 
                            @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control" , @readonly = true} })
                            @Html.HiddenFor(model => model.FeedbackRegisterID)
                            @Html.HiddenFor(model => model.EmployeeId)
                            @Html.HiddenFor(model => model.OfficeId)

                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeName, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.FeedbackCategoryID, new { @class = "control-label col-md-2 required" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(model => model.FeedbackCategoryID, CategoryList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.FeedbackDescription, new { @class = "control-label col-md-2 required" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.FeedbackDescription, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.FeedbackDate, new { @class = "control-label col-md-4 required" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.FeedbackDate, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.FeedbackDate)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        @Html.LabelFor(model => model.File_AttachmentU, new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @*@Html.TextBoxFor(model => model.File_AttachmentU, new { type = "file", @class = "form-control" })*@
                            @Html.EditorFor(model => model.FileLocation, new { htmlAttributes = new { @class = "form-control", @readonly = true } })
                        </div>
                    </div>
                </div>
            </div>


        </fieldset>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        &nbsp;
                        @*<input type="button" value="Save" id="btnSave" class="btn btn-success" />*@
                        <input type="submit" value="Submit" id="btnSubmit" class="btn btn-success" />
                       
                    </div>
                </div>
            </div>
        </div>

    </div>
}

 
