        $("#CorrectionDetails").val('');
        $("#FeedbackDescription").val('');


        $("#ActualLoandisbursementAmount").val('');
        $("#WebLoanCollectionAmount").val('');
        $("#ActualCollectionDesktop").val('');
        $("#WebInterestCharge").val('');
        $("#WebInterestColleciton").val('');
        $("#DesktopInterestCharge").val('');
        $("#DesktopInterestCollection").val('');

        $("#SolvedBy").val('');

        $('#grid').jtable('load');
    }


    //Update
    function Update() {

        var selectedOfficeId = $('#selectedOfficeId').val();// $("#SalaryYear").val();

        var EmployeeId = $('#EmployeeId').val();// $("#SalaryMonth").val();

        var PayRollFeedBackRegId = $("#PayRollFeedBackRegId").val();//Update If PayRollFeedBackRegId Exist

        var ContactMobileNo = "";

        var ItemCode = $("#ItemCode").val();

        var DisburseDate = $("#DisburseDate").val();
        var ProblemDetails = $("#ProblemDetails").val();
        var CorrectionDetails = $("#CorrectionDetails").val();
        var FeedbackDescription = $("#FeedbackDescription").val();
        var SolvedBy = $("#SolvedBy option:selected").text();
        var SolvedDate = $("#SolvedDate").val();


        var ActualLoandisbursementAmount = $("#ActualLoandisbursementAmount").val();
        var WebLoanCollectionAmount = $("#WebLoanCollectionAmount").val();
        var ActualCollectionDesktop = $("#ActualCollectionDesktop").val();
        var WebInterestCharge = $("#WebInterestCharge").val();
        var WebInterestColleciton = $("#WebInterestColleciton").val();
        var DesktopInterestCharge = $("#DesktopInterestCharge").val();
        var DesktopInterestCollection = $("#DesktopInterestCollection").val();




        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdateSavePayrollFeedbackRegister", "FeedbackRegister", "http")', //Create(long EmployeeID, int PRComponentID, decimal ComponentAmount, string EffectiveStartDate, string EffectiveEndDate)
            data: {
                selectedOfficeId            :       selectedOfficeId        ,
                EmployeeId                  :       EmployeeId              ,
                PayRollFeedBackRegId        :       PayRollFeedBackRegId    ,
                ContactMobileNo             :       ContactMobileNo         ,
                ItemCode                    :       ItemCode                ,
                DisburseDate                :       DisburseDate            ,
                ProblemDetails              :       ProblemDetails          ,
                CorrectionDetails           :       CorrectionDetails       ,
                FeedbackDescription         :       FeedbackDescription     ,
                SolvedBy                    :       SolvedBy                ,
                SolvedDate                  :       SolvedDate              ,


                ActualLoandisbursementAmount    :       ActualLoandisbursementAmount,
                WebLoanCollectionAmount         :       WebLoanCollectionAmount,
                ActualCollectionDesktop         :       ActualCollectionDesktop,
                WebInterestCharge               :       WebInterestCharge,
                WebInterestColleciton           :       WebInterestColleciton,
                DesktopInterestCharge           :       DesktopInterestCharge,
                DesktopInterestCollection       :       DesktopInterestCollection

            },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Update Successfully");
                $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");

                $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }

        });

    }// End of Function




    function LoadEmpInfoByCode(employee_code) {
        var selectedOfficeId =  $("#selectedOfficeId").val();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmployeeData", "PRLoanDisburse", "http")',
            data: { EmpId: employee_code, officeId: selectedOfficeId },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (index, data) {
                    if (data != "Error") {

                        $("#EmployeeName").val(data.EmployeeName);
                        $("#EmployeeId").val(data.EmployeeID);

                        $("#OfficeID").val(data.OfficeID);

                    }
                    else {

                        $("#EmployeeName").val('');
                        $.alert.open("Wrong Employe Code");
                        $("#txtEmpName").focus();
                        //$("#OfficeDesignationId").val(0);
                    }
                });
            },
            error: function (request, status, error) {

                $("#EmployeeName").val("");
                $("#EmployeeId").val("");
                $("#OfficeID").val("");
                $("#txtEmpName").val("");

                $.alert.open(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function GetComponentDropdown() {
        var ddlComponentD = $("#ComponentName");

        // var ddlZOOffice = $("#ddlZOOffice option:selected").text().split("-")[0];
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetPRComponentList", "PRComponent", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlComponentD.html('');
                $.each(data, function (id, option) {
                    ddlComponentD.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                $.alert.open(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }



