        $("#PayRollFeedBackRegId").val(PayRollFeedBackRegId);
        $("#ContactMobileNo").val(ContactMobileNo);
        $("#txtEmpName").val(EmployeeId).attr("readonly", true);
        $("#EmployeeName").val(EmployeeName);
        $("#ItemCode").val(ItemCode);
        $("#DisburseDate").val(DisburseDate);
        $("#ProblemDetails").val(ProblemDetails);
        $("#CorrectionDetails").val(CorrectionDetails);
        $("#FeedbackDescription").val(FeedbackDescription);
        $("#SolvedBy").val(SolvedBy);


        $("#ActualLoandisbursementAmount").val(ActualLoandisbursementAmount);
        $("#WebLoanCollectionAmount").val(WebLoanCollectionAmount);
        $("#ActualCollectionDesktop").val(ActualCollectionDesktop);
        $("#WebInterestCharge").val(WebInterestCharge);
        $("#WebInterestColleciton").val(WebInterestColleciton);
        $("#DesktopInterestCharge").val(DesktopInterestCharge);
        $("#DesktopInterestCollection").val(DesktopInterestCollection);

        //if(SolvedBy=="Md.Babul"){
        //    $("#SolvedBy").val(1);
        //}else{
        //    $("#SolvedBy").trigger('change');
        //    $("#SolvedBy").val('');
        //}

        $("#EmployeeId").val(EmployeeId);
        $("#btnSave").show();
        $("#btnReset").show();
    }

</script>

