@model gHRM.Web.ViewModels.FeedBack.FeedbackRegisterViewModel

@{
    ViewBag.Title = "FeedBack Submit";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<script type="text/javascript">

    function GetDownloadFile(FileUploadId) {
        //alert("Do");
        window.location.href = '@Url.Action("DownloadFile", "FeedbackRegister")?FileUploadId=' + FileUploadId;
    }

      function GetDownloadFile2(FileUploadId) {
        //alert("Do");
        window.location.href = '@Url.Action("DownloadFile2", "FeedbackRegister")?FileUploadId=' + FileUploadId;
    }

    function GetPrintDataById(ID) {

        url = '/FeedbackRegister/Print?Id=' + ID;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }


    //Save
    function Update() {
       // alert("Update");
        var SolvedBy = $("#SolvedBy").val();
        var SolvedDate = $("#SolvedDateSTR").val();
        var IsChecked = 0;
        if ($('#IsChecked').is(':checked')) {
            IsChecked = 1;
        }
        var IsSolved = 0;
        if ($('#IsSolved').is(':checked')) {
            IsSolved = 1;
        }
        var Remarks = $("#Remarks").val();

        var FeedbackRegisterID = $("#FeedbackRegisterID").val();


        var fileUpload = $("#File_AttachmentUReply").get(0);
        var files = fileUpload.files;

        // Create FormData object
        var fileData = new FormData();

        // Looping over all files and add it to FormData object
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        // Adding one more key to FormData object
        fileData.append('SolvedBy', SolvedBy);
        fileData.append('SolvedDate', SolvedDate);
        fileData.append('IsChecked', IsChecked);
        fileData.append('IsSolved', IsSolved);
        fileData.append('Remarks', Remarks);
        fileData.append('FeedbackRegisterID', FeedbackRegisterID);



        $.ajax({
            type: 'POST',
            contentType: false,
            processData: false,
            url: '@Url.Action("UpdateFeedBackReg_GC", "FeedbackCategory", "http")', // UpdateFeedBackReg(string FeedbackRegisterID, string IsChecked, string IsSolved, string SolvedBy, string SolvedDate)
            data: fileData,
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Update Successfully");

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }

        });

    }// End of Function


    //Save
    function Save() {

        var FeedbackCategoryName = $("#FeedbackCategoryName").val();
        var FeedbackCategoryType = $("#CatType option:selected").val();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("CreateNCategory", "FeedbackCategory", "http")', //CreateNCategory(string FeedbackCategoryName, string FeedbackCategoryType)
            data: { FeedbackCategoryName: FeedbackCategoryName, FeedbackCategoryType : FeedbackCategoryType },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Saved Successfully");

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Saved");

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }

        });

    }// End of Function



    //Promotion Config JS
    function GetData(ID) { //populate Area Form
        //alert(ID);
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetFeedBackRegisterList", "FeedbackCategory", "http")',  //GetFeedBackList(string Id, int jtStartIndex, int jtPageSize, string jtSorting, string filterColumn, string filterValue)
            data: { Id: ID, IsChecked : null, IsSolved : null, jtStartIndex: 1, jtPageSize: 5, jtSorting: true, filterColumn: null, filterValue: null},
            dataType: 'json',
            async: true,
            success: function (data) {

                $.each(data, function (id, option) {

                    //promotionConfigAge.append($('<option></option>').val(option.Value).html(option.Text));
                    //$('#DesignationIdFrom option[value=' + option.DesignationIdFrom + ']').prop('selected', true);
                    //$('#DesignationIdTo option[value=' + option.DesignationIdTo + ']').prop('selected', true);
                    $('#FeedbackRegisterID').val(option.FeedbackRegisterID);
                    $('#EmployeeCode').val(option.EmployeeCode);
                    $('#EmployeeId').val(option.EmployeeId);
                    $('#EmployeeName').val(option.EmployeeName);
                    $('#FeedbackCategoryName').val(option.FeedbackCategoryName);
                    $('#FeedbackDescription').val(option.FeedbackDescription);
                    $('#FeedbackDateSTR').val(option.FeedbackDateSTR);
                    $('#SolvedBy').val(option.SolvedBy);

                    if (option.ChkStatus == 'Checked') {
                        $('#IsChecked').prop('checked', true);
                    }
                    else {
                        //uncheck
                        $('#IsChecked').prop('checked', false);
                    }

                    if (option.SolvedStatus == 'Solved') {
                        $('#IsSolved').prop('checked', true);

                    }
                    else {
                        //UnSolved
                        $('#IsSolved').prop('checked', false);

                    }

                    $('#Remarks').val(option.Remarks);

                    //$('#FeedbackCategoryID').val(option.FeedbackCategoryID);
                    //$("#CatType").val(option.FeedbackCategoryType);
                    //$('#CatType option[value=' + option.FeedbackCategoryType + ']').prop('selected', true);

                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
                clear();
            }
        });
    }
    function clear()
    {
        $("#FeedbackRegisterID").val('');

        $("#EmployeeId").val('');
        $("#EmployeeName").val('');
        $("#FeedbackCategoryName").val('');
        $("#FeedbackDescription").val('');
        $("#FeedbackDateSTR").val('');
        $("#SolvedBy").val('');
        $("#FeedbackDateSTR").val('');
        $("#SolvedDateSTR").datepicker('setDate', new Date());
        $('#IsChecked').prop('checked', false);
        $('#IsSolved').prop('checked', false);

        $("#File_AttachmentUReply").val('');
        $("#Remarks").val('');

    }
    //Delete Cat
    function DeleteAction(Id) {

        //var FeedbackCategoryID = $("#FeedbackCategoryID").val();

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("DeleteFeedBack", "FeedbackCategory", "http")', //DeleteFeedBack(int FeedbackCategoryID)
            data: { FeedbackCategoryID: Id },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Delete Successfully");
                clear();
                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Delete");
                clear();
                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }

        });



    }// End of Function


    function Edit(id) // Edit ConfigAge Table
    {
        GetData(id);
        //$("#PromotionConfigId").attr('disabled', true);
        //GetDataPromoAge(id);
    }

    function Delete(id)
    {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                DeleteAction(id);
                return true;
            }
            else {

                return false;
            }
        });

    }

    //End Save Work Area

    $(document).ready(function () {

        $("#SolvedDateSTR").datepicker(
           {
               dateFormat: "dd-M-yy",
               showAnim: "scale",
               changeMonth: true,
               changeYear: true,
               yearRange: "1920:2050"

           });
        $("#SolvedDateSTR").datepicker(
      'setDate', new Date());


        $("#txtMasterID").blur(function (e) {
            var employee_code = $("#txtMasterID").val();
            if ($("#txtMasterID").val() != '') {
                LoadEmpInfoByCode(employee_code);
            }

            else {
                $("#EmployeeName").empty();
            }
        });


        $("#btnReset").click(function () { // Reset form
            clear();
        });

        $("#btnSave").click(function () {

            var EmployeeId = $("#EmployeeId").val();

            var EmployeeName = $("#EmployeeName").val();
            var SolvedBy = $("#SolvedBy").val();

            var id = $("#FeedbackRegisterID").val();
            //var CategoryType = $("#CatType option:selected").val();

            if (EmployeeId == "")
            {
                $.alert.open("Please Select Employee.");
                return false;
            }
            if (SolvedBy == "")
            {
                $.alert.open("Please Select Solved By.");
                return false;
            }
            if (id != 0)
            {
                //alert("Update");
                // Update
                Update();
                clear();
            }
            else
            {
                // Save
               // Save();
              //  clear();
            }

        });

        $('#grid2').jtable({
            // title: 'Investor List',
            paging: true,
            pageSize: 25,
            sorting: true,
            defaultSorting: 'Name ASC',
            actions: {
                listAction: '/FeedbackCategory/GetFeedBackRegisterList'
            },
            fields: {
                FeedbackRegisterID: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                EmployeeCode: {
                title: 'Employee ID',
                width: '10%'
                    },
                EmployeeName: {
                    title: 'Employee Name',
                    width: '20%'
                },
                FeedbackDateSTR: {
                    title: 'Feedback Date',
                    width: '15%'
                },
                FeedbackCategoryName: {
                    title: 'Feedback Category Name',
                    width: '20%'
                },
                ChkStatus: {
                    title: 'Check Status',
                    width: '15%'
                },
                SolvedStatus: {
                    title: 'Solved Status',
                    width: '30%'
                },
                DownloadLink1: {
                    title: "Download1",
                    sorting: false,
                    display: function (data) {
                        return "<div class='text-center'><a href='#' OnClick= GetDownloadFile('" + data.record.FeedbackRegisterID + "'" + ");><i class='fa fa-download'></i></a></div>";
                    }
                },
                DownloadLink2: {
                    title: "Download2",
                    sorting: false,
                    display: function (data) {
                        return "<div class='text-center'><a href='#' OnClick= GetDownloadFile2('" + data.record.FeedbackRegisterID + "'" + ");><i class='fa fa-download'></i></a></div>";
                    }
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Edit(' + data.record.FeedbackRegisterID + ')"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                PrintLink: {
                    title: "Print",
                    sorting: false,
                    display: function (data) {
                        return "<div class='text-center'><a href='#' OnClick='GetPrintDataById(" + data.record.FeedbackRegisterID + ");'><i class='fa fa-print'></i></a></div>";
                    }
                }

                //,
                //DeleteLink: {
                //    title: "Delete",
                //    display: function (data) {
                //        return '<div class="text-center"><a href="#" OnClick="Delete(' + data.record.FeedbackRegisterID + ');"><i class="fa fa-trash-o"></i></a></div>';
                //    }
                //}
            }
        });
        reloadGrid2();
        //$('#grid').jtable('load');
        $("#CatType").change(function () {
            if ($(this).val() === "ViewAll") {
                $('#grid2').jtable('load', {});
            }
            else if ($(this).val() === "Checked") { //string IsChecked, string IsSolved
                $('#grid2').jtable('load', {IsChecked : 1 , IsSolved: null});
            }
            else if ($(this).val() === "Solved") { //string IsChecked, string IsSolved
                $('#grid2').jtable('load', { IsChecked: null, IsSolved: 1 });
            }
            else if ($(this).val() === "UnChecked") { //string IsChecked, string IsSolved
                $('#grid2').jtable('load', { IsChecked: 0, IsSolved: null });
            }
            else if ($(this).val() === "UnSolved") { //string IsChecked, string IsSolved
                $('#grid2').jtable('load', { IsChecked: null, IsSolved: 0 });
            }

            //UnChecked
            //UnSolved

        });

        function reloadGrid2() {
            //$("#loading").show();
            $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            //$("#loading").hide();
        }





    });// End Document Rready
</script>

