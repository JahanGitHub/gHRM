    function EditGrid(SignatureId, SignatureCode, SignatureName) {
        $("#SignatureId").val(SignatureId);
        $("#SignatureCode").val(SignatureCode);
        $("#SignatureName").val(SignatureName);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }

    function UpdateSignatureDesignation() {
        var sigId =  $("#SignatureId").val();
        var sigCode = $("#SignatureCode").val();
        var sigName = $("#SignatureName").val();

        if (sigCode != "" && sigName != "") {
            var obj = {
                SignatureId:sigId,
                SignatureCode: sigCode,
                SignatureName: sigName
            }
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateSignatureDesignation", "EmployeeDesignation", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        $(".panel-body .create-success").show(800).fadeToggle(3000);
                        $.alert.open('Success', data.message);
                        loadEmployeeDesignation();
                        Clearform();
                    } else {
                        $.alert.open('Error', data.message);
                    }
                },
            });
        }
    }

    function ResetSignatureDesignation() {
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        $("#btnSave").show();
        Clearform();
    }

    function DeleteGrid(Id) {
       $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteSignatureDesignation", "EmployeeDesignation", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            loadEmployeeDesignation();
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

   
