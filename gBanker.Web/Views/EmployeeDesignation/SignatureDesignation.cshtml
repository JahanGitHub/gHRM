@model gHRM.Web.ViewModels.EmployeeSignatureDesignationViewModel
@{
    ViewBag.Title = "Signature Designation";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script>

    $(document).ready(function() {
        loadEmployeeDesignation();
        $("#btnUpdate").hide();
        $("#btnReset").hide();
    });

    function SaveSignatureDesignation() {
        var sigCode = $("#SignatureCode").val();
        var sigName = $("#SignatureName").val();

        if (sigCode != "" && sigName!="") {
            var obj= {
                SignatureCode: sigCode,
                SignatureName: sigName
            }
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SaveSignatureDesignation", "EmployeeDesignation", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        $(".panel-body .create-success").show(800).fadeToggle(3000);
                        $.alert.open('Success', data.message);
                        loadEmployeeDesignation();
                        Clearform();
                    } else {
                        $.alert.open('Error', data.message);
                    }
                },
            });
        }
    }

    function Clearform() {
        $("#SignatureCode").val('');
        $("#SignatureName").val('');
    }
    function loadEmployeeDesignation() {

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetSignatureDesignation", "EmployeeDesignation", "http")',
                    dataType: 'json',
                    //data: { FilterBy: filterBy, FilterValue: filterValue }
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "SignatureId",
                     hidden: true,
                     filterable: false
                 },
                 {
                     field: "rowSl",
                     title: "Sl No.",
                     width: "50px",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                     //locked: true,
                     //lockable: false,
                 },
                 {
                     width: "100px",
                     field: "SignatureCode",
                     filterable: true,
                     title: "Signature Code",
                     //locked: true
                 },
                 {
                     width: "200px",
                     field: "SignatureName",
                     title: "Signature Name",
                     //locked: true
                 },                
                 {
                     width: "50px",
                     title: 'Edit',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='EditGrid(" + dataItem.SignatureId + ",\"" + dataItem.SignatureCode + "\",\"" + dataItem.SignatureName + "\");'><i class='fa fa-pencil-square-o'></i></a>";///Office/Create/?OfficeId=" + dataItem.EntrepreneurId + "
                         
                     }
                 },
                 {
                     width: "50px",
                     title: 'Delete',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='DeleteGrid(" + dataItem.SignatureId + ");'><i class='fa fa-trash-o'></i></a>";///Office/Create/?OfficeId=" + dataItem.EntrepreneurId + "
                         
                     }
                 }
            ]
        });
    }
