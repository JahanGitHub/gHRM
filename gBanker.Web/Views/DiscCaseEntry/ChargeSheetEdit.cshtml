                    var AnnexationId = $("#txtAnnexationId" + NewSl).val();
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("CaseDetailDelete", "DiscCaseEntry", "http")',
                        data: { CaseDetailsId: CaseDetailsId, AnnexationId: AnnexationId },
                        dataType: 'json',
                        async: true,
                        success: function (result) {
                            LoadCaseDetails();
                        },
                        error: function (request, status, error) {
                            alert(request.statusText + "/" + request.statusText + "/" + error);
                        }
                    });
                    return true;
                }
                else {
                    $("#tableRow" + NewSl).remove();
                }
                return true;
            }
            else {
                return false;
            }
        });
    }
