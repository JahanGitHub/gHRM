    function LoadCrimeLocationInfo(office_Id) {

        var row_Count = $('#tblCrimeLocationDetails >tbody >tr').length;
        for (i = 1; i <= row_Count; i++) {
            var OfficeId = $("#txtOffice_Id" + i).val();

            if (OfficeId != undefined) {
                if (OfficeId == office_Id) {
                    $.alert.open("error", "This office has been added")
                    return false;
                }
            }

        }

        var dtTable = $("#tblCrimeLocationDetails")
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCrimeLocationByCode", "DiscCaseEntry", "http")',
            data: { office_Id: office_Id },
            dataType: 'json',
            async: true,
            success: function (List_EmployeeViewModel) {
                if (List_EmployeeViewModel != "") {
                    var rowCount = $('#tblCrimeLocationDetails >tbody >tr').length;
                    var sl = rowCount + 1;
                    var tableBody = dtTable.find('tbody');
                    $.each(List_EmployeeViewModel, function (index, off) {

                        tableBody.append('<tr id="table_Row' + sl + '">' +
                                                     '<td style="text-align: center">' + sl + '<input type="text" class="CrimeOfficeNo" value="' + off.OfficeId + '" style="display:none;" name="OfficeId" id="txtOffice_Id' + sl + '" /></td>' +
                                                     '<td style="text-align: center">' + off.OfficeCode + '<input type="text" class="CrimeOffice" value="' + off.OfficeId + '" style="display:none;" name="OfficeId" id="txtOfficeId' + off.OfficeId + '" /></td>' +
                                                     '<td>' + off.OfficeName + '<input type="text" value="' + off.OfficeName + '" style="display:none;" name="OfficeName" id="txtOfficeName' + off.OfficeId + '" /></td>' +
                                                     '<td style="text-align: center"><a href="javascript:;" onclick="delete_rowCrime(' + sl + ')"><i class="fa fa-trash-o fa-2x"></i></a>' +
                                                     '</td>' +
                                                  '</tr>'
                                )
                    });
                }
                else {
                    $.alert.open('alert', 'Invalid code');
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function CrimeLocation() {
        var CrimeLocation = 0;
        var radHO = "";
        var radZO = "";
        var radZAO = "";

        if ($("#radHO").is(":checked")) {
            radHO = $("#radHO").val();
        }
        else if ($("#radZO").is(":checked")) {
            radZO = $("#radZO").val();
        }
        else if ($("#radZAO").is(":checked")) {
            radZAO = $("#radZAO").val();
        }

        var hoOfc = 0
        if ($("#ddlHOOffice option:selected").val() == '')
            hoOfc = 0;
        else
            hoOfc = $("#ddlHOOffice option:selected").val();
        var zoOfc = 0;
        if ($("#ddlZOOffice option:selected").val() == '')
            zoOfc = 0
        else
            zoOfc = $("#ddlZOOffice option:selected").val();
        var aoOfc = 0;
        if ($("#ddlAOOffice option:selected").val() == '')
            aoOfc = 0;
        else
            aoOfc = $("#ddlAOOffice option:selected").val();
        var boOfc = 0;
        if ($("#ddlBOOffice option:selected").val() == '')
            boOfc = 0;
        else
            boOfc = $("#ddlBOOffice option:selected").val();
        var zaoOfc = 0;
        if ($("#ddlZAOOffice option:selected").val() == '')
            zaoOfc = 0;
        else
            zaoOfc = $("#ddlZAOOffice option:selected").val();


        if (radHO == 'HO') {
            if (hoOfc > 0) {
                CrimeLocation = hoOfc;
            }
        }
        else if (radZO == 'ZO') {
            if (zoOfc > 0) {
                CrimeLocation = zoOfc;
                if (aoOfc > 0) {
                    CrimeLocation = aoOfc;
                }
                if (boOfc > 0) {
                    CrimeLocation = boOfc;
                }
            }
        }
        else if (radZAO == 'ZAO') {
            if (zaoOfc > 0) {
                CrimeLocation = zaoOfc;
            }
        }
        // alert(CrimeLocation);
        return CrimeLocation;
    }

    function checkNumberic(e) {
        if (e.which != 8 && e.which != 0 && (e.which < 46 || e.which > 57)) {
            return false;
        }
        else
            return true;
    }

