    function ValidateAddRequirement() {
        var txtEmpName = $("#txtEmpName").val();
        var DealOfficerId = $('#tblDealinOfficerList >tbody >tr').length;
        var CrimeId = $("#ddlCrimeId").val();

        if (txtEmpName == '' && DealOfficerId == 0 && CrimeId == '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId == 0 && CrimeId != '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#DealOfficerId").addClass("errorClass");
            return false;
        }

        else if (txtEmpName == '' && DealOfficerId != 0 && CrimeId == '0') {
            $("#txtEmpName").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName == '' && DealOfficerId != 0 && CrimeId != '0') {
            $("#txtEmpName").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == 0 && CrimeId == '0') {
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == 0 && CrimeId != '0') {
            $("#DealOfficerId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId == 0 && CrimeId == '0') {
            $("#DealOfficerId").addClass("errorClass");
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else if (txtEmpName != '' && DealOfficerId != 0 && CrimeId == '0') {
            $("#CrimeId").addClass("errorClass");
            return false;
        }
        else
            return true;
    }

    function ValidateSaveRequirement() {
        var CaseNo = $("#CaseNo").val();
        var CaseDescription = $("#CaseDescription").val();

        if (CaseNo == '' && CaseDescription == '') {
            $("#CaseNo").addClass("errorClass");
            $("#CaseDescription").addClass("errorClass");
            return false;
        }
        else if (CaseNo == '' && CaseDescription != '') {
            $("#CaseNo").addClass("errorClass");
            return false;
        }
        else if (CaseNo != '' && CaseDescription == '') {
            $("#CaseDescription").addClass("errorClass");
            return false;
        }
        else
            return true;
    }
