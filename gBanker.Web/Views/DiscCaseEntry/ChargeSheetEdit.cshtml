        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "EmployeePostingHistory", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (index, data) {
                    if (data != "Error") {
                        $("#EmployeeRank").val(data.EmployeeRank);
                        $("#OfficeName").val(data.OfficeName);
                        //$("#DepartmentName").val(data.DepartmentName);
                        $("#DesignationName").val(data.DesignationName);
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#OfficeDesignationId").val(data.EmpOfficeDesigId);
                        $("#OrderNo").focus();
                    }
                    else {
                        $("#EmployeeRank").empty();
                        $("#OfficeName").empty();
                        //$("#DepartmentName").empty();
                        $("#DesignationName").empty();
                        $("#EmployeeName").empty();
                        alert("Wrong Employe Code");
                        $("#txtEmpName").focus();
                        $("#OfficeDesignationId").val(0);
                    }
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
