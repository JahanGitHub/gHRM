    <br />
    <fieldset>
        <legend>Employee Present Information</legend>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Employee Code</label>
                    <div class="col-sm-8">
                        @*@Html.DropDownListFor(model => model.EmployeeId, empList, new { @class = "form-control" })*@
                        @Html.TextBox("txtEmpName", "", new { @class = "form-control" })
                        @Html.HiddenFor(model => model.EmployeeId)
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Employee Name</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Employee Rank</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.EmployeeRank, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Office Name</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.OfficeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Designation Name</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Despatch No</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.DispatchNo, new { htmlAttributes = new { @class = "form-control txtcapitalize" } })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <label class="control-label col-sm-2">Remarks</label>
                    <div class="col-sm-10">
                        @Html.EditorFor(model => model.Remarks, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
            @*<div class="col-sm-6">
                &nbsp;
            </div>*@
        </div>
    </fieldset>
    <br />
    <fieldset>
        <legend>Crime Information</legend>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Crime</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.CrimeId, CrimeLists, new { @ID = "ddlCrimeId", @class = "form-control" })
                        <input type="text" id="txtCrimeType" style="display:none;" />
                    </div>
                </div>
            </div>
          
        </div>
        <div class="row" id="divAnnexation">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Total Emblezzle</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.TotalAnnexationAmount, new { htmlAttributes = new { @class = "form-control"} })                       
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div id="IndividualAnnexationAmount">                   
                    <div class="form-group">
                        <label class="control-label col-sm-4">Individual Emblezzle</label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.AnnexationAmount, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" id="divReturn">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Returned Amount</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.TotReturnAmount, new { htmlAttributes = new { @class = "form-control"} })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div id="IndividualAnnexationReturnAmount">
                    <div class="form-group">
                        <label class="control-label col-sm-4">Individual Returned Amount</label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.IndiReturnAmountMsg, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" id="div_Return" style="display:none">
