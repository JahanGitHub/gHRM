    function radioChk() {
        if ($("#radHO").is(":checked")) {
            //loaddept
            $("#HO").show();
            $("#ZO").hide();
            $("#ZAO").hide();

            GetHOOffice();
        }
        else if ($("#radZO").is(":checked")) {
            //load zone,area,branch
            $("#HO").hide();
            $("#ZO").show();
            $("#ZAO").hide();
            GetZOOffice();
        }
        else if ($("#radZAO").is(":checked")) {
            //load zonal audit
            $("#HO").hide();
            $("#ZO").hide();
            $("#ZAO").show();
            GetZAOOffice();

        }
        else {
            $("#HO").hide();
            $("#ZO").hide();
            $("#ZAO").hide();
        }
    }

