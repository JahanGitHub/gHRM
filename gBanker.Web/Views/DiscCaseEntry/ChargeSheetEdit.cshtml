    function GetOfficeForEdit() {
        var OfficeId = $("#CrimeLocation").val();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetOfficeForEdit", "DiscCaseEntry", "http")',
            data: { OfficeId: OfficeId },
            dataType: 'json',
            async: true,
            success: function (DisCrimeLocation) {

                $.each(DisCrimeLocation, function (index, crmLocation) {
                    rowCo = index + 1;
                    if (crmLocation.OfficeTypeId == 1) //Head Office
                    {
                        Office_Type = 1;
                        Office_Id = crmLocation.OfficeId;
                        $("#radHO").prop('checked', true);
                        $("#HO").show();
                        $("#ZO").hide();
                        $("#ZAO").hide();
                        GetHOOffice();

                    }
                    else if (crmLocation.OfficeTypeId == 2) //Zonal Office
                    {
                        Office_Type = 2;
                        Office_Id = crmLocation.OfficeId;

                        $("#radZO").prop('checked', true);

                       
                        $("#HO").hide();
                        $("#ZO").show();
                        $("#ZAO").hide();
                        GetZOOffice()
                    }
                    else if (crmLocation.OfficeTypeId == 3) {
                        Office_Type = 3;
                        $("#radZAO").prop('checked', true);
                        Office_Id = crmLocation.OfficeId;
                        $("#HO").hide();
                        $("#ZO").hide();
                        $("#ZAO").show();
                        GetZAOOffice();

                    }
                    else if (crmLocation.OfficeTypeId == 4) //Area  Office
                    {
                        $("#radZO").prop('checked', true);
                        $("#HO").hide();
                        $("#ZO").show();
                        $("#ZAO").hide();
                        Office_Type = 4;
                        Secondoffice_Id = crmLocation.SecondLevelId;
                        Office_Id = crmLocation.OfficeId;
                        GetZOOffice()
                    }
                    else //Branch  Office
                    {
                        Office_Type = 5;
                        Thirdoffice_Id = crmLocation.ThirdLevelId;
                        Secondoffice_Id = crmLocation.SecondLevelId;
                        Office_Id = crmLocation.OfficeId;
                        $("#radZO").prop('checked', true);
                        $("#HO").hide();
                        $("#ZO").show();
                        $("#ZAO").hide();

                        GetZOOffice()
                    }
                });

            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });


    }

