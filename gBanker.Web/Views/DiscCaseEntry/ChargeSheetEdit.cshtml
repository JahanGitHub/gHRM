    function delete_rowCrimeDB(DiscCaseCrimeLocationId) {
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("deleteLocation", "DiscCaseEntry", "http")',
                    data: { DiscCaseCrimeLocationId: DiscCaseCrimeLocationId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                      //  CrimeLocationLoad();
                        $("#table_Row" + DiscCaseCrimeLocationId).remove();
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                return false;
            }
        });
    }


    function CrimeLocationLoad() {
        var MasterId = $("#CaseMasterId").val();
