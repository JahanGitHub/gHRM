                <div class="form-group">
                    <label class="control-label col-sm-4">Date of Return</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.ReturnNoticeDate, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6" style="display:none">
