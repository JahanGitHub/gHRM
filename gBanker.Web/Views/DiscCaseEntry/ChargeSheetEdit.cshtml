                    <div class="form-group">
                        <label class="control-label col-sm-4">Date of Individual Return</label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.IndiReturnNoticeDate, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <br/>
    <fieldset>
        <legend>Payment/Other Notice</legend>
        <div class="row">
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="control-label col-sm-4">Despatch Type</label>
                    <div class="col-sm-8">
                        <select id="DespatchType" class="form-control">
                            <option value="Pay" selected="selected">Payment</option>
                            <option value="Rcv">Receive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="control-label col-sm-4">Date</label>
                    <div class="col-sm-8">
                        @Html.Editor("DespatchDate", new { htmlAttributes = new { @class = "form-control", @Value = DateTime.Now.ToString("dd-MMM-yyyy") } })
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">
                    <label class="control-label col-sm-4">Despatch No</label>
                    <div class="col-sm-8">
                        @Html.Editor("DespatchNo", new { htmlAttributes = new { @class = "form-control txtcapitalize" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="form-group">                   
                    <div class="col-sm-8">
                        <input type="submit" value="Save" id="btnDespatchSave" class="btn btn-info" /> 
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px; margin:5px;">
                <div class="save-success alert alert-success alert-dismissable" role="alert" style="display:none">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <p class="message-content">Saved Sucessfully</p>
                </div>
                <div class="save-fail alert alert-danger alert-dismissable" role="alert" style="display:none">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <p class="message-content">Fail to save</p>
                </div>
                &nbsp;
                <input type="submit" value="Add & Save" id="btnCaseEntryAdd" class="btn btn-info" />
                &nbsp;
               @* <input type="submit" value="Save" id="btnCaseEntrySave" class="btn btn-success" />*@
                <input type="hidden" value="" id="hdnCaseEntrySave" />
                <input type="hidden" value="" id="hdnCaseMasterId" />
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-sm-12">
            <div id="DivTableView">
                <div class="box-header">
                    <h3 class="box-title">Crime List</h3>
                </div>
                <div class="box-body no-padding table-responsive">
                    <table class="table table-striped responsive-utilities jambo_table bulk_action" id="tblCrimeDetails">
                        <thead>
                            <tr class="headings">
                                <th class="column-title">Sl</th>
                                <th class="column-title">Despatch No</th>
                                <th class="column-title">Employee Name</th>
                                @*<th class="column-title">Dealing Officer</th>
                                    <th class="column-title">Enquery Officer</th>*@
                                <th class="column-title">Crime Date From</th>
                                <th class="column-title">Crime Date To</th>
                                <th class="column-title">Crime</th>
                                <th class="column-title">Total Emblezzle Amount</th>
                                <th class="column-title">Total Return Amount</th>
                                <th class="column-title">Individual Emblezzle Amount</th>
                                <th class="column-title">Individual Return Amount</th>
                               @* <th class="column-title">Individual Return Date</th>*@
                               
                                @*<th class="column-title">Total Return Date</th>*@
                                @*<th class="column-title">Re-Despatch</th>*@
                                <th class="column-title">Remarks</th>
                                <th class="column-title">Update</th>
                                <th class="column-title">Delete</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

}
