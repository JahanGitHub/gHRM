    function delete_row(NewSl) {
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {


                var mode = $("#txtCaseSaveMode" + NewSl).val();
                if (mode == "U") {
