            data: { MasterId: MasterId },
            dataType: 'json',
            async: true,
            success: function (List_DiscCaseCrimeLocationViewModel) {
                var rowCo = 0;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                $.each(List_DiscCaseCrimeLocationViewModel, function (index, off) {
                    rowCo = index + 1;
                    tableBody.append('<tr id="table_Row' + off.rowSl + '">' +
