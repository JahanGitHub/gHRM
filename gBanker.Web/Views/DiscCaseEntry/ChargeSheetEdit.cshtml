                <input type="submit" value="Add" id="btnCrimeLocationAdd" class="btn btn-info" />
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-sm-12">
                <table id="tblCrimeLocationDetails" style="width:90%;margin-left:10%" border="1">
                    <thead style="background-color:green;color:white;">
                        <tr class="headings">
                            <th class="column-title" style="text-align: center">Sl</th>
                            <th class="column-title" style="text-align: center">Office Code</th>
                            <th class="column-title" style="text-align: center">Crime Location</th>
                            <th class="column-title" style="text-align: center">Delete</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
