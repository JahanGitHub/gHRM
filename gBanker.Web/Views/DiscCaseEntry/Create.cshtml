    ////////////End Office /////////////
    function LoadEmpInfoByCode(employee_code) {
        // alert(employee_code);
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "EmployeeTransferNew", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {
                        $("#EmployeeRank").val(data.EmployeeRank);
                        $("#OfficeName").val(data.EmployeeCurrentOfficeName);
                        //$("#DepartmentName").val(data.DepartmentName);
                        $("#DesignationName").val(data.EmployeeCurrentDesignation);
                        $("#OffcDesignName").val(data.EmployeeCurrentDesignation);
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#OfficeDesignationId").val(data.EmpOfficeDesigId);
                         
                    });
                    
                }

                else {
                    
                    $("#EmployeeRank").empty();
                    $("#OfficeName").empty();
                    //$("#DepartmentName").empty();
                    $("#DesignationName").empty();
                    $("#EmployeeName").empty();
                    alert("Wrong Employe Code");
                    $("#txtEmpName").focus();
                    $("#OfficeDesignationId").val(0);
                }
                 
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
