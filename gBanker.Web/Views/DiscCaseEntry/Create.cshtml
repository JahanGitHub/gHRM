    function DealingOfficerAdd() {

        var DealofficerId = $("#DealOfficerId").val();
        var DealOfficerName = $("#DealOfficerId option:selected").text();
        var rowCount = 0;
        var dtTable = $('#tblDealinOfficerList');
        rowCount = $('#tblDealinOfficerList >tbody >tr').length;

