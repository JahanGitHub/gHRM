                            <th class="column-title" style="text-align: center">Delete</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
     </fieldset>
    <br/>
   
    <fieldset>
        <legend>Crime Information</legend>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Crime<b class="required"></b></label>    
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.CrimeId, CrimeLists, new { @ID = "ddlCrimeId", @class = "form-control" })                        
                        <input type="text" id="txtCrimeType" style="display:none;" />
                    </div>
                </div>
            </div>          
        </div>
        <div class="row" id="divAnnexation"> 
            <div class="col-sm-6">
                <div id="IndividualAnnexationAmount">
                    @*style="display:none;"*@
                    <div class="form-group">
                        <label class="control-label col-sm-4">Individual Embezzle</label>
                        <div class="col-sm-7">
                            @Html.EditorFor(model => model.AnnexationAmount, new { htmlAttributes = new { @class = "form-control" } })                           
                        </div>
                        <div class="col-sm-1">
                            <input type="checkbox" id="sameEmbz" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Jointly Embezzle</label> 
                    <div class="col-sm-7">
                        @Html.EditorFor(model => model.TotalAnnexationAmount, new { htmlAttributes = new { @class = "form-control" } })                        
                    </div>
                </div>
            </div>           
        </div>
        <div class="row" id="divReturn">
            <div class="col-sm-6">
                <div id="IndividualAnnexationReturnAmount"> 
                    @*style="display:none;"*@
                    <div class="form-group">
                        <label class="control-label col-sm-4">Individual Returned Amount</label>
                        <div class="col-sm-7">
                            @Html.EditorFor(model => model.IndiReturnAmountMsg, new { htmlAttributes = new { @class = "form-control" } })                            
                        </div>
                        <div class="col-sm-1">
                            <input type="checkbox" id="sameEmbzReturn" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Jointly Returned Amount</label>
                    <div class="col-sm-7">
                        @Html.EditorFor(model => model.TotReturnAmount, new { htmlAttributes = new { @class = "form-control" } })                        
                    </div>
                </div>
            </div>          
        </div>
        <div class="row" id="divbalance">
            <div class="col-sm-6">
                <div>
                    @*style="display:none;"*@
                    <div class="form-group">
                        <label class="control-label col-sm-4">Individual Balance</label>
                        <div class="col-sm-7">
                            <input type="text" id="IndividualBalance" class="form-control" readonly="readonly" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Jointly Balance</label> 
                    <div class="col-sm-7">
                        <input type="text" id="JointlyBalance" class="form-control" readonly="readonly"/>
                    </div>
                </div>
            </div>          
        </div>
        <div class="row" id="div_Return" style="display:none">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Next Return Date</label>
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.ReturnNoticeDate, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div id="IndividualAnnexationReturnAmountDate">
                    @*style="display:none;"*@
                    <div class="form-group">
                        <label class="control-label col-sm-4">Next Individual Return Date</label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.IndiReturnNoticeDate, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
    <br/>
    <div class="row">
        <div class="col-sm-12">                  
            <div class="form-group form-action" style="padding:10px; margin:5px;">    
                <div class="save-success alert alert-success alert-dismissable" role="alert" style="display:none">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <p class="message-content">Saved Sucessfully</p>
                </div>
                <div class="save-fail alert alert-danger alert-dismissable" role="alert" style="display:none">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <p class="message-content">Fail to save</p>
                </div>                             
                &nbsp;
                <input type="submit" value="Add" id="btnCaseEntryAdd" class="btn btn-info" /> 
                &nbsp;      
               
                <input type="hidden" value="" id="hdnCaseEntrySave" />
                <input type="hidden" value="" id="hdnCaseMasterId" />
                <input type="hidden" value="" id="hdnSelectedOfficeId" />
                
                
            </div>
        </div>
    </div>
    <br/>
    <div class="row">
        <div class="col-sm-12">
            <div id="DivTableView">
                <div class="box-header">
                    <h3 class="box-title">Crime List</h3>
                </div>
                <div class="box-body no-padding table-responsive">
                    <table class="table table-striped responsive-utilities jambo_table bulk_action" id="tblCrimeDetails">
                        <thead>
                            <tr class="headings">
                                <th class="column-title">Sl</th>
                                
                                <th class="column-title">Employee Code</th>
                                <th class="column-title">Employee Name</th>
                               @* <th class="column-title">Dealing Officer</th>*@
                                <th class="column-title">Expla Issue Date</th>
                                <th class="column-title">Despatch No</th>
                                <th class="column-title">Crime</th>
                                <th class="column-title">Total Embezzle Amount</th>
                                <th class="column-title">Returned Amount</th>
                                <th class="column-title">Individual Embezzle Amount</th>
                                <th class="column-title">Individual Return Amount</th>
                               @* <th class="column-title"> Individual Return Date</th>*@                                                                                          
                                <th class="column-title">Remarks</th>
                                <th class="column-title">Delete</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <br />
            <input type="submit" value="Save" id="btnCaseEntrySave" class="btn btn-success" />
        </div>
    </div> 
    
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/alert")
}
