                    width: '12%'
                },
               
                PunishmentDateMsg: {
                    title: 'Punishment Dt',
                    width: '12%'
                },
                PunishmentDespatchNo: {
                    title: 'Punishment Despatch No',
                    width: '12%'
                },
                PunishmentName: {
                    title: 'Punishment(s)',
                    width: '12%'
                },
