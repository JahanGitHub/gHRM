        //reloadGrid();

        $("#btnSearch").click(function (e) {
            e.preventDefault();
            var filterType = $("#filterType").val();
            var FilterValue = $("#txtCaseNo").val();

            $('#grid').jtable('load', { filterType: filterType, FilterValue: FilterValue });
        });


        $('#grid').jtable({
            paging: true,
            pageSize: 50,
            sorting: false,
            defaultSorting: 'EmployeeName ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    //console.log("Loading from custom function...");
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/DiscCaseEntry/GetCasePunishmentList?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);

