        $("#btnCaseStatusSave").click(function (e) {
            e.preventDefault();
            
            var PunishmentDate = $('#txtPunishmentDate').val();
            var DespatchNo = $("#txtDespatch").val();
            var EmployeeCode = $("#txtCaseNo").val();
            if (PunishmentDate != '') {
                var allCollection = new Array();
                var allSno = new Array();
                var allEmployee = new Array();
                var allMasterId = new Array();
                var allCaseDetail = new Array();
                var allCrime = new Array();

                //var $allInputs = $('input[type="text"]');
                var $allSelect = $('.divPunishment');

                $allSelect.each(function () { //punishment SlNo
                    var value = $(this).val();
                    var id = $(this).attr('id');
                    var obj = new Object();
                    obj.Key = id;
                    obj.Value = value;
                    allCollection[allCollection.length] = obj;
                });
              
                var $allSnoId = $(".SLNo");//$('input[type="hidden" class="SLNo"]');

                $allSnoId.each(function () {
                    var value = $(this).val();
                    allSno[allSno.length] = value;
                });


                //employee
                var $allEmployeeId = $(".employee");//$('input[type="hidden" class="employee"]'); 

                $allEmployeeId.each(function () {
                    var value = $(this).val();
                    var id = $(this).attr('id');
                    var objemp = new Object();
                    objemp.Key = id;
                    objemp.Value = value;
                    allEmployee[allEmployee.length] = objemp;
                });
               
                var $allMaster = $(".CaseMater");//$('input[type="hidden" class="CaseMater"]');

                $allMaster.each(function () {
                    var value = $(this).val();
                    var id = $(this).attr('id');
                    var objmaster = new Object();
                    objmaster.Key = id;
                    objmaster.Value = value;
                    allMasterId[allMasterId.length] = objmaster;
                });

                var $allDetail = $(".CaseDetail");

                $allDetail.each(function () {
                    var value = $(this).val();
                    var id = $(this).attr('id');
                    var objDetail = new Object();
                    objDetail.Key = id;
                    objDetail.Value = value;
                    
                    allCaseDetail[allCaseDetail.length] = objDetail;
                });

                var $allCrimeId = $(".Crime");//$('input[type="hidden" class="crime"]');

                $allCrimeId.each(function () {
                    var value = $(this).val();
                    var id = $(this).attr('id');
                    var objCrime= new Object();
                    objCrime.Key = id;
                    objCrime.Value = value;
                    allCrime[allCrime.length] = objCrime;
                });

                var Punishment = $("#ddPunishmentList option:selected").val();

                var allDetails = new Object();
                allDetails.allCollections = allCollection;
                allDetails.Punishments = Punishment;
                allDetails.allEmployees = allEmployee;
                allDetails.allMasterIds = allMasterId;
                allDetails.allCaseDetails = allCaseDetail;
                allDetails.allCrimes = allCrime;
                //allDetails.Punishments = Punishment;
                allDetails.PunishmentDates = PunishmentDate;
                allDetails.DespatchNos = DespatchNo;
                allDetails.allSnos = allSno;
                allDetails.EmployeeCodes = EmployeeCode;//

                allDetails.DaysLose = $("#DaysLose").val();
                allDetails.ActivatedDt = $("#ActivatedDt").val();
                allDetails.FirstIncSuspendDt = $("#FirstIncSuspendDt").val();
                allDetails.SecondIncSuspendDt = $("#SecondIncSuspendDt").val();
                allDetails.ThirdIncSuspendDt = $("#ThirdIncSuspendDt").val();
                allDetails.FourthIncSuspendDt = $("#FourthIncSuspendDt").val();

                



                var json = JSON.stringify(allDetails);
                //console.log(json);
                $.ajax({
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("PunishmentUpdate", "DiscCaseEntry", "http")',
                    type: "POST",
                    dataType: 'json',
                    async: true,
                    data: json,

                    success: function (data) {
                        //field clear

                        if (data.Result == "OK") {
                            $("#filterValue").hide();
                            $("#idpunishment").hide();
                            $.alert.open("info", "Save Successfully");

                            $("#txtDespatch").val("");
                            $("#txtCaseType").val('');
                            $("#txtCaseDt").val('');
                            $("#txtDealOfficer").val('');
                            $("#txtEnquiryOfficer").val('');
                            $("#txtCrimeLoc").val('');
                            $("#txtDesc").val('');
                            $("#txtTotAnnexAmt").val('');
                            $("#txtTotReturnAmt").val('');
                            $("#txtPunishmentDate").val('');
                            $('#gridCrime').jtable('load', { case_no: null });

                            document.location.reload(true);

                        }
                        else {
                            $.alert.open("error", "Fail to Save");
                            //$(".failed").show(800).fadeToggle(3000);
                        }

                      

                    },
                    error: function () {
                        $("#dialog-message").html('<p>Error, Fail to Save.</p>');
                        $("#dialog-message").dialog({
                            modal: true,
                            buttons: {
                                Ok: function () {
                                    $(this).dialog("close");
                                }
                            }
                        });
                    }

                });
            }
            else {
                $.alert.open('error', 'Please select Punishment date.');
                return;
            }
        });



        $("#ddPunishmentList").change(function () {

            var ddPunishmentList = $("#ddPunishmentList").val();

            if (ddPunishmentList != "0") {
                $(".divPunishment").hide();
                if (ddPunishmentList > 0) { // Show For All.

                    $("#idDaysLose").show(); //Show Days Lose
                }
                else {
                    $("#idDaysLose").hide();// Hide Days Lose
                }
            }
            else {
                $(".divPunishment").show();
                $("#idDaysLose").hide();// Hide Days Lose
            }

            $("#DivRestrictedZone").hide();
            if (ddPunishmentList == 24) //When Resricted Zone Selected
            {
                GetRestrictedZOOffice();
                //PopupRestrictedZoneDiv();
                $("#DivRestrictedZone").show();

            }// End of Restricted Zone

            if (ddPunishmentList == 7) {
                $("#idFirstIncrement").show(); //Show First Increment Suspended Date
            }
            else if (ddPunishmentList == 16) {
                $("#idFirstIncrement").show(); //Show First Increment Suspended Date
                $("#idSecondIncrement").show(); //Show Second Increment Suspended Date
            }
            else if (ddPunishmentList == 17) {
                $("#idFirstIncrement").show(); //Show First Increment Suspended Date
                $("#idSecondIncrement").show(); //Show Second Increment Suspended Date
                $("#idThirdIncrement").show(); //Show Third Increment Suspended Date

            }
            else if (ddPunishmentList == 18) {
                $("#idFirstIncrement").show(); //Show First Increment Suspended Date
                $("#idSecondIncrement").show(); //Show Second Increment Suspended Date
                $("#idThirdIncrement").show(); //Show Third Increment Suspended Date
                $("#idFourthIncrement").show(); //Show Fourth Increment Suspended Date

            }
            else {

                $("#idFirstIncrement").hide(); //hide First Increment Suspended Date
                $("#idSecondIncrement").hide(); //hide Second Increment Suspended Date
                $("#idThirdIncrement").hide(); //hide Third Increment Suspended Date
                $("#idFourthIncrement").hide(); //hide Fourth Increment Suspended Date

            }


        });

        $("#filterColumn").change(function () {
            $("#txtCaseNo").val("");
           
            var Filter = $("#filterColumn").val();
            if (Filter != "0")
            {
                $("#filterValue").show();
                if (Filter == "EmpCode")
                {
                    $("#filterLebel").html("Employee Code");
                    FilterMode = "EmpCode";
                    $("#idpunishment").show();
                    loadPunishmentForEmployeewise();
                }
                else if (Filter == "CaseNo") {
                    $("#filterLebel").html("Case No");
                    FilterMode = "CaseNo";
                    $("#idpunishment").hide();
                }
                else
                {
                    $("#filterLebel").html("Despatch No.");
                    FilterMode = "DespatchNo";
                    $("#idpunishment").hide();
                }
            }
            else
            {
                $("#filterValue").hide();
                $("#idpunishment").hide();
            }
        });

      

    });
     
