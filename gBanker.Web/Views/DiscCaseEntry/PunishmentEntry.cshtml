    function CaseDelete(CaseMasterId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("CaseDelete", "DiscCaseEntry", "http")',
                    data: { CaseMasterId: CaseMasterId },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        EmployeeWiseCaseList()
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


    var FilterMode = "";

    function LoadCaseInfoByCaseNo(case_no, Despatch, employeeCode) {
        //alert('ready');
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetCaseInfoByCaseNoPunishment", "DiscCaseEntry", "http")',
            data: { case_no: case_no, Despatch: Despatch },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (index, data) {
                    if (data != "Error") {
                        //$("#hdnCaseMasterId").val(data.CaseMasterId);CaseNo
                        $("#txtCaseType").val(data.CaseType);
                        $("#txtCaseNo").val(data.CaseNo);
                        $("#txtCaseDt").val(data.CaseDateFromMsg);
                        $("#txtDealOfficer").val(data.DealerName);
                        $("#txtEnquiryOfficer").val(data.EnquiryName);
                        $("#txtCrimeLoc").val(data.CrimeLocationName);
                        $("#txtDesc").val(data.CaseDescription);
                        $("#txtTotAnnexAmt").val(data.TotalAnnexationAmountMsg);
                        $("#txtTotReturnAmt").val(data.TotReturnAmountMsg);
                        $("#ddlStatus").focus();
                        var case_no = data.CaseNo;
                        $('#gridCrime').jtable('load', { case_no: case_no, despatchNo: Despatch, employeeCode: employeeCode });
                    }
                    else {
                        //$("#hdnCaseMasterId").empty();
                        $("#txtCaseType").empty();
                        $("#txtCaseDt").empty();
                        $("#txtDealOfficer").empty();
                        $("#txtEnquiryOfficer").empty();
                        $("#txtCrimeLoc").empty();
                        $("#txtDesc").empty();
                        $("#txtTotAnnexAmt").empty();
                        $("#txtTotReturnAmt").empty();
                        alert("Wrong Case number");
                        $("#txtCaseNo").focus();
                    }
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

