    function EmployeeWiseCaseList() {
        $('#grid').jtable({
            paging: true,
            pageSize: 10,
            sorting: false,
            defaultSorting: 'EmployeeName ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    //console.log("Loading from custom function...");
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/DiscCaseEntry/GetEmployeeWiseCaseList?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }
            },
            fields: {
                CaseMasterId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                SlNo: {
                    title: 'Sl',
                    width: '5%'
                },
                Employees: {
                    title: 'Employees',
                    width: '16%'
                },
                Crimes: {
                    title: 'Crimes',
                    width: '26%'
                },
                CaseType: {
                    title: 'Case Type',
                    width: '7%'
                },

                TotalAnnexationAmountMsg: {
                    title: 'Embezzle',
                    width: '5%'
                },
                OfficeName: {
                    title: 'Crime Location',
                    width: '17%'
                },
                ZoneName: {
                    title: 'Zone',
                    width: '9%',
                },
                CaseDateFromMsg: {
                    title: 'Case Issue Dt',
                    width: '12%'
                },
                //CaseNo: {
                //    title: 'Case No',
                //    width: '5%'
                //},
                PunishmentDateMsg: {
                    title: 'Punishment Dt',
                    width: '12%'
                },
                PunishmentDespatchNo: {
                    title: 'Despatch No',
                    width: '9%'
                },

                PunishmentName: {
                    title: 'Punishment',
                    width: '10%'
                },
                ActivatedFromMsg: {
                    title: 'Activated On',
                    width: '12%'
                },
                DaysLose: {
                    title: 'Seniority Loss(Days)',
                    width: '7%'
                },
                PunishmentName: {
                    title: 'Punishment',
                    width: '10%'
                },

                EditLink: {
                    title: "Edit",
                    width: '5%',
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="PopupDiv(' + data.record.CaseMasterId + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },

                DeleteLink: {
                    title: "Delete",
                    width: '5%',
                    display: function (data) {
                        if (data.StatusMsg == null) {
                            return '<div class="text-center"><a href="#" OnClick="CaseDelete(' + data.record.CaseMasterId + ');"><i class="fa fa-trash-o"></i></a></div>';
                        }
                        else return '';
                    }
                },
            }
        });

        var EmployeeId = $("#txtCaseNo").val();
        $('#grid').jtable('load', { EmployeeId: EmployeeId });
    }


    function GetDataPopUp(masterId) { //populate Popup Form

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDataPopup", "DiscCaseEntry", "http")',
            data: { MasterId: masterId, jtStartIndex: 1, jtPageSize: 5, jtSorting: true, filterColumn: null, filterValue: null },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (id, option) {


                    $('#txtFirstIncSuspendDt').val(option.FirstIncSuspendDtmsg);
                    $('#txtSecondIncSuspendDt').val(option.SecondIncSuspendDtmsg);
                    $('#txtThirdIncSuspendDt').val(option.ThirdIncSuspendDtmsg);
                    $('#txtFourthIncSuspendDt').val(option.FourthIncSuspendDtmsg);

                    $('#txtSeniorityLoss').val(option.DaysLose);
                    $('#txtDespatchNo').val(option.PunishmentDespatchNo);
                    $('#txtCaseIssueDate').val(option.CaseDateFromMsg);
                    $('#txtPunishmentDate2').val(option.PunishmentDateMsg);
                    $('#txtActivatedDate').val(option.CrimeDateFromMsg);

                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
                clear();
            }
        });
    }


    function updatePopup() {
        var hdnMasterId = $('#hdnMasterId').val();

        var DespatchNo = $('#txtDespatchNo').val();
        var CaseIssueDate = $('#txtCaseIssueDate').val();
        var PunishmentDate = $('#txtPunishmentDate2').val();
        var ActivatedDate = $('#txtActivatedDate').val();

        var daysLoss = $('#txtSeniorityLoss').val();

        var FirstIncSuspendDt = $('#txtFirstIncSuspendDt').val();
        var SecondIncSuspendDt = $('#txtSecondIncSuspendDt').val();
        var ThirdIncSuspendDt = $('#txtThirdIncSuspendDt').val();
        var FourthIncSuspendDt = $('#txtFourthIncSuspendDt').val();

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdatePOPUPData", "DiscCaseEntry", "http")',
            //UpdatePOPUPData(string masterId, string PunishmentDespatchNo, string CaseDateFrom, string CaseDateTo, string PunishmentDate,
            //string FirstIncSuspendDt, string SecondIncSuspendDt, string ThirdIncSuspendDt, string FourthIncSuspendDt)
            //
            data: {
                masterId: hdnMasterId,
                PunishmentDespatchNo: DespatchNo,
                CaseDateFrom: CaseIssueDate,
                PunishmentDate: PunishmentDate,
                CaseDateTo: ActivatedDate,

                daysLoss: daysLoss,
                FirstIncSuspendDt: FirstIncSuspendDt,
                SecondIncSuspendDt: SecondIncSuspendDt,
                ThirdIncSuspendDt: ThirdIncSuspendDt,
                FourthIncSuspendDt: FourthIncSuspendDt
            },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Update Successfully");

                EmployeeWiseCaseList();
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");

                EmployeeWiseCaseList();
            }

        });


    }





    //Popup Start
    function PopupDiv(masterId) {

        GetDataPopUp(masterId);
        $('#hdnMasterId').val(masterId);
        $('html, body').animate({ scrollTop: $('#ProgramDiv').offset().top }, 'slow');
        // $("#ProgramDiv").attr("tabindex", -1).focus();


        $("#ProgramDiv").dialog({
            autoOpen: false,
            height: 700,
            width: 650,
            modal: true,
            buttons: {
                //"Save": function () {
                //    SaveUpdateProgram();
                //},
                "Close": function () {
                    //alert("No Office selected. Employee office will be used.");
                    // window.location.href = "Member/Create";

                    $(this).dialog("close");
                }
            }
        });

        var showPopup = "True";
        if (showPopup == "True") {
            $("#ProgramDiv").dialog('open');
        }



    }//End of Show Popup



</script>

