    function GetRestrictedZOOffice() {
        var ddlZOOffice = $("#ddlRestrictedZOOffice");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetZOOfficeList", "EmployeePromotion", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlZOOffice.html('');
                var Offi = "";
                $.each(data, function (id, option) {
                    var str = option.Text;
                    if (str != "Please Select") {
                        var res = str.split(" ");
                        Offi = res[0] + res[1] + res[4];
                    }
                    else {
                        Offi = "Please Select";
                    }
                    ddlZOOffice.append($('<option></option>').val(option.Value).html(Offi));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function CrimePunishmentSave() {
        $("#AjaxLoader").show();
        var allSno = new Array();
        var allCaseType = new Array();
        var allCrimeId = new Array();
        var allCrimeDtFrom = new Array();
        var allCrimeDtTo = new Array();
        var allDespatch = new Array();
        var allCrimeOffice = new Array();
        //var allPunishment = new Array();


        var $allSnoId = $(".SLNo");
        $allSnoId.each(function () {
            var value = $(this).val();
            allSno[allSno.length] = value;
        });


        var $allCrimeOfficeNo = $(".CrimeOffice");
        $allCrimeOfficeNo.each(function () {
            var value = $(this).val();
            allCrimeOffice[allCrimeOffice.length] = value;
        });


        var $allDespatchNo = $(".Despatch");
        $allDespatchNo.each(function () {
            var value = $(this).val();
            var id = $(this).attr('id');
            var objDespatch = new Object();
            objDespatch.Key = id;
            objDespatch.Value = value;
            allDespatch[allDespatch.length] = objDespatch;
        });


        var $allCrimeDateTo = $(".CrimeDtTo");
        $allCrimeDateTo.each(function () {
            var value = $(this).val();
            var id = $(this).attr('id');
            var objCrimeDateTo = new Object();
            objCrimeDateTo.Key = id;
            objCrimeDateTo.Value = value;
            allCrimeDtTo[allCrimeDtTo.length] = objCrimeDateTo;
        });



        var $allCrimeDateFrom = $(".CrimeDtFrom");
        $allCrimeDateFrom.each(function () {
            var value = $(this).val();
            var id = $(this).attr('id');
            var objCrimeDateFrom = new Object();
            objCrimeDateFrom.Key = id;
            objCrimeDateFrom.Value = value;
            allCrimeDtFrom[allCrimeDtFrom.length] = objCrimeDateFrom;
        });


        var $allCaseType = $(".caseType");
        $allCaseType.each(function () {
            var value = $(this).val();
            var id = $(this).attr('id');
            var objCaseType = new Object();
            objCaseType.Key = id;
            objCaseType.Value = value;
            allCaseType[allCaseType.length] = objCaseType;
        });


        var $allCrime = $(".Crime_Id");
        $allCrime.each(function () {
            var value = $(this).val();
            var id = $(this).attr('id');
            var objCrime = new Object();
            objCrime.Key = id;
            objCrime.Value = value;
            allCrimeId[allCrimeId.length] = objCrime;
        });


        //var $allCasePunishment = $('.divPunishment');
        //$allCasePunishment.each(function () {
        //    var value = $(this).val();
        //    var id = $(this).attr('id');
        //    var obj = new Object();
        //    obj.Key = id;
        //    obj.Value = value;
        //    allPunishment[allPunishment.length] = obj;
        // });


        var EmployeeId = $('#EmployeeId').val()
        var PunishmentDespatchNo = $("#PunishmentDespatchNo").val();
        var PunishmentDt = $("#PunishmentDt").val();
        var CommonPunishmentId = $("#ddPunishmentList option:selected").val();
        var AnnexationAmount = $("#AnnexationAmount").val();
        var CaseDateFromMsg = $("#CaseDateFromMsg").val();
        var DaysLose = $("#DaysLose").val();
        var ActivatedDt = $("#ActivatedDt").val();

        var FirstIncSuspendDt = $("#FirstIncSuspendDt").val();
        var SecondIncSuspendDt = $("#SecondIncSuspendDt").val();
        var ThirdIncSuspendDt = $("#ThirdIncSuspendDt").val();
        var FourthIncSuspendDt = $("#FourthIncSuspendDt").val();


        if (PunishmentDt == "") {
            $.alert.open("Please Select Punishment Issue Date.");
            return false;

        }


        var allDetails = new Object();

        allDetails.allCrimeOffices = allCrimeOffice;
        allDetails.allSnos = allSno;

        allDetails.allCaseTypes = allCaseType;
        allDetails.allCrimeIds = allCrimeId;
        allDetails.allCrimeDtFroms = allCrimeDtFrom;
        allDetails.allCrimeDtTos = allCrimeDtTo;
        allDetails.allDespatchs = allDespatch;
        //allDetails.allPunishments = allPunishment;

        allDetails.EmployeeIds = EmployeeId;
        allDetails.PunishmentDespatchNos = PunishmentDespatchNo;
        allDetails.PunishmentDts = PunishmentDt;
        allDetails.CommonPunishmentIds = CommonPunishmentId;
        allDetails.AnnexationAmounts = AnnexationAmount;
        allDetails.CaseDateFromMsgs = CaseDateFromMsg;
        allDetails.DaysLose = DaysLose
        allDetails.ActivatedDt = ActivatedDt;

        allDetails.FirstIncSuspendDt = FirstIncSuspendDt;
        allDetails.SecondIncSuspendDt = SecondIncSuspendDt;
        allDetails.ThirdIncSuspendDt = ThirdIncSuspendDt;
        allDetails.FourthIncSuspendDt = FourthIncSuspendDt;


        var json = JSON.stringify(allDetails);
        console.log(json);

        $.ajax({
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("CasePunishmentSave", "DiscCaseEntry", "http")',
            type: "POST",
            dataType: 'json',
            async: true,
            data: json,
            success: function (data) {

                if (data.Result == "OK") {
                    $.alert.open("info", "Save Successfully");
                    EmployeeWiseCaseList();

                    // location.reload();


                    $("#txtEmployeeCode").val("");
                    $("#EmployeeName").val('');
                    $("#DesignationName").val('');
                    $("#OfficeName").val('');
                    $("#ddlCrimeId").val('0');

                    $("#CaseDateFromMsg").val('');
                    $("#DispatchNo").val('');
                    $("#CrimeDateFrom").val('');
                    $("#CrimeDateTo").val('');
                    $("#AnnexationAmount").val('');

                    $("#PunishmentDespatchNo").val('');
                    $("#PunishmentDt").val('');
                    $("#ddPunishmentList").val('0');
                    $("#tblCrimeDetails > tbody").empty();
                    $("#tblCrimeLocationDetails >tbody >tr").empty();
                    $("#AjaxLoader").hide();
                }
                else {
                    $.alert.open("error", "Fail to Save");
                }
            },
            error: function () {
                $("#AjaxLoader").hide();
                $("#dialog-message").html('<p>Error, Fail to Save.</p>');

                $("#dialog-message").dialog({
                    modal: true,
                    buttons: {
                        Ok: function () {
                            $(this).dialog("close");
                        }
                    }
                });
            }

        });
        $("#AjaxLoader").hide();
    }

    function loadPunishment(sl) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPunishmentList", "DiscCaseEntry", "http")',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (data) {
                $("#" + sl).append($("<option     />").val('0').text('Select Punishemnt'));
                $.each(data.Options, function () {
                    $("#" + sl).append($("<option     />").val(this.Value).text(this.DisplayText));
                });
                $("#loading").hide();
            },
            failure: function () {
                alert("Failed!");
            }
        });
    }


