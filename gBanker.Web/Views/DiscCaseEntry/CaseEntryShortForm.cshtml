    function checkNumberic(e) {
        if (e.which != 8 && e.which != 0 && (e.which < 46 || e.which > 57)) {
            return false;
        }
        else
            return true;
    }
    function delete_row(sl) {
        $("#table_Row" + sl).remove();
    }
    function delete_Crime_row(sl) {
        $("#table_Row" + sl).remove();
