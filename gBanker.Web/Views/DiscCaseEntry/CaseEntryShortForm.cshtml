    function CaseDelete(CaseMasterId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("CaseDelete", "DiscCaseEntry", "http")',
                    data: { CaseMasterId: CaseMasterId },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        EmployeeWiseCaseList();
                        $.alert.open('Message', 'Data deleted successfully.');
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function EmployeeWiseCaseList() {
        $('#grid').jtable({
            paging: true,
            pageSize: 10,
            sorting: false,
            defaultSorting: 'EmployeeName ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    //console.log("Loading from custom function...");
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/DiscCaseEntry/GetEmployeeWiseCaseList?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }
            },
            fields: {
                CaseMasterId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                SlNo: {
                    title: 'Sl',
                    width: '5%'
                },
                Employees: {
                    title: 'Employees',
                    width: '16%'
                },
                Crimes: {
                    title: 'Crimes',
                    width: '26%'
                },
                CaseType: {
                    title: 'Case Type',
                    width: '7%'
                },

                TotalAnnexationAmountMsg: {
                    title: 'Embezzle',
                    width: '5%'
                },
                OfficeName: {
                    title: 'Crime Location',
                    width: '17%'
                },
                ZoneName: {
                    title: 'Zone',
                    width: '9%',
                },
                CaseDateFromMsg: {
                    title: 'Case Issue Dt',
                    width: '12%'
                },
                //CaseNo: {
                //    title: 'Case No',
                //    width: '5%'
                //},
                PunishmentDateMsg: {
                    title: 'Punishment Dt',
                    width: '12%'
                },
                PunishmentDespatchNo: {
                    title: 'Despatch No',
                    width: '9%'
                },

                PunishmentName: {
                    title: 'Punishment',
                    width: '10%'
                },
                ActivatedFromMsg: {
                    title: 'Activated On',
                    width: '12%'
                },
                DaysLose: {
                    title: 'Seniority Loss(Days)',
                    width: '7%'
                },
                PunishmentName: {
                    title: 'Punishment',
                    width: '10%'
                },

                EditLink: {
                    title: "Edit",
                    width: '5%',
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="PopupDiv(' + data.record.CaseMasterId + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                        //return '<div class="text-center"><a href="#" OnClick="popupPromotionNavDiv(' + data.record.CaseMasterId + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },

                DeleteLink: {
                    title: "Delete",
                    width: '5%',
                    display: function (data) {
                        if (data.StatusMsg == null) {
                            return '<div class="text-center"><a href="#" OnClick="CaseDelete(' + data.record.CaseMasterId + ');"><i class="fa fa-trash-o"></i></a></div>';
                        }
                        else return '';
                    }
                },
            }
        });
        var EmployeeId = $("#EmployeeId").val();
        $('#grid').jtable('load', { EmployeeId: EmployeeId });
    }


