    function GetOthersOffice() {
        var ddlOthersOffice = $("#ddlOtherOfficeList");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetOthersOfficeList", "EmployeePromotion", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlOthersOffice.html('');
                $.each(data, function (id, option) {
                    ddlOthersOffice.append($('<option></option>').val(option.Value).html(option.Text));
                });
