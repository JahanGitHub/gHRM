    function CaseDelete(CaseMasterId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("CaseDelete", "DiscCaseEntry", "http")',
                    data: { CaseMasterId: CaseMasterId },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        reloadGrid();
                    },
                    error: function (request, status, error) {
                        alert( request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


    //POPUP

    //Popup Start
    function PopupDiv(masterId, caseDetailsId) {

        GetDataPopUp(masterId, caseDetailsId);
        $('#hdnMasterId').val(masterId);
        $('#hdnCaseDetailsId').val(caseDetailsId);

        $('html, body').animate({ scrollTop: $('#ProgramDiv').offset().top }, 'slow');
        // $("#ProgramDiv").attr("tabindex", -1).focus();


        $("#ProgramDiv").dialog({
            autoOpen: false,
            height: 450,
            width: 650,
            modal: true,
            buttons: {
                //"Save": function () {
                //    SaveUpdateProgram();
                //},
                "Close": function () {
                    //alert("No Office selected. Employee office will be used.");
                    // window.location.href = "Member/Create";
                                        
                    reloadGrid();

                    $(this).dialog("close");
                }
            }
        });

        var showPopup = "True";
        if (showPopup == "True") {
            $("#ProgramDiv").dialog('open');
        }



    }//End of Show Popup



    function GetDataPopUp(masterId, CaseDetailsId) { //populate Popup Form

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDataPopupCaseEdit", "DiscCaseEntry", "http")',
            data: { MasterId: masterId, CaseDetailsId:CaseDetailsId, jtStartIndex: 1, jtPageSize: 5, jtSorting: true, filterColumn: null, filterValue: null },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.each(data, function (id, option) {
                     
                    $('#txtEmployeeId').val(option.EmployeeId);
                    $('#txtCaseIssueDate').val(option.CaseDateFromMsg);
                    $('#txtCrimeLocationId').val(option.CrimeLocationId);
                    $('#hdnOfficeIdEdit').val(option.CrimeLocationId);
                    $('#CaseDesPatchNo').val(option.CaseDesPatchNo);
                    $('#txtCrimeLocationBng').val(option.CrimeLocationBng);
                    $('#txtCrimeName').val(option.CrimeName);
                    
                    $('#hdnCrimeIdEdit').val(option.CrimeId);



                });
            },
            error: function (request, status, error) {
                alert( request.statusText + "/" + request.statusText + "/" + error);
                clear();
            }
        });
    }

    

