    function updatePopup() {
        var hdnMasterId = $('#hdnMasterId').val();
         
        var CaseIssueDate = $('#txtCaseIssueDate').val();
       
        var EmployeeId = $('#txtEmployeeId').val();

        var CrimeLocationId = $('#hdnOfficeIdEdit').val();
       
        var CaseDesPatchNo = $('#CaseDesPatchNo').val();

        var CaseDetailsId = $('#hdnCaseDetailsId').val();

        var CrimeId = $('#hdnCrimeIdEdit').val();

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("UpdatePOPUPCaseDataEdit", "DiscCaseEntry", "http")',
            data: {
                masterId: hdnMasterId,
                CaseDateFrom: CaseIssueDate,
                
                CrimeLocationId: CrimeLocationId,
                CaseDesPatchNo: CaseDesPatchNo,
                CaseDetailsId: CaseDetailsId,
                CrimeId: CrimeId,
                EmployeeId: EmployeeId

            },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", "Data Update Successfully");

                EmployeeWiseCaseList();
                reloadGrid();

            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Update");

                EmployeeWiseCaseList();
            }

        });

        ///Reload Grid
        //reloadGrid();

        var ZO = $("#ddlSearchZOOffice option:selected").val();
        var Status = $("#ddlSearchStatus option:selected").val();
        var CaseNo = $("#txtCaseNo").val();
        var CaseDate = $("#txtCaseDate").val();
        var DespatchNo = $("#txtDespatch").val();
        var filterType = $("#filterType option:selected").val();
        var EmployeeID = $("#EmployeeID").val();


        $('#grid').jtable('load', { zoOfc: ZO, EmployeeID: EmployeeID, StatusId: Status, CaseNo: CaseNo, CaseDate: CaseDate, DespatchNo: DespatchNo, filterType: filterType });


        ////END ReLoad Grid
       

    }

