    function LoadEmpInfo(employee_code) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCode", "EmployeeTransferNew", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: true,
            success: function (data) {
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {

                        $('#EmployeeId').val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#OfficeName").val(data.EmployeeCurrentOfficeName);
                        $("#DesignationName").val(data.EmployeeCurrentDesignation);
                       
                    });

                }

                else {

                    $('#EmployeeId').val("");
                    $("#EmployeeName").val("");
                    $("#OfficeName").val("");
                    $("#DesignationName").val("");
                }

            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });

    }

    function deleteDeOfficerRow(CaseEnquiryOfficerId)
    {
        $('#AjaxLoader').show()
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteInqueryOfficer", "DiscCaseEntry", "http")',
                    data: { CaseEnquiryOfficerId: CaseEnquiryOfficerId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        EnquiryOfficerLoad();
                    },
                    error: function (request, status, error) {
                        $('#AjaxLoader').hide()
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function CaseChargeSheetSave() {
        $('#AjaxLoader').show();
        var EnqueryofficerId = $("#EmployeeId").val();
                var rowCount = $('#tblEnquiryOfficerList >tbody >tr').length;

                for (i = 1; i <= rowCount; i++) {
                    var officerId = $("#txtEnqueryOfficerId" + i).val();//EnqueryOfficerId
                   // alert(EnqueryofficerId)
                    //alert(officerId);
                    if (officerId == EnqueryofficerId) {
                        $('#AjaxLoader').hide()
                        $.alert.open("error", "This officer has been added")
                       
                        return false;
                    }
                }
                var Enqueryofficer_Id = $("#EmployeeId").val();
                var EnqOfficerAssignedDt = $("#EnquiryOfficerAssignedDt").val();
                var InvestigationDt = $("#InvestigationDt").val();
                var ReportReceivedDt = $("#ReportReceivedDt").val();
                var EnquiryRemarks = $("#EnquiryRemarks").val();
                var DespatchNo = $("#DespatchNo").val();
                var masterId = $("#CaseMasterId").val();
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("EnquiryOfficerSave", "DiscCaseEntry", "http")',
                    data: { EnqueryofficerId: Enqueryofficer_Id, EnqOfficerAssignedDt: EnqOfficerAssignedDt, InvestigationDt: InvestigationDt, ReportReceivedDt: ReportReceivedDt, EnquiryRemarks: EnquiryRemarks, DespatchNo: DespatchNo, masterId: masterId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        $('#AjaxLoader').hide();
                        EnquiryOfficerLoad();
                    },
                    error: function (request, status, error) {
                        $('#AjaxLoader').hide()
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
       }

    function EditEnquiryOfficerRow(CaseEnquiryOfficerId, SlNo) {
        $('#AjaxLoader').show()
        var EnquiryOfficerAssignedDt = $("#txtEnquiryOfficerAssignedDt" + SlNo).val();
        var CrimeFindOutFromMsg = $("#txtCrimeFindOutFrom" + SlNo).val();
        var CrimeFindOutToMsg = $("#txtCrimeFindOutTo" + SlNo).val();
        var InvestigationDtMsg = $("#txtInvestigationDt" + SlNo).val();
        var ReportReceivedDtMsg = $("#txtReportReceivedDt" + SlNo).val();
        var EnquiryRemarks = $("#txtEnquiryRemarks" + SlNo).val();
        var DespatchNo = $("#txtDespatchNo" + SlNo).val();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("EnquiryoffEdit", "DiscCaseEntry", "http")',
            data: { CaseEnquiryOfficerId: CaseEnquiryOfficerId, EnquiryOfficerAssignedDt: EnquiryOfficerAssignedDt, CrimeFindOutFromMsg: CrimeFindOutFromMsg, CrimeFindOutToMsg: CrimeFindOutToMsg, InvestigationDtMsg: InvestigationDtMsg, ReportReceivedDtMsg: ReportReceivedDtMsg, EnquiryRemarks: EnquiryRemarks, DespatchNo: DespatchNo },
            dataType: 'json',
            async: true,
            success: function (result) {
                if (result == 1) {
                    $('#AjaxLoader').hide()
                    $.alert.open("info", "Update Successfully");
                }
                else {
                    $('#AjaxLoader').hide()
                    $.alert.open("info", "Save fail");
                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });

    }


    function EnquiryOfficerLoad() {
        //$('#AjaxLoader').show()
        var MasterId = $("#CaseMasterId").val();
        var dtTable = $('#tblEnquiryOfficerList');
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEnquiryOfficer", "DiscCaseEntry", "http")',
            data: { MasterId: MasterId },
            dataType: 'json',
            async: true,
            success: function (DisEnquiryOfficer) {
                // var sl = rowCount + 1;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                $.each(DisEnquiryOfficer, function (index, en) {
                    var rowCo = index + 1;
                    tableBody.append('<tr  id="table_Row' + en.SlNo + '"+>' +
                                    '<td></td>' +
                                    '<td>' + en.DespatchNo + '<input type="text" style="display:none;"  value="' + en.DespatchNo + '" name="DespatchNo" id="txtDespatchNo' + en.SlNo + '" /></td>' +
                                    '<td>' + en.EnqueryOfficerName + ' <input type="text" value="' + en.EmployeeId + '" style="display:none;" name="EnqueryOfficerId" id="txtEnqueryOfficerId' + en.SlNo + '" /><input type="text" value="U" style="display:none;" name="ReportReceivedDt" id="txtMode' + en.SlNo + '" /></td>' +
                                    '<td><input type="text" value="' + en.EnquiryOfficerAssignedDtMsg + '" name="EnquiryOfficerAssignedDt" id="txtEnquiryOfficerAssignedDt' + en.SlNo + '" /></td>' +                                 
                                    '<td><input type="text" value="' + en.InvestigationDtMsg + '"  name="InvestigationDt" id="txtInvestigationDt' + en.SlNo + '" /></td>' +
                                    '<td><input type="text" value="' + en.ReportReceivedDtMsg + '"  name="ReportReceivedDt" id="txtReportReceivedDt' + en.SlNo + '" /></td>' +
                                    '<td><input type="text" value="' + en.EnquiryRemarks + '"  name="EnquiryRemarks" id="txtEnquiryRemarks' + en.SlNo + '" /></td>' +
                                    '<td style="text-align:center;"><a href="javascript:;" onclick="EditEnquiryOfficerRow(' + en.CaseEnquiryOfficerId + ',' + en.SlNo + ')"><i class="fa fa-pencil-square-o"></i></a>' +
                                    '<td style="text-align:center;"><a href="javascript:;" onclick="deleteDeOfficerRow(' + en.CaseEnquiryOfficerId + ')"><i class="fa fa-trash-o fa-2x"></i></a>' +
                                    '</tr>'

                 )

                    $("#txtEnquiryOfficerAssignedDt" + en.SlNo).datepicker(
                        {
                            dateFormat: "dd-M-yy",
                            showAnim: "scale",
                            changeMonth: true,
                            changeYear: true,
                            yearRange: "1920:2025"
                        });

                    $("#txtInvestigationDt" + en.SlNo).datepicker(
                        {
                            dateFormat: "dd-M-yy",
                            showAnim: "scale",
                            changeMonth: true,
                            changeYear: true,
                            yearRange: "1920:2025"
                        });
                    $("#txtReportReceivedDt" + en.SlNo).datepicker(
                       {
                           dateFormat: "dd-M-yy",
                           showAnim: "scale",
                           changeMonth: true,
                           changeYear: true,
                           yearRange: "1920:2025"
                       });

                });
                $('#AjaxLoader').hide()
            },
            error: function (request, status, error) {
                $('#AjaxLoader').hide()
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });


    }

    $(document).ready(function () {

        EnquiryOfficerLoad();
        //EnquiryOfficerListLoad();
       
        $("#InvestigationDt").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: "1920:2025"
          });
        $("#ReportReceivedDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1920:2025"
        });
        $("#EnquiryOfficerAssignedDt").datepicker(
        {
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1920:2025"
        });

        $("#txtEmployeeCode").blur(function () {

            var employee_Code = $("#txtEmployeeCode").val();
            LoadEmpInfo(employee_Code);
        });

        $("#btnEnquirySave").click(function () {
           
            var EmployeeCode = $("#txtEmployeeCode").val();
            if (EmployeeCode != "") {               
                CaseChargeSheetSave();
            }
            else {
                $.alert.open("error", "Please select enquiry officer");
            }

        });
    });
</script>
