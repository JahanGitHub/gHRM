@model gHRM.Web.ViewModels.WelfareFund.StaffWelfareFundSettings.FundSetupViewModel

@{
    ViewBag.Title = "Fund Setup ";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/FundSetup">Fund Setup</a></li>
    </ol>
</div>

<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>

    &nbsp;
<h2 class="page-title">Fund Setup </h2>
    &nbsp;
<div class="container-fluid">
    @using (Html.BeginForm("AddNew", "FundSetup", FormMethod.Post, new { @role = "form", @class = "form-horizontal", @id = "add-or-edit-form" }))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)


        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.FundType, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.FundType, Model.StaffWelfareFundSettingList, new { @class = "form-control" })
                        @Html.HiddenFor(model => model.FundType)
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.PRComponentId, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.PRComponentId, Model.ComponentList, new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ComponentType, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.ComponentType, Model.ComponentTypeList, new { @class = "form-control" })
                        @Html.HiddenFor(model => model.ComponentType)
                    </div>
                </div>
            </div>


        </div>

        <div class="row">

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.RatioBasedOn, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.RatioBasedOn, Model.RatioBasedList, new { @class = "form-control" })
                        @Html.HiddenFor(model => model.RatioBasedOn)
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.ComponentAmount, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.ComponentAmount, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>


        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        &nbsp;
                        <button type="submit" class="btn btn-success">Save</button>
                        &nbsp;
                        <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" onclick="staffWelfareFundConfigurationManager.clearform()" />
                    </div>
                </div>
            </div>
        </div>


     
    }

    <h2 class="page-title">Fund Setup List</h2><br>
    <!--To view Listings-->
    <div id="grid"></div>
</div>


@section Scripts {
    <script src="~/Assets/js/app/welfarefund/FundSetupManager.js"></script>
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
