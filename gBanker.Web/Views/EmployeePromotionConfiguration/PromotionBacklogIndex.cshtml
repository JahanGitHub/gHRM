<script type="text/javascript">

    function SetSearchParameters() {

        var OfficeId = "";
        var DeptId = "";

        var officeTypeId = $("#OfficeTypeId").val();
        if (officeTypeId != "") {
            if (officeTypeId == 1) {
                OfficeId = $("#PVHeadOfficeId").val();
            } else if (officeTypeId == 3) {
                OfficeId = $("#PVProjectId").val();
            }
            else if (officeTypeId == 4) {
                OfficeId = $("#ZoneId").val();
            }
            else if (officeTypeId == 5) {
                OfficeId = $("#AreaId").val();
            }
            else if (officeTypeId == 6) {
                OfficeId = $("#UnitId").val();
            }
        }
        var deptId = $("#DepartmentId").val();
        if (deptId != "") {
            DeptId = deptId;
        } else {
            DeptId = "";
        }
        var payRollDesignation = $("#DesignationId").val();
        var responsibility = $("#OfficeDesignationId").val();
        var status = $('#typeFilterColumn').val();
        var filterColumn = $("#filterColumn").val();
        var filterValue = $("#filterValue").val();
        if (filterColumn != "" && filterValue == "") {
            $.alert.open("Error", "Please Provide Filter Value");
            return false;
        }

        var Section = $("#Section").val();
        if (Section == "0") {
            Section = "";
        }

        let status_Promotion = $('input[name=empPromotion]:checked').val();
        //if (status_Promotion == "AllPromotion") {
        //    status_Promotion = "AllPromotion";
        //}
        if (status_Promotion == "ActivePromotion") {
            status_Promotion = "ActivePromotion";
        }
        else if (status_Promotion == "InActivePromotion") {
            status_Promotion = "InActivePromotion";
        }

        LoadEmployeeListForPromotion(officeTypeId, OfficeId, DeptId, payRollDesignation, responsibility, Section, status, filterColumn, filterValue, status_Promotion);
    }

    function LoadEmployeeListForPromotion(OfficeTypeId, OfficeId, DeptId, payRollDesignation, responsibility, Section, status, filterColumn, filterValue, status_Promotion) {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetEmployeeListForPromotion", "EmployeePromotionConfiguration", "http")',
                    dataType: 'json',
                    data: { OfficeTypeId: OfficeTypeId, OfficeId: OfficeId, DepartmentId: DeptId, PayrollDesignation: payRollDesignation, Responsibility: responsibility, Section: Section, Status: status, FilterColumn: filterColumn, FilterValue: filterValue, status_Promotion: status_Promotion }
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "EmployeeId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "EmployeeCode",
                    title: "Code",
                    width: "25px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "DesignationName",
                    title: "Designation",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "OrnamentalDesignationName",
                    title: "Ornamental Designation",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "OfficeTypeName",
                    title: "Office Type",
                    width: "35px",
                    filterable: true,
                },
                //{
                //    field: "OfficeName",
                //    title: "Office",
                //    width: "40px",
                //    filterable: true,
                //},
                {
                    field: "EmployementTypeName",
                    title: "Type",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "EmployeeStatus",
                    title: "Status",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "NextReviewDate",
                    title: "Next Review Date",
                    width: "25px",
                    filterable: false,
                    template: "#= NextReviewDate==null?'':kendo.toString(kendo.parseDate(NextReviewDate, 'yyyy-MM-dd'), 'dd-MMM-yyyy') #"
                },
                {
                    title: "Details",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='/EmployeePromotionConfiguration/PromotionBacklogEntry/?EmployeeCode=" + dataItem.EmployeeCode + "'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },
            ]
        });
    }


    $(document).ready(function () {

        InformationStatus(true);

        $('input[name=empStatus]').click(function () {
            $('.selectpicker').selectpicker('deselectAll');
            let status_text = $('input[name=empStatus]:checked').val();

            if (status_text == "Active") {
                InformationStatus(true);
            }
            else if (status_text == "InActive") {
                InformationStatus(false);
            }
            else {
                $('.selectpicker').selectpicker('selectAll');
                $('.selectpicker').selectpicker('refresh');
            }
        });


        $("#DepartmentId").change(function () {
            var deptId = $("#DepartmentId").val();
            var ddlSection = $("#Section");
            if (deptId != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetDepartmentWiseSection", "Employee", "http")',
                    data: { deptId: deptId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            ddlSection.html("");
                            $.each(data, function (id, option) {
                                ddlSection.append($('<option></option>').val(option.Value).html(option.Text));
                            });
                        } else {
                            ddlSection.html("<option value=''>Please Select</option>");
                        }
                    },
                });
            } else {
                ddlSection.html("<option value='0'>Please Select</option>");
            }
        });

        $("#btnSearch").click(function () {
            SetSearchParameters();
        });

        $("#filterColumn").change(function () {
            $("#filterValue").val('');
            if ($(this).val() != "ViewAll") {
                if ($(this).val() == "Joining") {
                    $("#filterValue").datepicker(
                     {
                         dateFormat: "dd-M-yy",
                         showAnim: "scale",
                     });
                }
                else if ($(this).val() == "Posting") {
                    $("#filterValue").datepicker(
                    {
                        dateFormat: "dd-M-yy",
                        showAnim: "scale",
                    });
                }
                else if ($(this).val() == "Promotion") {
                    $("#filterValue").datepicker(
                     {
                         dateFormat: "dd-M-yy",
                         showAnim: "scale",
                     });
                }
                else {
                    $("#filterValue").datepicker("destroy");
                }
            }
        });
    });

    function InformationStatus(stsvalue) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("InformationStatus", "Employee", "http")',
            data: { stsvalue: stsvalue },
            dataType: 'json',
            async: true,
            success: function (response) {
                $.each(response.Data, function (index, status) {
                    if (status.Value) {
                        $("#typeFilterColumn option").filter(function () {
                            return $(this).text() == status.Text;
                        }).prop("selected", true);
                    }
                });

                $('.selectpicker').selectpicker('refresh');
            },
        });
    }

</script>

