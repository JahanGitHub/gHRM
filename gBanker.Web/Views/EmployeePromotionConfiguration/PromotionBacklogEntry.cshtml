@model gHRM.Web.ViewModels.EmployeePromotionViewModel
@{
    ViewBag.Title = "Promotion Backlog Entry";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">



    function PopupDiv(PromotionId, BasicSalary, HouseRent, Medical, BonusAmount, GrossSalary ) {
        $("#btnPopUpUpdate").prop("disabled", false);
        
        $('#hdnPromotionId').val(PromotionId);

        $('#txtBasicSalary').val(BasicSalary);
        $('#txtHouseRent').val(HouseRent);
        $('#txtMedical').val(Medical);
        
        $('#txtConveyance').val((parseFloat(GrossSalary) * 5) / 100);
        $('#txtBonusAmount').val(BonusAmount);
        $('#txtGrossSalary').val(GrossSalary);


        $('html, body').animate({ scrollTop: $('#SalaryDiv').offset().top }, 'slow');
        // $("#ProgramDiv").attr("tabindex", -1).focus();
         
        $("#SalaryDiv").dialog({
            autoOpen: false,
            height: 360,
            width: 830,
            modal: true,
            scroll: false,
            buttons: {
                "Close": function () {
                    $(this).dialog("close");
                }
            }
        });

        var showPopup = "True";
        if (showPopup == "True") {
            $("#SalaryDiv").dialog('open');
        }

    }// End of Show Popups

    function DivideFunction() {

        var grossSalary = $('#txtGrossSalary').val();

        $('#txtBasicSalary').val((parseFloat(grossSalary) * 55)/ 100);
        $('#txtHouseRent').val((parseFloat(grossSalary) * 30) / 100);
        $('#txtMedical').val((parseFloat(grossSalary) * 10) / 100);
        $('#txtConveyance').val((parseFloat(grossSalary) * 5) / 100);
        $('#txtBonusAmount').val((parseFloat(grossSalary) * 55) / 100);

    }

    $(document).ready(function () {



        $("#btnPopUpUpdate").click(function () {

            /*
            UpdateSalary(string PromotionId,
                string BasicSalary,
                string HouseRent,
                string Medical,
                string BonusAmount
                */
            var EmployeeId      = $("#EmployeeId").val();
            var PromotionId     = $('#hdnPromotionId').val();
            var BasicSalary     = $('#txtBasicSalary').val();
            var HouseRent       = $('#txtHouseRent').val();
            var Medical         = $('#txtMedical').val();
            var BonusAmount     = $('#txtBonusAmount').val();
            var GrossAmount     = $('#txtGrossSalary').val();


            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '/EmployeePromotionConfiguration/UpdateSalary',
                data: { EmplyoeeID: EmployeeId, PromotionId: PromotionId, BasicSalary: BasicSalary, HouseRent: HouseRent, Medical: Medical, BonusAmount: BonusAmount, GrossAmount: GrossAmount},
                dataType: 'json',
                async: true,
                success: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open("Message", data);
                    $("#btnPopUpUpdate").prop("disabled", true);
                },
                error: function (request, status, error) {
                    $('#AjaxLoader').hide();
                    $.alert.open("Message", "Process Not Completed.");
                }

            });

            $("#btnPopUpUpdate").prop("disabled", false);
            $("#SalaryDiv").dialog('close');
            LoadPreviousDataList();
        });// END Button;




        $("#btnReset").hide();
        $("#NextReviewDate").attr("disabled", true);

        $("#PromotionDate").datepicker(
           {
               dateFormat: "dd-M-yy",
               showAnim: "scale",
               changeMonth: true,
               yearRange: "1950:2050",
               changeYear: true
           });

        $("#NextReviewDate").datepicker(
           {
               dateFormat: "dd-M-yy",
               showAnim: "scale",
               changeMonth: true,
               yearRange: "1950:2050",
               changeYear: true
           });


        $("#StatusPeriodInMonth").change(function () {

            var PromotionDate = $("#PromotionDate").val();
            if (PromotionDate != "") {
                var StatusPeriodInMonth = $("#StatusPeriodInMonth option:selected").val();
                var date2 = $('#PromotionDate').datepicker('getDate');
                date2.setMonth(date2.getMonth() + parseInt(StatusPeriodInMonth));
                $('#NextReviewDate').datepicker('setDate', date2);
            } else {
                $.alert.open("Alert", "Please Input Promation Date Befor Select Duration Month");
            }
        });

        var employeeCode = $("#EmployeeCode").val();
        if (employeeCode != '') {
            LoadEmpInfoByCode(employeeCode);
        }

        $("#EmployeeCode").blur(function (e) {
            var employeeCode = $("#EmployeeCode").val();
            if (employeeCode != '') {
                LoadEmpInfoByCode(employeeCode);
            }
        });
    });


    function DeletePromotion(PromotionId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteEmployeePromotion", "EmployeePromotionConfiguration", "http")',
                    data: { PromotionId: PromotionId, EmployeeId: $("#EmployeeId").val()  },
                    dataType: 'json',
                    async: false,
                    success: function (response) {
                        if (response.result = 1) {
                            $.alert.open("Success", response.message);
                            LoadPreviousDataList();
                        }
                        else {
                            $.alert.open("Error", response.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function EmployeeDataEdit(PromotionId, EmployeeId, DesignationId, IsReviewed, PromotionDateMsg, NextReviewDateMsg, PromotionTypeId) {

        $("#PromotionId").val(PromotionId);
        $("#EmployeeId").val(EmployeeId);
        $("#DesignationId").val(DesignationId);
        $("#IsReviewed").val(IsReviewed);
        $("#PromotionDate").val(PromotionDateMsg == 'null' ? '' : PromotionDateMsg);
        $("#NextReviewDate").val(NextReviewDateMsg == 'null' ? '' : NextReviewDateMsg);
        $("#NextReviewDate").attr("disabled", true);
        $("#PromotionTypeId").val(PromotionTypeId);
        $("#btnSave").val("Update");
        $("#btnReset").show();
    }

    function LoadPreviousDataList() {

        var EmployeeId = $("#EmployeeId").val();

        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("LoadPreviousDataList", "EmployeePromotionConfiguration", "http")',
                    dataType: 'json',
                    data: { EmployeeId: EmployeeId }
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,
            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "Id",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "RowSl",
                    title: "Sl.",
                    width: "2%",
                    filterable: false,
                },
                {
                    field: "EmployeeName",
                    title: "EmployeeName",
                    width: "7%",
                    filterable: false
                },
                {
                    field: "DesignationId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "DesignationName",
                    title: "Designation Name",
                    width: "10%",
                    filterable: false
                },
                {
                    field: "PromotionTypeName",
                    title: "Promotion Type",
                    width: "5%",
                    filterable: false
                },
                {
                    field: "IsReviewed",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "IsReviewedString",
                    title: "Is Reviewed",
                    width: "3%",
                    filterable: false
                },
                {
                    field: "PromotionDateMsg",
                    title: "Promotion Date",
                    width: "6%",
                    filterable: false
                },
                {
                    field: "NextReviewDateMsg",
                    title: "NextReview Date",
                    width: "6%",
                    filterable: false
                },
                {
                    field: "BasicSalary",
                    title: "BasicSalary",
                    width: "5%",
                    filterable: false
                },
                {
                    field: "HouseRent",
                    title: "HouseRent",
                    width: "5%",
                    filterable: false
                },
                {
                    field: "Medical",
                    title: "Medical",
                    width: "5%",
                    filterable: false
                },
                {
                    field: "BonusAmount",
                    title: "BonusAmount",
                    width: "5%",
                    filterable: false
                },
                {
                    field: "GrossSalary",
                    title: "GrossSalary",
                    width: "5%",
                    filterable: false
                },
                {
                    title: "Edit",
                    width: "3%",
                    template: function (dataItem) {
                        var JoinDate = dataItem.JoiningDate == null ? '' : kendo.toString(kendo.parseDate(dataItem.JoiningDate, 'yyyy-MM-dd'), 'dd-MMM-yyyy');
                        var ReleDate = dataItem.ReleaseDate == null ? '' : kendo.toString(kendo.parseDate(dataItem.ReleaseDate, 'yyyy-MM-dd'), 'dd-MMM-yyyy');
                        var OrderDate = dataItem.OrderDate == null ? '' : kendo.toString(kendo.parseDate(dataItem.OrderDate, 'yyyy-MM-dd'), 'dd-MMM-yyyy');
                        return "<a href='#' OnClick='EmployeeDataEdit(" + dataItem.PromotionId + "," + dataItem.EmployeeId + "," + dataItem.DesignationId + "," + dataItem.IsReviewed + ",\"" + dataItem.PromotionDateMsg + "\",\"" + dataItem.NextReviewDateMsg + "\"," + dataItem.PromotionTypeId + ");'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },
                {
                    title: "Edit Salary",
                    width: '5%',
                    sorting: false,
                    template: function (dataItem) {
                        return '<div class="text-center"><a href="#" OnClick="PopupDiv(' + dataItem.PromotionId + ',' + dataItem.BasicSalary + ',' + dataItem.HouseRent + ',' + dataItem.Medical + ',' + dataItem.BonusAmount + ',' + dataItem.GrossSalary + ');"><i class="fa fa-pencil-square-o"></i></a></div>';

                    }
                },
                 {
                     title: "Delete",
                     width: "3%",
                     template: function (dataItem) {
                         return "<a href='#' OnClick='DeletePromotion(" + dataItem.PromotionId + ");'><i class='fa fa-trash-o'></i></a>";
                     }
                 }
            ]
        });
    }

    function LoadEmpInfoByCode(employee_code) {
        $("#EmployeeId").val(0);
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpInfoByCodeEmp", "EmployeePromotionConfiguration", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: false,
            success: function (data) {
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#CurrentOfficeType").val(data.CurrentOfficeType);
                        $("#EmployeeCurrentOfficeName").val(data.EmployeeCurrentOfficeName);
                        $("#EmployeeCurrenOfficeId").val(data.OfficeId);
                        $("#EmployeeCurrentDepartmentName").val(data.EmployeeCurrentDepartmentName);
                        $("#EmployeeCurrentDesignation").val(data.EmployeeCurrentDesignation);
                    });
                    LoadPreviousDataList();
                }

                else {
                    ClearControl();
                    $.alert.open("Error", "Invalid code");
                }
            },
        });
    }

    function ChechkRequiredFieldValidate() {

        var designationId = $("#DesignationId").val();
        var promotionDate = $("#PromotionDate").val();
        var nextReviewDate = $("#NextReviewDate").val();
        var isReviewed = $("#IsReviewed").val();
        var PromotionTypeId = $("#PromotionTypeId option:selected").val();
        if (designationId && PromotionDate && NextReviewDate && isReviewed && PromotionTypeId) {
            SavePromotionBacklog();
        } else {
            $.alert.open("Alert", "Please Insert all required fields");
            return false;
        }
    }

    function SavePromotionBacklog() {

        var promotionId = $("#PromotionId").val();
        var employeeId = $("#EmployeeId").val();
        var designationId = $("#DesignationId").val();
        var promotionDate = $("#PromotionDate").val();
        var nextReviewDate = $("#NextReviewDate").val();
        var isReviewedInt = $("#IsReviewed").val();
        var isReviewed = false;
        if (isReviewedInt>0) {
            isReviewed = true
        }
        var PromotionTypeId = $("#PromotionTypeId option:selected").val()

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SavePromotionBackLog", "EmployeePromotionConfiguration", "http")',
            data: { PromotionId: promotionId, EmployeeId: employeeId, DesignationId: designationId, PromotionDate: promotionDate, NextReviewDate: nextReviewDate, IsReviewed: isReviewed, PromotionTypeId: PromotionTypeId },
            dataType: 'json',
            async: false,
            success: function (response) {
                if (response.result == 1) {
                    ClearControl();
                    LoadPreviousDataList();
                    $.alert.open("Success", response.message);
                }
                else {
                    ClearControl();
                    $.alert.open("Success", response.message);
                }
            },
        });
    }


    function ClearControl() {
        $("#PromotionId").val(0);
        $("#DesignationId").val('');
        $("#PromotionDate").val('');
        $("#NextReviewDate").val('');
        $("#IsReviewed").val('');

        $("#btnSave").val("Save");
        $("#btnReset").hide();
        $("#NextReviewDate").attr("disabled", true);
    }

</script>
@Html.ActionLink("Back to list", "PromotionBacklogIndex", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Promotion Backlog Entry Form</h2>
