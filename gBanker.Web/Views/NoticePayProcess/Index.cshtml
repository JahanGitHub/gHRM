@model gHRM.Web.ViewModels.NoticePayProcessViewModel

@{
    ViewBag.Title = "Notice Pay Process";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    string ErrStat = null != ViewBag.IsSuccess && ViewBag.IsSuccess ? "Success" : "Error";
    var pvOfficeNevigation = new gHRM.Web.ViewModels.OfficeNevigationPartialViewModel();
    pvOfficeNevigation.OfficeTypeList = Model.OfficeTypeList;
    pvOfficeNevigation.ZoneList = Model.ZoneList;
    pvOfficeNevigation.AreaList = Model.AreaList;
    pvOfficeNevigation.UnitList = Model.UnitList;
}

<h2 class="page-title">Notice Pay Process</h2>
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @using (Html.BeginForm("Index", "NoticePayProcess", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "NoticePayProcessForm", onsubmit = "return Page.IsValid()" }))
    {
        @Html.AntiForgeryToken()
        @Html.Raw("&nbsp")
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4 required">Office Type (অফিসের ধরন)</label>
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.OfficeTypeId, Model.OfficeTypeList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Office (অফিস)</label>
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.OfficeId, Model.OfficeList, new { @class = "form-control" })
                        @Html.HiddenFor(model => model.OfficeId)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4">Processed By (যে ব্যক্তি দ্বারা প্রক্রিয়াকৃত)</label>
                    <div class="col-md-8">
                        @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4 required">Year (বছর)</label>
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.FromYear, Model.YearList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4 required">Month (মাস)</label>
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.FromMonth, Model.MonthList, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-md-4 required">Date (তারিখ)</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" id="ProcessDate" name="ProcessDate" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="padding-top: 10px;">
            <div class="col-sm-12">
                <div class="form-group form-action" style="padding-top:10px ;padding-left:10px;margin:5px;">
                    <input type="button" value="Summary Before Send for Approval" id="btnSummaryBeforeSendForApproval" class="btn btn-primary" onclick="Page.SummaryPreview()" /> &nbsp;&nbsp;
                    <input type="submit" value="Generate Notice Pay" id="btnProcess" class="btn btn-primary" />&nbsp;&nbsp;
                    <input type="button" value="Send For Approval" id="btnSendForApproval" class="btn btn-primary" onclick="Page.SendGeneratedNoticePayForApproval()" />&nbsp;&nbsp;
                </div>
            </div>
        </div>
        @Html.Raw("&nbsp;")
        <div class="row" style="display: none;">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
            </div>
        </div>
        <div class="row" style="display: none;">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4">Report Type</label>
                    <div class="col-md-8">
                        <select class="form-control" id="ReportType" name="ReportType">
                            <option value="">Please Select</option>
                            <option value="gratuity-before-approval-pdf">Notice Pay Before Approval (Pdf Format)</option>
                            <option value="gratuity-before-approval-excel">Notice Pay Before Approval (Excel Format)</option>
                            <option value="rejected-gratuity">Rejected Notice Pay</option>
                            <option value="approved-gratuity-pdf">Approved Notice Pay (Pdf Format)</option>
                            <option value="approved-gratuity-excel">Approved Notice Pay (Excel Format)</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-sm-2">
                <div class="form-group">
                    <input type="button" id="btnPrint" value="Print" class="btn btn-primary" onclick="Page.ReportView()" />
                </div>
            </div>
        </div>
        <div class="box-content before-approval-container" style="display: none;">
            <h4><label>Before Approval</label></h4>
            <div class="table-responsive">
                <div id="beforeApprovalGridKendo"></div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("/Assets/js/app/payroll/notice-pay-process.js?v=" + @gHRM.Core.Utilities.CommonHelper.DEV_VERSION()+System.DateTime.Now)
    <script>
        var ServerMessage = "@ViewBag.Message";
        var AllOfficeList = @Html.Raw(ViewBag.OfficeListJson);
        var SelectedOfficeId = @Model.OfficeId;

        $(function () {
            if (![null, ""].includes(ServerMessage)) {
                $.alert.open("@ErrStat", ServerMessage);
            }
        });
    </script>
}