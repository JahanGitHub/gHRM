    //create
    function GenerateCarRecognition() {
        var item = {};
        item.EmployeeId = $("#EmployeeId").val();
        item.CarNo = $("#CarNo").val();
        item.CarRecognitionDate = $("#CarRecognitionDate").val();
        item.CarRecognitionTimeFrom = $("#CarRecognitionTimeFrom").val();
        item.CarRecognitionTimeTo = $("#CarRecognitionTimeTo").val();
        item.Distance = $("#Distance").val();
        item.Purpose = $("#Purpose").val();
        return item;
    }

    function GenerateUpdateCarRecognition() {
        var item = {};
        item.CarRecognitionId = $("#CarRecognitionId").val();
        item.EmployeeId = $("#EmployeeId").val();
        item.CarNo = $("#CarNo").val();
        item.CarRecognitionDate = $("#CarRecognitionDate").val();
        item.CarRecognitionTimeFrom = $("#CarRecognitionTimeFrom").val();
        item.CarRecognitionTimeTo = $("#CarRecognitionTimeTo").val();
        item.Distance = $("#Distance").val();
        item.Purpose = $("#Purpose").val();
        return item;
    }

    //edit using jtable
    function ResetCarRecognition() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }
    function EditCarRecognition(CarRecognitionId, EmployeeId, CarNo, CRD, CRTF, CRTT, Distance, Purpose) {
        $("#CarRecognitionId").val(CarRecognitionId);
        $("#EmployeeId").val(EmployeeId);
        $("#CarNo").val(CarNo);
        $("#CarRecognitionDate").val(CRD);
        $("#CarRecognitionTimeFrom").val(CRTF);
        $("#CarRecognitionTimeTo").val(CRTT);
        $("#Distance").val(Distance);
        $("#Purpose").val(Purpose);

        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }

    function ClearControl() {
        $("#EmployeeId").val('');
        $("#CarNo").val('');
        $("#CarRecognitionDate").val('');
        $("#CarRecognitionTimeFrom").val('');
        $("#CarRecognitionTimeTo").val('');
        $("#Distance").val('');
        $("#Purpose").val('');
    }

    function SaveCarRecognition() {
        var carRecognition = GenerateCarRecognition();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveCarRecognition", "CarRecognition")',
            data: JSON.stringify({ carRecognition: carRecognition }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    //$('#grid').jtable('load');
                    loadCarRecognition();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function UpdateCarRecognition() {
        var carRecognition = GenerateUpdateCarRecognition();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateCarRecognition", "CarRecognition")',
            data: JSON.stringify({ carRecognition: carRecognition }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Update Successfull") {
                    ClearControl();
                    //$('#grid').jtable('load');
                    loadCarRecognition();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteCarRecognition", "CarRecognition", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            //$('#grid').jtable('load');
                            loadCarRecognition();
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }



</script>


<h2 class="page-title">Car Recognition</h2>
@using (Html.BeginForm("SaveCarRecognition", "CarRecognition", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
        <div id="AjaxLoader" class="ajaxLoader"></div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Employee Id</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.EmployeeId, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Car No</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.CarNo, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Car Recognition Date</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.CarRecognitionDate, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Car Recognition TimeFrom</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.CarRecognitionTimeFrom, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Car Recognition TimeTo</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.CarRecognitionTimeTo, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Distance</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.Distance, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Purpose</label>
                    <div class="col-sm-8">
                        @Html.TextAreaFor(model => model.Purpose, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <div class="col-sm-8 pull-right">
                        <input type="button" value="Save" id="btnSave" class="btn btn-primary" />
                        <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" />
                        <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-8">
                @Html.HiddenFor(model => model.CarRecognitionId)
            </div>
        </div>
}

<br />
