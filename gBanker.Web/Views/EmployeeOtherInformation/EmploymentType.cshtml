@model gHRM.Web.ViewModels.EmployementTypeViewModel

@{
    ViewBag.Title = "EmployementType";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script>
    $(document).ready(function () {
        $("#btnUpdate").hide();
        $("#btnRestore").hide();
        GetEmployementTypeList();


    });

    function SaveEmployementType() {
        var employementTypeName = $("#EmployementTypeName").val();
        if (employementTypeName != "") {
            $('#AjaxLoader').show();
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SaveEmployementType", "EmployeeOtherInformation", "http")',
                data: { EmployementTypeName: employementTypeName },
                dataType: 'json',
                async: false,
                success: function (data) {
                    $('#AjaxLoader').hide();
                    if (data.result == 1) {
                        $.alert.open("Success", data.message);
                        GetEmployementTypeList();
                        $("#EmployementTypeName").val('');
                    } else {
                        $.alert.open("Error", data.message);
                    }
                },

                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }

            });
        } else {
            $.alert.open("Error", "Please Insert Required Data");
        }
    }

    function GetEmployementTypeList() {
        $('#grid').jtable({
            paging: true,
            pageSize: 10,
            sorting: true,
            actions: {
                listAction: function (postData, jtParams) {
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/EmployeeOtherInformation/GetEmployementTypeList?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                EmployementTypeId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                EmployementTypeName: {
                    title: 'Employement Type Name',
                    width: '30%'
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EditEmployementType( ' + "'" + data.record.EmployementTypeId + "'" + ',' + "'" + data.record.EmployementTypeName + "'" + ' );"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                DeleteLink: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="DeleteEmployementType(' + data.record.EmployementTypeId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }
                }
            }
        });
        $('#grid').jtable('load');
    }

    function EditEmployementType(employementTypeId, employementTypeName) {
        $("#EmployementTypeId").val(employementTypeId);
        $("#EmployementTypeName").val(employementTypeName);

        $("#btnUpdate").show();
        $("#btnRestore").show();
        $("#btnSave").hide();
    }
   

    function UpdateEmployementType() {
        var typeId =  $("#EmployementTypeId").val();
        var employementTypeName = $("#EmployementTypeName").val();
        if (employementTypeName != "") {
            $('#AjaxLoader').show();
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateEmployementType", "EmployeeOtherInformation", "http")',
                data: { EmployementTypeName: employementTypeName, EmployementTypeId: typeId },
                dataType: 'json',
                async: false,
                success: function (data) {
                    $('#AjaxLoader').hide();
                    if (data.result == 1) {
                        $.alert.open("Success", data.message);
                        GetEmployementTypeList();
                        $("#EmployementTypeName").val('');
                    } else {
                        $.alert.open("Error", data.message);
                    }
                },

                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }

            });
        } else {
            $.alert.open("Error", "Please Insert Required Data");
        }
    }

    function ResetEmployementType() {
        $("#btnUpdate").hide();
        $("#btnRestore").hide();
        $("#btnSave").show();
        $("#EmployementTypeName").val('');
    }

    function DeleteEmployementType(id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteEmployementType", "EmployeeOtherInformation", "http")',
                    data: { id: id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            GetEmployementTypeList();
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }


</script>



<h2 class="page-title"> Employment Type Configuration </h2>
@using (Html.BeginForm("EmploymentType", "EmployeeOtherInformation", FormMethod.Get, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br />
    <br />
    <div id="AjaxLoader" class="ajaxLoader"></div>
    @Html.HiddenFor(model => model.EmployementTypeId)

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Employment Type </label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployementTypeName, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-10 col-md-offset-2">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveEmployementType()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateEmployementType()" /> &nbsp;
                    <input type="button" value="Restore" id="btnRestore" class="btn btn-primary" onclick="ResetEmployementType()" />
                </div>
            </div>
        </div>
    </div>

    <div id="grid"></div>
}


@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")

}