    function getEmployeeOfficeVisitInfoApproval() {
        $('#gridOfficeVisitApproval').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            actions: {
                listAction: function (postData, jtParams) {
                    return $.Deferred(function ($dfd) {
                        var empCode = $("#EmployeeCode").val();
                        $.ajax({
                            url: '/EmployeeOtherInformation/ListOfficeVisitApproval?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&empCode=' + empCode,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                EmpOfficeVisitId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                //EmployeeId: {
                //    title: 'EmployeeId',
                //    width: '3%'
                //},
                EmployeeCode: {
                    title: 'EmployeeCode',
                    width: '5%'
                },

                VisitType: {
                    title: 'Visit Type',
                    width: '5%'
                },
                Location: {
                    title: 'Location',
                    width: '5%'
                },
                Reason: {
                    title: 'Reason',
                    width: '5%'
                },
                //CurrentOfficeProvidedVal: {
                //    key: true,
                //    list: false,
                //    create: false,
                //    edit: false
                //},
                CurrentOfficeProvided: {
                    title: 'CurrentOfficeProvided',
                    width: '5%',
                    display: function (data) {
                        if (data.record.CurrentOfficeProvided == 1) {
                            debugger;
                            return '<div class="text-center">Yes</div>';
                        } else {
                            return '<div class="text-center">No</div>';
                        }

                    }
                },
                IsApproved: {
                    title: "Approved",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationOfficeVisitApproved(' + data.record.EmpOfficeVisitId + ');"><i class="fa fa-thumbs-up"></i></a></div>';
                    }
                },
                IsRejected: {
                    title: "Rejected",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationOfficeVisitRejected(' + data.record.EmpOfficeVisitId + ');"><i class="fa fa-thumbs-down"></i></a></div>';
                    }
                },
            }
        });
        $('#gridOfficeVisitApproval').jtable('load');
    }

    function InformationOfficeVisitApproved(Id) {
        $.alert.open('confirm', 'Are you sure you want to approved this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationOfficeVisitApproved", "EmployeeOtherInformation", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $('#gridOfficeVisitApproval').jtable('load');
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function InformationOfficeVisitRejected(Id) {
        $.alert.open('confirm', 'Are you sure you want to rejected this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
