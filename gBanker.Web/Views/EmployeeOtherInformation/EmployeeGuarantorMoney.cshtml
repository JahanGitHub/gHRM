@model gHRM.Web.ViewModels.EmployeeGuarantorMoneyViewModel

@{
    ViewBag.Title = "Guarantor Money";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script type="text/javascript">


    function ClearGrantorMoney() {
          $("#TransactionType").val('');
          $("#TransactionDate").val('');
          $("#TransactionAmount").val('');
          $("#PaymentType").val('');

          $("#BankName").val('');
          $("#AccountNo").val('');
          $("#CheckNo").val('');
    }


    function reloadGrantorMoneyGrid() {
        var empMasterId = $("#EmployeeId").val();
        $("#hdnEmpEducationSave").val('S');
        var dtTable = $('#tblEducation');
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetGrantorMoneyList", "Employee", "http")',
            data: { empMasterId: empMasterId },
            dataType: 'json',
            async: true,
            success: function (List_GrantorMoneyViewModel) {
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                $.each(List_GrantorMoneyViewModel, function (index, emp) {
                    var sl = index + 1;
                    tableBody.append('<tr>' +
                        '<td>' + emp.SNO + '</td>' +
                        '<td>' + emp.EmployeeCode + ' <input type="text" value="' + emp.TransactionType + '" style="display:none;" name="TransactionType" id="TransactionType' + sl + '" /></td>' +
                        '<td>' + emp.EmployeeName + ' <input type="text" value="' + emp.TransactionDate + '" style="display:none;" name="TransactionDate" id="TransactionDate' + sl + '" /></td>' +
                        '<td>' + emp.TransactionType + ' <input type="text" value="' + emp.TransactionAmount + '" style="display:none;" name="TransactionAmount" id="TransactionAmount' + sl + '" /></td>' +
                        '<td>' + emp.TransactionDate + ' <input type="text" value="' + emp.BankName + '" style="display:none;" name="BankName" id="BankName' + sl + '" /></td>' +
                        '<td>' + emp.TransactionAmount + '</td>' +
                        '<td>' + emp.PaymentType + '<input type="text" value="' + emp.AccountNo + '" style="display:none;" name="AccountNo" id="AccountNo' + sl + '" /></td>' +
                        '<td>' + emp.CheckNo + '<input type="text" value="' + emp.PaymentType + '" style="display:none;" name="PaymentType" id="PaymentType' + sl + '" /></td>' +
                         '<td><a href="#" OnClick="LoadEdit(' + sl + ');"><i class="fa fa-pencil-square-o"></i></a></td>' +
                        '<td><a href="#" OnClick="Delete(' + sl + ')"><i class="fa fa-trash-o"></i></a>' +
                        '<input type="text" value="' + emp.CheckNo + '" style="display:none;" name="CheckNo" id="CheckNo' + sl + '" />' +
                        '<input type="text" value="' + emp.ID + '" style="display:none;" name="ID" id="ID' + sl + '" />' +
                        '<input type="text" value="' + emp.Division + '" style="display:none;" name="Division" id="txtDivision' + sl + '" />' +
                        '<input type="text" value="' + emp.CGPAScale + '" style="display:none;" name="CGPAScale" id="txtCGPAScale' + sl + '" />' +
                        '<input type="text" value="' + emp.DegreeLevelId + '" style="display:none;" name="DegreeLevelId" id="txtDegreeLevelId' + sl + '" />' +
                        '<input type="text" value="' + emp.DegreeLevel + '" style="display:none;" name="DegreeLevel" id="txtDegreeLevel' + sl + '" />' +
                        '<input type="text" value="' + emp.Concentration + '" style="display:none;" name="txtConcentration" id="txtConcentration' + sl + '" />' +
                        '</tr>');
                });

            },
            error: function (request, status, error) {
                $("#loading").hide();
                $("#dvMessage").attr('class', 'failed');
                $("#dvMessage").html(request.statusText);
                $("#dvMessage").show();
            }
        });
    }


    function Delete(rowSl) {
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {
                var empEduId = $("#ID" + rowSl).val();
              //  alert(empEduId);
                var empMasterId = $("#EmployeeId").val();
            //    alert(empMasterId);



                if (empEduId == '') {
                    empEduId = 0;
                }

                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteGrantorMoney", "Employee", "http")',
                    data: { empEduId: empEduId, empMasterId: empMasterId },
                    dataType: 'json',
                    async: true,
                    success: function (empEduId) {
                        if (empEduId > 0) {
                            reloadGrantorMoneyGrid();
                            $("#hdnEmpEducationSave").val('S');
                            $.alert.open("Success", "Deleted Successfully");

                            var employee_code = $("#EmployeeCode").val();
                            LoadEmpInfoByCode(employee_code);

                        } else {
                            // not save
                        }
                    },
                    error: function (request, status, error) {
                        alert(error);
                    }
                });
            }

        });
    }


    function LoadEdit(rowSl) {

        var TransactionType = $("#TransactionType" + rowSl).val();
        $("#TransactionType").val(TransactionType);

        var TransactionDate = $("#TransactionDate" + rowSl).val();
        $("#TransactionDate").val(TransactionDate);

        var TransactionAmount = $("#TransactionAmount" + rowSl).val();
        $("#TransactionAmount").val(TransactionAmount);

        var PaymentType = $("#PaymentType" + rowSl).val();
        $("#PaymentType").val(PaymentType);


        var BankName = $("#BankName" + rowSl).val();
        $("#BankName").val(BankName);


        var AccountNo = $("#AccountNo" + rowSl).val();
        $("#AccountNo").val(AccountNo);


        var CheckNo = $("#CheckNo" + rowSl).val();
        $("#CheckNo").val(CheckNo);

        var empEduId = $("#ID" + rowSl).val();
        $("#hdnEmpEducationEditId").val(empEduId);
        $("#hdnEmpEducationSave").val('U');



        if (PaymentType == "Bank") {
            $('.CheckNoContainer').show();
            $('.AccountNoContainer').show();
            $('.BankNameContainer').show();
        }
        else {
            $('.CheckNoContainer').hide();
            $('.AccountNoContainer').hide();
            $('.BankNameContainer').hide();
        }



    }



    function SaveGuarantorInfo() {

        $.alert.open('confirm', 'Are you sure, you want to save this transaction?', function (button) {
            if (button == 'yes') {

                try {
                    // e.preventDefault();
                    var flag = 0;
                    var TransactionType = $("#TransactionType option:selected").val();
                    var TransactionDate = $("#TransactionDate").val();
                    var TransactionAmount = $("#TransactionAmount").val();
                    var PaymentType = $("#PaymentType").val();
                    var BankName = $("#BankName").val();
                    var AccountNo = $("#AccountNo").val();
                    var CheckNo = $("#CheckNo").val();
                    var EmployeeId = $("#EmployeeId").val();
                    var mode = $("#hdnEmpEducationSave").val();
                    var eduEditId = $("#hdnEmpEducationEditId").val();


                    if (EmployeeId == "") {
                        $.alert.open("error", "Please type employee code first  !");
                        return false;
                    }



                    if (TransactionType == "") {
                        $.alert.open("error", "Please select transaction type !");
                        return false;
                    }


                    if (TransactionDate == "") {
                        $.alert.open("error", "Please select transaction date   !");
                        return false;
                    }

                    if (TransactionAmount == "" || TransactionAmount == "0.00") {
                        $.alert.open("error", "Transaction amount can not be empty and Transaction amount should be greater than 0   !");
                        return false;
                    }


                    if (PaymentType == "") {
                        $.alert.open("error", "Please select payment type   !");
                        return false;
                    }



                    if (PaymentType == "Bank") {


                        if (BankName == "") {
                            $.alert.open("error", "BankName  Needed!");
                            return false;
                        }


                        if (AccountNo == "") {
                            $.alert.open("error", "Account No Needed!");
                            return false;
                        }

                        if (CheckNo == "") {
                            $.alert.open("error", "CheckNo No Needed!");
                            return false;
                        }



                    }



                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("SaveGuarantorMoney", "Employee", "http")',
                        data: { TransactionType: TransactionType, TransactionDate: TransactionDate, TransactionAmount: TransactionAmount, PaymentType: PaymentType, BankName: BankName, AccountNo: AccountNo, CheckNo: CheckNo, EmployeeId: EmployeeId, mode: mode, eduEditId: eduEditId },
                        dataType: 'json',
                        async: true,
                        success: function (Grantor_Id) {
                            if (Grantor_Id == 0) {
                                //$(".panel-body .create-success").show(800).fadeToggle(3000);
                                $.alert.open("Success", "Saved Successfully");
                                var employee_code = $("#EmployeeCode").val();
                                LoadEmpInfoByCode(employee_code);
                                reloadGrantorMoneyGrid();
                                $("#hdnEmpEducationSave").val('S');
                                ClearGrantorMoney();
                            } else {
                                // not save

                                $.alert.open("error", "Current Transaction Amount is Greater than Guarantee Money !");
                                var employee_code = $("#EmployeeCode").val();
                                LoadEmpInfoByCode(employee_code);
                                reloadGrantorMoneyGrid();
                                $("#hdnEmpEducationSave").val('S');
                                ClearGrantorMoney();
                            }
                        },
                        error: function (request, status, error) {
                            alert(error);
                        }
                    });
                }
                catch (ex) {
                    alert(ex.message);
                }
            }

            });

       }



     function LoadEmpInfoByCode(employee_code) {
      //  $("#EmployeeCode").val(0);
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDepositMoney", "EmployeeProfileReport", "http")',
            data: { employee_code: employee_code },
            dataType: 'json',
            async: false,
            success: function (data) {
                debugger;
                if (data.result == 1) {
                    $.each(data.data, function (index, data) {
                        $("#deposit").val(data.deposit);
                        $("#balance").val(data.balance);
                        $("#EmployeeId").val(data.EmployeeId);
                        $("#EmployeeName").val(data.EmployeeName);
                        $("#CurrentOfficeType").val(data.CurrentOfficeType);
                        $("#EmployeeCurrentOfficeName").val(data.EmployeeCurrentOfficeName);
                        $("#EmployeeCurrenOfficeId").val(data.OfficeId);
                        $("#EmployeeCurrentDepartmentName").val(data.EmployeeCurrentDepartmentName);
                        $("#EmployeeCurrentDesignation").val(data.EmployeeCurrentDesignation);

                        if (data.deposit == 0) {
                            alert("Please add guarantor money in profile!");
                            $('#deposit').css('background-color', '#F00;')
                        }
                        else {
                            $('#deposit').css('background-color', '#FFF;')
                        }
                    });
                    //LoadPreviousDataList($("#EmployeeId").val());

                   

                    reloadGrantorMoneyGrid();
                }

                else {
                    $("#OrderNo").val("");
                    $("#EmployeeName").val("");
                    $("#CurrentOfficeType").val("");
                    $("#EmployeeCurrentOfficeName").val("");
                    $("#EmployeeCurrenOfficeId").val("");
                    $("#EmployeeCurrentDepartmentName").val("");
                    $("#EmployeeCurrentDesignation").val("");

                    ClearControl();
                    $.alert.open("Error", "Invalid code");
                }
            },
        });
    }





    var Page = {
        ControlList: ["DateContainer", "BasicOfficeTypeContainer", "DesignationContainer", "TotalServiceYearContainer", "ServiceYearFromLastPromotionContainer"],
        ReportControlConfig: {
            EFPOD: ["DateContainer", "BasicOfficeTypeContainer", "DesignationContainer", "TotalServiceYearContainer", "ServiceYearFromLastPromotionContainer"]
        },
        ReportControlConfigMousumiCode: {
            EPRCode: ["EmployeeCodeContainer"]
        },

        ReportControlConfigMousumiDate: {
            EPRDate: ["CheckNoContainer", "AccountNoContainer","BankNameContainer"]
        },

        IsNumber: function (Value) {
            return ![null, ""].includes(Value) && !isNaN(Value);
        },
        Load: function () {
            this.BindEvents();
        },
        BindEvents: function () {
            $("#TransactionDate").datepicker(
                {
                    dateFormat: "dd-M-yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true
                });
          //  $("#DateFrom").datepicker('setDate', new Date());


            $("#DateTo").datepicker(
                {
                    dateFormat: "dd-M-yy",
                    showAnim: "scale",
                    changeMonth: true,
                    changeYear: true
                });
        //    $("#DateTo").datepicker('setDate', new Date());



            $("#PaymentType").change(function () {
                var PaymentType = $(this).val();
                //alert(PaymentType);


                if (PaymentType == "Bank") {
                    $('.CheckNoContainer').show();
                    $('.AccountNoContainer').show();
                    $('.BankNameContainer').show();
                }
                else {
                    $('.CheckNoContainer').hide();
                    $('.AccountNoContainer').hide();
                    $('.BankNameContainer').hide();
                }

            });
        },
        PrintReport: function (DownloadExcel) {

            var EmployeeCode = $("#OrderNo").val();
            var DateFrom = $("#DateFrom").val();
            var DateTo = $("#DateTo").val();

          //  alert(ReportType);

           // alert(EmployeeCode);
         //   alert(DateFrom);
          //  alert(DateTo);

            if (EmployeeCode == "" )  {
                var url = '/TransferReport/TransferReportDateWiseForStaf?'+
                    '&Date=' + $("#DateFrom").val() +
                    '&DateTo=' + $("#DateTo").val() +
                    '&EmployeeCode=' + $("#OrderNo").val() +
                    '&DownloadExcel=' + (DownloadExcel ? "true" : "false");
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
            else {
                var url = '/TransferReport/TransferReportEmpCodeForStaf?' +
                    '&EmployeeCode=' + $("#OrderNo").val() +
                    '&DownloadExcel=' + (DownloadExcel ? "true" : "false");
                window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
            }
        }
    };

    $(function () {
        Page.Load();
    });

</script>


<script type="text/javascript">
    var IsEmployeeCodeEditAllowed = "True" == "@ViewBag.IsEmployeeCodeEditAllowed";

    $(document).ready(function () {

        $("#EmployeeCode").blur(function (e) {
            debugger;
            var employeeCode = $("#EmployeeCode").val();
            if (employeeCode != '') {
                LoadEmpInfoByCode(employeeCode);
            }
        });



    });


</script>


