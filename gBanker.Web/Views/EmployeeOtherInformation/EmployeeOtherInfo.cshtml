    // starts Visit Information functions//

    function ChechkRequiredFieldValidate() {

        var reqFieldsName = new Array(
                                    '#EmployeeCode'
                                  , '#VisitType'
                                  , '#Location'
                                  , '#Reason'
                                  , '#CurrentOfficeProvided'
                                  );

        var fieldValidate = RequiredFieldValidate(reqFieldsName);

        if (fieldValidate == 1) {
            SaveOfficeVisitInfo();
        }
    }


    function RequiredFieldValidate(reqFieldsName) {

        var flag = 1;
        for (var i = 0; i < reqFieldsName.length; i++) {
            var fieldName = reqFieldsName[i];
            $(fieldName).removeClass("errorClass");
            if ($(fieldName).val() == '' //|| $(fieldName).val() == '0'
                ) {
                $(fieldName).addClass("errorClass");
                flag = 0;
            }
        }
        return flag;
    }


    function SaveOfficeVisitInfo() {

        var empCode = $("#EmployeeCode").val();
        var visitType = $("#VisitType").val();
        var location = $("#Location").val();
        var reason = $("#Reason").val();
        var currentOfficeProvided = $("#CurrentOfficeProvided").val();
        if (visitType != "" && location != "" && reason != "" && currentOfficeProvided != "") {
            var obj = {
                EmployeeCode: empCode,
                VisitType: visitType,
                Location: location,
                Reason: reason,
                CurrentOfficeProvided: currentOfficeProvided
            }
            $('#AjaxLoader').show();
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SaveOfficeVisitInfo", "EmployeeOtherInformation", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        //$(".panel-body .create-success").show(800).fadeToggle(3000);
                        $("#AjaxLoader").hide();
                        $.alert.open("Success", data.message);
                        getEmployeeOfficeVisitInfo();
                        //ClearVisitInfoform();

                    } else {
                        $("#AjaxLoader").hide();
                        $.alert.open("Error", data.message);
                    }
                },
                error: function (request, status, error) {
                    $("#AjaxLoader").hide();
                    alert(error);
                }
            });


        } else {
            $.alert.open("Error", "Please provide the required field");
        }
    }

