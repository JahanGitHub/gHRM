    function getEmployeeOfficeVisitInfo() {
        $('#gridOfficeVisit').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            actions: {
                listAction: function (postData, jtParams) {
                    return $.Deferred(function ($dfd) {
                        var empCode = $("#EmployeeCode").val();
                        $.ajax({
                            url: '/EmployeeOtherInformation/GetEmployeeOfficeVisitInformation?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&empCode=' + empCode,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                EmpOfficeVisitId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                //EmployeeId: {
                //    title: 'EmployeeId',
                //    width: '3%'
                //},
                EmployeeCode: {
                    title: 'EmployeeCode',
                    width: '5%'
                },

                VisitType: {
                    title: 'Visit Type',
                    width: '5%'
                },
                Location: {
                    title: 'Location',
                    width: '5%'
                },
                Reason: {
                    title: 'Reason',
                    width: '5%'
                },
                CurrentOfficeProvidedVal: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                CurrentOfficeProvided: {
                    title: 'CurrentOfficeProvided',
                    width: '5%'
                },
                VisitStatus: {
                    title: 'VisitStatus',
                    width: '3%'
                },
                EditLink: {
                    title: "Edit",
                    width: '2%',
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EditOfficeVisitInformation( ' + data.record.EmpOfficeVisitId + ',' + "'" + data.record.VisitType + "'" + ',' + "'" + data.record.Location + "'" + ',' + "'" + data.record.Reason + "'" + ',' + data.record.CurrentOfficeProvidedVal + ' );"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                Delete: {
                    title: "Delete",
                    width: '2%',
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="DeleteOfficeVisitInfo(' + data.record.EmpOfficeVisitId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#gridOfficeVisit').jtable('load');
    }

    function EditOfficeVisitInformation(EmpOfficeVisitId, VisitType, Location, Reason, CurrentOfficeProvided) {
        $("#EmpOfficeVisitId").val(EmpOfficeVisitId);
        if (VisitType == 'Local') {
            $("#VisitType").val('L');
        } else if (VisitType == 'International') {
            $("#VisitType").val('IN');
        }
        $("#Location").val(Location);
        $("#Reason").val(Reason);
        $("#CurrentOfficeProvided").val(CurrentOfficeProvided);

        $("#btnOfficeVisitUpdate").show();
        $("#btnOfficeVisitRestore").show();
        $("#btnOfficeVisitSave").hide();
    }

    function UpdateOfficeVisitInfo() {
        var empCode = $("#EmployeeCode").val();
        var empVisitId = $("#EmpOfficeVisitId").val();
        var visitType = $("#VisitType").val();
        var location = $("#Location").val();
        var reason = $("#Reason").val();
        var currentOfficeProvided = $("#CurrentOfficeProvided").val();

        var obj = {
            EmployeeCode: empCode,
            EmpOfficeVisitId: empVisitId,
            VisitType: visitType,
            Location: location,
            Reason: reason,
            CurrentOfficeProvided: currentOfficeProvided
        }

        if (visitType != "" && location != "" && reason != "" && currentOfficeProvided != "") {
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateOfficeVisitInfo", "EmployeeOtherInformation", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        $(".panel-body .create-success").show(800).fadeToggle(3000);
                        $.alert.open("Success", data.message);
                        getEmployeeOfficeVisitInfo();
                        ClearVisitInfoform();
                    } else {
                        $.alert.open("Error", data.message);
                    }
                },
                error: function (request, status, error) {
                    alert(error);
                }
            });


        } else {
            $.alert.open("Error", "Please provide the required field");
        }
    }

    function ResetOfficeVisitInfo() {
        $("#btnOfficeVisitSave").show();
        $("#btnOfficeVisitUpdate").hide();
        $("#btnOfficeVisitRestore").hide();
        ClearVisitInfoform();
    }

    function DeleteOfficeVisitInfo(EmpOfficeVisitId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
