@model gHRM.Web.ViewModels.EmployeePromotionViewModel
@{
    ViewBag.Title = "Employee Assessment Approval";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<style type="text/css">
    .ui-datepicker-year {
        display: none;
    }
</style>
<h2>Employee Assessment</h2>
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-sm-3">
            <div class="form-group">
                @Html.LabelFor(model => model.FromDateStr, htmlAttributes: new { @class = "control-label col-sm-3 required" })
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.FromDateStr, new { @class = "form-control" ,@autocomplete="off" })
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                @Html.LabelFor(model => model.ToDateStr, htmlAttributes: new { @class = "control-label col-sm-3 required" })
                <div class="col-sm-9">
                    @Html.TextBoxFor(model => model.ToDateStr, new { @class = "form-control", @autocomplete = "off" })
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                <label class="control-label col-md-3 required"> Year</label>
                <div class="col-md-9">
                    @Html.DropDownList("Years", null, new { @ID = "Year", @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <input type="button" id="btnSearch" value="Search" class="btn btn-primary" />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <input type="button" name="btnReport" value="Pdf" class="btn btn-info" />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            <input type="button" name="btnReport" value="Excel" class="btn btn-info" />
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6" >
            <div class="form-group">
                <label class="control-label col-md-4">Office Type</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.BasicOfficeTypeId, Model.BasicOfficeTypeList, new { @class = "form-control" })
                </div>
            </div>
        </div>

    </div>

    <br />
    <div class="row">
        <div class="col-md-12">
            <div id="grid"></div>
        </div>
    </div>
    <br />
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
    <script src="~/Assets/js/app/employeeAssessment/employeeAssessmentApproval.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()@System.DateTime.Now"></script>
}