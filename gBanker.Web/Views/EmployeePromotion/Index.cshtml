@model gHRM.Web.ViewModels.EmployeePromotionViewModel

@{
    ViewBag.Title = "Promotion";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

    var proOfficeNevigation = new gHRM.Web.ViewModels.PromotionNevigationPartialViewModel
    {
        DesignationList = Model == null ? null : Model.DesignationList,
        EmployeeSalaryType = Model.EmployeeSalaryType,
        SalaryGenerationTypeList = Model.SalaryGenerationTypeList,
        GradeList = Model.GradeList,
        SalaryScaleList = Model.SalaryScaleList,
        OverTimeList = Model.OverTimeList,
        PFTypeList = Model == null ? null : Model.PFTypeList,
        PromotionTypeList = Model == null ? null : Model.PromotionTypeList,
        MonthList = Model.MonthList,
        IncrementYearFromList = Model.IncrementYearFromList,
        BankList = Model.BankList
    };
}


<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeePromotion">Promotion</a></li>
    </ol>
</div>

<link href="~/Content/bpopup/bpopupStyle.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" type="text/css" />
<script src="~/Content/bpopup/jquery.bpopup.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" type="text/javascript"></script>

<style>
    .errorClass {
        border: 1px solid red;
    }

    #PromotionNavDiv {
        background-color: #fff;
        border-radius: 15px;
        color: #000;
        display: none;
        padding: 20px;
        min-width: 400px;
        min-height: 180px;
    }

    #PromotionDiv {
        background-color: #fff;
        border-radius: 15px;
        color: #000;
        display: none;
        padding: 20px;
        min-width: 400px;
        min-height: 180px;
    }

    #PromotionRejectionDiv {
        background-color: #fff;
        border-radius: 15px;
        color: #000;
        display: none;
        padding: 20px;
        min-width: 400px;
        min-height: 180px;
    }
</style>

&nbsp;
<h2 class="page-title">Eligible Employee List</h2>
&nbsp;

<div class="row">

    <input type="hidden" id="PromotionId" />
    <div class="col-sm-6">
        <div class="form-group">
            <label class="control-label col-md-4"> Year</label>
            <div class="col-md-8">
                @Html.DropDownList("Years", null, new { @ID = "Year", @class = "form-control" })
            </div>
        </div>
    </div>

    <div class="col-sm-6">
        <div class="form-group">
            <label class="control-label col-md-4"> Month</label>
            <div class="col-md-8">
                @Html.DropDownList("Months", null, new { @ID = "Month", @class = "form-control" })
            </div>
        </div>
    </div>
</div><br>


<div class="row">
    <div class="col-sm-6">
        <div class="form-group">
            <label class="control-label col-md-4">Promotion Type</label>
            <div class="col-sm-8">               
                @Html.DropDownList("PromotionTypeId1", new SelectList(Model.PromotionTypeList, "Value", "Text"), new { @class = "form-control" })               
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            <label class="control-label col-md-4"> Designation  </label>
            <div class="col-sm-8">
                @Html.DropDownList("DesignationList", null, new { @ID = "Designation", @class = "form-control" })
            </div>
        </div>
    </div>
</div><br>

<div class="row">
    <div class="col-sm-6">
        <div class="form-group">
            &nbsp;
            <div class="col-md-8">
                <input type="button" id="btnSearch" value="Search" class="btn btn-primary" onclick="SearchEligibleEmployees();" />
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        &nbsp;
    </div>
    &nbsp;
    <div id="grid">
    </div>
</div>


<div id="PromotionNavDiv" title="Promotion information" style="width:70%">
    <input type="button" value="Close" id="btnPromotionCancel" class="btn btn-facebook  b-close" />
    <div>
        @Html.Partial("~/Views/Shared/_PromotionNevigationPane.cshtml", proOfficeNevigation)
    </div>
</div>

<!-- Popup Promotion Rejection Entry -->
<div id="PromotionRejectionDiv" title="Promotion Rejection" style="width:70%">
    <input type="button" value="Close" id="btnPromotionRejectionCancel" class="btn btn-facebook  b-close" />

    <div class="row">

        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-md-3">(Old) Next Review Date </label>
                <div class="col-sm-6">
                    <input type="text" id="NRDM" class="form-control" disabled="disabled" />
                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-md-3 required">(New) Next Review Date </label>
                <div class="col-sm-6">
                    <input type="text" id="txtNextPromotionReviewDate" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-md-3 required"> Remarks </label>
                <div class="col-sm-6">
                    <textarea id="txtRemarks" class="form-control"></textarea>                   
                </div>
            </div>
        </div>
        <input type="text" id="pid" value="" style="display:none;" />
    </div>


    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    &nbsp;
                    <input type="button" value="Save" id="btnPromotionRejectionSave" class="btn btn-success" />
                </div>
            </div>
        </div>
    </div>

</div>

<!-- End Of Profession Entry Div -->

@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")

    <script src="~/Assets/js/app/employeePromotion/eligiblePromotionManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()@DateTime.Now"></script>
}
