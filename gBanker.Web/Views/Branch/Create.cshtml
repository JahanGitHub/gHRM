@model gHRM.Web.ViewModels.BranchViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var companyList = Model == null ? null : Model.CompanyList;
}
<script type="text/javascript">
    $(document).ready(function () {
    
        $("#btnBranchSave").click(function (e) {
            if ($("#CompanyId").val() == '0' && $("#BranchAddress").val() == '' && $("#BranchName").val() == '') {
                $("#CompanyId").addClass("errorClass");
                $("#BranchAddress").addClass("errorClass");
                $("#BranchName").addClass("errorClass");
               
                return false;
            }
            else if ($("#CompanyId").val() == '0' && $("#BranchAddress").val() == '' && $("#BranchName").val() != '') {
                $("#CompanyId").addClass("errorClass");
                $("#BranchAddress").addClass("errorClass");
                
                return false;
            }
            else if ($("#CompanyId").val() == '0' && $("#BranchAddress").val() != '' && $("#BranchName").val() == '') {
                $("#CompanyId").addClass("errorClass");
                $("#BranchName").addClass("errorClass");
               
                return false;
            }
            else if ($("#CompanyId").val() != '0' && $("#BranchAddress").val() == '' && $("#BranchName").val() == '') {
                $("#BranchAddress").addClass("errorClass");
                $("#BranchName").addClass("errorClass");
                return false;
            }
            else if ($("#CompanyId").val() == '0' && $("#BranchAddress").val() != '' && $("#BranchName").val() != '') {
                $("#CompanyId").addClass("errorClass");
                if ($("#BranchAddress").val() == '') {
                    $("#BranchAddress").addClass("errorClass");
                    
                }
                return false;
            }
            else if ($("#CompanyId").val() != '0' && $("#BranchAddress").val() != '' && $("#BranchName").val() == '') {
                $("#BranchName").addClass("errorClass");
                return false;
            }
            else if ($("#CompanyId").val() == '0' && $("#BranchAddress").val() != '' && $("#BranchName").val() != '') {
                $("#BranchAddress").addClass("errorClass");
                $("#BranchName").addClass("errorClass");
              
                return false;
            }
            else return true;
        });
    });

</script>
@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Add Branch</h2>
@using (Html.BeginForm("Create", "Branch", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "BranchProfile" }))
{
    @Html.AntiForgeryToken()
    <div class="container-fluid">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <div class="col-sm-8">
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.CompanyId, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.CompanyId, companyList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.CompanyId, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.BranchName, new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.BranchName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Branch Name" } })
                        @*@Html.ValidationMessageFor(model => model.BranchName, "", new { @class = "text-danger" })*@
                    </div>
                </div>          
            </div>       
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.BranchPhone, new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.BranchPhone, new { htmlAttributes = new { @class = "form-control", @placeholder = "Branch Phone" } })
                        @*@Html.ValidationMessageFor(model => model.district_code, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.BranchAddress, new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.BranchAddress, new { htmlAttributes = new { @class = "form-control", @placeholder = "Branch Address" } })
                        @*@Html.ValidationMessageFor(model => model.district_code, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
            </div>
        <div class="row">          
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.BranchEmail, new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.BranchEmail, new { htmlAttributes = new { @class = "form-control", @placeholder = "Branch Email" } })
                        @*@Html.ValidationMessageFor(model => model.district_code, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
        </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        <input type="submit" value="Save" id="btnBranchSave" class="btn btn-primary" />
                        <input type="hidden" value="" id="btnBranchSave" />
                        <input type="hidden" value="" id="btnBranchSave" />
                    </div>
                </div>
            </div>
        </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
