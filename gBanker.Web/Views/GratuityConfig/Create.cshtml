@{
    ViewBag.Title = "Gratuity Configuration";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Gratuity Configuration</h2>&nbsp;
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Eligible Employee Type</label>
                <div class="col-sm-7">
                    @Html.DropDownList("EmployeeStatus", (List<SelectListItem>)ViewBag.EmployeeStatusList, "Please Select", new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Effective Date</label>
                <div class="col-sm-7">
                    <input id="EffectiveStartDate" class="form-control" type="text" />
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Service Age From (Year)</label>
                <div class="col-sm-7">
                    <select class="form-control" id="ServiceAgeFrom">
                        <option value="">Please Select</option>
                        @for (int i = 1; i < 101; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Service Age To (Year)</label>
                <div class="col-sm-7">
                    <select class="form-control" id="ServiceAgeTo">
                        <option value="">Please Select</option>
                        @for (int i = 1; i < 101; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Gratuity Basic</label>
                <div class="col-sm-7">
                    <input id="GratuityTimes" type="text" class="form-control number-value" />
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Eligible From</label>
                <div class="col-sm-7">
                    <select id="EligibleFrom" class="form-control">
                        <option value="">Please Select</option>
                        <option value="C">Confirmation Date</option>
                        <option value="J">Joining Date</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <div class="page-title"></div>&nbsp;
    <div class="row">
        @Html.AntiForgeryToken()
        <div class="col-sm-12">
            <input type="button" value="Save" id="btnSave" class="btn btn-success" onclick="Page.Save()" />
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("/Assets/js/app/gratuity/gratuity-config-create.js?v=" + @gHRM.Core.Utilities.CommonHelper.DEV_VERSION())
}
