@model gHRM.Web.ViewModels.EmployeeInformationApprovalViewModel
@{
    ViewBag.Title = "Employee Information Approval";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script>
    $(document).ready(function () {
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        GetApprovalAuthorityInfo();

        $("#EmployeeCode").blur(function () {
            debugger;
            var empCode = $("#EmployeeCode").val();
            if (empCode != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetEmpInfoByCode", "EmployeeCommonInformation", "http")',
                    data: { employee_code: empCode },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            $("#DepartmentName").val(data[0].DepartmentName);
                            $("#DesignationName").val(data[0].DesignationName);
                            $("#EmployeeName").val(data[0].EmployeeName);
                        } else {
                            $("#DepartmentName").val('');
                            $("#DesignationName").val('');
                            $("#EmployeeName").val('');
                        }
                    },
                });
            }
        });


    });

    function SaveAuthority() {
        var empCode = $("#EmployeeCode").val();
        var department = $("#DepartmentName").val();
        var designation = $("#DesignationName").val();
        var empName = $("#EmployeeName").val();

        if (empCode != "" && department != "" && designation != "" && empName !="") {
            var obj= {
                EmployeeCode: empCode,
                DepartmentName: department,
                DesignationName: designation,
                EmployeeName: empName
            }
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("SaveApprovalAuthoriy", "EmployeeInfoApproveAuthority", "http")',
                data: JSON.stringify({ obj: obj }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        $.alert.open("Success", data.message);
                        GetApprovalAuthorityInfo();
                        Clearform();
                    } else {
                        $.alert.open("Error", data.message);
                    }
                },
            });
        }
    }

    function Clearform() {
        $("#EmployeeCode").val('');
        $("#DepartmentName").val('');
        $("#DesignationName").val('');
        $("#EmployeeName").val('');
    }



    function GetApprovalAuthorityInfo() {
       $('#grid').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            actions: {
                listAction: function (postData, jtParams) {
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/EmployeeInfoApproveAuthority/GetApprovalAuthorityInfo?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                EmployeeId: {
                    title: 'Employee Id',
                    width: '15%'
                },
                EmployeeCode: {
                    title: 'Employee Code',
                    width: '15%'
                },
                Delete: {
                    title: "Delete",
                    width: '10%',
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="DeleteGrid(' + data.record.Id + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#grid').jtable('load');
    }


    function DeleteGrid(id) {
        debugger;
       $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteApprovalAuthoriy", "EmployeeInfoApproveAuthority", "http")',
                    data: { Id: id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            GetApprovalAuthorityInfo();
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }





</script>

<h2 class="page-title">Employee Information Approval Authority</h2> <br />
@using (Html.BeginForm("EmployeeInfoApproveAuthority", "EmployeeInfoApproveAuthorityController", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", @id = "Create" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    <div id="AjaxLoader" class="ajaxLoader"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Employee Code</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4"> Department</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.DepartmentName, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Designation Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.DesignationName, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="control-label col-sm-4"> Employee Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-10 col-md-offset-2">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveAuthority()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateAuthority()" /> &nbsp;
                    <input type="button" value="Reset" id="btnReset" class="btn btn-primary" onclick="ResetAuthority()" />
                </div>
            </div>
        </div>
    </div>
        <div class="row">
            <div id="grid"></div>
        </div>
}

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}





