                        <div id="imgNominee">

                        </div>
                        <div id="blaImage">
                            <img id="thumbnil" style="width:100px; height:100px;" src="~/Images/blank-headshot.jpg" alt="Employee Image" class="img-responsive" />
                        </div>
                        @Html.TextBoxFor(model => model.ImgFile_NomineeImage, new { type = "file", @id = "NomineeImage", @onchange = "showNomineeImage(this);", @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <div class="col-sm-8">
                        <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveEmployeeNomineeInformations()" />
                        <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="SaveEmployeeNomineeInformations()" />
                        <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetNominee()" />
                    </div>
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset id="fldNomineeList">
        <legend>Nominee List</legend>
        <div class="row">
            <div class="col-md-12">
                <div id="gridNominee"></div>
            </div>
        </div>
    </fieldset>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/alert")
}