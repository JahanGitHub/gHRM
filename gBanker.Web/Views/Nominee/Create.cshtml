@model gHRM.Web.ViewModels.NomineeViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Nominee/Create">Nominee</a></li>
        <li class="active"><span>Create</span></li>
    </ol>
</div>
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var nominee_type = Model == null ? null : Model.NomineeTypeList;
    var relationship_type = Model == null ? null : Model.RelationshipList;
}
<style type="text/css">
    #multiSection {
        width: 40px;
    }

    table.jambo_table thead {
        background: rgba(52, 73, 94, 0.94);
        color: #ECF0F1;
    }

    <a href="~/Views/Nominee/Create.cshtml" > ~ /Views/Nominee/Create.cshtml</a > .table > thead > tr > th, .table > tbody > tr > th, .table > tfoot > tr > th, .table > thead > tr > td, .table > tbody > tr > td, .table > tfoot > tr > td {
