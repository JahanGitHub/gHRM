@{
    ViewBag.Title = "Manual Overtime Configuration";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    string SaveBtnText = ViewBag.EmployeeStatusId > 0 ? "Update" : "Save";
}

@Html.ActionLink("Back to List", "ManualConfig", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Manual Overtime Configuration</h2>
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div style="margin-top: 10px;"></div>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group page-radio-container">
                <div class="col-sm-7 col-sm-offset-4">
                    <label><input name="ConfigType" type="radio" value="PayrollDesignation" checked /><span>Payroll Designation</span></label>
                    <label><input name="ConfigType" type="radio" value="EmployeeCode" /><span>Employee Code</span></label>
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group employee-code-control" style="display: none;">
        <div class="col-sm-6">
            <label class="control-label col-sm-4 required" style="text-align: left;">Employee Code (কর্মকর্তা/কর্মচারী পরিচিতি নং)</label>
            <div class="col-sm-8">
                <input id="EmployeeCode" type="text" class="form-control" placeholder="Employee Code" />
            </div>
        </div>
        <div class="col-sm-6">
            <label class="control-label col-md-4" for="EmployeeName" style="text-align: left;">Name(নাম)</label>
            <div class="col-sm-8">
                <input class="form-control text-box single-line" id="EmployeeName" name="EmployeeName" readonly="true" type="text" value="" />
            </div>
        </div>
    </div>
    <div class="row form-group employee-code-control" style="display: none;">
        <div class="col-sm-6">
            <label class="control-label col-md-4" for="OfficeName" style="text-align: left;">Office(অফিস)</label>
            <div class="col-sm-8">
                <input class="form-control text-box single-line" id="OfficeName" name="OfficeName" readonly="true" type="text" value="" />
            </div>
        </div>
        <div class="col-sm-6">
            <label class="control-label col-md-4" for="DepartmentName" style="text-align: left;">Department(বিভাগ)</label>
            <div class="col-sm-8">
                <input class="form-control text-box single-line" id="DepartmentName" name="DepartmentName" readonly="true" type="text" value="" />
            </div>
        </div>
    </div>
    <div class="row form-group employee-code-control" style="display: none;">
        <div class="col-sm-6">
            <label class="control-label col-md-4" for="DesignationName" style="text-align: left;">Payroll Designation (পদবী)</label>
            <div class="col-sm-8">
                <input class="form-control text-box single-line" id="DesignationName" name="DesignationName" readonly="true" type="text" value="" />
            </div>
        </div>
        <div class="col-sm-6">
            <label class="control-label col-md-4" for="OffcDesignName" style="text-align: left;">Responsibility (অফিস পদবী)</label>
            <div class="col-sm-8">
                <input class="form-control text-box single-line" id="OffcDesignName" name="OffcDesignName" readonly="true" type="text" value="" />
            </div>
        </div>
    </div>

    <div class="row form-group">
        <div class="col-sm-6">
            <label class="control-label col-sm-4 payroll-designation-control required" style="text-align: left;">Payroll Designation (পদবী)</label>
            <div class="col-sm-8 payroll-designation-control">
                @Html.DropDownList("PayrollDesignationId", (List<SelectListItem>)ViewBag.PayrollDesignationList, null, new { @class = "form-control" })
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6">
            <label class="control-label col-sm-4 required" style="text-align: left;">Working Day Max (Hour) (কর্ম দিবস সর্বোচ্চ (ঘণ্টা))</label>
            <div class="col-sm-8">
                <input id="WorkingDayMax" type="text" class="form-control number-value" placeholder="Working Day Max" />
            </div>
        </div>
        <div class="col-sm-6">
            <label class="control-label col-sm-4 required" style="text-align: left;">Holiday Max (Hour) (ছুটির দিন সর্বোচ্চ (ঘণ্টা))</label>
            <div class="col-sm-8">
                <input id="HolidayMax" type="text" class="form-control number-value" placeholder="Holiday Max" />
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6">
            <label class="control-label col-sm-4 required" style="text-align: left;">Monthly Max (Hour) (মাসিক সর্বোচ্চ (ঘণ্টা))</label>
            <div class="col-sm-8">
                <input id="MonthlyMax" type="text" class="form-control number-value" placeholder="Monthly Max" />
            </div>
        </div>
        <div class="col-sm-6">
            <label class="control-label col-sm-4 required" style="text-align: left;">Allow Time Keeping Exception Only (শুধুমাত্র ব্যতিক্রমের সময় রাখার অনুমতি দিন)</label>
            <div class="col-sm-8">
                <label><input name="ManualOvertimeOnly" type="radio" value="y" />&nbsp;&nbsp; Yes</label>
                <label style="margin-left: 10px;"><input name="ManualOvertimeOnly" type="radio" value="n" checked />&nbsp;&nbsp; No</label>
            </div>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-sm-6">
            <label class="control-label col-sm-4 required" style="text-align: left;">Effective Start Date (কার্যকরী শুরুর তারিখ)</label>
            <div class="col-sm-8">
                <input id="EffectiveStartDate" type="text" class="form-control" placeholder="Effective Start Date" />
            </div>
        </div>
    </div>
    <div class="row form-group" style="padding-top: 10px;">
        <div class="col-sm-12" style="margin-left: 10px;">
            @Html.AntiForgeryToken()
            <input type="button" value="@SaveBtnText" id="btnSave" class="btn btn-success" onclick="Page.Save()" />
        </div>
    </div>
</div>

@section styles {
    @Styles.Render("/Content/Gratuity/gratuity-config.css?v=" + @gHRM.Core.Utilities.CommonHelper.DEV_VERSION())
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("/Assets/js/app/time-kepping/overtime-manual-config-create.js?v=" + @gHRM.Core.Utilities.CommonHelper.DEV_VERSION())
}
