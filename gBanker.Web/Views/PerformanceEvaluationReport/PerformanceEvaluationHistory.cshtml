@model gHRM.Web.ViewModels.PerformanceEvaluationViewModel
@{
    ViewBag.Title = "PerformanceEvaluationHistory";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var pvOfficeNevigation = new gHRM.Web.ViewModels.OfficeNevigationPartialViewModel();
    pvOfficeNevigation.OfficeTypeList = Model.OfficeTypeList;
    pvOfficeNevigation.ZoneList = Model.ZoneList;
    pvOfficeNevigation.AreaList = Model.AreaList;
    pvOfficeNevigation.UnitList = Model.UnitList;
}

<h2>Performance Evaluation History Report</h2>
<br />
@Html.Partial("~/Views/Shared/_OfficeNevigationPaneForPE.cshtml", pvOfficeNevigation)
<br />
<div class="row">
    <div class="col-sm-6">
        <div class="form-group">
            @Html.LabelFor(model => model.DateFrom, htmlAttributes: new { @class = "control-label col-md-4 required" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.DateFrom, new { @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group">
            @Html.LabelFor(model => model.DateTo, htmlAttributes: new { @class = "control-label col-md-4 required" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.DateTo, new { @class = "form-control", @autocomplete = "off" })
            </div>
        </div>
    </div>
</div>
<br />
<div class="row">
    <div class="col-sm-6">
        <div class="form-group">
            @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-8">
                @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control" })
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-6">
        <div class="form-group">
            <label class="control-label col-md-4"></label>
            <div class="col-md-8">
                <div class="checkbox">
                    <label>@Html.CheckBoxFor(model => model.Ledger, new { @checked = "false" })Ledger (Individual performance)</label>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                <input type="button" id="btnPrint" value="View" class="btn btn-primary" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Assets/js/app/performanceEvaluation/PerformanceEvaluationHistoryReport.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}