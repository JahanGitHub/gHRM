@model gHRM.Web.ViewModels.eRecruits.ApplicationConfirmationViewModel

@{
    ViewBag.Title = "Confirmation";
    Layout = "~/Views/Shared/_AdminLTE_Recruitment.cshtml";
}

<div class="container-fluid">

    <div class="row">
        <center> <img src="~/Content/Images/Grameen-Bank.png" /> </center>
    </div>
    <div class="row">
        <div class="col-sm-2"><h3 class="page-title"></h3></div>
        <div class="col-sm-7 "> &nbsp; </div>
        <div class="col-sm-3"><h5 class="page-title pull-right">Batch No: GBORC: 2020-01</h5></div>
    </div>
</div>
<div class="jumbotron" style="padding: 20px">
    <div class="text-center">
        <h2><i class="fa fa-check-circle"></i> Congratulations! Mr/Mrs. @Model.ApplicantName</h2>
        <p class="lead">Your Application Submission Completed Successfully!</p>
    </div>
    <div class="row">
        <div class="col-md-2 col-sm-2">

        </div>
        <div class="col-md-8 col-sm-8">
            <div class="row">
                Applicant Summary
                <hr />
            </div>

            <div class="row">
                <div class="row">
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label>Application Serial No : </label> @Model.ApplicantId
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label>Application Name : </label> Mr/Mrs. @Model.ApplicantName
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label>Father Name : </label> @Model.FatherName
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label>Mother Name : </label> @Model.MotherName
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label>MobileNo : </label> @Model.MobileNo
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-6">
                        <div class="form-group">
                            <label>Email : </label> @Model.Email
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-2">

        </div>

    </div>

    @*<button type="button" class="btn btn-sm btn-success" data-toggle="modal" data-target="#applicationPreviewModal">
        <i class="fa fa-info-circle"></i> Preview
    </button>*@
    @*<p><a class="btn btn-success" href="/ApplicationInfo/ApplicationInfoReportById?ApplicationId=@Model.ApplicantId"> <i class="fa fa-print"></i> Print Application</a></p>*@
</div>
@Html.Partial("_ConfirmationPreviewInfoPartial", Model)