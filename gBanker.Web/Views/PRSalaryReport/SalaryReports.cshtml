
@model gHRM.Web.ViewModels.Payroll.PRWorkAreaViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/PRSalaryReport">SalaryReport</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Payroll Process";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<script type="text/javascript">

    function PrintOfficeTypeWiseSalaryReportAfterApproval(year, month, officeTypeId,bank) {
        url = '/PRSalaryReport/PrintOfficeTypeWiseSalaryReportAfterApproval?OfficeTypeId=' + officeTypeId + '&Year=' + year + '&Month=' + month + '&BankCode=' + bank;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    $(document).ready(function () {
        $("#BankList").hide();
     
        $("#ReportType").change(function () {
            var reportType = $("#ReportType").val();
            if (reportType!="") {
                if (reportType=="SBS") {
                    $("#BankCode").val("");
                    $("#BankList").show();
                } else {
                    $("#BankCode").val("");
                    $("#BankList").hide();
                }
            } else {
                $("#BankCode").val("");
                $("#BankList").hide();
            }
        });
        $("#btnExcel").click(function () {
            var reportType = $("#ReportType").val();
            var officeTypeId = $("#OfficeTypeId").val();
            if (officeTypeId == "") {
                officeTypeId = 0;
            }
            var year = $("#Year").val();
            var month = $("#Month").val();
           // var date = $("#ProcessDate").val();

            if (reportType != "") {
                if (reportType == "SBS" && officeTypeId != "" && year!="" && month!=""  ) {
                    var bank = $("#BankCode").val();
                    if (bank!="") {
                        PrintOfficeTypeWiseSalaryReportAfterApproval(year, month, officeTypeId,bank)
                    } else {
                        $.alert.open("Error", "Please Select Bank");
                    }
                } else if (reportType == "SR") {
                    if (officeTypeId != "" && year != "" && month != "" ) {

                    }
                }
            } else {
                $.alert.open("Error", "Please Select Report Type");
            }
        });
        $("#btnPrint").click(function () {

        });

    });// End Document Rready
</script>

<h2 class="page-title">Salary Reports</h2>
&nbsp;

@using (Html.BeginForm())
{
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container-fluid">
            <div id="AjaxLoader" class="ajaxLoader"></div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Report Type</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.ReportType, Model.ReportList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6" id="BankList">
                    <div class="form-group">
                        <label class="control-label col-md-4">Bank Name</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.BankCode, Model.BankList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Office Type</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(model => model.OfficeTypeId, Model.OfficeTypeList, new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4"> Year</label>
                        <div class="col-md-8">
                            @Html.DropDownList("Years", null, new { @ID = "Year", @class = "form-control" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4"> Month</label>
                        <div class="col-md-8">
                            @Html.DropDownList("Months", null, new { @ID = "Month", @class = "form-control" })
                        </div>
                    </div>
                </div>
                @*<div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Date</label>
                        <div class="col-sm-8">
                            <input type="text" id="ProcessDate" class="form-control" />
                        </div>
                    </div>
                </div>*@
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="form-group form-action" style="padding-top:10px;margin:5px;">
                            <input type="button" value="Generate EXCEL" id="btnExcel" class="btn btn-success" />
                            &nbsp;&nbsp;&nbsp;
                            <input type="button" value="Print" id="btnPrint" class="btn btn-success" />

                        </div>
                    </div>
                </div>
            </div> <!--New Div-->






      

    </div> <!--Main Container Fluid-->


    </div> <!--Form Horizontal-->
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


