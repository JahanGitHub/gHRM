      function GetChangedOffice() {
        var office_id = GetWorkingOffice();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SelectOffice", "EmployeeProfileReport", "http")',
            data: { officeId: office_id },
            dataType: 'json',
            async: false,
            success: function (data) {
                $("#OfficeName").val(data.OfficeName);
                //location.reload();
            }
        });
        return true;
    }
    function GetWorkingOffice() {
        if ($("#ddlHO").val() > 0) {
            var office_id;
            if ($("#ddlZone").val() > 0) {
                if ($("#ddlArea").val() > 0) {
                    if ($("#ddlOffice").val() > 0) {
                        office_id = $("#ddlOffice").val();
                    }
                    else {
                        office_id = $("#ddlArea").val();
                    }
                }
                else {
                    office_id = $("#ddlZone").val();
                }
            }
            else {
                office_id = $("#ddlHO").val();
            }
        }
        return office_id;
    }



