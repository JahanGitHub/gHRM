                    @Html.ValidationMessageFor(model => model.LoanDisburse, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LoanRepaid, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.LoanRepaid, new { htmlAttributes = new { @class = "form-control validateText validateLength" } })
                    @Html.ValidationMessageFor(model => model.LoanRepaid, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.LoanOutstanding, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.LoanOutstanding, new { htmlAttributes = new { @class = "form-control validateText" } })
                    @Html.ValidationMessageFor(model => model.LoanOutstanding, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label class="control-label col-sm-2"> </label>
                <div class="col-sm-10">
                    <b><u>Due Info</u></b>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CurrentDueNo, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CurrentDueNo, new { htmlAttributes = new { @class = "form-control validateLength" } })
                    @Html.ValidationMessageFor(model => model.CurrentDueNo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CurrentDue, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CurrentDue, new { htmlAttributes = new { @class = "form-control validateText validateLength" } })
                    @Html.ValidationMessageFor(model => model.CurrentDueNo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.OverDueNo, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.OverDueNo, new { htmlAttributes = new { @class = "form-control validateLength" } })
                    @Html.ValidationMessageFor(model => model.OverDueNo, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.OverDue, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.OverDue, new { htmlAttributes = new { @class = "form-control validateText validateLength" } })
                    @Html.ValidationMessageFor(model => model.OverDue, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <div class="form-group form-action" style="padding:10px;padding-left: 180px;margin:5px;">
                    &nbsp;
                    <button type="submit" class="btn btn-success">Save</button>
                    &nbsp;
                    <a class="btn btn-facebook" href="/performanceevaluation/listing">Back to List</a>
                </div>
            </div>
        </div>
    </div>
}
    </div>


    @section Scripts {
        <script src="~/Assets/js/app/performanceEvaluation/performanceEvaluationManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
        @*<script src="~/Scripts/jquery.validate.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
            <script src="~/Scripts/jquery.validate.unobtrusive.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
            <script type="text/javascript">
                $.validator.methods.number = function (value, element) {
