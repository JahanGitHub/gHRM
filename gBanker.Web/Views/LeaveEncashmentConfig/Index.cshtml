@model gHRM.Web.ViewModels.ELEncashmentConfigurationViewModel

<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/LeaveEncashmentConfig/ELEncashmentConfiguration">ELEncashmentConfiguration</a></li>
    </ol>
</div>



@{
    ViewBag.Title = "ELEncashmentConfiguration";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">
    var STAGE_DISABLED = @Html.Raw(@ViewBag.STAGE_DISABLED ? "true" : "false");

    var Page = {
        IsNumber: function (Value) {
            return ![null, ""].includes(Value) && !isNaN(Value);
        },
        IsValid: function () {
            var MinimumBalance = $("#MinimumBalance").val();
            MinimumBalance = Page.IsNumber(MinimumBalance) ? parseFloat(MinimumBalance) : 0;

            if (0 == MinimumBalance) {
                $.alert.open("Error", "Minimum Balance is required");
                return false;
            }
            else if (MinimumBalance < 0) {
                $.alert.open("Error", "Minimum Balance must be positive");
                return false;
            }
            else if (parseFloat(MinimumBalance) > parseInt(MinimumBalance)) {
                $.alert.open("Error", "Minimum Balance must be an integer");
                return false;
            }
            return true;
        }
    };

    //create
    function GenerateELEncashmentConfiguration() {
        var item = {};
        item.EncashmentStage = $("#EncashmentStage").val();
        item.EligibleFrom = $("#EligibleFrom").val();
        item.EligibilityDuration = $("#EligibilityDuration").val();
        item.MinimumBalance = $("#MinimumBalance").val();
        item.EncashmentEligibleQuantity = $("#EncashmentEligibleQuantity").val();
        item.EncashmentEligibleYears = $("#EncashmentEligibleYears").val();
        item.Formula = $("#Formula").val();
        return item;
    }

    function GenerateUpdateELEncashmentConfiguration() {
        var item = {};
        item.ConfigurationId = $("#ConfigurationId").val();
        item.EncashmentStage = $("#EncashmentStage").val();
        item.EligibleFrom = $("#EligibleFrom").val();
        item.EligibilityDuration = $("#EligibilityDuration").val();
        item.MinimumBalance = $("#MinimumBalance").val();
        item.EncashmentEligibleQuantity = $("#EncashmentEligibleQuantity").val();
        item.EncashmentEligibleYears = $("#EncashmentEligibleYears").val();
        item.Formula = $("#Formula").val();
        return item;
    }

    function ClearControl() {
        $("#EligibleFrom").val('');
        $("#EligibilityDuration").val('');
        $("#MinimumBalance").val('');
        $("#Formula").val('');

        if (!STAGE_DISABLED) {
            $("#EncashmentStage").val('');
            $("#EncashmentStage").removeAttr('disabled');
        }
    }

    function SaveELEncashmentConfiguration() {
        if (!Page.IsValid()) return false;
        var eLEncashmentConfiguration = GenerateELEncashmentConfiguration();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveELEncashmentConfiguration", "LeaveEncashmentConfig")',
            data: JSON.stringify({ eLEncashmentConfiguration: eLEncashmentConfiguration }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    $('#grid').jtable('load');
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }

    function UpdateELEncashmentConfiguration() {
        if (!Page.IsValid()) return false;

        var eLEncashmentConfiguration = GenerateUpdateELEncashmentConfiguration();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateELEncashmentConfiguration", "LeaveEncashmentConfig")',
            data: JSON.stringify({ eLEncashmentConfiguration: eLEncashmentConfiguration }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Update Successfull") {
                    ClearControl();
                    $('#grid').jtable('load');
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }
</script>


<h2 class="page-title">EL Encashment Configuration</h2>
@using (Html.BeginForm("SaveELEncashmentConfiguration", "LeaveEncashmentConfig", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br />
    <br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Encashment Stage</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.EncashmentStage, Model.EncashmentStageList, new { @class = "form-control", @disabled = "disabled" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Eligible From</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.EligibleFrom, Model.EligibleFromList, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Eligibility Duration (Year)</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.EligibilityDuration, Model.EligibilityDurationList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Minimum Balance</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.MinimumBalance, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Sellable Quantity</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EncashmentEligibleQuantity, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4">Formula</label>
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.Formula, Model.FormulaList, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveELEncashmentConfiguration()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateELEncashmentConfiguration()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetEASSManagment()" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
            @Html.HiddenFor(model => model.ConfigurationId)
        </div>
    </div>
}


<script type="text/javascript">

    // delete
    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteELEncashmentConfiguration", "LeaveEncashmentConfig", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $('#grid').jtable('load');
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    //edit using jtable

    function ResetEASSManagment() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }

    function EditTada(cid, ens, efr, ed, mb, Formula, EncashmentEligibleQuantity) {
        $("#ConfigurationId").val(cid);
        $("#EncashmentStage").val(ens);
        $("#EncashmentStage").attr('disabled','disabled');
        $("#EligibleFrom").val("null" == efr ? "" : efr);
        $("#EligibilityDuration").val(0 == ed ? "" : ed);
        $("#MinimumBalance").val(mb);
        $("#EncashmentEligibleQuantity").val(EncashmentEligibleQuantity);
        $("#Formula").val(Formula);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();

    }

    $(document).ready(function () {
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        var RowNumber = 0;
        $("#EncashmentStage").prop("disabled", STAGE_DISABLED);

        $('#grid').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            defaultSorting: 'InventoryId ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    //var eCode = $("#Ecode").val();
                    var RowNumber = 0;

                    return $.Deferred(function ($dfd) {

                        $.ajax({
                            url: '/LeaveEncashmentConfig/ListELEncashmentConfiguration?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,

                            type: 'POST',
                            dataType: 'json',
                            data: postData,

                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                //ConfigurationId: {
                //    title: 'ConfigurationId',
                //    width: '10%'
                //},
                EncashmentStage: {
                    title: 'EncashmentStage',
                    width: '50%',
                    display: function (data) {
                        return data.record.EncashmentStage;
                    }
                },
                EligibleFrom: {
                    title: 'EligibleFrom',
                    width: '50%',
                    display: function (data) {
                        if (data.record.EligibleFrom == "C") {
                            return "Confirmation Date"
                        } else if (data.record.EligibleFrom == "J") {
                            return "Joining Date"
                        }
                    }
                },
                EligibilityDuration: {
                    title: 'EligibilityDuration',
                    width: '10%'
                },
                MinimumBalance: {
                    title: 'MinimumBalance',
                    width: '15%'
                },
                EncashmentEligibleQuantity: {
                    title: 'SellableQuantity',
                    width: '15%'
                },
                EligibilityDuration: {
                    title: 'EligibleYears',
                    width: '15%'
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="EditTada(' + "'" + data.record.ConfigurationId + "'" + ',' + "'" + data.record.EncashmentStage + "'" + ',' + "'" + data.record.EligibleFrom + "'" + ',' + "'" + data.record.EligibilityDuration + "'" + ',' + "'" + data.record.MinimumBalance + "'" + ',' + "'" + data.record.Formula + "'" + ',' + "'" + data.record.EncashmentEligibleQuantity + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                Delete: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + data.record.ConfigurationId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#grid').jtable('load');
    });

</script>

<h2 class="page-title"> ELEncashment Configuration List</h2>
&nbsp;
<div id="grid"></div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}
