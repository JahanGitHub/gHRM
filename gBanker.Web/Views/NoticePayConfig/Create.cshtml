@{
    ViewBag.Title = "Notice Pay Configuration";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Notice Pay Configuration</h2>&nbsp;
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Notice Period</label>
                <div class="col-sm-7">
                    <select class="form-control" id="NoticePeriod">
                        <option value="0">Please Select</option>
                        <option value="30">30 Days</option>
                        <option value="60">60 Days</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Effective Date</label>
                <div class="col-sm-7">
                    <input id="EffectiveStartDate" class="form-control" type="text" />
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Calculation From</label>
                <div class="col-sm-7">
                    <select class="form-control" id="CalculationFrom">
                        <option value="">Please Select</option>
                        <option value="B">Basic Salary</option>
                        <option value="G">Gross Salary</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Salary Percentage</label>
                <div class="col-sm-7">
                    <input id="SalaryPer" type="text" class="form-control number-value" />
                </div>
            </div>
        </div>
    </div>
    <div class="page-title"></div>&nbsp;
    <div class="row">
        @Html.AntiForgeryToken()
        <div class="col-sm-12">
            <input type="button" value="Save" id="btnSave" class="btn btn-success" onclick="Page.Save()" />
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("/Assets/js/app/payroll/notice-pay-config-create.js?v=" + @gHRM.Core.Utilities.CommonHelper.DEV_VERSION()+System.DateTime.Now)
}
