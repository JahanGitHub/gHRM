@model gHRM.Web.ViewModels.EmployeeTimeKeepingExceptionViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeTimeKeepingException">EmployeeTimeKeepingException</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "EmployeeTimeKeepingException";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <script src="~/Scripts/wickedpicker.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    <link href="~/Content/wickedpicker.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<h2 class="page-title">Employee TimeKeeping Exception</h2>

@*@using (Html.BeginForm("SaveEmployeeTimeKeepingException", "EmployeeTimeKeepingException", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {*@
<div class="form-horizontal">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.EmployeeId)
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.DepartmentName, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.DepartmentId, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.OffcDesignName, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.OfficeDesignationId, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control", @readonly = "readonly" })
                </div>
            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.AttenTypeFullName, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.AttendenceTypeId, Model.AttendenceTypeNameList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Justification</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.Justification, new { @class = "form-control required" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Event Start Date</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EventStartDate, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Event End Date</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EventEndDate, new { @class = "form-control required" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Login Time</label>
                <div class="col-sm-2 col-sm-2p5">
                    @Html.EditorFor(model => model.LoginTime, new { htmlAttributes = new { @class = "form-control timepicker-editable" } })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Logout Time</label>
                <div class="col-sm-2 col-sm-2p5">
                    @Html.EditorFor(model => model.LogoutTime, new { htmlAttributes = new { @class = "form-control timepicker-editable" } })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Last Login Time</label>
                <div class="col-sm-2 col-sm-2p5">
                    @Html.EditorFor(model => model.LastLoginTime, new { htmlAttributes = new { @class = "form-control timepicker-editable" } })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveEmployeeTimeKeepingException()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateEmployeeTimeKeepingException()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetEASSManagment()" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            @Html.HiddenFor(model => model.Id)
        </div>
    </div>

</div>

<h2 class="page-title">Employee TimeKeeping Exception  List</h2>
&nbsp;

<div class="row">
    <div class="col-sm-12">
        &nbsp;
    </div>
</div>

<div id="grid"></div>


<div class="row">
    <div class="col-sm-12">
        &nbsp;
    </div>
</div>

@section Scripts {
    <script src="~/Assets/js/app/time-kepping/employeeTimeKeepingExceptionManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()@DateTime.Now"></script>
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}