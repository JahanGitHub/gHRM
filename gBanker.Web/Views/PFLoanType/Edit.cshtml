@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.ValidationSummary(true)

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.LoanTypeId, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.LoanTypeId, new { htmlAttributes = new { @class = "form-control", @tabindex = 1, disabled = "disabled" } })
                    @Html.HiddenFor(model => model.Id)
                </div>
                @Html.LabelFor(model => model.LoanTypeName, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.LoanTypeName, new { htmlAttributes = new { @class = "form-control" }, @tabindex = 2 })
                </div>
            </div>
        </div>
               
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.InterestRate, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.InterestRate, new { htmlAttributes = new { @class = "form-control" }, @tabindex = 3 })
                </div>
                @Html.LabelFor(model => model.LoanPercentage, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.EditorFor(model => model.LoanPercentage, new { htmlAttributes = new { @class = "form-control" }, @tabindex = 4 })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.InterestRateTypeList, htmlAttributes: new { @class = "control-label col-md-2 required" })
                <div class="col-md-3">
                    @Html.DropDownListFor(model => model.InterestRateTypeList, Model.InterestRateTypeList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <hr />
       
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-10">
                <div class="form-group" style="padding-left:7px;">
                    <input type="button" value="Update" id="btnUpdateLoanType" class="btn btn-success" />
                </div>
            </div>
        </div>
    </div>
}

