@model gHRM.Web.ViewModels.CompanyViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var companyList = Model == null ? null : Model.CompanyList;
    var countryList = Model == null ? null : Model.CountryList;
}

<h2 class="page-title">Manage Company</h2>
<br />

@using (Html.BeginForm("Manage", "Company", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "Edit" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.CompanyId)

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CountryId, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.CountryId, countryList, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyType, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.CompanyType, companyList, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyName, new { @class = "control-label  col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Company Name" } })
                    @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">

        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyAddress, new { @class = "control-label  col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.TextAreaFor(model => model.CompanyAddress, new { @class = "form-control", @placeholder = "Company Address" })
                    @Html.ValidationMessageFor(model => model.CompanyAddress, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyMobile, new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CompanyMobile, new { htmlAttributes = new { @class = "form-control", @placeholder = "Company Mobile" } })
                    @Html.ValidationMessageFor(model => model.CompanyMobile, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyEmail, new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CompanyEmail, new { htmlAttributes = new { @class = "form-control", @placeholder = "Company Email" } })
                    @Html.ValidationMessageFor(model => model.CompanyEmail, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyPhone, new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CompanyPhone, new { htmlAttributes = new { @class = "form-control", @placeholder = "Company Phone" } })
                    @Html.ValidationMessageFor(model => model.CompanyPhone, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanySlogan, new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.CompanySlogan, new { htmlAttributes = new { @class = "form-control", @placeholder = "Company Slogan" } })
                    @Html.ValidationMessageFor(model => model.CompanySlogan, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.WebsiteURL, new { @class = "control-label col-md-4" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.WebsiteURL, new { htmlAttributes = new { @class = "form-control", @placeholder = "Website URL" } })
                    @Html.ValidationMessageFor(model => model.WebsiteURL, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanyImage, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    <p><strong>Note:</strong> Please try upload image .jpg format within KB size. </p>
                    <img id="thumbnil" style="width:100px; height:100px;" src="@Model.ImagePreviewPath" alt="Company Image" class="img-responsive ImagePreviewPath" />
                    <input type="file" id="ImgFile" class="file" name="ImgFile" onchange="showMyImage(this,'thumbnil','ImgFile');" />
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.CompanySignaturePath, htmlAttributes: new { @class = "control-label col-sm-4" })
                <div class="col-sm-8">
                    <p><strong>Note:</strong> Please try upload image .jpg format within KB size. </p>
                    <img id="thumbnil2" style="width:100px; height:100px;" src="@Model.CompanySignaturePreviewPath" alt="Company Signature" class="img-responsive CompanySignaturePreviewPath" />
                    <input type="file" id="CopanySignatureFile" class="file" name="CopanySignatureFile" onchange="showMyImage(this,'thumbnil2','CopanySignatureFile');" />
                </div>
            </div>
        </div>        
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                <input type="submit" value="Save" id="btnCompanySave" class="btn btn-primary" />
                <input type="hidden" value="" id="hdnCompanySave" />
                <input type="hidden" value="" id="hdnCompanyId" />
            </div>
        </div>
    </div>
</div>
}

@section scripts {   
    <script src="~/Assets/js/app/company/companyManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}