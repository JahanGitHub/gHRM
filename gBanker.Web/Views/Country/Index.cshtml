@model IEnumerable<gHRM.Web.ViewModels.CountryViewModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<script type="text/javascript">
    function deleteConfirm(status) {
        if (status == "true") {
            return confirm('Are you sure you want to delete this record');
        }
        else {
            alert("You cannot delete this record because it is already disabled.");
            return false;
        }
    }


    $(document).ready(function () {
        $('#grid').jtable({
           // title: 'Investor List',
            paging: true,
            pageSize: 10,
            sorting: true,
            defaultSorting: 'Name ASC',
            actions: {

                listAction: '/Country/GetCountries'

            },
            fields: {
                CountryId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                CountryShortCode: {
                    title: 'Country Code',
                    width: '20%'
                },
                CountryName: {
                    title: 'Country Name',
                    width: '40%'
                },

                Status: {
                    title: 'IsActive',
                    width: '20%',
                    list: false
                },                
                //DeleteLink: {
                //    title: "Delete",
                //    display: function (data) {
                //        return '<div class="text-center delete-link"><a href="/Country/Delete/' + data.record.CountryId + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + "'><i class='fa fa-trash-o'></i></a></div>";

                //       //return '<a href="/Investor/Delete/' + data.record.InvestorID + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '>Delete</a>';
                //    }
                //}
            }
        });
        $('#grid').jtable('load');


    });

</script>

@Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Country List</h2>

<div class="row">
    <div class="col-md-12">
        &nbsp;
    </div>
    &nbsp;
    <div id="grid"></div>
</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}
