@model gHRM.Web.ViewModels.AspNetRoleViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })

<h2 class="page-title">User Role (ইউজার রোল)</h2>

<div class="container-fluid">
    @using (Html.BeginForm("UserRoleCreate", "Security", FormMethod.Post, new { @class = "form-horizontal", id = "user-role-submit-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <br />
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>
        if (SessionHelper.EnabledSSOLogin)
        {
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Associated With", new { @class = "control-label col-md-4 required" })
                        <div class="col-sm-8">
                            <div class="form-check form-check-inline">
                                <input checked="checked" class="form-check-input" type="checkbox" name="AppClientIDs" id="@AuthServerClientConstants.HR_APP" value="@AuthServerClientConstants.HR_APP">
                                <label class="form-check-label" for="@AuthServerClientConstants.HR_APP">@AuthServerClientConstants.GetText(AuthServerClientConstants.HR_APP) </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="AppClientIDs" id="@AuthServerClientConstants.HEALTH_APP" value="@AuthServerClientConstants.HEALTH_APP">
                                <label class="form-check-label" for="@AuthServerClientConstants.HEALTH_APP">@AuthServerClientConstants.GetText(AuthServerClientConstants.HEALTH_APP)</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="AppClientIDs" id="@AuthServerClientConstants.ACCOUNTING_APP" value="@AuthServerClientConstants.ACCOUNTING_APP">
                                <label class="form-check-label" for="@AuthServerClientConstants.ACCOUNTING_APP">@AuthServerClientConstants.GetText(AuthServerClientConstants.ACCOUNTING_APP)</label>
                            </div>
                        </div>
                    </div>
                   
                </div>
            </div>
        }
        <div class="row">
            <div class="col-sm-2">
       
            </div>
            <div class="col-sm-6">
                <button type="submit" id="btnRoleSave" class="btn btn-primary">Save</button>
            </div>
        </div>
    }

    <br />
    <div class="box-content">
        <div class="table-responsive">
            <div id="gridKendo"></div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Assets/js/app/security/userRoleManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}