                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Approve(' + data.record.SalaryIncentiveId + ')"><i class="fa fa-check"></i></a></div>';
                    }
                }
            }
        });
        reloadGrid();

        $("#filterColumn").change(function () {
            if ($(this).val() === "ViewAll") {
                $("#filterValue").val('');
            }
        });

    }
    function reloadGrid() {
        $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });//,

