@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script>
    function Approve(SalaryIncentiveId) {
        if (SalaryIncentiveId != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("ApproveSalaryAllowance", "PRSalaryAllowance", "http")',
                data: { SalaryIncentiveId: SalaryIncentiveId },
                dataType: 'json',
                async: false,
                cache: false,
                success: function (data) {
                    $.alert.open(data);
                    reloadGrid();
                },
                error: function (request, status, error) {
                    alert(request.statusText + "/" + request.statusText + "/" + error);
                }
            });
        }
    }
    function ApproveAllIncentive() {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("ApproveAllIncentive", "PRSalaryAllowance", "http")',
            data: {},
            dataType: 'json',
            async: false,
            cache: false,
            success: function (data) {
                $.alert.open(data);
                reloadGrid();
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
