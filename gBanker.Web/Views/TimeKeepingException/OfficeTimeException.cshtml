@model gHRM.Web.ViewModels.EmployeeOfficeTimeExceptionViewModel
<div class="row">
    OfficeTimeException
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeTimeKeepingException">Employee Timekeeping Exception</a></li>
        <li><a href="/EmployeeTimeKeepingException/OfficeTimeException">Office Time Exception</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Office Time Exception";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var pvOfficeNevigation = new gHRM.Web.ViewModels.OfficeNevigationPartialViewModel();
    pvOfficeNevigation.OfficeTypeList = Model.OfficeTypeList;
    pvOfficeNevigation.ZoneList = Model.ZoneList;
    pvOfficeNevigation.AreaList = Model.AreaList;
    pvOfficeNevigation.UnitList = Model.UnitList;
}
<style>
    .jtable > thead > tr {
        height: 50px;
    }

    .modal-backdrop {
        z-index: 900;
    }

    .vertical-alignment-helper {
        display: table;
        height: 100%;
        width: 100%;
        pointer-events: none; /* This makes sure that we can still click outside of the modal to close it */
    }

    .vertical-align-center {
        /* To center vertically */
        display: table-cell;
        vertical-align: middle;
        pointer-events: none;
    }

    .modal-content {
        /* Bootstrap sets the size of the modal in the modal-dialog class, we need to inherit it */
        width: inherit;
        max-width: inherit; /* For Bootstrap 4 - to avoid the modal window stretching full width */
        height: inherit;
        /* To center horizontally */
        margin: 0 auto;
        pointer-events: all;
    }

    .modal-header {
        background: #008d4c;
        color: #fff;
        font-weight: bold;
    }

    .modal-header {
        color: #fff;
    }
</style>

<script src="~/Scripts/wickedpicker.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<link href="~/Content/wickedpicker.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />


<script type="text/javascript">
    function GridLoad() {
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("ListOfficeTimeException", "TimeKeepingException", "http")',
                    dataType: 'json'
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            //height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "Id",
                     hidden: true,
                     filterable: false
                 },
                 {
                     field: "OfficeTypeName",
                     title: "Office Type",
                     width: "110px",
                     filterable: true
                 },
                 {
                     width: "80px",
                     field: "OfficeName",
                     filterable: true,
                     title: "Office",
                     //locked: true
                 },
                 {
                     width: "95px",
                     field: "LIT",
                     filterable: true,
                     title: "LogIn Time",
                     //locked: true
                 },
                 {
                     width: "120px",
                     field: "LLT",
                     title: "Last LogIn Time",
                     //locked: true
                 },
                 {
                     width: "110px",
                     field: "LOT",
                     title: "LogOut Time",
                     //locked: true
                 },
                 {
                     width: "120px",
                     field: "ESD",
                     title: "Effective Date From",
                     //locked: true
                 },
                 {
                     width: "80px",
                     field: "EED",
                     title: "Effective Date To",
                     //locked: true
                 },
                 {
                     width: "130px",
                     field: "RosterName",
                     title: "Time Keeping Roster",
                     //locked: true
                 },
                 {
                     width: "130px",
                     field: "TimeExceptionReason",
                     title: "Time Exception Reason",
                     //locked: true
                 },
                 

                 {
                     width: "40px",
                     title: 'Action',
                     template: function (data) {
                         var btn = '';
                         //btn += '<div class="text-center"><a href="#" OnClick="EditOfficeTimeKeeping(' + "'" + data.Id + "'" + ',' + "'" + data.OfficeTypeId + "'" + ',' + "'" + data.OfficeId + "'" + ',' + "'" + data.LIT + "'" + ',' + "'" + data.LLT + "'" + ',' + "'" + data.LOT + "'" + ',' + "'" + data.ESD + "'" + ',' + "'" + data.EED + "'" + ',' + "'" + data.TimeKeepingRosterId + "'" + ',' + "'" + data.TimeExceptionReason + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                         btn += '<div class="text-center"><a href="#" OnClick="InformationDelete(' + data.Id + ');"><i class="fa fa-trash-o"></i></a></div>';
                         return btn;
                     }


                 },
            ]
        });
    }

    $(document).ready(function () {

        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();

        //Timepicker

        var options = {// now: "12:35", //hh:mm 24 hour format only, defaults to current time
            twentyFour: true, //Display 24 hour format, defaults to false
            upArrow: 'wickedpicker__controls__control-up', //The up arrow class selector to use, for custom CSS
            downArrow: 'wickedpicker__controls__control-down', //The down arrow class selector to use, for custom CSS
            close: 'wickedpicker__close', //The close class selector to use, for custom CSS
            hoverState: 'hover-state', //The hover state class to use, for custom CSS
            title: 'Timepicker', //The Wickedpicker's title,
            showSeconds: false, //Whether or not to show seconds,
            secondsInterval: 1, //Change interval for seconds, defaults to 1  ,
            minutesInterval: 1, //Change interval for minutes, defaults to 1
            beforeShow: null, //A function to be called before the Wickedpicker is shown
            show: null, //A function to be called when the Wickedpicker is shown
            clearable: false, //Make the picker's input clearable (has clickable "x")
        };


        $("#LogInTime").wickedpicker(options);
        $("#LogOutTime").wickedpicker(options);
        $("#LastLogInTime").wickedpicker(options);

        $("#LogInTime").val("10 : 00");
        $("#LogOutTime").val("18 : 00");
        $("#LastLogInTime").val("18 : 00");

        //End Time Picker



        /////DATE FIELDS
        $("#EffectiveDateFrom").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: "1920:2100"

          });
        $("#EffectiveDateFrom").datepicker(
      'setDate', new Date());

        $("#EffectiveDateTo").datepicker(
          {
              dateFormat: "dd-M-yy",
              showAnim: "scale",
              changeMonth: true,
              changeYear: true,
              yearRange: "1920:2100"
          });
        $("#EffectiveDateTo").datepicker(
      'setDate', new Date());
        $("#btnReset").click(function () {
            clear();
        });
        $("#btnSave").click(function () {
            //debugger;
            var OfficeId = 0;
            var OfficeTypeId = $("#OfficeTypeId").val();
            if (OfficeTypeId == 1) {
                OfficeId = $("#PVHeadOfficeId").val();
            } else if (OfficeTypeId == 3) {
                OfficeId = $("#PVProjectId").val();
            } else if (OfficeTypeId == 4) {
                OfficeId = $("#ZoneId").val();
            } else if (OfficeTypeId == 5) {
                OfficeId = $("#AreaId").val();
            } else if (OfficeTypeId == 6) {
                OfficeId = $("#UnitId").val();
            }
            var LoginTime = $("#LogInTime").val();
            var LogoutTime = $("#LogOutTime").val();
            var LastLoginTime = $("#LastLogInTime").val();

            var EffectiveStartDate = $("#EffectiveDateFrom").val();
            var EffectiveEndDate = $("#EffectiveDateTo").val();



            var LoginTime2 = LoginTime.split(":");
            var LogoutTime2 = LogoutTime.split(":");

            var logINTim = LoginTime2[0] + "" + LoginTime2[1];
            var logOUTim = LogoutTime2[0] + "" + LogoutTime2[1];

            if (OfficeTypeId == '' || OfficeId == '' || LoginTime == '' || LogoutTime == '' || LastLoginTime == '') {
                $.alert.open("Message", "Please Fill All required data.");
                return false;
            }
            if (logOUTim < logINTim) {
                $.alert.open("Message", "Logout time can not be earlier than Login time.");
                return false;
            }
            var startDate = new Date(EffectiveStartDate);
            var endDate = new Date(EffectiveEndDate);
            if (startDate > endDate) {
                $.alert.open("Message", "Effective End date can not be Earlier than Effective Start Date. ");
                return false;
            }
        });

        $("#TimeExceptionReason").change(function () {
            if ("Other" == $(this).val()) {
                $("#ExceptionCustomReason").val("");
                $("#ExceptionReasonModal").modal("show");
            }
        });

        GridLoad();
    });

    function CustomExceptionReasonSave() {
        $("#ExceptionReasonModal").modal("hide");
        var CustomReason = $("#ExceptionCustomReason").val().trim();
        if (CustomReason.length > 50) {
            $.alert("error", "Reason can not be greater than 50 characters.");
        }
        var IsDuplicate = false;
        $("#TimeExceptionReason option").each(function (index, x) {
            if (CustomReason == x.innerHTML) IsDuplicate = true;
        });
        if (!IsDuplicate) {
            $("#TimeExceptionReason").append("<option value='" + CustomReason + "'>" + CustomReason + "</option>");
            $("#TimeExceptionReason").val(CustomReason);
        }
    }


    function GenerateOfficeTimeException() {//kk

        var OfficeId = 0;
        var OfficeTypeId = $("#OfficeTypeId").val();
        if (OfficeTypeId == 1) {
            OfficeId = $("#PVHeadOfficeId").val();
        } else if (OfficeTypeId == 3) {
            OfficeId = $("#PVProjectId").val();
        } else if (OfficeTypeId == 4) {
            OfficeId = $("#ZoneId").val();
        } else if (OfficeTypeId == 5) {
            OfficeId = $("#AreaId").val();
        } else if (OfficeTypeId == 6) {
            OfficeId = $("#UnitId").val();
        }

        var item = {};
        item.OfficeTypeId = $("#OfficeTypeId").val();
        item.OfficeId = OfficeId;
        item.LogInTime = $("#LogInTime").val();
        item.LastLogInTime = $("#LastLogInTime").val();
        item.LogOutTime = $("#LogOutTime").val();
        item.EffectiveDateFrom = $("#EffectiveDateFrom").val();
        item.EffectiveDateTo = $("#EffectiveDateTo").val();
        item.TimeKeepingRosterId = $("#TimeKeepingRosterId").val();
        item.TimeExceptionReason = $("#TimeExceptionReason").val();

        return item;
    }

    function GenerateUpdateOfficeTimeKeepingRoster() {
        var item = {};
        item.Id = $("#Id").val();
        item.OfficeTypeId = $("#OfficeTypeId").val();
        item.OfficeId = $("#OfficeId").val();
        item.LogInTime = $("#LogInTime").val();
        item.LastLogInTime = $("#LastLogInTime").val();
        item.LogOutTime = $("#LogOutTime").val();
        item.EffectiveDateFrom = $("#EffectiveDateFrom").val();
        item.EffectiveDateTo = $("#EffectiveDateTo").val();
        item.TimeKeepingRosterId = $("#TimeKeepingRosterId").val();
        item.TimeExceptionReason = $("#TimeExceptionReason").val();
        return item;
    }

    function ClearControl() {
        $("#OfficeTypeId").val('');
        $("#OfficeId").val('');
        $("#LogInTime").val('');
        $("#LastLogInTime").val('');
        $("#LogOutTime").val('');
        $("#EffectiveDateFrom").val('');
        $("#EffectiveDateTo").val('');
        $("#TimeKeepingRosterId").val('');
        $("#TimeExceptionReason").val('');

        $("#LogInTime").val("10 : 00");
        $("#LastLogInTime").val("10 : 00");
        $("#LogOutTime").val("10 : 00");
    }

    function SaveOfficeTimeException() {

        var employeeOfficeTimeException = GenerateOfficeTimeException();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveOfficeTimeException", "TimeKeepingException")',
            data: JSON.stringify({ employeeOfficeTimeException: employeeOfficeTimeException }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data == "Save Successfull") {
                    GridLoad();
                    ClearControl();
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }

    function UpdateOfficeTimeException() {

        var employeeOfficeTimeException = GenerateUpdateOfficeTimeKeepingRoster();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateOfficeTimeException", "TimeKeepingException")',
            data: JSON.stringify({ employeeOfficeTimeException: employeeOfficeTimeException }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                GridLoad();
                if (data.result == "Update Successfull") {
                    GridLoad();
                    $.alert.open('Success', data.result);
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }


    // delete
    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteOfficeTimeException", "TimeKeepingException", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            GridLoad();
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    //edit using jtable

    function ResetEASSManagment() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }

    function EditOfficeTimeKeeping(a, b, c, d, e, f, g, h, i, j) {
        $("#Id").val(a);
        $("#OfficeTypeId").val(b);
        $("#OfficeTypeId").trigger("change");
        $("#OfficeId").val(c);
        $("#LogInTime").val(d);
        $("#LastLogInTime").val(e);
        $("#LogOutTime").val(f);
        $("#EffectiveDateFrom").val(g);
        $("#EffectiveDateTo").val(h);
        $("#TimeKeepingRosterId").val(i);
        $("#TimeExceptionReason").val(j);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();


    }


</script>

    &nbsp;
<h2 class="page-title">Employee Office Time Exception</h2>
    &nbsp;
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="container-fluid">
