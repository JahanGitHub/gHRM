                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.LastLogInTime, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.EffectiveDateFrom, htmlAttributes: new { @class = "control-label col-md-4 required" })
