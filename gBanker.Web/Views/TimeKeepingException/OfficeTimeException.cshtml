                    @Html.HiddenFor(model => model.Id)
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        <div class="form-group form-action" style="padding:10px;margin:5px;">
                            &nbsp;
                            <input type="button" value="Save" id="btnSave" class="btn btn-success" onclick="SaveOfficeTimeException()" />
                            &nbsp;
                            <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateOfficeTimeException()" />
