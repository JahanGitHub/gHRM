<div class="modal" id="ExceptionReasonModal" role="dialog" aria-hidden="true">
    <div class="vertical-alignment-helper">
        <div class="modal-dialog vertical-align-center" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Exception Reason
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="form-group">
                            <label class="control-label col-sm-4 required">Reason</label>
                            <div class="col-sm-8">
                                <input id="ExceptionCustomReason" name="ExceptionCustomReason" type="text" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div style="margin-top: 15px; text-align: right;">
                        <input type="button" value="Save" class="btn btn-success" onclick="CustomExceptionReasonSave()" />
                    </div>
                </div>
                <div class="modal-footer" style="display: none;"></div>
            </div>
        </div>
    </div>
</div>

