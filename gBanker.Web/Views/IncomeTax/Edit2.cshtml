@model gHRM.Web.ViewModels.IncomeTax.IncomeTaxViewModel

@{
    ViewBag.Title = "Edit Income Tax";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <script>
    Swal.fire({
        icon: 'success',
        title: 'Success!',
        text: '@TempData["Success"]',
        confirmButtonColor: '#3085d6',
        confirmButtonText: 'OK'
    });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
    Swal.fire({
        icon: 'error',
        title: 'Oops...',
        text: '@TempData["Error"]',
        confirmButtonColor: '#d33',
        confirmButtonText: 'Try Again'
    });
    </script>
}


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="http://momentjs.com/downloads/moment.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.form/4.3.0/jquery.form.min.js"></script>

<script type="text/javascript">

    function reloadGrid() {
        $('#grid').jtable('load');
    }

    function LoadEmpInfoByCode(employee_code) {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetEmployeeData", "IncomeTax")',
            data: { EmpId: employee_code },
            dataType: 'json',
            success: function (data) {
                if (data.length > 0) {
                    let emp = data[0];
                    $("#EmployeeName").val(emp.EmployeeName);
                    $("#EmployeeID").val(emp.EmployeeID);
                    $("#OfficeID").val(emp.OfficeID);
                } else {
                    $("#EmployeeName").val('');
                    $("#EmployeeID").val('');
                    $("#OfficeID").val('');
                    alert("Wrong Employee Code");
                    $("#txtEmpName").focus();
                }
            },
            error: function (request, status, error) {
                alert("Error: " + error);
            }
        });
    }

    function clearForm() {
        $("#txtEmpName").val('');
        $("#EmployeeName").val('');
        $("#EmployeeID").val('');
        $("#OfficeID").val('');
        $("#NationalID").val('');
        $("#TIN").val('');
        $("#ReturnRegisterSlNo").val('');
        $("#ReturnRegisterVolNo").val('');
        $("#ReturnFillingDate").datepicker('setDate', new Date());
        $("#FiscalYear").val('');
        $("#Circle").val('');
        $("#TaxArea").val('');
        $("#TotalIncome").val('');
        $("#TotalTaxPaid").val('');
        $("#FileLocation").val('');
    }

    $(document).ready(function () {

        // Reset
        $("#btnReset").click(function () {
            clearForm();
        });

        // Submit
        $("#btnSubmit").click(function () {
            let empName = $("#EmployeeName").val();
            let empId = $("#EmployeeID").val();
            let officeId = $("#OfficeID").val();
            let fiscalYear = $("#FiscalYear").val();
            let fillingDate = $("#ReturnFillingDate").val();

            if (empName === '' || empId === '' || officeId === '' || fiscalYear === '' || fillingDate === '') {
                $.alert.open("Message", "Please fill in all required fields.");
                return false;
            }

            reloadGrid(); // Optional, if form submits normally
        });

        // Datepicker
        $("#ReturnFillingDate").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "slideDown",
            changeMonth: true,
            changeYear: true,
            yearRange: "1990:2050"
        }).datepicker('setDate', new Date());

        // Load employee data on blur
        $("#txtEmpName").blur(function () {
            var code = $(this).val();
            if (code !== '') {
                LoadEmpInfoByCode(code);
            } else {
                $("#EmployeeName").val('');
                $("#EmployeeID").val('');
                $("#OfficeID").val('');
            }
        });

        // Grid
