<h2>Income Tax Edit</h2>

@using (Html.BeginForm("Edit2", "IncomeTax", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.EmployeeID)
    @Html.HiddenFor(model => model.OfficeID)

<fieldset>
    <legend>Edit Income Tax Info</legend>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.EmployeeCode, new { @class = "form-control", @readonly = "readonly", id = "txtEmpName" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control", @readonly = "readonly", id = "EmployeeName" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.NationalID, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.NationalID, new { @class = "form-control", id = "NationalID" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.TIN, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.TIN, new { @class = "form-control", id = "TIN" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.FiscalYear, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.FiscalYear, new { @class = "form-control", id = "FiscalYear" })

                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.ReturnFillingDate, htmlAttributes: new { @class = "control-label col-md-4 required" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.ReturnFillingDate, new { @class = "form-control", id = "ReturnFillingDate" })
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.ReturnRegisterSlNo, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.ReturnRegisterSlNo, new { @class = "form-control", id = "ReturnRegisterSlNo" })
                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.ReturnRegisterVolNo, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.ReturnRegisterVolNo, new { @class = "form-control", id = "ReturnRegisterVolNo" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.TotalIncome, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.TotalIncome, new { @class = "form-control", id = "TotalIncome" })
                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.TotalTaxPaid, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.TotalTaxPaid, new { @class = "form-control", id = "TotalTaxPaid" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Circle, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-8">
                    @Html.TextBoxFor(model => model.Circle, new { @class = "form-control", id = "Circle" })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                @Html.LabelFor(model => model.FileLocation, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.TextBoxFor(m => m.FileLocationU, new { type = "file", @class = "form-control" })

                    @*@Html.TextBoxFor(model => model.FileLocation, new { @class = "form-control", @readonly = "readonly", id = "FileLocation" })
                    @Html.HiddenFor(model => model.FileLocation)*@
                </div>
            </div>
        </div>
    </div>
</fieldset>


    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <div class="form-group form-action" style="padding:10px;margin:5px;">
                    &nbsp;
                    @*<input type="button" value="Save" id="btnSave" class="btn btn-success" />*@
                    <input type="submit" value="Submit" id="btnSubmit" class="btn btn-success" />

                </div>
            </div>
        </div>
    </div>
}
