@model gHRM.Web.ViewModels.ThanaViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var countryList = Model == null ? null : Model.CountryList;
    var stateList = Model == null ? null : Model.StateOrProvinceList;
    var districtList = Model == null ? null : Model.DistrictList;

}

<script type="text/javascript">

    function LoadState(country_id) {
        var ddlState = $("#StateOrProvinceId");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetStateList", "Thana", "http")',
            data: { country_id: country_id },
            dataType: 'json',
            async: true,
            success: function (data) {

                ddlState.html('');
                $.each(data, function (id, option) {
                    ddlState.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function LoadDistrict(state_id) {
        var ddlDistrict = $("#district_id");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDistrictList", "Thana", "http")',
            data: { state_id: state_id },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlDistrict.html('');
                $.each(data, function (id, option) {
                    ddlDistrict.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    $(document).ready(function () {
        //Countrywise State

        var country_id = $("#CountryId").val();
        if (country_id > 0) {
            LoadState(country_id);
        }

        $("#CountryId").change(function () {
            var country_id = $("#CountryId").val();

            if (country_id > 0) {
                LoadState(country_id);
            }
        });

        //Statewise District
        $("#StateOrProvinceId").change(function () {
            var state_id = $("#StateOrProvinceId").val();
            if (state_id > 0) {
                LoadDistrict(state_id);
            }
        });

        $("#btnThanaSave").click(function (e) {
            if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() != '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;

            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() != '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() != '') {
                $("#CountryId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;

            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }

            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() != '') {
                $("#CountryId").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() == '') {
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() != '') {
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() == '') {
                $("#StateOrProvinceId").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() != '') {
                $("#StateOrProvinceId").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() == '') {
                $("#district_id").addClass("errorClass");
                $("#thana_name_eng").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_name_eng").val() != '') {
                $("#district_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() != '0' && $("#thana_name_eng").val() == '') {
                $("#thana_name_eng").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }

                return false;
            }


            else
                return true;
        });
    });

</script>

