@using (Html.BeginForm("Create", "LeaveEncashment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "LeaveSellProfile" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="container-fluid">
        <div id="AjaxLoader" class="ajaxLoader"></div>
        <fieldset>
            <legend>Employee Leave Info</legend>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @if (Model.IsAuthorized == true)
                            {
                                @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control" } })
                            }
                            else
                            {
                                @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                            }
                            @Html.HiddenFor(model => model.EmployeeId)
                            @Html.HiddenFor(model => model.LeaveSellSave)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.OfficeName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.OfficeName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DepartmentName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DepartmentName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.DesignationName, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.DesignationName, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Salary Scale Date", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">

                            <input type="text" id="txtJoiningDate" class="form-control" readonly="readonly" />
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Encash Eligible Date", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtEligibleDate", "", new { @class = "form-control", @readonly = "true" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Total Earn Leave", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtTotalEarnLeave", "", new { @class = "form-control", @readonly = "true" })
                            @*@Html.EditorFor(model => model.JoiningDate, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })*@
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Earn Leave Taken", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtLeaveTaken", "", new { @class = "form-control", @readonly = "true" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Available Earn Leave", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtAvailableLeave", "", new { @class = "form-control", @readonly = "true" })
                            @*@Html.EditorFor(model => model.JoiningDate, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })*@
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Earn Leave Sold", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtLeaveSold", "", new { @class = "form-control", @readonly = "true" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Last Encash Date", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.TextBox("txtLastSellDate", "", new { @class = "form-control", @readonly = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        @Html.Label("Encashment Quantity", htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.TotalDays, new { htmlAttributes = new { @class = "form-control", @readonly = "true" } })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-sm-6">
                    <div class="form-group">
                        <label class="control-label col-md-4">Request Date</label>
                        <div class="col-sm-8">
                            @Html.EditorFor(model => model.RequestDate, new { htmlAttributes = new { @Value = DateTime.Now.ToString("dd-MMM-yyyy"), @class = "form-control" } })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <div id="grid"></div>
                    </div>
                </div>
            </div>

        </fieldset>

        <div class="row" style="margin-top:20px;">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                <div class="col-sm-12">
                    <div class="create-success create-content alert alert-success alert-dismissable" role="alert" style="display:none">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <p class="message-content"><label id="lblSellSucessMsg" style="font-size:15px;"></label></p>
                    </div>
                    <div class="create-danger create-content alert alert-danger alert-dismissable" role="alert" style="display:none">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <p class="message-content"><label id="lblSellDangerMsg" style="font-size:15px;"></label></p>
                    </div>

                    <div class="save-success alert alert-success alert-dismissable" role="alert" style="display:none">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <p class="message-content">Saved Sucessfully</p>
                    </div>
                    <div class="save-fail alert alert-danger alert-dismissable" role="alert" style="display:none">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                        <p class="message-content">Fail to save</p>
                    </div>

                    <input type="submit" value="Save" id="btnLeaveSellSave" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}


