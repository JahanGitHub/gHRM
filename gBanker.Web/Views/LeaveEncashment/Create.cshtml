@model gHRM.Web.ViewModels.LeaveSellViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<script src="http://malsup.github.com/jquery.form.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
<script type="text/javascript">

    $(document).ready(function () {

        $("#RequestDate").datepicker({
             dateFormat: "dd-M-yy",
             showAnim: "scale",
             changeMonth: true,
             changeYear: true,
             yearRange: "1920:2025"
         });

        $("#EmployeeCode").keyup(function (e) {
            var keycode = e.keyCode ? e.keyCode : e.which;
            if (keycode == 8) {
                ClearFormData();
            }
        });

        $("#EmployeeCode").blur(function () {
            var employee_Code = $("#EmployeeCode").val();
            if (employee_Code != "") {
                LoadEmpInfo(employee_Code);
            }
            else {
                $("#OfficeName").empty();
                $("#DepartmentName").empty();
                $("#DesignationName").empty();
            }
        });

        if ('@Model.EmployeeCode' != "") {
            $("#EmployeeCode").trigger("blur");
        }

        //$("#TotalDays").val(30);//????  Must be come from configuration

        $("#btnLeaveSellSave").click(function (e) {
            e.preventDefault();

            var empId = $("#EmployeeId").val();
            if (!empId) {
                $("#EmployeeCode").addClass("errorClass");
                return false;
            }
            else {
                $('#LeaveSellProfile').ajaxSubmit({
                    type: "POST",
                    target: '#thumbnil',
                    data: {},
                    dataType: 'json',
                    resetForm: false,
                    success: function (data) {

                        $('#AjaxLoader').hide();
                        if (data.result == 1) {
                            $.alert.open('Success', data.message);
                            $("#btnLeaveSellSave").hide();

                            if (data.leaveSellId > 0 && empId > 0) {
                                ELEncashmentApplication(data.leaveSellId, empId)
                            }
                            ClearFormData();
                        } else {
                            $.alert.open('error', data.message);
                        }
                    },
                    error: function () {
                        $('#AjaxLoader').hide();
                        $.alert.open('error', "Error Occured");
                    }
                });
            }
        });
    });

    function LoadEmpInfo(employee_Code) {
        $('#AjaxLoader').show();
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetLeaveSellInfo", "LeaveEncashment", "http")',
            data: { employee_Code: employee_Code },
            dataType: 'json',
            async: true,
            success: function (data) {
                $('#AjaxLoader').hide();
                if (data.result==0) {
                    $.alert.open('Error',data.message);
                    ClearFormData();
                    $(".create-success").hide();
                    $(".create-danger").hide();
                }

                else {
                    $("#EmployeeId").val(data.model.EmployeeId);
                    $("#EmployeeName").val(data.model.EmployeeName);
                    $('#OfficeName').val(data.model.OfficeName);
                    $('#DepartmentName').val(data.model.DepartmentName);
                    $('#DesignationName').val(data.model.DesignationName);
                    $('#txtJoiningDate').val(data.model.ConfirmDateMsg);
                    $('#txtEligibleDate').val(data.model.EligibleDateMsg);
                    $('#txtTotalEarnLeave').val(data.model.TotalEarnLeave);
                    $('#txtLeaveSold').val(data.model.TotalLeaveSold);
                    $('#txtLastSellDate').val(data.model.LastSellDateMsg);
                    $('#txtLeaveTaken').val(data.model.TotalEarnLeaveTaken);
                    $('#txtAvailableLeave').val(data.model.AvailableLeave);
                    $("#TotalDays").val(data.model.EncashmentQuantity);
                    //$('#LeaveSellMessage').val(data.LeaveSellMessage);
                    $(".create-success").hide();
                    $(".create-danger").hide();
                    $('#LeaveSellSave').val(data.model.LeaveSellSave);
                    if ($('#LeaveSellSave').val() == '1') {
                        $('#lblSellSucessMsg').html(data.model.LeaveSellMessage);
                        $(".create-success").show();
                    }
                    else {
                        $('#lblSellDangerMsg').html(data.model.LeaveSellMessage);
                        $(".create-danger").show();
                    }
                    
                    GetLeaveSellListByEmployee();

                }
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    function GetLeaveSellListByEmployee() {

        var empId = $("#EmployeeId").val();

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetLeaveSellListByEmployee", "LeaveEncashment", "http")',
                    dataType: 'json',
                    data: { EmployeeId: empId }
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            //height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,
            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "LeaveSellId",
                     hidden: true,
                     filterable: false
                 },

                 {
                     field: "EmployeeId",
                     hidden: true,
                     filterable: false
                 },
                 {
                     field: "Rowsl",
                     title: "Sl.",
                     width: "30px",
                     filterable: false
                 },
                 {
                     width: "50px",
                     field: "EmployeeCode",
                     filterable: false,
                     title: "Code"
                 },
                 {
                     width: "100px",
                     field: "EmployeeName",
                     title: "Name",
                     filterable: false
                 },
                  {
                      width: "100px",
                      field: "SaleDateMsg",
                      title: "Sale Date",
                      filterable: false
                  },
                    //{
                    //    width: "70px",
                    //    field: "ScaleDate",
                    //    title: "Scale Date",
                    //    filterable: false
                    //},
                {
                    width: "50px",
                    field: "BalanceEl",
                    title: "EL Balance",
                    filterable: false
                },

                {
                    width: "50px",
                    field: "TotalDays",
                    title: "Days Sold",
                    filterable: false
                },
                {
                    width: "50px",
                    field: "EncashedAmount",
                    title: "Amount",
                    filterable: false
                },
                 {
                     title: "Print",
                     width: "40px",
                     template: function (data) {
                         return '<div class="text-center"><a title="EL Encashment Application" href="#" OnClick="ELEncashmentApplication(' + data.LeaveSellId + ',' + data.EmployeeId + ');"><i class="fa fa-print"></i></a></div>';
                     }
                 },
                {
                    width: "100px",
                    title: 'Status',
                    template: function (data) {
                        if (data.IsApproved == false && data.IsActive == true) {
                            // return '<input type="file" name="pic" accept="image/*">';
                            return "Not Approved";
                        }
                        else if (data.IsApproved == true) {
                            return "Approved";
                        }
                        else if (data.IsApproved == false && data.IsActive == false) {
                            return "Rejected";
                        }
                    }
                },
            ]
        });
    }

    function ClearFormData() {

        $("#EmployeeId").val("");
        $("#EmployeeName").val("");
        $('#OfficeName').val("");
        $('#DepartmentName').val("");
        $('#DesignationName').val("");
        $('#txtJoiningDate').val("");
        $('#txtEligibleDate').val("");
        $('#txtTotalEarnLeave').val("");
        $('#txtLeaveSold').val("");
        $('#txtLastSellDate').val("");
        $('#txtLeaveTaken').val("");
        $('#txtAvailableLeave').val("");
        $("#TotalDays").val();

    }

    function ELEncashmentApplication(LeaveSellId, EmployeeId) {
        var url;
        url = '/LeaveEncashment/ELEncashmentApplication?LeaveSellId=' + LeaveSellId + '&EmployeeId=' + EmployeeId;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

</script>

@Html.ActionLink("Back to List", "Index", null, new { @class = "pull-right   btn btn-success" })
