        </div>
        <div class="row" style="display:block;">

            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Opening Collection Amount", htmlAttributes: new { @class = "control-label col-sm-4" })
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.PreviousLoanAmount, new { @class = "form-control" })  @*, @readonly = "readonly"*@
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Opening Collection Interest Amount", htmlAttributes: new { @class = "control-label col-sm-4" })
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.MaxLoanAmount, new { @class = "form-control" })  @*, @readonly = "readonly"*@
                    </div>
                </div>
            </div>

        </div>
        <div class="row">

        </div>
        <div class="row">
            <div class="col-md-6"></div>
            <div class="col-md-1">
                <button type="button" id="btnSave" class="btn btn-success">Save</button>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-12">
                <div id="grid"></div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script src="~/Assets/js/app/CommonMethod.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    @Scripts.Render("~/bundles/jqueryval")
