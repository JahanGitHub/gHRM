@model gHRM.Web.Models.LocalPasswordModel

@{
    ViewBag.Title = "Change Account";
    Layout = "~/Views/Shared/_AdminLteLayoutPassword.cshtml";
}

<p>You're logged in as <strong>@User.Identity.Name</strong>.</p>
<h3 class="text-blue">@ViewBag.StatusMessage</h3>
<h3 class="text-blue">(Please change your password first! )</h3>


@if (ViewBag.StatusMessage != null)
{
    @Html.Partial("_ChangePasswordPartial12345678")
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Assets/js/app/security/passwordChangeManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}
