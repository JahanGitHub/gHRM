<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/Account">Account</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}
<script type="text/javascript">
    function RegisterResetPassword(Id) {
        $.alert.open('confirm', 'Are you sure you want to reset this password?', function (button) {
            if (button == 'yes') {
                $('#AjaxLoader').show();
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("RegisterInfoResetPassword", "Account", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        $('#AjaxLoader').hide();
                        //$('#grid').jtable('load');
                        if (Result == 'OK') {
                            getUsersListDashboard();
                            $.alert.open("info", "Password reset successfully.");
                        }
                        else
                            $.alert.open("info", "Failed to reset password.");
                    },
                    error: function (request, status, error) {
                        $('#AjaxLoader').hide();
                        $.alert.open("error", request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                return false;
            }
        });
    }
    function getUsersListDashboard() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    //url: baseURL + '/ProcessCategory/GetProcessCategoryList?QueryOption=' + 1,
                    url: '@Url.Action("getUserDashboard", "Account", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });
        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "Id",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "EmployeeId",
                    title: "SL.",
                    width: "20px",
                    filterable: false,
                },
                {
                    field: "UserName",
                    title: "User Name",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "FirstName",
                    title: "Employee Name",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "RoleName",
                    title: "Role",
                    width: "50px",
                    filterable: true,
                },
                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.RoleName !== enumUserRole.SuperAdmin) {
                             return "<a href='/Account/RegisterEdit/?Id=" + dataItem.Id + "'><i class='fa fa-pencil-square-o'></i></a>";
                         }
                         else {
                             return "<span class='label label-danger'>Read Only</span>";
                         }

                     }
                 },
                 {
                     title: "Reset",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.RoleName !== enumUserRole.SuperAdmin) {
                             return "<a href='javascript:void(0);' OnClick='RegisterResetPassword(" + '"' + dataItem.Id + '"' + ");'><i class='fa fa-undo' aria-hidden='true'></i></a>";
                         }
                         else {
                             return "<span class='label label-danger'>Read Only</span>";
                         }                         
                     }
                 },
            {
                title: "Delete",
                width: "25px",
                template: function (dataItem) {
                    if (dataItem.RoleName !== enumUserRole.SuperAdmin) {
                        return '<a href="/Account/DeleteLogin/' + dataItem.Id + '"' + " onclick='return confirm(" + '"Are you sure you want to delete this item?");' + "'" + '><i class="fa fa-trash-o"></i></a>';                    
                    }
                    else {
                        return "<span class='label label-danger'>Read Only</span>";
                    }                    
                }
            }
            ]
        });
    }
    $(document).ready(function () {
        getUsersListDashboard();        
    });

</script>
@Html.ActionLink("Add New Login ", "Register", null, new { @class = "btn btn-success btn-sm pull-right" })
<h2 class="page-title">Login User List(লগইন ব্যবহারকারীর তালিকা)</h2>

<div class="box-content">

    <div class="table-responsive">
        <div id="gridKendo"></div>
    </div>
</div>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
}

