@model gHRM.Web.ViewModels.WelfareFund.StaffWelfareFundConfiguration.HealthFundingViewModel

@{
    ViewBag.Title = " Health Funding ";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
   
}


<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/HealthFunding"> Health Funding </a></li>
    </ol>
</div>

<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>

    &nbsp;
<h2 class="page-title"> Health Funding </h2>
    &nbsp;
<div class="container-fluid">
    <div id="AjaxLoader" class="ajaxLoader"></div>
    @using (Html.BeginForm("Configure", "HealthFunding", FormMethod.Post, new { @role = "form", @class = "form-horizontal", @id = "add-or-edit-form" }))
    {
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model=>model.EmployeeId)



        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.EmployeeCode, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.EmployeeCode, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.EmployeeName, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.EmployeeName, new { @class = "form-control required", @readonly = "readonly" })
                    </div>
                </div>
            </div>
        </div>




        <div class="row">

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.PurposeId, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.PurposeId, Model.PurposeList, new { @class = "form-control" })
                    </div>
                </div>
            </div>


            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.FundAmount, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.FundAmount, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>

        </div>

        <div class="row">

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.remarks, htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.remarks, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>


        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <div class="form-group form-action" style="padding:10px;margin:5px;">
                        &nbsp;
                        <button type="submit" class="btn btn-success">Save</button>
                        &nbsp;
                        <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" onclick="staffWelfareFundConfigurationManager.clearform()" />
                    </div>
                </div>
            </div>
        </div>
    }


    <h2 class="page-title">Health Fund  List</h2><br>
    <!--To view Listings-->
    <div id="grid"></div>


</div>


@section Scripts {
    <script src="~/Assets/js/app/welfarefund/healthFundingManager.js"></script>
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
