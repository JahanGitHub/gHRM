@{
    ViewBag.Title = "Cost Center";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}


<h3>Delete Cost Centers</h3>
<table id="deleteGrid" class="table table-bordered">
    <thead>
        <tr>
            <th>Cost Center Name</th>
            <th>Type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<script>
    $(document).ready(function () {
        loadDeleteGrid();
    });

    function loadDeleteGrid() {
        $.get('@Url.Action("GetSavedCostCenters", "CostCenter")', function (res) {
            var rows = '';
            $.each(res.data, function (i, item) {
                rows += `<tr>
                            <td>${item.CostCenterName}</td>
                            <td>${item.Type}</td>
                            <td><button class="btn btn-sm btn-danger" onclick="deleteRow(${item.Id})">Delete</button></td>
                         </tr>`;
            });
            $("#deleteGrid tbody").html(rows);
        });
    }

    function deleteRow(id) {
        if (!confirm("Are you sure you want to delete this record?")) return;

        $.post('@Url.Action("DeleteCostCenter", "CostCenter")',
            { Id: id },
            function (res) {
                if (res.result == 1) {
                    alert("Deleted successfully!");
                    loadDeleteGrid();
                } else {
                    alert(res.Message);
                }
            });
    }
</script>

