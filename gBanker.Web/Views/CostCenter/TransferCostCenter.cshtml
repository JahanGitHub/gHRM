@{
    ViewBag.Title = "Cost Center Transfer";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<h2>Transfer  Cost Center To  Cost Center </h2>
<br />

<div class="form-horizontal">
    <input type="hidden" id="FromCostCenterId" />
    <input type="hidden" id="ToCostCenterId" />

    <div class="container-fluid">
        <!-- Employee Info -->
        <div class="row" style="display:none;">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Employee ID", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeCode", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("Employee Name", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.TextBox("EmployeeName", "", new { @class = "form-control", @readonly = "readonly" })
                    </div>
                </div>
            </div>
        </div>

        <!-- From / To Cost Center -->
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("From Cost Center", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("FromCostCenter", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.Label("To Cost Center", htmlAttributes: new { @class = "control-label col-md-4 required" })
                    <div class="col-md-8">
                        @Html.TextBox("ToCostCenter", "", new { @class = "form-control", autocomplete = "off" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group">
                    <input type="button" id="btnSave" value="Transfer" class="btn btn-primary" />
                    <input type="button" id="btnClear" value="Clear" class="btn btn-warning" style="margin-left:10px;" />
                </div>
            </div>
        </div>

        <!-- Grid -->
        <div class="row">
            <h3 class="page-title">Current Mappings</h3>
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function () {
    // Load Employee Name by Code
    $("#EmployeeCode").blur(function () {
        var code = $("#EmployeeCode").val();
        if (code != '') {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetEmpInfoByCode", "EmployeeProfileReport")',
                data: { employee_code: code },
                dataType: 'json',
                success: function (data) {
                    if (data && data.result === 1 && data.data.length > 0) {
                        $("#EmployeeName").val(data.data[0].EmployeeName);
                    } else {
                        $("#EmployeeName").val("");
                        alert("Invalid Employee Code");
                    }
                }
            });
        }
    });

    // Autocomplete
    function setupCostCenterAutocomplete(txtId, hiddenId) {
        $("#" + txtId).autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: '@Url.Action("GetCostCenters", "CostCenter")',
                    data: { term: request.term },
                    dataType: "json",
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Cost_Center_Name, value: item.Cost_Center_Name, id: item.id };
                        }));
                    }
                });
            },
            minLength: 1,
            select: function (event, ui) {
                $("#" + hiddenId).val(ui.item.id);
            }
        });
    }

    setupCostCenterAutocomplete("FromCostCenter", "FromCostCenterId");
    setupCostCenterAutocomplete("ToCostCenter", "ToCostCenterId");

    // Save / Transfer
    $("#btnSave").click(function () {
        var EmployeeCode = $("#EmployeeCode").val();
        var FromId = $("#FromCostCenterId").val();
        var ToId = $("#ToCostCenterId").val();

        if ( !FromId || !ToId) {
            alert("All fields are required!");
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdateEmployeeCostCenter", "CostCenter")',
            data: { EmployeeCode, FromCostCenterId: FromId, ToCostCenterId: ToId },
            success: function (data) {
                if (data.result === 1) {
                    alert("Cost Center transferred successfully!");
                    getEmployeeCostCenterList();
                    $("#EmployeeCode").val(""); $("#EmployeeName").val("");
                    $("#FromCostCenter").val(""); $("#ToCostCenter").val("");
                    $("#FromCostCenterId").val(""); $("#ToCostCenterId").val("");
                } else {
                    alert(data.Message);
                }
            }
        });
    });

    $("#btnClear").click(function () {
        $("#EmployeeCode").val(""); $("#EmployeeName").val("");
        $("#FromCostCenter").val(""); $("#ToCostCenter").val("");
        $("#FromCostCenterId").val(""); $("#ToCostCenterId").val("");
    });

    // Grid
    function getEmployeeCostCenterList() {
        var grid = $("#gridKendo").data("kendoGrid");
        if (grid) { grid.dataSource.read(); grid.refresh(); }
        else {
            $("#gridKendo").kendoGrid({
                dataSource: {
                    transport: { read: { url: '@Url.Action("GetEmployeeCostCenterList", "CostCenter")', dataType: 'json' } },
                    schema: { data: "data", total: "total" },
                    pageSize: 20
                },
                pageable: true,
                sortable: true,
                filterable: true,
                columns: [
                    { field: "SL", title: "SL", width: "50px" },
                    { field: "EmployeeCode", title: "Employee ID", width: "120px" },
                    { field: "EmployeeName", title: "Employee Name", width: "200px" },
                    { field: "CostCenterName", title: "Cost Center", width: "150px" },
                    { field: "CreatedDate", title: "Created On", width: "130px" }
                ]
            });
        }
    }

    getEmployeeCostCenterList();
});
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
