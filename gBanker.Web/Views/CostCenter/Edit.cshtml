@{
    ViewBag.Title = "Cost Center";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<h3>Edit Cost Centers</h3>
<table id="editGrid" class="table table-bordered">
    <thead>
        <tr>
            <th>Cost Center Name</th>
            <th>Type</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<script>
    $(document).ready(function () {
        loadEditGrid();
    });

    function loadEditGrid() {
        $.get('@Url.Action("GetSavedCostCenters", "CostCenter")', function (res) {
            var rows = '';
            $.each(res.data, function (i, item) {
                rows += `<tr>
                            <td><input type="text" value="${item.CostCenterName}" id="cc_${item.Id}" class="form-control" /></td>
                            <td><input type="text" value="${item.Type}" id="type_${item.Id}" class="form-control" /></td>
                            <td><button class="btn btn-sm btn-success" onclick="updateRow(${item.Id})">Update</button></td>
                         </tr>`;
            });
            $("#editGrid tbody").html(rows);
        });
    }

    function updateRow(id) {
        var cc = $("#cc_" + id).val();
        var type = $("#type_" + id).val();

        $.post('@Url.Action("UpdateCostCenter", "CostCenter")',
            { Id: id, CostCenterName: cc, Type: type },
            function (res) {
                if (res.result == 1) {
                    alert("Updated successfully!");
                    loadEditGrid();
                } else {
                    alert(res.Message);
                }
            });
    }
</script>


