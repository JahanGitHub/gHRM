@model IEnumerable<gHRM.Web.ViewModels.ThanaViewModel>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">
    function deleteConfirm(status) {
        if (status == "true") {
            return confirm('Are you sure you want to delete this record');
        }
        else {
            alert("You cannot delete this record because it is already disabled.");
            return false;
        }
    }
    function GetDistrict() {
        var ddlDistrict = $("#ddlDistrict");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDistrictList", "Thana", "http")',
            data: {},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlDistrict.html('');
                $.each(data, function (id, option) {
                    ddlDistrict.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function GetThana(district_Id) {
        var ddlThana = $("#ddlThana");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetThanaList", "Union", "http")',
            data: { district_id: district_Id},
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlThana.html('');
                $.each(data, function (id, option) {
                    ddlThana.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }
    function reloadGrid() {
        debugger;
        $('#grid').jtable('load', { thanaId: $('#ddlThana').val() });
    }
    $(document).ready(function () {
        GetDistrict();

        $("#ddlDistrict").change(function () {
            var district_Id = $("#ddlDistrict").val();
            if (district_Id > 0)
                GetThana(district_Id);
        });


        $('#grid').jtable({
            // title: 'Investor List',
            paging: true,
            pageSize: 10,
            sorting: true,
            defaultSorting: 'Name ASC',
            actions: {
                title: "Edit",
                listAction: '/Union/GetUnion',
                updateAction: '/Union/Edit',
                //deleteAction: '/Thana/Delete'
            },
            fields: {
                union_id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                district_name_eng: {
                    title: 'District Name (জেলার নাম)',
                    width: '20%',
                    edit: false,
                    type: 'label'
                },               

                thana_name_eng: {
                    title: 'Thana Name (থানার নাম)',
                    width: '20%',
                    edit:false
                },
                union_name_eng: {
                    title: 'Union Name (ইউনিয়ন নাম)',
                    width: '20%',
                    edit: true
                },
              //  EditLink: {
                    //title: "Edit",
                   // sorting: false,
                 // display: function (data) {
                      // return "<div class='text-center'><a href='/Thana/Edit/" + data.record.thana_id + "'><i class='fa fa-pencil-square-o'></i></a></div>";
                   // }
                //},
                //DeleteLink: {
                //    title: "Delete",
                //    edit: false,
                //    display: function (data) {
                //        //return '<div class="text-center delete-link"><a href="/Employee/Delete/' + data.record.EmployeeId + '"' + 'onclick="return confirm("Are you sure you want to delete this item?");"' + '><i class="fa fa-trash-o"></i></a></div>';
                //        return '<div class="text-center delete-link"><a href="/Thana/Delete/' + data.record.thana_id + '" ' + ' OnClick="return confirm(' + "'" + 'Are you sure you want to delete this item?' + "'" + ');"' + '><i class="fa fa-trash-o"></i></a></div>';

                //    }
                //}



            }
        });

        reloadGrid();        
    });

</script>

