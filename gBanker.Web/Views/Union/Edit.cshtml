@model gHRM.Web.ViewModels.UnionViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    var countryList = Model == null ? null : Model.CountryList;
    var stateList = Model == null ? null : Model.StateOrProvinceList;
    var districtList = Model == null ? null : Model.DistrictList;
    var thanaList = Model == null ? null : Model.ThanaList;

}

<script type="text/javascript">

    function LoadState(country_id) {
        var ddlState = $("#StateOrProvinceId");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetStateList", "Thana", "http")',
            data: { country_id: country_id },
            dataType: 'json',
            async: true,
            success: function (data) {

                ddlState.html('');
                $.each(data, function (id, option) {
                    ddlState.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function LoadDistrict(state_id) {
        var ddlDistrict = $("#district_id");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetDistrictList", "Thana", "http")',
            data: { state_id: state_id },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlDistrict.html('');
                $.each(data, function (id, option) {
                    ddlDistrict.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }

    function LoadThana(district_id) {
        var ddlThana = $("#thana_id");
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetThanaList", "Thana", "http")',
            data: { district_id: district_id },
            dataType: 'json',
            async: true,
            success: function (data) {
                ddlThana.html('');
                $.each(data, function (id, option) {
                    ddlThana.append($('<option></option>').val(option.Value).html(option.Text));
                });
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
            }
        });
    }


    $(document).ready(function () {
        $("#union_id").val('');
        //Countrywise State

        var country_id = $("#CountryId").val();
        if (country_id > 0) {
            LoadState(country_id);
        }

        $("#CountryId").change(function () {
            var country_id = $("#CountryId").val();

            if (country_id > 0) {
                LoadState(country_id);
            }
        });

        //Statewise District
        $("#StateOrProvinceId").change(function () {
            var state_id = $("#StateOrProvinceId").val();
            if (state_id > 0) {
                LoadDistrict(state_id);
            }
        });

        $("#district_id").change(function () {
            var district_id = $("#district_id").val();
            if (district_id > 0) {
                LoadThana(district_id);
            }
        });

        $("#btnUnionSave").click(function (e) {
            if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                $("#union_name_eng").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;

            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#StateOrProvinceId").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;

            }
            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }

            else if ($("#CountryId").val() == '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#CountryId").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#StateOrProvinceId").addClass("errorClass");
                $("#district_id").addClass("errorClass");
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#StateOrProvinceId").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() == '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#StateOrProvinceId").addClass("errorClass");
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#district_id").addClass("errorClass");
                $("#thana_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() == '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#district_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                return false;
            }
            else if ($("#CountryId").val() != '' && $("#StateOrProvinceId").val() != '0' && $("#district_id").val() != '0' && $("#thana_id").val() == '0' && $("#union_name_eng").val() == '') {
                $("#thana_id").addClass("errorClass");
                if ($("#StateOrProvinceId").val() == '') {
                    $("#StateOrProvinceId").addClass("errorClass");
                }
                if ($("#district_id").val() == '') {
                    $("#district_id").addClass("errorClass");
                }

                return false;
            }
            else
                return true;
        });
    });

</script>

@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-success btn-sm pull-right" })

<h2 class="page-title">Edit Union(ইউনিয়ন সংযুক্তি করুন)</h2>
<br />
@using (Html.BeginForm("Edit", "Union", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form", id = "UnionProfile" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.CountryId, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.CountryId, countryList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.StateOrProvinceId, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.StateOrProvinceId, stateList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.StateOrProvinceId, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.district_id, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.district_id, districtList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.district_id, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.thana_name_eng, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.thana_id, thanaList, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(model => model.thana_name_eng, "", new { @class = "text-danger" })*@
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.LabelFor(model => model.union_name_eng, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                    <div class="col-sm-8">
                        @Html.EditorFor(model => model.union_name_eng, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="col-sm-6">
    </div>

    <div class="col-sm-6">
    </div>

    <div class="row">
    </div>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                <input type="submit" value="Save" id="btnUnionSave" class="btn btn-primary" />
            </div>
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
