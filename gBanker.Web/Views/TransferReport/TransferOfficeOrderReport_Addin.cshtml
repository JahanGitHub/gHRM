</div>


<div class="officeOrderHeader">
    <h2 class="page-title">CC For Office Order</h2>
    @using (Html.BeginForm("SaveTransferOfficeOrder", "TransferReport", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal global-submit-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <br /><br />

        <div id="AjaxLoader" class="ajaxLoader"></div>

        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Office Order Name</label>
                    <div class="col-sm-8">
                        @Html.TextAreaFor(model => model.CCForOfficeOrderNameView, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">View Order</label>
                    <div class="col-sm-8">
                        @Html.TextBoxFor(model => model.ViewOrder, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <label class="control-label col-sm-4 required">Text Placement In Report</label>
                    <div class="col-sm-8">
                        @Html.DropDownListFor(model => model.ReportPlacementType, Model.ReportPlacementList, new { @class = "form-control required" })
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @*<label class="control-label col-sm-4 required">View Order</label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(model => model.ViewOrder, new { @class = "form-control required" })
                        </div>*@


                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-sm-6">
                <div class="form-group">
                    <div class="col-sm-8">
                        <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateCCForOfficeOrder()" />
                        <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetForm()" />
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-8">
                @Html.HiddenFor(model => model.CCForOfficeOrderId)
            </div>
        </div>

    }
</div>
<div class="officeOrderContent">

    <h2 class="page-title"> Report Footer </h2>
    &nbsp;

    <div class="row">
        <div class="col-sm-12">
            &nbsp;
        </div>
    </div>

    <div id="grid"></div>

    <div class="row">
        <div class="col-sm-12">
            &nbsp;
        </div>
    </div>

    <div class="row">
        <div class="pull-right" style="margin-right: 15px;">
            <input type="button" id="btnPrintWithpr" value="Print(Pdf)" class="btn btn-success">
            @if (ViewBag.TRANSFER_OFFICE_ORDER_REPORT_SHOW_BTN_COMPANYREPORT)
            {
                <input type="button" value="@ViewBag.CompanyCode Transfer Planning Proposal Report(Pdf)" class="btn btn-success" onclick="Page.TransferPlanningProposalReport()" style="margin-left: 10px;">
                <input type="button" value="@ViewBag.CompanyCode Office Order Report(Pdf)" class="btn btn-success" onclick="Page.TransferPlanningOfficeOrderReport()" style="margin-left: 10px;">
            }
        </div>
    </div>

    <div class="row">
        <div class="pull-right" style="margin-right: 15px; margin-top:20px;">
            <input type="button" id="btnPrintWithpr2" value="Print(Doc)" class="btn btn-success">
            @if (ViewBag.TRANSFER_OFFICE_ORDER_REPORT_SHOW_BTN_COMPANYREPORT)
            {
                <input type="button" value="@ViewBag.CompanyCode Transfer Planning Proposal Report(Doc)" class="btn btn-success" onclick="Page.TransferPlanningProposalReport2()" style="margin-left: 10px;">
                <input type="button" value="@ViewBag.CompanyCode Office Order Report(Doc)" class="btn btn-success" onclick="Page.TransferPlanningOfficeOrderReport2()" style="margin-left: 10px;">
            }
