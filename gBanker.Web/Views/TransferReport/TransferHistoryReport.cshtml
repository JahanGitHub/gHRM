                    </div>
                </div>
            </div>
        </div><br>

              <div class="row">
                  <div class="col-sm-6 ">
                      <div class="form-group col-sm-offset-4">
                          <div class="col-md-8">
                              <input type="button" id="btnPrint" value="Print" class="btn btn-primary" />
                              &nbsp;
                              <input type="button" id="btnPrintNew" value="New Report" class="btn btn-primary" />
                          </div>
                      </div>
                  </div>
              </div>
    </fieldset>

</div>



