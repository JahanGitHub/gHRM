@model gHRM.Web.ViewModels.TransferOfficeOrderViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/TransferReport/TransferOfficeOrder">TransferOfficeOrder</a></li>
    </ol>
</div>

@{
    ViewBag.Title = "Tranfer Office Order";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">

    function GenerateCCForOfficeOrder() {
        var item = {};
        item.CCForOfficeOrderName = $("#CCForOfficeOrderName").val();
        item.ViewOrder = $("#ViewOrder").val();
        return item;
    }

    function GenerateUpdateCCForOfficeOrder() {
        var item = {};
        item.CCForOfficeOrderId = $("#CCForOfficeOrderId").val();
        item.CCForOfficeOrderName = $("#CCForOfficeOrderName").val();
        item.ViewOrder = $("#ViewOrder").val();
        return item;
    }

    function ClearControl() {
        $("#CCForOfficeOrderName").val('');
        $("#ViewOrder").val('');
    }

    function SaveCCForOfficeOrder() {

        var ccForOfficeOrder = GenerateCCForOfficeOrder();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveTransferOfficeOrder", "TransferReport")',
            data: JSON.stringify({ ccForOfficeOrder: ccForOfficeOrder }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.result = 1) {
                    $.alert.open('Success', data.message);
                    ClearControl();
                    LoadMainGrid();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function UpdateCCForOfficeOrder() {

        var ccForOfficeOrder = GenerateUpdateCCForOfficeOrder();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateTransferOfficeOrder", "TransferReport")',
            data: JSON.stringify({ ccForOfficeOrder: ccForOfficeOrder }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.result = 1) {
                    $.alert.open('Success', data.message);
                    ClearControl();
                    LoadMainGrid();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

</script>


<h2 class="page-title">Transfer For Office Order</h2>
@using (Html.BeginForm("SaveTransferOfficeOrder", "TransferReport", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Office Order Name</label>
                <div class="col-sm-8">
                    @Html.TextAreaFor(model => model.CCForOfficeOrderName, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">View Order</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.ViewOrder, new { @class = "form-control required" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveCCForOfficeOrder()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateCCForOfficeOrder()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetEmployeeStatus()" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
            @Html.HiddenFor(model => model.CCForOfficeOrderId)
        </div>
    </div>
}


@*list*@

<script type="text/javascript">

    // delete
    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteTranferOfficeOrder", "TransferReport", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            //$('#grid').jtable('load');
                            LoadMainGrid();
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    //edit using jtable

    function ResetEmployeeStatus() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }

    function EditEmpstatus(CCForOfficeOrderId, CCForOfficeOrderName, vieword) {
        debugger;
        $("#CCForOfficeOrderId").val(CCForOfficeOrderId);
        $("#CCForOfficeOrderName").val(CCForOfficeOrderName);
        $("#ViewOrder").val(vieword);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();

    }


    function LoadMainGrid() {
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("TransferOfficeOrderList", "TransferReport", "http")',
                    dataType: 'json',
                    //data: { FilterBy: filterBy, FilterValue: filterValue }
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "Id",
                     hidden: true,
                     filterable: false
                 },
                {
                    width: "150px",
                    field: "CCForOfficeOrderName",
                    filterable: true,
                    title: "Office Order Name"
                },
                 {
                     width: "150px",
                     field: "ViewOrder",
                     filterable: true,
                     title: "View Order"
                 },
                 {
                     width: "50px",
                     title: 'Edit',
                     template: function (dataItem) {
                         return '<div class="text-center"><a href="#" OnClick="EditEmpstatus(' + "'" + dataItem.CCForOfficeOrderId + "'" + ',' + "'" + dataItem.CCForOfficeOrderName + "'" + ',' + "'" + dataItem.ViewOrder + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                     }
                 },
                 {
                     width: "50px",
                     title: 'Delete',
                     template: function (dataItem) {
                         return "<a href='#' OnClick='InformationDelete(" + dataItem.CCForOfficeOrderId + ");'><i class='fa fa-trash-o'></i></a>";///Office/Create/?OfficeId=" + dataItem.EntrepreneurId + "
                     }
                 }
            ]
        });

    }



    $(document).ready(function () {
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        LoadMainGrid();
    });


</script>

