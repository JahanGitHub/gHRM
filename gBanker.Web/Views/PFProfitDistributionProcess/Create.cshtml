@model gHRM.Web.ViewModels.PF.ProfitDistributionProcessViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<h2 class="page-title">Profit Distribution</h2>
&nbsp

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.IsValidDistribution)

    <div class="form-horizontal">
        @Html.ValidationSummary(true)
        @Html.HiddenFor(model => model.DeclararionId)
        @Html.HiddenFor(model => model.YearStartDateStr)
        @Html.HiddenFor(model => model.YearEndDateStr)
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.Message, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Message, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.ProfitRate, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.ProfitRate, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.Distribution, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.Distribution, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.DistributionYear, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.EditorFor(model => model.DistributionYear, new { htmlAttributes = new { @class = "form-control", disabled = "disabled" } })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <label for="TransactionDate" class="control-label col-md-2">Distribution Date</label>
                <div class="col-md-4">
                    @Html.EditorFor(model => model.TransactionDate, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-1">
                <div class="form-group" style="padding-left:7px;">
                    <input type="button" value="View" id="btnView" class="btn btn-info" />
                </div>
            </div>
            @if (string.IsNullOrEmpty(Model.Message))
            {
                <div class="col-md-1">
                    <div class="form-group" style="padding-left:7px;">
                        <input type="button" value="Process" id="btnProcessProfitDistribution" class="btn btn-success" style="display:none;" />
                    </div>
                </div>

            }
        </div>

        <div class="row">
            <div class="col-sm-12">
                <table class="table" id="tbContribution">
                    <thead>
                        <tr>
                            <th scope="col"><input type="checkbox" id="chkAll" /> </th>
                            <th scope="col">Employee ID</th>
                            <th scope="col">Employee Name</th>
                            <th scope="col" style="text-align:right;">Contribution Amt</th>
                            <th scope="col" style="text-align:right;">Profit Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    <tfoot>
                        <tr style="text-align:right;font-size:medium;">
                            <td colspan="4">Total</td>
                            <td id="tfd"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

    </div>
}

@section Scripts {
    <script src="~/Assets/js/app/CommonMethod.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Assets/js/app/pf/pfProfitDistributionManager.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
}
