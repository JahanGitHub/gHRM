    //File Upload
    var base64;
    var fileName = "";
    var fileLocation = "";
    var fileLocEdit = "";
    var totalFileSize = 0;
    var curfile = 0;


    // new Image Upload
    var handleEmployeeImage = function (evt) {

        var files = evt.target.files;
        var file = files[0];
        curfile = 0;
        if (totalFileSize > 1024) {
            files = null;
            file = null;
            document.getElementById('ImgFile').value = null;
            $.messager.alert('Required', 'You Can not Attach More then 1 MB at a time!', 'info');
            return;
        }

        if (file.size != null) {

            var sizeInMb = file.size / 1024;
            var sizelimit = 1024 * 1;
            if (sizeInMb > sizelimit) {
                files = null;
                file = null;
                document.getElementById('ImgFile').value = null;
                $.messager.alert('Required', 'The attachment is too big, maximum allowed file size is 1 MB!', 'info');
                return;
            }
            else {
                totalFileSize = totalFileSize + sizeInMb;
                curfile = sizeInMb;
            }
        }
        if (files && file) {
            var reader = new FileReader();
            reader.onload = function (readerEvt) {
                var res = readerEvt.target.result.split(",");
                base64 = res[1];
                fileName = file.name;
            };
            reader.readAsDataURL(file);
        }
    };

