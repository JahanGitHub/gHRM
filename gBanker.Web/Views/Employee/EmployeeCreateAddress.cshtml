@* Employee Attendance info*@
<script type="text/javascript">

    $(function () {
        $("#RoasterEffectiveStartDate").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:2050"

        });
        $("#RoasterEffectiveStartDate").datepicker('setDate', new Date());

        $("#RoasterEffectiveEndDate").datepicker({
            dateFormat: "dd-M-yy",
            showAnim: "scale",
            changeMonth: true,
            changeYear: true,
            yearRange: "1950:2050"

        });
        $("#RoasterEffectiveEndDate").datepicker('setDate', new Date());

        $('.section-roaster-time').hide();

        $("#TimeKeepingRosterId").on("change", function () {
            var timeKeepingRosterId = $("#TimeKeepingRosterId").val();
            if (!timeKeepingRosterId || timeKeepingRosterId <= 0) {
                $(".roaster-login-time").text('');
                $(".roaster-lastlogin-time").text('');
                $(".roaster-logout-time").text('');
                $('.section-roaster-time').hide();
            }

            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '/TimeKeepingRoster/getRoasterDetailsById/' + timeKeepingRosterId,
                dataType: 'json',
                success: function (data) {
                    $(".roaster-login-time").text(data.LoginTime);
                    $(".roaster-lastlogin-time").text(data.LastLoginTime);
                    $(".roaster-logout-time").text(data.LogoutTime);
                    $('.section-roaster-time').show();
                },
                error: function (request, status, error) {
                    $(".roaster-login-time").text('');
                    $(".roaster-lastlogin-time").text('');
                    $(".roaster-logout-time").text('');
                    $('.section-roaster-time').hide();
                }
            });
        })

        //submit to change userrole
        $('#add-or-edit-employee-roaster-form').on('submit', function (event) {

            event.preventDefault();
            var form = $(this);

            var roasterEffectiveStartDate=$('#RoasterEffectiveStartDate').val(),
                roasterEffectiveEndDate = $('#RoasterEffectiveEndDate').val();

            if (!app.checkStartDateIsSmallerThanOrEqualToEndDate(roasterEffectiveStartDate, roasterEffectiveEndDate)) {
                $.alert.open("Error", "Effective End date can not be Earlier than Effective Start Date.");
                return;
            }

            //for form validation
            var isValid = app.validateForm('#add-or-edit-employee-roaster-form');
            if (!isValid) return;

            $.ajax({
                type: form.attr('method'),
                url: form.attr('action'),
                data: form.serialize()
            }).done(function (data) {
                if (data.isSuccess) {
                    //success alert
                    $.alert.open(data.result);
                    if (data.isSuccess) {
                        $('#gridAttendance').jtable('load');
                    }
                }
                else {
                    $.alert.open("Error", data.result);
                }
            });

        });
    })

    // get Attendance info start
