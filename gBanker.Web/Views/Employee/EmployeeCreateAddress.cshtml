    function LoadMedicalInfo(MedicalInfoId, sl, e) {

        e.preventDefault();

        $("#MedicalInfoOf").val($("#txtinfoOf" + sl).val());
        $("#PersonBloodGroup").val($("#txtbloodGrp" + sl).val());

        $("#BloodPressureType").val($("#txtbpType" + sl).val());

        if ($("#txthasBp" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioBpYes");
            radiobtn.checked = true;
            $("#bloodPressureDiv").removeAttr('hidden');
        } else {
            var radiobtn = document.getElementById("radioBpNo");
            radiobtn.checked = true;
            $("#bloodPressureDiv").attr('hidden', true);

        }
        if ($("#txthasDiabetics" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioDiabeticsYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioDiabeticsNo");
            radiobtn.checked = true;
        }
        if ($("#txthasHeartDisease" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioHeartDiseaseYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioHeartDiseaseNo");
            radiobtn.checked = true;

        }
        if ($("#txthasAlergy" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioAlergyYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioAlergyNo");
            radiobtn.checked = true;
        }
        if ($("#txthasXray" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioXRayChestYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioXRayChestNo");
            radiobtn.checked = true;
        }
        if ($("#txthasVDRL" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioVDRLYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioVDRLNo");
            radiobtn.checked = true;
        }
        if ($("#txthasHBs" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioHBsAgEYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioHBsAgENo");
            radiobtn.checked = true;
        }
        if ($("#txthasVisionTest" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioVisionTestYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioVisionTestNo");
            radiobtn.checked = true;
        }
        $("#Weight").val($("#txthasWeight" + sl).val());
        $("#Height").val($("#txthasHeight" + sl).val());

        if ($("#txthasOtherDisease" + sl).val() == 'Yes') {
            var radiobtn = document.getElementById("radioOtherDiseaseYes");
            radiobtn.checked = true;
        } else {
            var radiobtn = document.getElementById("radioOtherDiseaseNo");
            radiobtn.checked = true;
        }

        $("#MedicalRemarks").val($("#txtremarks" + sl).val());

        $("#hiddenMedicalInfoId").val(MedicalInfoId);
    }

    function DeleteMedicalInfo(MedicalInfoId, e) {

        e.preventDefault();
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {
                var EmployeeId = $("#hdnEmpMasterId").val();
                if (parseInt(EmployeeId) <= 0) {
                    $.alert.open("Error", "Your are not valid user.");
                }
                if (MedicalInfoId > 0) {
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("DeleteMedicalInfo", "Employee", "http")',
                        data: { MedicalInfoId: MedicalInfoId },
                        dataType: 'json',
                        async: false,
                        success: function (Result) {

                            if (Result > 0) {

                                $.alert.open("Success", "Deleted Successfully");
                                reloadMedicalInfoGrid(EmployeeId);
                            } else {

                                $.alert.open("Error", "Error");
                            }
                        },
                        error: function (request, status, error) {
                            alert(error)
                        }
                    });
                }
            } else {
                return false;
            }
        });
    }


</script>

