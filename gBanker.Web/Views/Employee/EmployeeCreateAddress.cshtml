<script type="text/javascript">

    function TestFileUpload() {

        //fileName = $("#filePicker").val();
        if (fileName != '' && base64 != '') {
            GetTempFile();
            document.getElementById('filePicker').value = null;
        }
    }

    function GetTempFile() {
        var fileToAttach = GenerateAttachment();
        var relatedInfo = GenerateRelatedInfo();
        if (relatedInfo != null) {
            $.ajax({
                type: "POST",
                dataType: "json",
                async: false,
                url: '@Url.Action("SaveFileAttachment", "Employee")',
                data: JSON.stringify({ fileAttachment: fileToAttach, RelatedInfo: relatedInfo }),
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    GetAttachmentList();
                    $.alert.open("Success", data);
                },
                error: function (xhr, status, error) {
                    alert(error);
                }

            });
        } else {
            $.alert.open("Error", "Please inaser required fields");
        }
    }


    function GetAttachmentList() {

        var employeeId = $("#EmployeeId").val();


        if (employeeId != null || employeeId != "") {

            $('#grid').jtable({
                paging: true,
                pageSize: 20,
                sorting: true,
                //defaultSorting: ' ASC',
                actions: {
                    listAction: function (postData, jtParams) {

                        return $.Deferred(function ($dfd) {
                            employeeId = $("#EmployeeId").val();
                            $.ajax({
                                cache: false,
                                async: false,
                                url: '/Employee/GetAttachmentList?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&EmployeeId=' + employeeId,

                                //cache:false,
                                type: 'POST',
                                dataType: 'json',
                                data: postData,
                                //async:false,
                                success: function (data) {
                                    $dfd.resolve(data);

                                },
                                error: function () {
                                    $dfd.reject();
                                }
                            });
                        });
                    }

                },
                fields: {
                    AttachmentId: {
                        key: true,
                        list: false,
                        create: false,
                        edit: false
                    },
                    DocumentType: {
                        width: '25%',
                        title: 'File Name'
                    },
                    FileName: {
                        width: '50%',
                        title: 'File Name'
                    },
                    //FileLocation: {
                    //    width: '55%',
                    //    title: 'Type Name(???????? ???)'
                    //},
                    Command: {
                        title: "Attached File",
                        width: '25%',
                        sorting: false,
                        display: function (data) {
                            return '<div class="text-center"><a  target="_blank" href="' + data.record.FileLocation + '" ><i class="fa fa-file" title="View File"></i></a>&nbsp;&nbsp;<a href="#" OnClick="DeleteFile(' + data.record.AttachmentId + ');"><i class="fa fa-trash"></i></a></div>';
                        }
                    },

                }
            });
            reloadGrid();
        }

    }

    function DeleteFile(Id) {

        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteFile", "Employee", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (Result) {
                        reloadGrid();
                        $.alert.open("Message", Result);
                    },
                    error: function (request, status, error) {
                        $.alert.open("Message", "Error Occured");
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function reloadGrid() {

        var employeeId = $("#EmployeeId").val();

        //$('#grid').jtable('load', { filterColumn: '', filterValue: '' });
        $('#grid').jtable('load', { filterColumn: '', filterValue: '', EmployeeId: employeeId });
    }



</script>

