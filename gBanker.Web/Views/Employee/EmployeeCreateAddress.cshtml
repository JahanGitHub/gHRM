                                @using (Html.BeginForm("UpdateRosterAttendance", "Employee", FormMethod.Post, new { @role = "form", @class = "form-horizontal", @id = "add-or-edit-employee-roaster-form" }))
                                {
                                    @Html.HiddenFor(model => model.EmployeeId)
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label class="control-label col-sm-4 required">Time Keeping Roster</label>
                                                <div class="col-sm-8">
                                                    @Html.DropDownListFor(model => model.TimeKeepingRosterId, Model.AttendanceRosterList, new { @class = "form-control" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <div class="row section-roaster-time">
                                                    <div class="col-sm-3">
                                                    </div>
                                                    <div class="col-sm-3">
                                                        <span style="padding-left: 47px;">Login: <b class="roaster-login-time"></b></span>
                                                    </div>
                                                    <div class="col-sm-3">
                                                        <span style="padding-left: 24px;">Last Login: <b class="roaster-lastlogin-time"></b></span>
                                                    </div>
                                                    <div class="col-sm-3">
                                                        <span style="padding-left: 21px;">Logout: <b class="roaster-logout-time"></b></span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
