                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label class="control-label col-md-4 required"> Effective End Date </label>
                                                <div class="col-md-8">
                                                    @Html.EditorFor(model => model.RoasterEffectiveEndDate, new { htmlAttributes = new { @class = "form-control ddl-datepicker", @autoComplete = "off" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label class="control-label col-md-4">  </label>
                                                <div class="col-md-8">
                                                    <button type="submit" class="btn btn-primary"> Save </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

