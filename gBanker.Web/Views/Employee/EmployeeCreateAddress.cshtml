        $("#btnCertificateSave").show();
        $("#btnCertificateUpdate").hide();
        $("#btnCertificateRestore").hide();
        ClearCertificateInfoform();
    }

    function EditCertificateInformation(CertificateId, DegreeCode, Memo, NoOfCopies, EmployeeCertificateStatus, StatusDateForCertificate, Comment, CertificateType) {

        $("#CertificateId").val(CertificateId);
        $("#DegreeCode").val(DegreeCode);
        $("#Memo").val(Memo);
        $("#NoOfCopies").val(NoOfCopies);
        $("#EmployeeCertificateStatus").val('Receive');
        $("#CertificateStatusDate").val(StatusDateForCertificate);
        if (Comment != 'null' && Comment != '') {
            $("#Comment").val(Comment);
        }

        $("#CertificateType").val(CertificateType);
        $("#btnCertificateUpdate").show();
        //$("#btnCertificateRestore").show();
        $("#btnCertificateSave").hide();
        $('#CertificateAdd').hide();
        $('#btnAddGrid').hide();
        $('#btnWithdraw').hide();
        $('#btnRutern').hide();
    }

    function EditwithdrawCertificateInformation(CertificateId, DegreeCode, Memo, NoOfCopies, EmployeeCertificateStatus, StatusDateForCertificate, Comment, CertificateType) {

        $("#CertificateId").val(CertificateId);
        $("#DegreeCode").val(DegreeCode);
        $("#Memo").val(Memo);
        $("#NoOfCopies").val(NoOfCopies);
        $("#EmployeeCertificateStatus").val('TemporaryWithdrawal');
        $("#CertificateStatusDate").val(StatusDateForCertificate);
        var com = Comment;
        if (com == 'null') {
            com = '';
        }
        $("#Comment").val(com);
        $("#CertificateType").val(CertificateType);

        $("#btnCertificateUpdate").show();
        //$("#btnCertificateRestore").show();
        $("#btnCertificateSave").hide();
        $('#btnAddGrid').hide();
        $('#btnWithdraw').show();
        $('#btnRutern').hide();

        $('#CertificateAdd').show();
        $("#EmployeeCertificateStatus").val('Receive');
        resetcertificate();
