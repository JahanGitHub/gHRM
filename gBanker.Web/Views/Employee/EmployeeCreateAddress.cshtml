        var cgpa = $("#txtCGPA" + rowSl).val();
        var cgpaScale = $("#txtCGPAScale" + rowSl).val();
        var empEduId = $("#txtEmployeeEducationId" + rowSl).val();

        $("#DegreeTitle").val(degreeTitle);
        $("#Concentration").val(concentration);
        $("#InstitutionName").val(institutionName);
        $("#ResultType").val(resultTyp);
        if (resultTyp == "G") {
            $("#gradeDivId").show();
            $("#divisionDivId").hide();

            $("#CGPA").val(cgpa);
            $("#CGPAScale").val(cgpaScale);
        }
        else if (resultTyp == "D" || resultTyp == "C") {
            $("#divisionDivId").show();
            $("#gradeDivId").hide();

            $("#Division").val(division);
            $("#MarksPercentage").val(marksPercentage);
        }
        else {
            $('#divisionDivId').hide();
            $('#gradeDivId').hide();
        }
        $("#PassingYear").val(passingYear);
        $("#Duration").val(duration);
        $("#Acheivements").val(acheivements);
        $("#hdnEmpEducationEditId").val(empEduId);
        $("#hdnEmpEducationSave").val('U');

