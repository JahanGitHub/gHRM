@*Employee Official Info*@
<script type="text/javascript">
    var EMPLOYEE_EDIT_PAGE_CODE_EDIT_ENABLED = "@ViewBag.EMPLOYEE_EDIT_PAGE_CODE_EDIT_ENABLED" == "True";

    function GetDepartmentWiseSection() {
        var deptId = $("#DepartmentId").val();
        var ddlSection = $("#Section");
        if (deptId != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetDepartmentWiseSection", "Employee", "http")',
                data: { deptId: deptId },
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.length > 0) {
                        ddlSection.html("");
                        $.each(data, function (id, option) {
                            ddlSection.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlSection.html("<option value='0'>Please Select</option>");
                    }
                },
            });
        } else {

            ddlSection.html("<option value='0'>Please Select</option>");
        }
    }

    function InformationStatus(stsvalue) {
        LoadDropDown('/Employee/InformationStatus', { stsvalue: stsvalue }, '', '#EmployeeStatusId');
    }



</script>


@*Employee Supervisor*@
<script type="text/javascript">

    function GetSupervisorList(supervisorEmployeeRank) {
        var ddlSupervisor = $("#SupervisorId");

        var supervisorOfficeTypeId = $("#supervisorOfficeTypeId").val();
        var supervisorZoneId = $("#supervisorZoneId").val();
        var supervisorAreaId = $("#supervisorAreaId").val();
        var supervisorUnitId = $("#supervisorUnitId").val();
        var supervisorHOId = $("#supervisorHOId").val();
        var supervisorPRId = $("#supervisorPRId").val();
        var supervisorDepartmentId = $("#SupervisorDeptartmentId").val();
        var CurrentEmployeeId = $("#hdnEmpMasterId").val();
        if (supervisorOfficeTypeId != "" && supervisorDepartmentId != "" && CurrentEmployeeId > 0) {
            //$('#AjaxLoader').show();
            $.ajax({
                type: "GET", //GET or POST or PUT or DELETE verb
                url: '/Employee/GetSupervisorList', // Location of the service
                data: { OfficeTypeId: supervisorOfficeTypeId, HOId: supervisorHOId, PRId: supervisorPRId, ZoneId: supervisorZoneId, AreaId: supervisorAreaId, UnitId: supervisorUnitId, EmployeeRank: supervisorEmployeeRank, SupervisorDepartmentId: supervisorDepartmentId, CurrentEmployeeId: CurrentEmployeeId }, //Data sent to server
                dataType: "json", //Expected data format from server
                async: false,
                processdata: false, //True or False
                success: function (data) { //On Successful service call

                    ddlSupervisor.html('');
                    if (data.length > 0) {
                        $.each(data, function (i, option) {
                            ddlSupervisor.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                        });
                    }
                    //$('#AjaxLoader').hide();
                },
                error: function (data) {
                    //$('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
        } else {
            $.alert.open('Error', 'Please Provide All Required Fields');
        }
    }

    function GetSupervisorListByDepartment(supervisorDepartmentId) {

        var ddlSupervisor = $("#SupervisorId");
        var supervisorOfficeTypeId = $("#supervisorOfficeTypeId").val();
        var supervisorZoneId = $("#supervisorZoneId").val();
        var supervisorAreaId = $("#supervisorAreaId").val();
        var supervisorUnitId = $("#supervisorUnitId").val();
        var supervisorHOId = $("#supervisorHOId").val();
        var supervisorPRId = $("#supervisorPRId").val();
        var CurrentEmployeeId = $("#hdnEmpMasterId").val();

        if (supervisorDepartmentId != "" && supervisorOfficeTypeId != "" && CurrentEmployeeId > 0) {
            $.ajax({
                type: "GET",
                url: '/Employee/GetSupervisorListByDepartment',
                data: { OfficeTypeId: supervisorOfficeTypeId, HOId: supervisorHOId, PRId: supervisorPRId, ZoneId: supervisorZoneId, AreaId: supervisorAreaId, UnitId: supervisorUnitId, SupervisorDepartmentId: supervisorDepartmentId, CurrentEmployeeId: CurrentEmployeeId }, //Data sent to server
                dataType: "json",
                async: false,
                processdata: false,
                success: function (data) {

                    ddlSupervisor.html('');
                    if (data.length > 0) {
                        $.each(data, function (i, option) {
                            ddlSupervisor.append('<option value="' + option.Value + '">' + option.Text + '</option>');
                        });
                    }
                },
                error: function (data) {
                    $.alert.open('error', 'Please Provide All Required Fields');
                }
            });
        }
    }

    function GetSupervisorByOfficeType(supervisorEmployeeRank) {

        var supOfficeTypeId = $("#supervisorOfficeTypeId").val();

        if (supOfficeTypeId != "") {
            if (supOfficeTypeId == 1) {
                $("#supervisorHoDiv").show();
                $("#supervisorUnitDiv").hide();
                $("#supervisorZoneDiv").hide();
                $("#supervisorAreaDiv").hide();
                $("#supervisorPrDiv").hide();
            } else if (supOfficeTypeId == 3) {
                $("#supervisorUnitDiv").hide();
                $("#supervisorZoneDiv").hide();
                $("#supervisorAreaDiv").hide();
                $("#supervisorPrDiv").show();
                $("#supervisorHoDiv").hide();
            } else if (supOfficeTypeId == 4) {
                $("#supervisorUnitDiv").hide();
                $("#supervisorZoneDiv").show();
                $("#supervisorAreaDiv").hide();
                $("#supervisorPrDiv").hide();
                $("#supervisorHoDiv").hide();
            } else if (supOfficeTypeId == 5) {
                $("#supervisorUnitDiv").hide();
                $("#supervisorZoneDiv").show();
                $("#supervisorAreaDiv").show();
                $("#supervisorPrDiv").hide();
                $("#supervisorHoDiv").hide();
            } else if (supOfficeTypeId == 6) {
                $("#supervisorUnitDiv").show();
                $("#supervisorZoneDiv").show();
                $("#supervisorAreaDiv").show();
                $("#supervisorPrDiv").hide();
                $("#supervisorHoDiv").hide();
                $("#supervisorZoneId").prop('selectedIndex', 0);

            }
        } else {
            $("#supervisorUnitDiv").hide();
            $("#supervisorZoneDiv").hide();
            $("#supervisorAreaDiv").hide();
            $("#supervisorPrDiv").hide();
            $("#supervisorHoDiv").hide();
        }

        var ddlDepartmentId = $("#SupervisorDeptartmentId");

        if (supOfficeTypeId != "") {

            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetDeptListByOfficeType", "Employee", "http")',
                data: { officeTypeId: supOfficeTypeId },
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.length > 0) {
                        ddlDepartmentId.html("");
                        ddlDepartmentId.html('<option value="">Please Select</option>');

                        $.each(data, function (id, option) {
                            ddlDepartmentId.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlDepartmentId.html('<option value="">Please Select</option>');
                    }

                },
            });
        } else {
            ddlDepartmentId.html('<option value="">Please Select</option>');
        }


    }

    function getEmployeeSupervisorInfo() {

        $('#gridSupervisor').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            //defaultSorting: 'InventoryId ASC',
            actions: {
                listAction: function (postData, jtParams) {

                    return $.Deferred(function ($dfd) {
                        var employeId = $("#hdnEmpMasterId").val();
                        $.ajax({
                            url: '/Employee/getEmployeeSupervisorInfo?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&EmployeeId=' + employeId,
                            type: 'GET',
                            dataType: 'json',
                            data: postData,

                            success: function (data) {
                                debugger;
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                EmployeeId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                SupervisorId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                rowSl: {
                    title: 'Sl. No',
                    width: '15%'
                },
                SupervisorName: {
                    title: 'Supervisor Name',
                    width: '50%'
                },
                Delete: {
                    title: "Delete",
                    width: '15%',
                    display: function (data) {
                        return '<div class="text-center"><a href="javascript:void(0);" OnClick="DeleteSupervisorInfo(' + data.record.Id + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#gridSupervisor').jtable('load');
    }

    function DeleteSupervisorInfo(Id) {

        $.alert.open('confirm', 'Are you sure you want to delete this supervisor?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteSupervisorInfo", "Employee", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            getEmployeeSupervisorInfo();
                            $.alert.open("Error", data.message);
                        } else {

                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function DeleteEmployeeRoasterSchedule(id) {
        $.alert.open('confirm', 'Are you sure you want to delete this roaster schedule?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteEmployeeRoasterSchedule", "Employee", "http")',
                    data: { id: id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {

                            //get employee roaster schedule data
                            getAttendanceInfo();

                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

</script>


@*Employee Employee Educational Info*@
<script type="text/javascript">

    function GetDegreesByDegreeLevel() {

        var degreeLevelId = $("#DegreeLevel").val();
        var ddlDegreeTitle = $("#DegreeTitle");

        if (degreeLevelId != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetDegreesByDegreeLevel", "EducationSubjects", "http")',
                data: { degreeLevelId: degreeLevelId },
                dataType: 'json',
                async: false,
                success: function (data) {
                    if (data.length > 0) {
                        ddlDegreeTitle.html("");
                        ddlDegreeTitle.html('<option value="">Please Select</option>');
                        $.each(data, function (id, option) {
                            ddlDegreeTitle.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlDegreeTitle.html('<option value="">Please Select</option>');
                    }
                },
            });
        } else {
            ddlDegreeTitle.html('<option value="">Please Select</option>');
        }
    };


    function GetSubjectsByDegree() {

        var degreeCode = $("#DegreeTitle").val();
        var ddlConcentration = $("#Concentration");

        if (degreeCode != "") {
            $.ajax({
                type: 'GET',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("GetSubjectsByDegree", "EducationSubjects", "http")',
                data: { degreeCode: degreeCode },
                dataType: 'json',
                async: false,
                success: function (data) {
                    if (data.length > 0) {
                        ddlConcentration.html("");
                        ddlConcentration.html('<option value="">Please Select</option>');
                        $.each(data, function (id, option) {
                            ddlConcentration.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlConcentration.html('<option value="">Please Select</option>');
                    }
                },
            });
        } else {
            ddlConcentration.html('<option value="">Please Select</option>');
        }
    }

    function ValidateEducationInfo() {

        var resultTyp = $("#ResultType").val();
        var reqFieldsName = "";
        if (resultTyp === "E") {
            reqFieldsName = new Array('#DegreeTitle', '#DegreeTitle', '#ResultType', '#Concentration');
        }
        else {
            reqFieldsName = new Array('#DegreeTitle', '#DegreeTitle', '#ResultType', '#PassingYear', '#Concentration');
        }

        var fieldValidate = RequiredFieldValidate(reqFieldsName);
        if (fieldValidate == 1) {
            return true;
        }
        else {
            return false;
        }

    }

    function ClearEmployeeEducation() {
        $("#DegreeTitle").val('');
        $("#Concentration").val('');
        $("#InstitutionName").val('');
        $("#ResultType").val('0');
        if ($("#Division").val() != '')
            $("#Division").val('');
        if ($("#MarksPercentage").val() != '')
            $("#MarksPercentage").val('');

        if ($("#CGPA").val() != '')
            $("#CGPA").val('');
        if ($("#CGPAScale").val() != '')
            $("#CGPAScale").val('');

        $("#PassingYear").val('');
        $("#Duration").val('');
        $("#Acheivements").val('');
    }


    function reloadEducationGrid() {
        var empMasterId = $("#hdnEmpMasterId").val();
        var dtTable = $('#tblEducation');
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpEducationList", "Employee", "http")',
            data: { empMasterId: empMasterId },
            dataType: 'json',
            async: true,
            success: function (List_EmployeeEducationViewModel) {
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                $.each(List_EmployeeEducationViewModel, function (index, emp) {
                    var sl = index + 1;
                    var resultType;
                    if (emp.ResultType == 'G')
                        resultType = 'Grade';
                    else if (emp.ResultType == 'D')
                        resultType = 'Division';
                    else if (emp.ResultType == 'A')
                        resultType = 'Appeared';
                    else if (emp.ResultType == 'E')
                        resultType = 'Enrolled';
                    else if (emp.ResultType == 'P')
                        resultType = 'Passed';
                    tableBody.append('<tr>' +
                        '<td>' + ' ' + '</td>' +
                        '<td>' + emp.DegreeName + ' <input type="text" value="' + emp.DegreeTitle + '" style="display:none;" name="DegreeTitle" id="txtDegreeTitle' + sl + '" /></td>' +
                        '<td>' + emp.ConcentrationName + ' <input type="text" value="' + emp.ConcentrationName + '" style="display:none;" name="ConcentrationName" id="txtConcentrationName' + sl + '" /></td>' +
                        '<td>' + emp.InstitutionName + ' <input type="text" value="' + emp.InstitutionName + '" style="display:none;" name="InstitutionName" id="txtInstitutionName' + sl + '" /></td>' +
                        '<td>' + emp.PassingYear + ' <input type="text" value="' + emp.PassingYear + '" style="display:none;" name="PassingYear" id="txtPassingYear' + sl + '" /></td>' +
                        '<td>' + resultType + '</td>' +
                        '<td>' + emp.Division +  emp.MarksPercentage + '<input type="text" value="' + emp.MarksPercentage + '" style="display:none;" name="MarksPercentage" id="txtMarksPercentage' + sl + '" /></td>' +
                        '<td>' + emp.CGPA + '<input type="text" value="' + emp.CGPA + '" style="display:none;" name="CGPA" id="txtCGPA' + sl + '" /></td>' +
                         '<td><a href="#" OnClick="LoadEditEducation(' + sl + ');"><i class="fa fa-pencil-square-o"></i></a></td>' +
                        '<td><a href="#" OnClick="DeleteEducation(' + sl + ')"><i class="fa fa-trash-o"></i></a>' +
                        '<input type="text" value="' + emp.EducationId + '" style="display:none;" name="EmployeeEducationId" id="txtEmployeeEducationId' + sl + '" />' +
                        '<input type="text" value="' + emp.ResultType + '" style="display:none;" name="ResultType" id="txtResultType' + sl + '" />' +
                        '<input type="text" value="' + emp.Duration + '" style="display:none;" name="Duration" id="txtDuration' + sl + '" />' +
                        '<input type="text" value="' + emp.Acheivements + '" style="display:none;" name="Acheivements" id="txtAcheivements' + sl + '" />' +
                        '<input type="text" value="' + emp.Division + '" style="display:none;" name="Division" id="txtDivision' + sl + '" />' +
                        '<input type="text" value="' + emp.CGPAScale + '" style="display:none;" name="CGPAScale" id="txtCGPAScale' + sl + '" />' +
                        '<input type="text" value="' + emp.DegreeLevelId + '" style="display:none;" name="DegreeLevelId" id="txtDegreeLevelId' + sl + '" />' +
                        '<input type="text" value="' + emp.DegreeLevel + '" style="display:none;" name="DegreeLevel" id="txtDegreeLevel' + sl + '" />' +
                        '<input type="text" value="' + emp.Concentration + '" style="display:none;" name="txtConcentration" id="txtConcentration' + sl + '" />' +
                        '</tr>');
                });

            },
            error: function (request, status, error) {
                $("#loading").hide();
                $("#dvMessage").attr('class', 'failed');
                $("#dvMessage").html(request.statusText);
                $("#dvMessage").show();
            }
        });
    }


    function DeleteEducation(rowSl) {
        $.alert.open('confirm', 'Are you sure, you want to delete this record?', function (button) {
            if (button == 'yes') {
                var empEduId = $("#txtEmployeeEducationId" + rowSl).val();
                var empMasterId = $("#hdnEmpMasterId").val();
                if (empEduId == '') {
                    empEduId = 0;
                }

                if (empMasterId > 0) {
                    $.ajax({
                        type: 'GET',
                        contentType: "application/json; charset=utf-8",
                        url: '@Url.Action("DeleteEmpEducation", "Employee", "http")',
                        data: { empEduId: empEduId, empMasterId: empMasterId },
                        dataType: 'json',
                        async: true,
                        success: function (empEduId) {
                            if (empEduId > 0) {
                                reloadEducationGrid();
                                $("#hdnEmpEducationSave").val('S');
