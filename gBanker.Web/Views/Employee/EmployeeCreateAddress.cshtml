        $("#PassportIssueDate").blur(function () {

            var dt = $("#PassportIssueDate").val();
            if (dt != "") {
                var delayMillis = 200;

                setTimeout(function () {
                    var validationYears = 5 * 12; //  years to month
                    var passIssueDate = $("#PassportIssueDate").val();

                    var issueDate = new Date(MakeDate(passIssueDate));
                    var expireDate = issueDate.setMonth(issueDate.getMonth() + validationYears);
                    var dd = new Date(expireDate - 1);
                    var date = DateConversionToLongDate(dd);
                    $("#PassportExpireDate").val(date);
                }, delayMillis);
            }
        });

