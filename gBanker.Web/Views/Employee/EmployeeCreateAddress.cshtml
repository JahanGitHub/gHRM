                                     '<td>' + CertificateType + '<input type="text" value="' + CertificateType + '" style="display:none;" name="CertificateType" id="txtCertificateType' + NewSl + '" /></td>' +
                                     '<td>' + EmployeeCertificateStatus + '<input type="text" value="' + EmployeeCertificateStatus + '" style="display:none;" name="EmployeeCertificateStatus" id="txtEmployeeCertificateStatus' + NewSl + '" /></td>' +
                                     '<td>' + comment + '<input type="text" value="' + comment + '" style="display:none;" name="comment" id="txtcomment' + NewSl + '" /></td>' +
                                     '<td>' + StatusDate + '<input type="text" value="' + StatusDate + '" style="display:none;" name="StatusDate" id="txtStatusDate' + NewSl + '" /></td>' +
                                     '<td>' + EmployeeId + '<input type="text" value="' + EmployeeId + '" style="display:none;" name="StatusDate" id="txtEmployeeId" /></td>' +

                                     '<td style="text-align:center;">' +
                                         '<a href="javascript:;" onclick="delete_row(' + NewSl + ')"><i class="fa fa-trash-o fa-2x"></i></a>' +
                                         '<input type="text" value="' + NewSl + '" style="display:none;" name="NewSl" id="txtNewSl' + NewSl + '" />' +
