    function SaveEmployeeGuarantorInformation() {
        var empMasterId = $("#hdnEmpMasterId").val();

        if (empMasterId > 0) {
            var guarantorInfo = GenerateEmployeeGuarantorInformation();

            if (guarantorInfo.gRType != "" && guarantorInfo.GuarantorName != "" && guarantorInfo.GuarantorRelationshipId != "" &&
                guarantorInfo.OccupationId != "" && guarantorInfo.ContactNo != "") {

                var img = document.getElementById("GuarantorImage").value;
                if (guarantorInfo.gRType == "Guarantor" && (GuaranteeMoney == 0 || GuaranteeMoney == "")) {
                    $.alert.open("Error", "Please Add Guarantee money for Guarantor");
                    return false;
                }

                $.ajax({
                    type: "POST",
                    dataType: "json",
                    async: false,
                    cache: false,
                    url: '@Url.Action("SaveEmployeeGuarantorInformation", "Employee")',
                    data: JSON.stringify({ employeeGuarantorInformation: guarantorInfo }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {

                        if (data.result > 0) {
                            var guarantorId = data.result;
                            var xhr = new XMLHttpRequest();
                            var fd = new FormData();
                            fd.append("file", document.getElementById("GuarantorImage").files[0]);
                            fd.append("GuarantorId", guarantorId);
                            xhr.open("POST", "/Employee/UploadGuarantorImage/", true);
                            xhr.send(fd);
                            xhr.addEventListener("load", function (event) {
                                if (event.target.response > 0) {
                                    $(".panel-body .create-success").show(800).fadeToggle(3000);
                                } else {
                                    $.alert.open("Error", "Image couldn't Save");
                                }
                            }, false);

                            $.alert.open(data.message);

                            $('#gridGuarantor').jtable('load');
                            ClearControl();
                        } else {
                            $.alert.open('Error', data);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert(error);
                    }
                });
            } else {
                $.alert.open("Error", "Please Insert Required Fields");
            }
        } else {
            $.alert.open("Error", "At first save an employee");
        }
    }

    function UpdateEmployeeGuarantorInformation() {

        var employeeGuarantorInformation = GenerateEmployeeGuarantorInformation();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateEmployeeGuarantorInformation", "Employee")',
            data: JSON.stringify({ employeeGuarantorInformation: employeeGuarantorInformation }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.result > 0) {
                    var guarantorId = data.result;
                    var xhr = new XMLHttpRequest();
                    var fd = new FormData();
                    fd.append("file", document.getElementById("GuarantorImage").files[0]);
                    fd.append("GuarantorId", guarantorId);
                    xhr.open("POST", "/Employee/UploadGuarantorImage/", true);
