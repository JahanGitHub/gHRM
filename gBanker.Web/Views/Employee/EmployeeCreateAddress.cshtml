    function resetcertificate() {
        $('#btnAddGrid').show();
        $("#CertificateId").val('');
        $("#DegreeCode").val('');
        $("#NoOfCopies").val('');
        $("#EmployeeCertificateStatus").val('Receive');
        $("#CertificateStatusDate").val('');
        $("#Comment").val('');
        $("#CertificateType").val('');
    }

    function UpdateCertificateInfo() {
        var id = $("#CertificateId").val();
        var DegreeCode = $("#DegreeCode").val();
        var NoOfCopies = $("#NoOfCopies").val();
        var EmployeeCertificateStatus = $("#EmployeeCertificateStatus").val();
        var StatusDate = $("#CertificateStatusDate").val();
        var comment = $("#Comment").val();
        var CertificateType = $("#CertificateType").val();

        if (DegreeCode != "" && EmployeeCertificateStatus != "" && StatusDate != "") {

            var item = {
                Id: id,
                DegreeCode: DegreeCode,
                NoOfCopies: NoOfCopies,
                EmployeeCertificateStatus: EmployeeCertificateStatus,
                StatusDate: StatusDate,
                Comment: comment,
                CertificateType: CertificateType
            }
            $.ajax({
                type: 'POST',
                contentType: "application/json; charset=utf-8",
                url: '@Url.Action("UpdateCertificatesInfo", "Employee", "http")',
                data: JSON.stringify({ data: item }),
                dataType: 'json',
                async: true,
                success: function (data) {
                    if (data.result == 1) {
                        $(".panel-body .create-success").show(800).fadeToggle(3000);
                        $.alert.open("Success", data.message);
                        // $("#btnCertificateUpdate").hide();
                        //ClearCertificateInfoform();
                        ResetCertificateInfo();
                        getEmployeeCertificateInfo();
                        $("#btnAddGrid").show();
                    } else {

                        $.alert.open("Error", data.message);
                    }
                },
                error: function (request, status, error) {
                    alert(error);
                }
            });
        }
    };

    function AddCertificateInformations() {

        $('#CertificateAdd').show();
        var EmployeeId = $("#hdnEmpMasterId").val();
        var Memo = $("#Memo").val();
        var DegreeCode = $("#DegreeCode").val();
        var DegreeCodeText = $("#DegreeCode option:selected").text();
        var CertificateType = $("#CertificateType").val();
        var EmployeeCertificateStatus = $("#EmployeeCertificateStatus").val();
        var comment = $("#Comment").val();
        var StatusDate = $("#CertificateStatusDate").val();

        var dtTable = $('#tblPostingProposal');
