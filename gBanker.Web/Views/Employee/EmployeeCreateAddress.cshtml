            yearRange: "1900:2050",
            onClose: function () {

                var today = new Date(($("#ServerCurrentDate").val()));
                var dt = $("#DateOfBirth").val();
                //var bd = new Date(MakeDate(dt));
                var birthDate = new Date(MakeDate(dt));//new Date(($("#DateOfBirth").val()));

                if (birthDate != 'Invalid Date') {
                    var age = today.getFullYear() - birthDate.getFullYear();
                    var m = today.getMonth() - birthDate.getMonth();
                    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                        age--;
                    }
                    if (age >= 18) {
                        return true;
                    }
                    else {
                        $("#DateOfBirth").val('');
                        $.alert.open('info', 'Employee age must be greater than 18');
                    }
                }
            }
        });

