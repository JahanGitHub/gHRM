@* Employee Certificates Info*@
<script type="text/javascript">

    function GetMaxMemoNumber() {
        var employeId = '@Model.EmployeeId';
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetMaxMemoNumber", "Employee", "http")',
            data: { employeId: employeId },
            dataType: 'json',
            async: true,
            success: function (data) {
                $('#Memo').val(data.nomemo);
            },
            error: function (request, status, error) {
            }
        });
    }

    function getEmployeeCertificateInfo() {

        GetMaxMemoNumber();
        $('#CertificateAdd').hide();
        $('#btnWithdraw').hide();
        $('#btnRutern').show();

        $('#gridCertificate').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            //defaultSorting: 'InventoryId ASC',
            actions: {
                listAction: function (postData, jtParams) {

                    return $.Deferred(function ($dfd) {
                        var employeId = $("#hdnEmpMasterId").val();
                        $.ajax({
                            url: '/Employee/GetEmployeeCertificateInformation?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting + '&employeeId=' + employeId,
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                CertificateId: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                DegreeCode: {
                    key: true,
                    list: false,
                    create: false,
                    edit: true
                },

                DegreeLevel: {
                    title: 'Degree Level',
                    width: '5%'
                },
                Memo: {
                    title: 'Memo',
                    width: '5%'
                },
                EmployeeCertificateStatus: {
                    title: 'Status',
                    width: '15%',
                    display: function (data) {
                        if (data.record.EmployeeCertificateStatus == "Receive") {
                            return "Receive"
                        } else if (data.record.EmployeeCertificateStatus == "Return") {
                            return "Return"
                        } else if (data.record.EmployeeCertificateStatus == "TemporaryWithdrawal") {
                            return "TemporaryWithdrawal"
                        }
                    }
                },
                StatusDateForCertificate: {
                    title: 'StatusDate',
                    width: '10%'
                },
                Comment: {
                    title: 'Comment',
                    width: '15%'
                },
                withdraw: {
                    title: "withdraw",
                    width: '2%',
                    sorting: false,
                    display: function (data) {
                        if (data.record.EmployeeCertificateStatus == "Receive") {
                            return '<div class="text-center"><a href="#" OnClick="WithdrawCertificateInformations(' + "'" + data.record.CertificateId + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                        } else if (data.record.EmployeeCertificateStatus == "Return") {
                            return ""
                        } else if (data.record.EmployeeCertificateStatus == "TemporaryWithdrawal") {
                            return ""
                        }
                    }
                },
                EditLink: {
                    title: "Edit",
                    width: '2%',
                    sorting: false,
                    display: function (data) {
                        if (data.record.EmployeeCertificateStatus == "Receive") {
                            return '<div class="text-center"><a href="#" OnClick="EditCertificateInformation(' + "'" + data.record.CertificateId + "'" + ',' + "'" + data.record.DegreeCode + "'" + ',' + "'" + data.record.Memo + "'" + ',' + "'" + data.record.NoOfCopies + "'" + ',' + "'" + data.record.EmployeeCertificateStatus + "'" + ',' + "'" + data.record.StatusDateForCertificate + "'" + ',' + "'" + data.record.Comment + "'" + ',' + "'" + data.record.CertificateType + "'" + ' );"><i class="fa fa-pencil-square-o"></i></a></div>';
                        } else if (data.record.EmployeeCertificateStatus == "Return") {
                            return ""
                        } else if (data.record.EmployeeCertificateStatus == "TemporaryWithdrawal") {
                            return '<div class="text-center"><a href="#" OnClick="EditCertificateInformation(' + "'" + data.record.CertificateId + "'" + ',' + "'" + data.record.DegreeCode + "'" + ',' + "'" + data.record.Memo + "'" + ',' + "'" + data.record.NoOfCopies + "'" + ',' + "'" + data.record.EmployeeCertificateStatus + "'" + ',' + "'" + data.record.StatusDateForCertificate + "'" + ',' + "'" + data.record.Comment + "'" + ',' + "'" + data.record.CertificateType + "'" + ' );"><i class="fa fa-pencil-square-o"></i></a></div>';
                        }
                    }
                },
                Delete: {
                    title: "Delete",
                    width: '2%',
                    display: function (data) {
                        if (data.record.EmployeeCertificateStatus == "Receive") {
                            return '<div class="text-center"><a href="#" OnClick="DeleteCertificateInfo(' + data.record.CertificateId + ');"><i class="fa fa-trash-o"></i></a></div>';
                        } else if (data.record.EmployeeCertificateStatus == "Return") {
                            return ""
                        } else if (data.record.EmployeeCertificateStatus == "TemporaryWithdrawal") {
                            return ""
                        }
                    }
                },
            }
        });
        $('#gridCertificate').jtable('load');
    }

    function ClearCertificateInfoform() {
        $("#DegreeCode").val('');
        $("#Memo").val('');
        $("#NoOfCopies").val('');
        $("#EmployeeCertificateStatus").val('Receive');
        $("#Comment").val('');
        $("#CertificateType").val('');
    }

