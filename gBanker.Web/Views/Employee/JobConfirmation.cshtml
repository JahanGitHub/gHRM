            <label class="control-label col-md-4">Section</label>
            <div class="col-md-8">
                @Html.DropDownListFor(model => model.Section, Model.SectionList, new { @class = "form-control" })
            </div>
        </div>
    </div>
</div>



<div class="row" style="margin-top:15px;">
    <div class="col-sm-6">
        <div class="form-group">
            <label class="control-label col-md-4">From Date</label>
            <div class="col-sm-8">
                @Html.TextBoxFor(model => model.Date, new { @class = "form-control" })
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            <label class="control-label col-md-4">To Date</label>
            <div class="col-sm-8">
                @Html.TextBoxFor(model => model.DateTo, new { @class = "form-control" })
            </div>
        </div>
    </div>

</div>





<div class="row" style="margin-top:15px;">
    <div class="col-sm-6">
        <div class="form-group">
            <div class="col-md-4 ">
                <label class="control-label" style="padding-top:8px;"> Search By(Code/Name):</label>
            </div>
            <div class="col-md-8">
                <select id="filterColumn" class="form-control">
                    <option value="">Please Select</option>
                    <option value="EmployeeCode">Employee Code</option>
                    <option value="EmployeeName">Employee Name</option>
                    <option value="Joining">Joining Date</option>
                </select>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <input type="text" id="filterValue" placeholder="Type Search Text" class="form-control" />
    </div>
    <div class="col-md-2 text-center">
        <input type="button" id="btnSearch" value="Search" class="btn btn-primary" />
        @Html.Label("" + ViewData["SecondLevel"], new { @ID = "hfSecondLevel", @Style = "display:none;" })
        @Html.Label("" + ViewData["ThirdLevel"], new { @ID = "hfThirdLevel", @Style = "display:none;" })
        @Html.Label("" + ViewData["FourthLevel"], new { @ID = "hfFourthLevel", @Style = "display:none;" })

        @Html.Label("" + ViewData["SecondLevelId"], new { @ID = "hfSecondLevelId", @Style = "display:none;" })
        @Html.Label("" + ViewData["ThirdLevelId"], new { @ID = "hfThirdLevelId", @Style = "display:none;" })
        @Html.Label("" + ViewData["FourthLevelId"], new { @ID = "hfFourthLevelId", @Style = "display:none;" })
    </div>
</div>


