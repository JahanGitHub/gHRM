    function EmployeeDelete(employeeId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("EmployeeDelete", "Employee", "http")',
                    data: { employeeId: employeeId },
                    dataType: 'json',
                    async: true,
                    success: function (response) {
                        debugger;
                        if (response.result = 1) {
                            SetSearchParameters();
                        }
                        else {
                            alert(response.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function GetPrintEmployeeProfile(EmployeeCode) {
        var url = '/EmployeeProfileReport/FullProfileReport?EmployeeCode=' + EmployeeCode;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
        //SetSearchParameters2();
    }

    function ExportOfficeTypeEmployee(option) {
        // option = 1 Excell
        //option = 2 PDF
        url = '/Employee/GenerateReportEmployee?DownloadExcel=' + option; //DownloadExcel

        if (option != 1)
            window.open(url, 'mywindow', 'fillscreen=yes, scrollbars = auto');

        window.open(url);

    }


    $(document).ready(function () {

        var officeTypeIddv = $("#OfficeTypeId").val();
        if (officeTypeIddv != "") {
            if (officeTypeIddv == 1) {
                alert(officeTypeIddv);
                $("#dvExcelDownload").show();
            }
        }




        InformationStatus(true);

        $('input[name=empStatus]').click(function () {
            $('.selectpicker').selectpicker('deselectAll');
            let status_text = $('input[name=empStatus]:checked').val();

            if (status_text == "Active") {
                InformationStatus(true);
            }
            else if (status_text == "InActive") {
                InformationStatus(false);
            }
            else {
                $('.selectpicker').selectpicker('selectAll');
                //$('.selectpicker').selectpicker('val', statusArray);
                //$('.selectpicker').selectpicker('val', 'Probationary');
                //$('#typeFilterColumn').val(['1', '2', '3', '4', '9']);
                //$("#typeFilterColumn option:contains('Probationary')").val();
                //$("#typeFilterColumn option:contains('Probationary')").attr('selected', true);
                $('.selectpicker').selectpicker('refresh');
            }
        });

        $("#DepartmentId").change(function () {
            var deptId = $("#DepartmentId").val();
            var ddlSection = $("#Section");
            if (deptId != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetDepartmentWiseSection", "Employee", "http")',
                    data: { deptId: deptId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            ddlSection.html("");
                            $.each(data, function (id, option) {
                                ddlSection.append($('<option></option>').val(option.Value).html(option.Text));
                            });
                        } else {
                            ddlSection.html("<option value=''>Please Select</option>");
                        }
                    },
                });
            } else {

                ddlSection.html("<option value='0'>Please Select</option>");
            }
        });

        $("#btnSearch").click(function () {
            SetSearchParameters();
        });

        $("#filterColumn").change(function () {
            $("#filterValue").val('');
            if ($(this).val() != "ViewAll") {
                if ($(this).val() == "Joining") {
                    $("#filterValue").datepicker(
                     {
                         dateFormat: "dd-M-yy",
                         showAnim: "scale",
                     });
                }
                else if ($(this).val() == "Posting") {
                    $("#filterValue").datepicker(
                    {
                        dateFormat: "dd-M-yy",
                        showAnim: "scale",
                    });
                }
                else if ($(this).val() == "Promotion") {
                    $("#filterValue").datepicker(
                     {
                         dateFormat: "dd-M-yy",
                         showAnim: "scale",
                     });
                }
                else {
                    $("#filterValue").datepicker("destroy");

                }
            }
        });
    });

    function InformationStatus(stsvalue) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("InformationStatus", "Employee", "http")',
            data: { stsvalue: stsvalue } ,
            dataType: 'json',
            async: true,
            success: function (response) {
                $.each(response.Data, function (index, status) {
                    if (status.Value) {
                        $("#typeFilterColumn option").filter(function () {
                            return $(this).text() == status.Text;
                        }).prop("selected", true);
                    }
                });

                $('.selectpicker').selectpicker('refresh');

            },
        });

    }

</script>

