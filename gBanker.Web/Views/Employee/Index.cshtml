     $("#EmployeeStatusId,#StatusPeriodInMonth,#FirstJoiningDateMsg").change(function (e) {
            e.preventDefault();

            var flag = 0;
            var EmployeeStatusId = $("#EmployeeStatusId").val();
            var AgreementPeriodInMonth = $("#StatusPeriodInMonth").val();
            var FirstJoiningDateMsg = $("#FirstJoiningDateMsg").val();

            if (EmployeeStatusId == "3") {

                $('#AjaxLoader').show();
                $.ajax({
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetDateForJobConfirmation", "Employee", "http")',
                    data: JSON.stringify({ EmployeeStatusId: EmployeeStatusId, AgreementPeriodInMonth: AgreementPeriodInMonth, FirstJoiningDateMsg: FirstJoiningDateMsg }),
                    dataType: 'json',
                    resetForm: true,
                    async: false,
                    success: function (Result) {
                        console.log(Result);
                        // var array = JSON.parse(Result);
                        $('#AjaxLoader').hide();
                        //if (!$.trim(Result)) {

                        // $.alert.open('Success', "Saved Successfully");
                        $("#StatusFromDate").val("");
                        $("#ConfirmationDate").val("");
                        $("#StatusToDate").val("");
                        //  GetLanguageFluencyList(EmployeeId);//


                        $("#StatusFromDate").val(Result.FirstJoiningDateMsg);
                        $("#StatusToDate").val(Result.AddMonth);
                        $("#ConfirmationDate").val(Result.AddMonth);

                        $("#StatusFromDate").prop("readonly", true);
                        $("#StatusToDate").prop("readonly", true);


                        $("#StatusFromDate").datepicker("option", "disabled", true);
                        $("#StatusToDate").datepicker("option", "disabled", true);


                        //} else {
                        //    $.alert.open('error', Result.message + " Hello");
                        //}
                    },
                    error: function () {
                        $('#AjaxLoader').hide();
                        $(".create-fail").show(800).fadeToggle(3000);
                        $("#dialog-message").html('<p>Error, Fail to Fetch.</p>');
                        $("#dialog-message").dialog({
                            modal: true,
                            buttons: {
                                Ok: function () {
                                    $(this).dialog("close");
                                }
                            }
                        });
                    }
                });
            }

            else {

                $("#StatusFromDate").prop("readonly", false);
                $("#StatusToDate").prop("readonly", false);


                $("#StatusFromDate").datepicker("option", "disabled", false);
                $("#StatusToDate").datepicker("option", "disabled", false);

            }
        });


    function GetPostingDetails(EmployeeId) {
        var dtTable = $('#tblPostingDetails');
        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetPostingDetails", "Employee", "http")',
            data: { EmployeeId: EmployeeId },
            dataType: "json",
            success: function (data) {
                var dataRows = data;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();

                for (var i = 0; i < dataRows.length; i++) {
                    tableBody.append('<tr>' +
                                        '<td align="center" width="5%">' + dataRows[i].sl + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].OfficeName + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].DepartmentName + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].DesignationName + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].DepartureDate + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].JoiningDate + '</td>' +
                                     '</tr>');
                }
                $('#element_to_pop_up').bPopup({
                    speed: 450,
                    transition: 'slideDown'

                });
            },
            error: function () {
                alert("An error has occurred during processing your request.");
            }
        });
    }


