<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.12.4/css/bootstrap-select.min.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()">
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-select/1.12.4/js/bootstrap-select.min.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>


<script type="text/javascript">

    function SetSearchParameters() {
        var OfficeId = "";
        var DeptId = "";

        var officeTypeId = $("#OfficeTypeId").val();
        if (officeTypeId != "") {
            if (officeTypeId == 1) {
                OfficeId = $("#PVHeadOfficeId").val();
            } else if (officeTypeId == 3) {
                OfficeId = $("#PVProjectId").val();
            }
            else if (officeTypeId == 4) {
                OfficeId = $("#ZoneId").val();
            }
            else if (officeTypeId == 5) {
                OfficeId = $("#AreaId").val();
            }
            else if (officeTypeId == 6) {
                OfficeId = $("#UnitId").val();
            }
        }
        var deptId = $("#DepartmentId").val();
        if (deptId != "") {
            DeptId = deptId;
        } else {
            DeptId = "";
        }
        var payRollDesignation = $("#DesignationId").val();
        var responsibility = $("#OfficeDesignationId").val();
        var status = $('#typeFilterColumn').val();
        var filterColumn = $("#filterColumn").val();
        var filterValue = $("#filterValue").val();
        if (filterColumn != "" && filterValue == "") {
            $.alert.open("Error", "Please Provide Filter Value");
            return false;
        }

        var Section = $("#Section").val();
        if (Section == "0") {
            Section = "";
        }

        LoadEmployeeList(officeTypeId, OfficeId, DeptId, payRollDesignation, responsibility, Section, status, filterColumn, filterValue);
    }

    function LoadEmployeeList(OfficeTypeId, OfficeId, DeptId, payRollDesignation, responsibility, Section, status, filterColumn, filterValue) {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("LoadEmployeeList", "Employee", "http")',
                    dataType: 'json',
                    data: { OfficeTypeId: OfficeTypeId, OfficeId: OfficeId, DepartmentId: DeptId, PayrollDesignation: payRollDesignation, Responsibility: responsibility, Section:Section, Status: status, FilterColumn: filterColumn, FilterValue: filterValue }
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "EmployeeId",
                    hidden: true,
                    filterable: false
                },
                 {
                     field: "ImageFilePath",
                     title: "Image",
                     width: "30px",
                     filterable: false,
                     template: function (dataItem) {
                         if (dataItem.ImageFilePath != null) {
                             return '<img src="' + dataItem.ImageFilePath + '" height="50" width="50" alt="No Image" class="img-circle"/>'
                         } else {
                             return '<img src="../../Images/blank-headshot.jpg" height="50" width="50" alt="No Image" class="img-circle"/>'
                         }
                     }
                 },
                {
                    field: "EmployeeCode",
                    title: "Code",
                    width: "25px",
                    filterable: true,
                },
                {
                    field: "EmployeeName",
                    title: "Name",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "DesignationName",
                    title: "Designation",
                    width: "30px",
                    filterable: true,
                },
                {
                    field: "OrnamentalDesignationName",
                    title: "Ornamental Designation",
                    width: "50px",
                    filterable: true,
                },
                {
                    field: "OfficeTypeName",
                    title: "Office Type",
                    width: "35px",
                    filterable: true,
                },
                {
                    field: "OfficeName",
                    title: "Office",
                    width: "40px",
                    filterable: true,
                },
                {
                    title: "Posting",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' onclick = 'GetPostingDetails(" + dataItem.EmployeeId + ");'><i class='fa fa-bars'></i></a>";
                    }
                },
                {
                    title: "Promotion",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' onclick = 'GetPromotionDetails(" + dataItem.EmployeeId + ");'><i class='fa fa-bars'></i></a>";
                    }
                },
                {
                    title: "Disciplinary",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' onclick = 'GetDisciplinaryDetails(" + dataItem.EmployeeId + ");'><i class='fa fa-bars'></i></a>";
                    }
                },
                {
                    field: "Phone",
                    title: "Phone",
                    width: "35px",
                    filterable: false,
                },
                {
                    field: "EmployementTypeName",
                    title: "Type",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "EmployeeStatus",
                    title: "Status",
                    width: "25px",
                    filterable: false,
                },
                {
                    field: "StatusDateMsg",
                    title: "Status Date",
                    width: "40px",
                    filterable: false,
                },
                {
                    title: "Edit",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='/Employee/EmployeeCreate/?EmployeeId=" + dataItem.EmployeeId + "'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                },
                 //{
                 //    title: "Delete",
                 //    width: "20px",
                 //    template: function (dataItem) {
                 //        return "<a href='#' OnClick='EmployeeDelete(" + dataItem.EmployeeId + ");'><i class='fa fa-trash-o'></i></a>";
                 //    }
                 //},
                {
                    title: "Print",
                    width: "20px",
                    template: function (dataItem) {
                        return "<a href='#' OnClick='GetPrintEmployeeProfile(" + '"' + dataItem.EmployeeCode + '"' + ");'><i class='fa fa-print'></i></a>";
                        //return "<a href='#' OnClick='RegisterResetPassword(" + '"' + dataItem.Id + '"' + ");'><i class='fa fa-pencil-square-o'></i></a>";
                    }
                }
            ]
        });
    }


    function GetPostingDetails(EmployeeId) {
        var dtTable = $('#tblPostingDetails');
        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetPostingDetails", "Employee", "http")',
            data: { EmployeeId: EmployeeId },
            dataType: "json",
            success: function (data) {
                var dataRows = data;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();

                for (var i = 0; i < dataRows.length; i++) {
                    tableBody.append('<tr>' +
                                        '<td align="center" width="5%">' + dataRows[i].sl + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].OfficeName + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].DepartmentName + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].DesignationName + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].DepartureDate + '</td>' +
                                        '<td align="center" width="15%">' + dataRows[i].JoiningDate + '</td>' +
                                     '</tr>');
                }
                $('#element_to_pop_up').bPopup({
                    speed: 450,
                    transition: 'slideDown'

                });
            },
            error: function () {
                alert("An error has occurred during processing your request.");
            }
        });
    }


    function GetDisciplinaryDetails(EmployeeId) {
        var dtTable = $('#tblDisciplinaryDetails');
        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("GetEmpDisciplinaryHistoryList", "Employee", "http")',
            data: { EmployeeId: EmployeeId },
            dataType: "json",
            success: function (data) {
                var dataRows = data;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                for (var i = 0; i < dataRows.length; i++) {
                    tableBody.append('<tr>' +
                                        '<td align="center" width="10%">' + dataRows[i].RowSl + '</td>' +
                                        '<td align="center" width="20%">' + dataRows[i].IncidentNo + '</td>' +
                                        '<td align="center" width="20%">' + dataRows[i].IncidentDateMsg + '</td>' +
                                        '<td align="center" width="25%">' + dataRows[i].PunishmentName + '</td>' +
                                        '<td align="center" width="25%">' + dataRows[i].PunishementDateMsg + '</td>' +
                                     '</tr>');
                }
                $('#element_to_pop_up3').bPopup({
                    speed: 450,
                    transition: 'slideDown'

                });
            },
            error: function () {
                alert("An error has occurred during processing your request.");
            }
        });
    }

    function GetPromotionDetails(EmployeeId) {
        var dtTable = $('#tblPromotionDetails');
        $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("LoadPreviousDataList", "EmployeePromotionConfiguration", "http")',
            data: { EmployeeId: EmployeeId },
            dataType: "json",
            success: function (data) {
                debugger;
                var dataRows = data.data;
                var tableBody = dtTable.find('tbody');
                tableBody.empty();
                for (var i = 0; i < dataRows.length; i++) {
                    tableBody.append('<tr>' +
                                        '<td align="center" width="5%">' + dataRows[i].RowSl + '</td>' +
                                        '<td align="center" width="10%">' + dataRows[i].PromotionTypeName + '</td>' +
                                        '<td align="center" width="20%">' + dataRows[i].DesignationName + '</td>' +
                                        '<td align="center" width="20%">' + dataRows[i].IsReviewedString + '</td>' +
                                        '<td align="center" width="20%">' + dataRows[i].PromotionDateMsg + '</td>' +
                                        '<td align="center" width="20%">' + dataRows[i].NextReviewDateMsg + '</td>' +
                                     '</tr>');
                }
                $('#element_to_pop_up2').bPopup({
                    speed: 450,
                    transition: 'slideDown'

                });
            },
            error: function () {
                alert("An error has occurred during processing your request.");
            }
        });
    }


    function GetPrintDataById(EmployeeId) {
        window.open('@Url.Action("Details", "Employee")?EmployeeId=' + EmployeeId);
    }

    function EmployeeDelete(employeeId) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("EmployeeDelete", "Employee", "http")',
                    data: { employeeId: employeeId },
                    dataType: 'json',
                    async: true,
                    success: function (response) {
                        debugger;
                        if (response.result = 1) {
                            SetSearchParameters();
                        }
                        else {
                            alert(response.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    function GetPrintEmployeeProfile(EmployeeCode) {
        var url;
        //url = '/Employee/GetPrintEmployeeProfile?EmployeeId=' + EmployeeId;
        url = '/EmployeeProfileReport/FullProfileReport?EmployeeCode=' + EmployeeCode;
        window.open(url, 'mywindow', 'fullscreen=yes, scrollbars=auto');
    }

    $(document).ready(function () {

        InformationStatus(true);

        $('input[name=empStatus]').click(function () {
            $('.selectpicker').selectpicker('deselectAll');
            let status_text = $('input[name=empStatus]:checked').val();

            if (status_text == "Active") {
                InformationStatus(true);
            }
            else if (status_text == "InActive") {
                InformationStatus(false);
            }
            else {
                $('.selectpicker').selectpicker('selectAll');
                //$('.selectpicker').selectpicker('val', statusArray);
                //$('.selectpicker').selectpicker('val', 'Probationary');
                //$('#typeFilterColumn').val(['1', '2', '3', '4', '9']);
                //$("#typeFilterColumn option:contains('Probationary')").val();
                //$("#typeFilterColumn option:contains('Probationary')").attr('selected', true);
                $('.selectpicker').selectpicker('refresh');
            }
        });

        $("#DepartmentId").change(function () {
            var deptId = $("#DepartmentId").val();
            var ddlSection = $("#Section");
            if (deptId != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetDepartmentWiseSection", "Employee", "http")',
                    data: { deptId: deptId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            ddlSection.html("");
                            $.each(data, function (id, option) {
                                ddlSection.append($('<option></option>').val(option.Value).html(option.Text));
                            });
                        } else {
                            ddlSection.html("<option value=''>Please Select</option>");
                        }
                    },
                });
            } else {

                ddlSection.html("<option value='0'>Please Select</option>");
            }
        });

        $("#btnSearch").click(function () {
            SetSearchParameters();
        });

        $("#filterColumn").change(function () {
            $("#filterValue").val('');
            if ($(this).val() != "ViewAll") {
                if ($(this).val() == "Joining") {
                    $("#filterValue").datepicker(
                     {
                         dateFormat: "dd-M-yy",
                         showAnim: "scale",
                     });
                }
                else if ($(this).val() == "Posting") {
                    $("#filterValue").datepicker(
                    {
                        dateFormat: "dd-M-yy",
                        showAnim: "scale",
                    });
                }
                else if ($(this).val() == "Promotion") {
                    $("#filterValue").datepicker(
                     {
                         dateFormat: "dd-M-yy",
                         showAnim: "scale",
                     });
                }
                else {
                    $("#filterValue").datepicker("destroy");

                }
            }
        });
    });

    function InformationStatus(stsvalue) {

        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("InformationStatus", "Employee", "http")',
            data: { stsvalue: stsvalue } ,
            dataType: 'json',
            async: true,
            success: function (response) {
                $.each(response.Data, function (index, status) {
                    if (status.Value) {
                        $("#typeFilterColumn option").filter(function () {
                            return $(this).text() == status.Text;
                        }).prop("selected", true);
                    }
                });

                $('.selectpicker').selectpicker('refresh');

            },
        });

    }

</script>


