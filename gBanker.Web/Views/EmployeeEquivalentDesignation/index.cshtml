@model gHRM.Web.ViewModels.EmployeeEquivalentDesignationViewModel
<div class="row">
    <ol class="breadcrumb breadcrumb-arrow">
        <li><a href="/EmployeeEquivalentDesignation/">EmployeeEquivalentDesignation</a></li>
    </ol>
</div>
@{
    ViewBag.Title = "EmployeeEquivalentDesignation";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
    <link href="~/Content/jtable-custom.css?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()" rel="stylesheet" />
}

<script type="text/javascript">

    //create
    function GenerateEmployeeEquivalentDesignation() {
        var item = {};
        item.EquivalentDesignationName = $("#EquivalentDesignationName").val();
        return item;
    }

    function GenerateUpdateEmployeeEquivalentDesignation() {
        var item = {};
        item.EquivalentDesigId = $("#EquivalentDesigId").val();
        item.EquivalentDesignationName = $("#EquivalentDesignationName").val();
        return item;
    }

    function ClearControl() {
        $("#EquivalentDesignationName").val('');

    }

    function SaveEmployeeEquivalentDesignation() {


        var employeeEquivalentDesignation = GenerateEmployeeEquivalentDesignation();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveEmployeeEquivalentDesignation", "EmployeeEquivalentDesignation")',
            data: JSON.stringify({ employeeEquivalentDesignation: employeeEquivalentDesignation }),
            contentType: "application/json; charset=utf-8",
            success: function(data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    $('#grid').jtable('load');
                }

            },
            error: function(xhr, status, error) {
                alert(error);
            }

        });

    }

    function UpdateEmployeeEquivalentDesignation() {


        var employeeEquivalentDesignation = GenerateUpdateEmployeeEquivalentDesignation();

        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateEmployeeEquivalentDesignation", "EmployeeEquivalentDesignation")',
            data: JSON.stringify({ employeeEquivalentDesignation: employeeEquivalentDesignation }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                $('#grid').jtable('load');
                if (data == "Update Successfull") {
                    ClearControl();
                    $('#grid').jtable('load');
                }

            },
            error: function (xhr, status, error) {
                alert(error);
            }

        });

    }

    // delete
    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteEmployeeEquivalentDesignation", "EmployeeEquivalentDesignation", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $('#grid').jtable('load');
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    //edit using jtable

    function ResetEASSManagment() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }

    function Edited(tgid, tgn) {
        $("#EquivalentDesigId").val(tgid);
        $("#EquivalentDesignationName").val(tgn);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();

    }



    $(document).ready(function () {
        $("#btnUpdate").hide();
        $("#btnReset").hide();


        $('#grid').jtable({
            paging: true,
            pageSize: 20,
            sorting: true,
            defaultSorting: 'InventoryId ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    var eCode = $("#Ecode").val();

                    return $.Deferred(function ($dfd) {

                        $.ajax({
                            url: '/EmployeeEquivalentDesignation/ListEmployeeEquivalentDesignation?jtStartIndex=' + jtParams.jtStartIndex + '&jtPageSize=' + jtParams.jtPageSize + '&jtSorting=' + jtParams.jtSorting,

                            type: 'POST',
                            dataType: 'json',
                            data: postData,

                            success: function (data) {
                                $dfd.resolve(data);

                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                }

            },
            fields: {
                Id: {
                    key: true,
                    list: false,
                    create: false,
                    edit: false
                },
                EquivalentDesigId: {
                    title: 'EquivalentDesigId',
                    width: '10%'
                },
                EquivalentDesignationName: {
                    title: 'EquivalentDesignationName',
                    width: '15%'
                },
                EditLink: {
                    title: "Edit",
                    sorting: false,
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="Edited(' + "'" + data.record.EquivalentDesigId + "'" + ',' + "'" + data.record.EquivalentDesignationName + "'" + ');"><i class="fa fa-pencil-square-o"></i></a></div>';
                    }
                },
                Delete: {
                    title: "Delete",
                    display: function (data) {
                        return '<div class="text-center"><a href="#" OnClick="InformationDelete(' + data.record.EquivalentDesigId + ');"><i class="fa fa-trash-o"></i></a></div>';
                    }

                },
            }
        });
        $('#grid').jtable('load');
    });





</script>


<h2 class="page-title">Employee Equivalent Designation</h2>
@using (Html.BeginForm("SaveEmployeeEquivalentDesignation", "EmployeeEquivalentDesignation", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Equivalent Designation Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.EquivalentDesignationName, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" onclick="SaveEmployeeEquivalentDesignation()" />
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" onclick="UpdateEmployeeEquivalentDesignation()" />
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary" onclick="ResetEASSManagment()" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
            @Html.HiddenFor(model => model.EquivalentDesigId)
        </div>
    </div>
}


