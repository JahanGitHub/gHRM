@model gHRM.Web.ViewModels.PF.CollectionTypeConfigurationViewModel

@{
    ViewBag.Title = "Collection Configuration";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>
<script type="text/javascript">
    
    $(document).ready(function () {
        $("#dvInterest").hide();
        $("#PrincipalInPer").val(100);
        NumericTextboxOnly("#PrincipalInPer")
        NumericTextboxOnly("#InterestInPer")

        $("#CollectionType").change(function () {
            var t = $(this).val();
            if (t == "Principal"){
                $("#PrincipalInPer").val(100);
                $("#InterestInPer").val(0);
                $("#dvPrincipal").show()
                $("#dvInterest").hide()
            }
                
            else if (t == "Interest") {
                $("#PrincipalInPer").val(0);
                $("#InterestInPer").val(100);
                $("#dvPrincipal").hide()
                $("#dvInterest").show()
            }
            else {
                $("#PrincipalInPer,#InterestInPer").val(0);
                $("#dvPrincipal,#dvInterest").show();
            }
        });

        $("button").click(function (e) {
            e.preventDefault();
            if ($(this).val() == "Reset") 
                $("textbox").val(0);
            else if ($(this).val() == "Save") {
                var principal = parseInt($("#PrincipalInPer").val());
                var interest = parseInt($("#InterestInPer").val());
                if (principal + interest == 100) {
                    var dataObject = {
                        CollectionType: $("#CollectionType").val(),
                        PrincipalInPer: principal,
                        InterestInPer: interest,
                        IsActive: true
                    };
                    var data = GenerateAjaxRequist('/PFType/SaveCollectionConfiguration', JSON.stringify({ obj: dataObject }), "POST");
                    reloadGrid();
                }
               
            }
        });

        $('#grid').jtable({
            // title: 'Product List',
            paging: false,
            //pageSize: 10,
            sorting: false,
            //defaultSorting: 'Name ASC',
            actions: {
                listAction: function (postData, jtParams) {
                    console.log("Loading from custom function...");
                    return $.Deferred(function ($dfd) {
                        $.ajax({
                            url: '/PFType/GetAllCollectionConfig',
                            type: 'POST',
                            dataType: 'json',
                            data: postData,
                            success: function (data) {
                                $dfd.resolve(data);
                            },
                            error: function () {
                                $dfd.reject();
                            }
                        });
                    });
                },
            },
            fields: {
                CollectionType: {
                    title: 'Collection Type',
                    width: '10%'

                },
                PrincipalInPer: {
                    title: 'Principal (%)',
                    width: '30%'

                },
                InterestInPer: {
                    title: 'Interest (%)',
                    width: '30%'
                }
            }
        });
        reloadGrid();
    });
    function reloadGrid() {
        $('#grid').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
    }
</script>



<h2 class="page-title">Collection Configuration</h2>

<br />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true)

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.CollectionType, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.DropDownListFor(model => model.CollectionType, Model.CollectionTypeLst, new { @class = "form-control", @tabindex = 1 })
                </div>
            </div>
        </div>

        <div class="row" id="dvPrincipal">
            <div class="form-group">
                @Html.LabelFor(model => model.PrincipalInPer, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.PrincipalInPer, new { @class = "form-control", @tabindex = 2 })
                </div>
            </div>
        </div>

        <div class="row" id="dvInterest">
            <div class="form-group">
                @Html.LabelFor(model => model.InterestInPer, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.InterestInPer, new { @class = "form-control", @tabindex = 3 })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-3">
                <div class="form-group" style="padding-left:7px;">
                    <button type="button" class="btn btn-success" value="Save">Save</button>
                    &nbsp;
                    <button type="button" class="btn btn-facebook" value="Reset">Reset</button>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-12">
                <div id="grid"></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Assets/js/app/CommonMethod.js?v=@gHRM.Core.Utilities.CommonHelper.DEV_VERSION()"></script>
    @Scripts.Render("~/bundles/jqueryval")
}