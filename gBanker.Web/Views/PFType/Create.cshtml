@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true)

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.ShortName, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.DropDownListFor(model => model.ShortName, Model.PFTypeList, new { @class = "form-control", @tabindex = 1 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.FullName, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", @tabindex = 2 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.HasSelfContribution, new { @class = "control-label col-md-2" })
                <div class="col-md-2">
                    @Html.CheckBoxFor(model => model.HasSelfContribution, new { @tabindex = 3 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.SelfContributionRate, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.SelfContributionRate, new { @class = "form-control", @tabindex = 5 })
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.HasOrgContribution, new { @class = "control-label col-md-2" })
                <div class="col-md-1">
                    @Html.CheckBoxFor(model => model.HasOrgContribution, new { @tabindex = 6 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.OrgContributionRate, new { @class = "control-label col-md-2" })
                <div class="col-md-4">
                    @Html.TextBoxFor(model => model.OrgContributionRate, new { @class = "form-control", @tabindex = 7 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                @Html.LabelFor(model => model.HasAddSelfContribution, new { @class = "control-label col-md-2" })
                <div class="col-md-2">
                    @Html.CheckBoxFor(model => model.HasAddSelfContribution, new { @tabindex = 3 })
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-3">
                <div class="form-group" style="padding-left:7px;">
                    <input type="button" value="Save" id="btnSavePFType" class="btn btn-success" tabindex="8" />
                    &nbsp;
                    <input type="button" value="Reset" id="btnReset" class="btn btn-facebook" tabindex="9" />
                </div>
            </div>
        </div>

    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}