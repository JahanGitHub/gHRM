@model gHRM.Web.ViewModels.PF.PFTypeViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";
}

<style>
    .jtable > thead > tr {
        height: 50px;
    }
</style>

<script type="text/javascript">

    var pfTypeEnum = {
        CPF: "CPF",
        GPF: "GPF"
    }

    function isNumber(evt, element) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (
            (charCode != 45 || $(element).val().indexOf('-') != -1) &&      // “-” CHECK MINUS, AND ONLY ONE.
            (charCode != 46 || $(element).val().indexOf('.') != -1) &&      // “.” CHECK DOT, AND ONLY ONE.
            (charCode < 48 || charCode > 57))
            return false;
        return true;
    }

    function SavePFType(pfTypeId, shortName, fullName, hasSelfContribution, hasOrgContribution, hasAddSelfContribution, selfContributionRate, orgContributionRate) {        
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("SavePFType", "PFType", "http")',
            data: { pfTypeId: pfTypeId, shortName: shortName, fullName: fullName, hasSelfContribution: hasSelfContribution, hasOrgContribution: hasOrgContribution, hasAddSelfContribution: hasAddSelfContribution, selfContributionRate: selfContributionRate, orgContributionRate: orgContributionRate },
            dataType: 'json',
            async: true,
            success: function (data) {
                $.alert.open("Message", data.message);

                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            },
            error: function (request, status, error) {
                $.alert.open("Message", "Data Not Saved");
                $('#grid2').jtable('load', { filterColumn: $('#filterColumn').val(), filterValue: $('#filterValue').val() });
            }
        });
    }

    function HasActivePFType(FullName) {
        $.ajax({
            type: 'GET',
            contentType: "application/json; charset=utf-8",
            url: '@Url.Action("HasActivePFType", "PFType", "http")',
            data: { FullName: FullName },
            dataType: 'json',
            async: false,
            success: function (data) {
                alert(data.message);
            },
            error: function (request, status, error) {
                alert(request.statusText + "/" + request.statusText + "/" + error);
                clear();
            }
        });
    }

    function IsValidate(shortName, fullName, hasSelfContribution, hasOrgContribution, selfContributionRate, orgContributionRate) {
        var message = '';

        //Checking Self Contribution
        if (fullName == '') {
            message = 'Enter Full Name.';
            return message;
        }
        if (hasSelfContribution == false) {
            message = 'Allow Self Contribution.';
            return message;
        }
        if (selfContributionRate == '') {
            message = 'Enter Self Contribution Rate.';
            return message;
        }

        if (shortName == 'GPF') {
            if (hasOrgContribution == true) {
                message = 'Disallow Organization Contribution.';
                return message;
            }
            if (orgContributionRate != '') {
                message = 'Organization Contribution Rate should be empty';
                return message;
            }
        }

        if (shortName == 'CPF') {
            if (hasOrgContribution == false) {
                message = 'Allow Organization Contribution.';
                return message;
            }
            if (orgContributionRate == '') {
                message = 'Enter Organization Contribution Rate.';
                return message;
            }
        }

        return message;
    }

    function ClearOnPFChange() {

        $("#FullName").val('');
        $("#HasSelfContribution").prop("checked", false);
        $("#HasOrgContribution").prop("checked", false);
        $("#HasAddSelfContribution").prop("checked", false);
        $("#SelfContributionRate").val('');
        $("#OrgContributionRate").val('');
        SpecializeUI();
    }

    function SpecializeUI() {
        var shortName = '';
        var sName = $("#ShortName option:selected").text();       
        if (sName) {
            shortName = sName.split('[')[0].trim();
            var fullName = sName.split('[')[1].trim();
            $("#FullName").val(fullName.replace(']', ''));
        }

        if (shortName == pfTypeEnum.GPF) {
            $("#HasOrgContribution").prop("disabled", true);
            $("#OrgContributionRate").prop("disabled", true);
        }
        if (shortName == pfTypeEnum.CPF) {
            $("#HasOrgContribution").prop("disabled", false);
            $("#OrgContributionRate").prop("disabled", false);
        }
    }

    function clear() {
        $("#ShortName").val('');
        $("#FullName").val('');
        $("#HasSelfContribution").prop("checked", false);
        $("#HasOrgContribution").prop("checked", false);
        $("#HasAddSelfContribution").prop("checked", false);
        $("#SelfContributionRate").val('');
        $("#OrgContributionRate").val('');
    }

    function Add() {
        var sName = $("#ShortName option:selected");
        if (!sName) {
            alert('Select One');
            return;
        }

        var pfTypeId = sName.val();
        var shortName = sName.text();
        shortName = shortName.split('[')[0].trim();

        var fullName = $("#FullName").val();
        var hasSelfContribution = $("#HasSelfContribution").is(":checked");
        var hasOrgContribution = $("#HasOrgContribution").is(":checked");
        var hasAddSelfContribution = $("#HasAddSelfContribution").is(":checked");
        var selfContributionRate = $("#SelfContributionRate").val();
        var orgContributionRate = $("#OrgContributionRate").val();
        
        var message = IsValidate(shortName, fullName, hasSelfContribution, hasOrgContribution, selfContributionRate, orgContributionRate);

        if (message != '') {
            alert(message);
            return;
        }

        SavePFType(pfTypeId, shortName, fullName, hasSelfContribution, hasOrgContribution, hasAddSelfContribution, selfContributionRate, orgContributionRate);
        clear();
    }

    $(document).ready(function () {
        //disable Full Name
        $('#FullName').attr('disabled', true);

        $("#ShortName").focus();

        $('#ShortName').change(function () {
            ClearOnPFChange();
        });

        $("#btnReset").click(function () {
            clear();
        });

        $('#SelfContributionRate').keypress(function (event) {
            return isNumber(event, this)
        });
        $('#OrgContributionRate').keypress(function (event) {
            return isNumber(event, this)
        });
       
        $("#btnSavePFType").click(function (e) {
            $.alert.open('confirm', 'Are you sure you want to add?', function (button) {
                if (button == 'yes') {
                    Add();
                    return true;
                }
                else {
                    return false;
                }
            });
        });

    });
</script>

