@model gHRM.Web.ViewModels.EducationDegreeViewModel

@{
    ViewBag.Title = "EducationDegreeCreate";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

    var DegreeLevelList = Model == null ? null : Model.DegreeLevelList;
}

<script>
    $(document).ready(function () {

        GetEducationDegreeDashBoard();
        $('[name="DegreeLevel"]').prop('readonly', true);
        $("#customControlAutosizing").click(function () {
            if ($(this).prop('checked') == true) {
                $('#DegreeLevelId').val(0).prop('disabled', true);
                $('[name="DegreeLevel"]').prop('readonly', false);
            } else {
                $('#DegreeLevelId').prop('disabled', false);
                $('[name="DegreeLevel"]').prop('readonly', true);
            }

        });
        $("#DegreeLevelId").change(function () {
            var degreeLevelId = $("#DegreeLevelId").val();

            if (degreeLevelId != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetDegreesByDegreeLevelId", "EducationSubjects", "http")',
                    data: { degreeLevelId: degreeLevelId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            $("#DegreeLevel").val(data);
                        } else {
                            $("#DegreeLevel").val("");
                        }
                    },
                });
          } 
        });
        $("#btnSave").click(function (e) {
            e.preventDefault();

            debugger;

            var DegreeId = $("#DegreeId").val();
            var DegreeLevelId = $("#DegreeLevelId").val();
            var DegreeLevel = $("#DegreeLevel").val();
            var DegreeCode = $("#DegreeCode").val();
            var DegreeName = $("#DegreeName").val();

            if ($("#DegreeLevelId").val() == "") {
                $.alert.open("Error", "Please Insert Degree Level Id");
                return false;
            }
            //if ($("#DegreeLevel").val() == "") {
            //    $.alert.open("Error", "Please Insert Degree Level");
            //    return false;
            //}
            if ($("#DegreeCode").val() == "") {
                $.alert.open("Error", "Please Insert DegreeCode");
                return false;
            }
            if ($("#DegreeName").val() == "") {
                $.alert.open("Error", "Please Insert DegreeName");
                return false;
            }

            $('#AjaxLoader').show();
            $.ajax({
                type: "GET", //GET or POST or PUT or DELETE verb
                url: '/EducationSubjects/SaveEducationDegree',
                data: {
                    DegreeId: DegreeId, DegreeLevelId: DegreeLevelId, DegreeLevel: DegreeLevel,
                    DegreeCode: DegreeCode, DegreeName: DegreeName
                },
                dataType: "json", //Expected data format from server
                processdata: false, //True or False
                success: function (data) { //On Successful service call
                    $('#AjaxLoader').hide();
                    $.alert.open("Alert", data.message);
                    ClearForm();
                    GetEducationDegreeDashBoard();
                },
                error: function (data) {
                    $('#AjaxLoader').hide();
                    $.alert.open('error', 'Error');
                }
            });
            //} else {
            //    $.alert.open("Error", "Please Insert required fields");
            //}

        });
    });
    function GetEducationDegreeDashBoard() {
        $('#gridKendo').html("");
        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data",
                total: "total"
            },
            serverPaging: true,
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("GetEducationDegree", "EducationSubjects", "http")',
                    dataType: 'json',
                    data: {}
                }
            }
        });

        $("#gridKendo").kendoGrid({
            dataSource: dataSource,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                {
                    field: "DegreeId",
                    hidden: true,
                    filterable: false
                },
                {
                    field: "rowSl",
                    title: "SL",
                    width: "50px",
                    filterable: false,
                },
                {
                    field: "DegreeLevel",
                    title: "DegreeLevel",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "DegreeCode",
                    title: "Degree Code",
                    width: "100px",
                    filterable: true,
                },
                {
                    field: "DegreeName",
                    title: "Degree Name",
                    width: "60px",
                    filterable: true,
                },
                 {
                     title: "Edit",
                     width: "20px",
                     template: function (dataItem) {
                         if (dataItem.DegreeId > 0) {
                             return "<a href='/EducationSubjects/AddEducationDegree/?DegreeId=" + dataItem.DegreeId + "'><i class='fa fa-pencil-square-o'></i></a>";
                         } else {
                             return "";
                         }
                     }
                 }
            ]
        });
    }

    function ClearForm() {
        $("#DegreeId").val('');
        $("#DegreeLevelId").val("").trigger('change');
        $("#DegreeLevel").val('');
        $("#DegreeCode").val('');
        $("#DegreeName").val('');
        /*location.href ="/EducationSubjects/AddEducationDegree"*/
    }


</script>

&nbsp;
<h2 class="page-title">Add Education Degree</h2>
