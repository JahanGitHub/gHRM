@using (Html.BeginForm("Step_02", "Apply", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "JobExperience" }))

{
    @Html.AntiForgeryToken()
    <form id="InputForm">
        <div class="container-fluid">
            <fieldset>
                <div class="">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(m => m.DegreeId)
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                @Html.LabelFor(model => model.DegreeLevel, htmlAttributes: new { @class = "control-label col-sm-4" })
                                <div class="col-sm-8">
                                    @Html.DropDownListFor(model => model.DegreeLevelId, Model.DegreeLevelList, new { @id = "DegreeLevelId", @class = "form-control required" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-1">
                            <div class="custom-control custom-checkbox mr-sm-3">
                                <input type="checkbox" id="customControlAutosizing">
                                <label for="customControlAutosizing">Add New Degree</label>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="form-group NewDegreeLevel">
                                <label class="control-label col-sm-4 required" for="DegreeLevel">Degree Level Name</label>
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.DegreeLevel, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.DegreeLevel, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group">
                                @Html.LabelFor(model => model.DegreeCode, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.DegreeCode, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.DegreeCode, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1">
                        </div>
                        <div class="col-md-5">
                            <div class="form-group">
                                @Html.LabelFor(model => model.DegreeName, htmlAttributes: new { @class = "control-label col-sm-4 required" })
                                <div class="col-sm-8">
                                    @Html.TextBoxFor(model => model.DegreeName, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.DegreeName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </fieldset>
        </div>
    </form>
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group form-action" style="padding:10px;margin:5px;">
                &nbsp;
                <button type="button" id="btnSave" class="btn btn-success btn-sm" style="float:right;"><i class="fa fa-check-circle-o"></i> Save</button>
            </div>
        </div>
    </div>
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-horizontal">
            <hr />
            <div class="box-content">
                <div class="table-responsive">
                    <div id="gridKendo"></div>
                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}
