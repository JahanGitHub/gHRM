@model gHRM.Web.ViewModels.EmployeeViewModel

@{
    ViewBag.Title = "EducationSubjectCreate";
    Layout = "~/Views/Shared/_AdminLteLayout.cshtml";

    var degreeLevelList = Model == null ? null : Model.DegreeLevelList;
    var degreeList = Model == null ? null : Model.DegreeList;
}

<script type="text/javascript">

    $(document).ready(function () {

        ResetControls()
        LoadGrid();

        $("#DegreeLevel").change(function () {
            var degreeLevelId = $("#DegreeLevel").val();
            var ddlDegreeTitle = $("#DegreeTitle");

            if (degreeLevelId != "") {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("GetDegreesByDegreeLevel", "EducationSubjects", "http")',
                    data: { degreeLevelId: degreeLevelId },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.length > 0) {
                            ddlDegreeTitle.html("");
                            ddlDegreeTitle.html('<option value="">Please Select</option>');
                            $.each(data, function (id, option) {
                                ddlDegreeTitle.append($('<option></option>').val(option.Value).html(option.Text));
                            });
                        } else {
                            ddlDegreeTitle.html('<option value="">Please Select</option>');
                        }
                    },
                });
            } else {
                ddlDegreeTitle.html('<option value="">Please Select</option>');
            }
        });


        $("#btnSave").click(function (e) {
            e.preventDefault();
            var vmCarType = GenerateVMCartype();
            var isValid = EducationValidation(vmCarType);

            if (isValid) {

                $.ajax({
                    type: "POST",
                    dataType: "json",
                    async: true,
                    cache: false,
                    url: '@Url.Action("SaveEducationSubject", "EducationSubjects")',
                    data: JSON.stringify({ vmCarType: vmCarType }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open('Success', data.message);
                            ClearForm();
                            LoadGrid();
                        }
                        else {
                            $.alert.open('ERROR', data.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert(error);
                    }
                });
            }
            else {
                $.alert.open('ERROR', "Please Select all required fields");
            }
        }); // End Save


        // Update
        $("#btnUpdate").click(function (e) {
            e.preventDefault();

            var vmCarType = UpdateVMCartype();
            var isValid = EducationValidation(vmCarType);

            if (isValid) {
                $.ajax({
                    type: "POST",
                    dataType: "json",
                    async: true,
                    cache: false,
                    url: '@Url.Action("UpdateEducationSubject", "EducationSubjects")',
                    data: JSON.stringify({ vmCarType: vmCarType }),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open('Success', data.message);
                            ResetControls();
                            LoadGrid();
                        }
                        else {
                            $.alert.open('ERROR', data.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        alert(error);
                    }
                });
            }
            else {
                $.alert.open('ERROR', "Please Select all required fields");
            }
        });

        $("#btnReset").click(function () {
            ResetControls();
        });

    });

    function ResetControls() {
        $("#btnSave").show();
        $("#btnUpdate").hide();
        $("#btnReset").hide();
        ClearForm();
    }

    function ClearForm() {
        $("#ConcentrationCode").val('');
        $("#ConcentrationName").val('');
    }


    function GenerateVMCartype() {

        var item = {};
        item.DegreeLevel = $("#DegreeLevel").val();
        item.DegreeCode = $("#DegreeTitle").val();
        item.ConcentrationName = $("#ConcentrationName").val();
        item.ConcentrationCode = $("#ConcentrationCode").val();
        return item;
    }

    function UpdateVMCartype() {
        var item = {};
        item.ConcentrationId = $("#ConcentrationId").val();
        item.DegreeLevel = $("#DegreeLevel").val();
        //item.DegreeCode = $("#DegreeCode").val();
        item.DegreeCode = $("#DegreeTitle").val();
        item.ConcentrationCode = $("#ConcentrationCode").val();
        item.ConcentrationName = $("#ConcentrationName").val();
        return item;
    }

    function EducationValidation(vmCarType) {

        if (vmCarType.DegreeLevel == '' || vmCarType.DegreeTitle == '' || vmCarType.ConcentrationName == '' || vmCarType.ConcentrationCode == '') {
            return false;
        }
        else {
            return true;
        }
    }

    function LoadGrid() {

        var dataSource = new kendo.data.DataSource({
            type: "aspnetmvc-ajax",
            pageSize: 25,
            schema: {
                data: "data", // records are returned in the "data" field of the response
                total: "total" // total number of records is in the "total" field of the response
            },
            serverPaging: true,   // enable server paging
            serverSorting: true,
            serverFiltering: true,
            transport: {
                read: {
                    url: '@Url.Action("EducationSubjectList", "EducationSubjects", "http")',
                    dataType: 'json',
                    //data: { FilterBy: filterBy, FilterValue: filterValue }OfficeDesignation/DesignationList
                }
            }
        });

        $("#grid").kendoGrid({
            dataSource: dataSource,
            //height: 600,
            groupable: false,
            reorderable: true,
            filterable: true,
            sortable: true,

            selectable: false,
            resizable: true,
            pageable: {
                refresh: true,
                pageSizes: true,
                buttonCount: 5
            },
            columns: [
                 {
                     field: "Id",
                     hidden: true,
                     filterable: false
                 },
                 //{
                 //    field: "ConcentrationId",
                 //    title: "ConcentrationId",
                 //    width: "50px",
                 //    filterable: true
                 //},

                 {
                     field: "rowSl",
                     title: "Sl No.",
                     width: "50px",
                     filterable: false,
                     columnMenu: false,
                     groupable: false,
                     reorderable: false,
                     sortable: false
                     //locked: true,
                     //lockable: false,
                 },
                 {
                     field: "DegreeLevel",
                     title: "Degree Level",
                     width: "100px",
                     filterable: true
                 },
                 {
                     field: "DegreeName",
                     title: "Degree Name",
                     width: "100px",
                     filterable: true
                 },
                 {
                    field: "ConcentrationName",
                    title: "Concentration Name",
                    width: "100px",
                    filterable: true
                 },
                 {
                     field: "ConcentrationCode",
                     title: "Concentration Code",
                     width: "50px",
                     filterable: true
                 },
                 {
                     width: "40px",
                     title: 'Action',
                     template: function (data) {
                        
                         var btn = '';
                         btn += "<div class='text-center' style='float:left;'><a title='Edit' href='#' OnClick='EditGrid(" + data.ConcentrationId +");'><i class='fa fa-pencil-square-o'></i></a></div>";
                         btn += '<div class="text-center"><a href="#" OnClick="InformationDelete(' + data.ConcentrationId + ');" title="Delete"><i class="fa fa-trash-o"></i></a></div>';
                         return btn;
                     }
                 }
            ]
        });
    }

    function EditGrid(ConcentrationId) {
        $.ajax({
            //type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("EditEducationSubject", "EducationSubjects")',
            data:{ConcentrationId: ConcentrationId},
            //data: JSON.stringify({ vmCarType: vmCarType }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.result == 1) {
                    var ddlDegreeTitle = $("#DegreeTitle");
                    if (data.model.DegreeList.length > 0) {
                        ddlDegreeTitle.html("");
                        $.each(data.model.DegreeList, function (id, option) {
                            ddlDegreeTitle.append($('<option></option>').val(option.Value).html(option.Text));
                        });
                    } else {
                        ddlDegreeTitle.html('<option value="">Please Select</option>');
                    }

                    $("#ConcentrationId").val(data.model.ConcentrationId);
                    $("#DegreeLevel").val(data.model.DegreeLevel);
                    $("#DegreeTitle").val(data.model.DegreeCode);
                    $("#ConcentrationName").val(data.model.ConcentrationName);
                    $("#ConcentrationCode").val(data.model.ConcentrationCode);

                    $("#btnReset").show();
                    $("#btnUpdate").show();
                    $("#btnSave").hide();                  
                }
                else {
                    $.alert.open('ERROR', data.message);
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("DeleteEducationSubject", "EducationSubjects", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            $.alert.open("Success", data.message);
                            LoadGrid();
                        } else {
                            $.alert.open("Error", data.message);
                        }
                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

</script>

<h2 class="page-title"> Education Subject Entry List </h2>
@using (Html.BeginForm("EducationSubjectEntry", "EducationSubjects", FormMethod.Get, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br />
    <br />
    <div id="AjaxLoader" class="ajaxLoader"></div>
    @Html.HiddenFor(model => model.ConcentrationId)

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">

                @Html.LabelFor(model => model.DegreeLevel, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.DegreeLevel, degreeLevelList, new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">

                @Html.LabelFor(model => model.DegreeTitle, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.DropDownListFor(model => model.DegreeTitle, degreeList, new { @class = "form-control" })
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.ConcentrationName, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.ConcentrationName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Concentration Name" } })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">

                @Html.LabelFor(model => model.ConcentrationCode, htmlAttributes: new { @class = "control-label  col-sm-4 required" })
                <div class="col-sm-8">
                    @Html.EditorFor(model => model.ConcentrationCode, new { htmlAttributes = new { @class = "form-control", @placeholder = "Concentration Code" } })
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-10 col-md-offset-2">
            <div class="form-group">
                <div class="col-sm-8">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary" /> 
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary" /> &nbsp;
                    <input type="button" value="Reset" id="btnReset" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>

    <div id="grid"></div>
}


@section Scripts {

    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/jtable")
    @Scripts.Render("~/bundles/alert")
}
