    //create
    function GenerateInternalOrganization() {
        var item = {};
        item.OrganizationName = $("#OrganizationName").val();
        item.OrganizationCode = $("#OrganizationCode").val();
        return item;
    }

    function GenerateUpdateInternalOrganization() {
        var item = {};
        item.OrgId = $("#OrgId").val();
        item.OrganizationName = $("#OrganizationName").val();
        item.OrganizationCode = $("#OrganizationCode").val();
        return item;
    }

    //edit using jtable
    function ResetInternalOrganization() {
        $("#btnUpdate").hide();
        $("#btnSave").show();
        $("#btnReset").hide();
        ClearControl();
    }
    function EditInternalOrganization(OrgId, OrganizationName, OrganizationCode) {
        $("#OrgId").val(OrgId);
        $("#OrganizationName").val(OrganizationName);
        $("#OrganizationCode").val(OrganizationCode);
        $("#btnUpdate").show();
        $("#btnReset").show();
        $("#btnSave").hide();
    }

    function ClearControl() {
        $("#OrganizationName").val('');
        $("#OrganizationCode").val('');
    }


    function SaveInternalOrganization() {
        var InternalOrganization = GenerateInternalOrganization();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("SaveInternalOrganization", "InternalOrganization")',
            data: JSON.stringify({ InternalOrganization: InternalOrganization }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Save Successfull") {
                    ClearControl();
                    //$('#grid').jtable('load');
                    loadInternalOrganization();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function UpdateInternalOrganization() {
        var InternalOrganization = GenerateUpdateInternalOrganization();
        $.ajax({
            type: "POST",
            dataType: "json",
            async: true,
            cache: false,
            url: '@Url.Action("UpdateInternalOrganization", "InternalOrganization")',
            data: JSON.stringify({ InternalOrganization: InternalOrganization }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $.alert.open('Success', data);
                if (data == "Update Successfull") {
                    ClearControl();
                    //$('#grid').jtable('load');
                    loadInternalOrganization();
                }
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }

    function InformationDelete(Id) {
        $.alert.open('confirm', 'Are you sure you want to delete this record?', function (button) {
            if (button == 'yes') {
                $.ajax({
                    type: 'GET',
                    contentType: "application/json; charset=utf-8",
                    url: '@Url.Action("InformationDeleteInternalOrganization", "InternalOrganization", "http")',
                    data: { Id: Id },
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.result == 1) {
                            //$('#grid').jtable('load');
                            loadInternalOrganization();
                            $.alert.open("Error", data.message);
                        } else {
                            $.alert.open("Error", data.message);
                        }

                    },
                    error: function (request, status, error) {
                        alert(request.statusText + "/" + request.statusText + "/" + error);
                    }
                });
                return true;
            }
            else {
                hiddenField.value = 'false';
                return false;
            }
        });
    }

    

</script>


<h2 class="page-title">Internal Organization</h2>
@using (Html.BeginForm("SaveInternalOrganization", "InternalOrganization", FormMethod.Post, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <br /><br />
    <div id="AjaxLoader" class="ajaxLoader"></div>

    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Organization Name</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.OrganizationName, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label col-sm-4 required">Organization Code</label>
                <div class="col-sm-8">
                    @Html.TextBoxFor(model => model.OrganizationCode, new { @class = "form-control required" })
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="form-group">
                <div class="col-sm-8 pull-right">
                    <input type="button" value="Save" id="btnSave" class="btn btn-primary"/>
                    <input type="button" value="Update" id="btnUpdate" class="btn btn-primary"/>
                    <input type="button" value="Reset" id="btnReset" style="margin-left: 20px" class="btn btn-primary"/>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-8">
            @Html.HiddenFor(model => model.OrgId)
        </div>
    </div>
}

<br/><h2 class="page-title">Internal Organization List</h2>
<div id="grid"></div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    @Scripts.Render("~/bundles/gbUtility")
    @Scripts.Render("~/bundles/jtable")
}












